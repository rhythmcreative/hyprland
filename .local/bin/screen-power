#!/usr/bin/env bash
# Apaga o enciende todas las pantallas.
#
# Soporta Hyprland 0.55+ (API Lua: hl.dispatch(hl.dsp.dpms(...))) y
# Hyprland < 0.55 (legacy: hyprctl dispatch dpms on|off).
#
# Nota API Lua 0.57: hl.dsp.dpms("on", "eDP-1") devuelve nil (dos argumentos
# posicionales no existen); la forma correcta con monitor es tabla
# {state='on', monitor='eDP-1'} o cadena global 'on'/'off'.
#
# Uso: screen-power on|off|toggle

set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    _wl=$(ls -t "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$_wl" ]; then export WAYLAND_DISPLAY=$(basename "$_wl"); fi
    unset _wl
fi
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    _sig=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    [ -n "$_sig" ] && export HYPRLAND_INSTANCE_SIGNATURE="$_sig"
    unset _sig
fi

estado="${1:-}"
[ -n "$estado" ] || { echo "Uso: screen-power on|off|toggle" >&2; exit 1; }

FLAG="$XDG_RUNTIME_DIR/screen-power.state"

case "$estado" in
    on|off) ;;
    toggle)
        if [ -f "$FLAG" ] && [ "$(cat "$FLAG" 2>/dev/null)" = "off" ]; then
            estado="on"
        else
            estado="off"
        fi
        ;;
    *) echo "screen-power: solo on, off o toggle" >&2; exit 1 ;;
esac

command -v hyprctl >/dev/null 2>&1 || { echo "screen-power: hyprctl no esta" >&2; exit 1; }

hypr_eval_ok() {
    local out
    out=$(hyprctl eval "$1" 2>&1) || return 1
    case "$out" in
        *error*|*unknown*|*"legacy parsers"*|"") return 1 ;;
    esac
    return 0
}

monitores=""
if command -v jq >/dev/null 2>&1; then
    monitores=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.disabled == false) | .name' 2>/dev/null || true)
fi

fallos=0
if [ -n "$monitores" ]; then
    for m in $monitores; do
        lua="hl.dispatch(hl.dsp.dpms({state='${estado}', monitor='${m}'}))"
        if ! hypr_eval_ok "$lua" && ! hyprctl dispatch dpms "$estado" "$m" >/dev/null 2>&1; then
            fallos=$((fallos + 1))
        fi
    done
fi

# Despacho global para asegurar todas las salidas
if ! hypr_eval_ok "hl.dispatch(hl.dsp.dpms('${estado}'))"; then
    hyprctl dispatch dpms "$estado" >/dev/null 2>&1 || true
fi

if [ "$estado" = "off" ]; then
    echo "off" > "$FLAG" 2>/dev/null || true
else
    rm -f "$FLAG" 2>/dev/null || true
fi

[ "$fallos" -eq 0 ] || exit 1
exit 0

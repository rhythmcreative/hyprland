#!/bin/bash
# Toggle all rust-dock instances seamlessly
STATE_FILE="/tmp/rust-dock-visible"

# Usar SIGHUP para invocar toggle_visibility() nativamente en rust-dock sin matar este script
pkill -x -HUP rust-dock 2>/dev/null || true

# Alternar el estado registrado
if [ -f "$STATE_FILE" ] && [ "$(cat "$STATE_FILE" 2>/dev/null)" = "hidden" ]; then
    echo "visible" > "$STATE_FILE" 2>/dev/null || true
else
    echo "hidden" > "$STATE_FILE" 2>/dev/null || true
fi

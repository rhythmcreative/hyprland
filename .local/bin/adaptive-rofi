#!/bin/bash

# Script adaptativo para rofi que detecta monitores automáticamente
# Soporta: drun, run, window

MODE=${1:-drun}

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Configuración de tema por defecto
THEME="~/.config/rofi/onedark.rasi"

# Verificar si el tema existe
if [ ! -f "$HOME/.config/rofi/onedark.rasi" ]; then
    # Fallback a tema por defecto del sistema
    THEME=""
fi

# Obtener información de monitores
get_active_monitor() {
    if command -v hyprctl &> /dev/null; then
        # Hyprland
        hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .name'
    elif command -v xrandr &> /dev/null; then
        # X11
        xrandr --listmonitors | grep -E '^\s*[0-9]+:.*\*' | awk '{print $4}' | head -1
    else
        echo "primary"
    fi
}

# Obtener configuración de monitor
ACTIVE_MONITOR=$(get_active_monitor)
MONITOR_COUNT=$(xrandr --listmonitors 2>/dev/null | tail -n +2 | wc -l || echo 1)

# Configurar argumentos de rofi según el modo
case "$MODE" in
    "drun")
        ROFI_ARGS="-show drun"
        ;;
    "run")
        ROFI_ARGS="-show run"
        ;;
    "window")
        ROFI_ARGS="-show window"
        ;;
    *)
        ROFI_ARGS="-show $MODE"
        ;;
esac

# Añadir tema si está disponible
if [ -n "$THEME" ]; then
    ROFI_ARGS="$ROFI_ARGS -theme $THEME"
fi

if [ -f "/tmp/powersave-active" ]; then
    bg_c=$(head -n 1 "$HOME/.cache/wal/colors" 2>/dev/null || echo "#101516")
    [ -n "$bg_c" ] || bg_c="#101516"
    ROFI_ARGS="$ROFI_ARGS -theme-str '* { bgcolor: ${bg_c}; background-trans: ${bg_c}; background-alt-trans: ${bg_c}; } window { background-color: ${bg_c}; } mainbox { background-color: ${bg_c}; }'"
fi

_rust_was_visible=false
_waybar_was_visible=false
_qs_was_visible=false

if [ -n "$ACTIVE_MONITOR" ]; then
    if pgrep -f "rust-dock.*-o +$ACTIVE_MONITOR" >/dev/null 2>&1; then
        _rust_was_visible=true
        pkill -SIGUSR1 -f "rust-dock.*-o +$ACTIVE_MONITOR" 2>/dev/null &
    fi
    if pgrep -f "waybar.*config-$ACTIVE_MONITOR" >/dev/null 2>&1; then
        _waybar_was_visible=true
        pkill -SIGUSR1 -f "waybar.*config-$ACTIVE_MONITOR" 2>/dev/null &
    elif pgrep -x waybar >/dev/null 2>&1; then
        _waybar_was_visible=true
        pkill -SIGUSR1 waybar 2>/dev/null &
    fi
    if pgrep -f "quickshell -p .*waybar-island" >/dev/null 2>&1; then
        _qs_was_visible=true
        quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island hide "$ACTIVE_MONITOR" >/dev/null 2>&1 &
    fi
fi

rofi $ROFI_ARGS

if [ -n "$ACTIVE_MONITOR" ]; then
    [ "$_rust_was_visible" = true ] && pkill -SIGUSR2 -f "rust-dock.*-o +$ACTIVE_MONITOR" 2>/dev/null &
    [ "$_waybar_was_visible" = true ] && { pkill -SIGUSR2 -f "waybar.*config-$ACTIVE_MONITOR" 2>/dev/null & pkill -SIGUSR2 -x waybar 2>/dev/null & }
    [ "$_qs_was_visible" = true ] && quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island reveal "$ACTIVE_MONITOR" >/dev/null 2>&1 &
fi

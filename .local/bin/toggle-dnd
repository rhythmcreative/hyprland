#!/bin/bash
# Do Not Disturb switch (Omarchy-style).
# Uses mako / swaync when present, otherwise falls back to a flag file
# honored by the quickshell island notification banner.
STATE_FILE="/tmp/dnd-active"
ACTION="${1:-toggle}"

dnd_on() {
    if pgrep -x mako >/dev/null 2>&1 && command -v makoctl >/dev/null 2>&1; then
        makoctl mode -a do-not-disturb 2>/dev/null || true
    fi
    if pgrep -x swaync >/dev/null 2>&1 && command -v swaync-client >/dev/null 2>&1; then
        swaync-client -d 2>/dev/null || true
    fi
    touch "$STATE_FILE"
    echo "on"
}

dnd_off() {
    if pgrep -x mako >/dev/null 2>&1 && command -v makoctl >/dev/null 2>&1; then
        makoctl mode -r do-not-disturb 2>/dev/null || true
    fi
    if pgrep -x swaync >/dev/null 2>&1 && command -v swaync-client >/dev/null 2>&1; then
        swaync-client -D 2>/dev/null || true
    fi
    rm -f "$STATE_FILE"
    echo "off"
}

dnd_notify() {
    local title msg
    title=$(hypr-i18n dnd.title 2>/dev/null)
    [ -z "$title" ] && title="Do Not Disturb"
    msg="$1"
    notify-send "$title" "$msg" 2>/dev/null || true
}

case "$ACTION" in
    status)
        if [ -f "$STATE_FILE" ]; then
            echo "on"
        else
            echo "off"
        fi
        ;;
    on)
        dnd_on
        msg_on=$(hypr-i18n dnd.enabled 2>/dev/null)
        [ -z "$msg_on" ] && msg_on="Enabled - notifications silenced"
        dnd_notify "$msg_on"
        ;;
    off)
        dnd_off
        msg_off=$(hypr-i18n dnd.disabled 2>/dev/null)
        [ -z "$msg_off" ] && msg_off="Disabled - notifications allowed"
        dnd_notify "$msg_off"
        ;;
    toggle|*)
        if [ -f "$STATE_FILE" ]; then
            dnd_off
            msg_off=$(hypr-i18n dnd.disabled 2>/dev/null)
            [ -z "$msg_off" ] && msg_off="Disabled - notifications allowed"
            dnd_notify "$msg_off"
        else
            dnd_on
            msg_on=$(hypr-i18n dnd.enabled 2>/dev/null)
            [ -z "$msg_on" ] && msg_on="Enabled - notifications silenced"
            dnd_notify "$msg_on"
        fi
        ;;
esac

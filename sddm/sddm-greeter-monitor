#!/bin/sh
# Decide que salida debe pintar el login de SDDM y arranca Hyprland con ello.
#
# POR QUE ESTO NO ESTA EN LA CONFIG
# ---------------------------------
# La regla "el login solo en el panel" no se puede escribir tal cual en
# hyprland.lua porque tiene que ser condicional: con la tapa cerrada no hay
# panel interno, y una regla que lo apagase sin mirar dejaria el login sin
# ninguna pantalla. La condicion no se puede resolver dentro de la config
# porque esta version de Hyprland (0.56) no expone getMonitors en Lua, asi que
# la unica fuente fiable en ese punto es /sys/class/drm, que ya esta poblado
# cuando SDDM arranca el compositor en su VT.
#
# Ademas hay una razon de orden: la config se parsea cuando Hyprland ya esta
# initializing el backend, y una consulta al socket en ese momento es una
# carrera. /sys no tiene esa carrera.
#
# QUE HACE
# --------
#   1. Lista los conectores DRM conectados y se queda con el nombre (la parte
#      que va tras "cardN-"), no con la tarjeta: aqui conviven DOS conectores
#      eDP, card0-eDP-2 y card1-eDP-1, y el que sirve es el segundo. Buscar por
#      "la primera eDP" habria apagado la pantalla equivocada segun como se
#      numeren las GPUs.
#   2. Si hay panel, genera una regla por salida: el panel con su modo
#      preferido y todo lo demas apagado. Si no hay panel, no apaga nada y deja
#      que Hyprland encienda lo que encuentre, que es el caso de la tapa
#      cerrada con el monitor externo.
#   3. Sustituye la marca @@MONITOR@@ de la plantilla y arranca Hyprland.
#
# Los nombres de conector vienen del kernel, pero aun asi se validan: este
# fichero lo ejecuta root en el arranque y lo que sale de aqui se escribe en un
# fichero que Hyprland va a interpretar como config.

set -eu

PLANTILLA="${RHYTHM_SDDM_PLANTILLA:-}"
if [ -z "$PLANTILLA" ]; then
    if [ -f /usr/share/sddm/hyprland.conf ]; then
        PLANTILLA="/usr/share/sddm/hyprland.conf"
    elif [ -f /usr/share/sddm/hyprland.lua ]; then
        PLANTILLA="/usr/share/sddm/hyprland.lua"
    else
        PLANTILLA="/usr/share/sddm/hyprland.conf"
    fi
fi

# DONDE SE ESCRIBE LA CONFIG GENERADA
#
# NO puede ser /run. El greeter no corre como root: SDDM abre su sesion PAM
# como el usuario "sddm", asi que /run (755 root:root) no le deja crear nada
# ahi y el compositor no llega a arrancar nunca. Tampoco sirve /run/sddm, que es
# 711 de root.
#
# El fichero tiene que sobrevivir al exec (Hyprland lo lee al arrancar y no lo
# vuelve a pedir), asi que no se puede borrar despues. Por eso se reusa siempre
# el mismo nombre en vez de uno temporal: como mucho queda un fichero por
# arranque, y el siguiente login lo sobrescribe.
elegir_directorio() {
    for candidato in "${XDG_RUNTIME_DIR:-}" "/run/user/$(id -u)" /tmp; do
        [ -n "$candidato" ] || continue
        [ -d "$candidato" ] || continue
        [ -w "$candidato" ] || continue
        printf '%s\n' "$candidato"
        return 0
    done
    return 1
}

if ! WORK=$(elegir_directorio); then
    echo "sddm-greeter-monitor: no hay ningun directorio escribible para la config" >&2
    exit 1
fi

is_lua=0
case "$PLANTILLA" in
    *.lua) is_lua=1 ;;
esac

ext="conf"
[ "$is_lua" -eq 1 ] && ext="lua"
GENERADO="${RHYTHM_SDDM_CONFIG:-$(mktemp "$WORK/sddm-hyprland-greeter.XXXXXX.$ext" 2>/dev/null || echo "$WORK/sddm-hyprland-greeter-$$.$ext")}"

# La raiz de DRM se puede apuntar a otro sitio para poder probar los dos casos
# (con panel y con la tapa cerrada) sin desenchufar nada. En el arranque normal
# no se define y vale /sys.
DRM="${RHYTHM_SDDM_DRM:-/sys/class/drm}"

# Un conector valido solo tiene letras, digitos,guion y guion bajo.
CONECTOR_VALIDO='^[A-Za-z0-9_-]+$'

conectados() {
    for estado in "$DRM"/card*-*/status; do
        [ -r "$estado" ] || continue
        [ "$(cat "$estado" 2>/dev/null || echo desconocido)" = "connected" ] || continue
        nombre="${estado%/status}"
        nombre="${nombre##*/}"
        case "$nombre" in
            card*-*) ;;
            *) continue ;;
        esac
        # La tarjeta se guarda aparte porque hace falta mas abajo, para saber en
        # que GPU esta el panel: aqui conviven dos y no esta en la primera.
        tarjeta="${nombre%%-*}"
        # quita el prefijo de tarjeta: card1-eDP-1 -> eDP-1
        nombre="${nombre#card*-}"
        case "$nombre" in
            *[!A-Za-z0-9_-]*) continue ;;
        esac
        case "$tarjeta" in
            *[!A-Za-z0-9_-]*) continue ;;
        esac
        printf '%s %s\n' "$tarjeta" "$nombre"
    done
}

es_panel() {
    case "$1" in
        eDP-*) return 0 ;;
        *) return 1 ;;
    esac
}

hay_panel=0
salidas=""
tarjeta_panel=""

# Se lee linea a linea y NO con for $(...): cada linea son dos palabras
# (tarjeta y conector) y el bucle de palabras las separaria, dejando "card1" y
# "eDP-1" como dos conectores distintos. Ya paso: se terminaba apagando "card0"
# y "card1" como si fueran monitores, y el monitor se apagaba por la tarjeta
# entera en vez de por el conector.
lista=$(mktemp)
conectados >"$lista"
while read -r tarjeta c; do
    [ -n "$c" ] || continue
    salidas="$salidas $c"
    if es_panel "$c"; then
        hay_panel=1
        tarjeta_panel="$tarjeta"
    fi
done <"$lista"
rm -f "$lista"

# AQ_DRM_DEVICES: NO se pone. Y esto es lo que hacia que el login no arrancara.
#
# La variable existe en Aquamarine para desambiguar que render node se usa cuando
# hay mas de una GPU. Aqui se ponia a la tarjeta del panel (card1, la AMD) para
# que Aquamarine no creara un renderizador por tarjeta y para que el destructor
# de CDRMRenderer no reventara con un SEGV en eglDestroyContext al pararse el
# login. Motivo logico. El problema es que restringirla aqui hace que Aquamarine
# no pueda crear el backend en absoluto:
#
#     terminate called after throwing an instance of 'std::runtime_error'
#       what():  CBackend::create() failed!
#
# Hyprland lanza eso dentro de CCompositor::initServer, nadie lo captura,
# std::terminate() llama a abort() y el proceso muere con SIGABRT. SDDM lo
# reintenta cada 15 s: en un arranque medido, 78 coredumps de Hyprland con uid
# 962 (sddm) y el login dando un bote tras otro, sin llegar a verse.
#
# O sea que la variable arreglo un fallo que solo pasaba al PARAR el login, y a
# cambio decia que el login no ARRANCARA. Mal negocio.
#
# Medido el 2026-10-03, mismo greeter y misma config, cambiando solo esto:
#
#     con AQ_DRM_DEVICES=card1   78 coredumps en el arranque, greeter en bucle
#     sin AQ_DRM_DEVICES         0 coredumps, greeter estable y quieto
#
# El SEGV del teardown, si vuelve, es cosmetico: pasa cuando el login ya se esta
# cerrando. Se deja para el final en vez de pagar con no poder entrar.

# Escribe las reglas en un temporal para poder inyectarlas linea a linea.
reglas=$(mktemp)
trap 'rm -f "$reglas"' EXIT INT TERM

if [ "$hay_panel" -eq 1 ]; then
    # El panel manda. Todo lo demas se apaga: el login se ve una vez y sin
    # encender la dGPU entera por duplicar la misma pantalla.
    for c in $salidas; do
        if es_panel "$c"; then
            # La escala se fija a 1 a proposito: Hyprland usa 1.5 por defecto en
            # 1080p y el tema del greeter esta hecho en pixeles fijos, asi que a
            # 1.5 sale con todo enorme.
            if [ "$is_lua" -eq 1 ]; then
                echo "hl.monitor({ output = \"$c\", mode = \"preferred\", position = \"auto\", scale = \"1\" })" >>"$reglas"
            else
                echo "monitor = $c, preferred, auto, 1" >>"$reglas"
            fi
        else
            # En formato clásico es "monitor = <salida>, disable". En formato Lua es disabled = true.
            if [ "$is_lua" -eq 1 ]; then
                echo "hl.monitor({ output = \"$c\", disabled = true })" >>"$reglas"
            else
                echo "monitor = $c, disable" >>"$reglas"
            fi
        fi
    done
    modo="panel"
else
    # Sin panel no se apaga nada: si la tapa esta cerrada, el externo es la
    # unica pantalla que queda y un login en negro deja al usuario fuera.
    for c in $salidas; do
        if [ "$is_lua" -eq 1 ]; then
            echo "hl.monitor({ output = \"$c\", mode = \"preferred\", position = \"auto\", scale = \"1\" })" >>"$reglas"
        else
            echo "monitor = $c, preferred, auto, 1" >>"$reglas"
        fi
    done
    modo="sin-panel"
fi

if [ ! -r "$PLANTILLA" ]; then
    echo "sddm-greeter-monitor: no se encuentra la plantilla $PLANTILLA" >&2
    exit 1
fi

# Sustituye la marca por las reglas. Si no hay ninguna, la lista monitor se
# queda vacia y Hyprland aplica sus modos preferidos: peor que la regla
# correcta, pero el login arranca en vez de romperse.
awk -v fichero="$reglas" '
    /@@MONITOR@@/ {
        while ((getline linea < fichero) > 0) print linea
        close(fichero)
        next
    }
    { print }
' "$PLANTILLA" >"$GENERADO"
chmod 644 "$GENERADO"

registro="${RHYTHM_SDDM_LOG:-$WORK/sddm-greeter-monitor.log}"
{ echo "sddm-greeter-monitor: modo=$modo salidas=[${salidas# }] panel=${tarjeta_panel:-(ninguno)} reglas=$(wc -l <"$reglas") config=$GENERADO" >"$registro"; } 2>/dev/null || true

# Espera a que el Hyprland de la sesion anterior termine de desmontarse.
#
# Al salir de sesion, SDDM rearranca el greeter enseguida. Si el compositor del
# usuario aun no ha soltado DRM/KMS, el nuevo falla CBackend::create() igual que
# con el bug de AQ_DRM_DEVICES y SDDM reintenta contra una pantalla negra: el
# login "a veces no sale". En este punto ningun Hyprland deberia estar corriendo
# —el del greeter arranca abajo, con el exec— asi que cualquiera que haya es la
# sesion anterior apagandose. Con tope: si en 12 s sigue ahi, se arranca igual y
# queda escrito, que un arranque tardio vale mas que no arrancar.
espera=0
if command -v pgrep >/dev/null 2>&1; then
    while pgrep -x Hyprland >/dev/null 2>&1 && [ "$espera" -lt 12 ]; do
        sleep 1
        espera=$((espera + 1))
    done
fi

# Log persistente para los arranques que fallan al salir de sesion. El de $WORK
# se borra con la sesion y no sirve para diagnosticar despues; este sobrevive.
# Con tope de lineas para que un bucle de reintentos no llene el disco. Todo con
# red de seguridad: si no se puede escribir, se arranca igual.
LOG_FIJO="${RHYTHM_SDDM_LOG_FIJO:-/var/log/sddm-greeter-monitor.log}"
if touch "$LOG_FIJO" 2>/dev/null; then
    echo "$(date '+%F %T') modo=$modo espera=${espera}s salidas=[${salidas# }] config=$GENERADO" >>"$LOG_FIJO" 2>/dev/null || true
    tail -n 200 "$LOG_FIJO" >"$LOG_FIJO.tmp" 2>/dev/null && mv "$LOG_FIJO.tmp" "$LOG_FIJO" 2>/dev/null || true
fi

extra_flags=""
if [ "$(id -u)" -eq 0 ]; then
    extra_flags="--i-am-really-stupid"
fi

if [ -n "${HYPRLAND_CMD:-}" ] && [ -x "$HYPRLAND_CMD" ]; then
    _bin_dir=$(dirname "$HYPRLAND_CMD")
    if [ -x "$_bin_dir/start-hyprland" ]; then
        exec "$_bin_dir/start-hyprland" -- $extra_flags --config "$GENERADO"
    fi
    exec "$HYPRLAND_CMD" $extra_flags --config "$GENERADO"
elif command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland -- $extra_flags --config "$GENERADO"
elif command -v Hyprland >/dev/null 2>&1; then
    exec Hyprland $extra_flags --config "$GENERADO"
elif [ -x /usr/bin/start-hyprland ]; then
    exec /usr/bin/start-hyprland -- $extra_flags --config "$GENERADO"
elif [ -x /usr/bin/Hyprland ]; then
    exec /usr/bin/Hyprland $extra_flags --config "$GENERADO"
elif [ -x /usr/local/bin/Hyprland ]; then
    exec /usr/local/bin/Hyprland $extra_flags --config "$GENERADO"
else
    echo "sddm-greeter-monitor: no Hyprland executable found" >&2
    exit 1
fi

#!/bin/bash
# privacy-shield-daemon - Camera and mic background-activity watchdog.
#
# Polls every POLL_INTERVAL seconds:
#   Camera: any open file descriptor on /dev/video* (via fuser, lsof fallback)
#   Mic:    any PipeWire/Pulse source in RUNNING state (pactl; wpctl fallback)
#
# On idle -> active transitions it sends a critical notify-send in English
# and appends a timestamped line to /tmp/privacy-shield.log.
# Rising-edge only with a cooldown, so it never spams.
#
# Run persistently via the user service privacy-shield.service.
set -uo pipefail

LOG_FILE="/tmp/privacy-shield.log"
POLL_INTERVAL="${PRIVACY_SHIELD_INTERVAL:-4}"
COOLDOWN="${PRIVACY_SHIELD_COOLDOWN:-30}"
STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/privacy-status.json"

cam_active=false
mic_active=false
last_cam_notify=0
last_mic_notify=0
last_state_json=""

write_state() {
    local json="{\"mic\": ${mic_active}, \"cam\": ${cam_active}}"
    if [ "$json" != "$last_state_json" ] || [ ! -f "$STATE_FILE" ]; then
        printf '%s\n' "$json" > "${STATE_FILE}.tmp.$$" 2>/dev/null && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE" 2>/dev/null || true
        last_state_json="$json"
    fi
}

log() {
    printf '%(%F %T)T %s\n' -1 "$1" >> "$LOG_FILE" 2>/dev/null || true
}

camera_in_use() {
    local devs=(/dev/video*)
    [ -e "${devs[0]}" ] || return 1
    if command -v fuser >/dev/null 2>&1; then
        fuser -s "${devs[@]}" 2>/dev/null && return 0
    elif command -v lsof >/dev/null 2>&1; then
        lsof -t "${devs[@]}" >/dev/null 2>&1 && return 0
    fi
    return 1
}

mic_in_use() {
    # Fast single-line-per-source query via pactl list sources short
    if command -v pactl >/dev/null 2>&1; then
        local out line name state
        out=$(pactl list sources short 2>/dev/null || true)
        if [ -n "$out" ]; then
            while IFS=$'\t' read -r _ name _ _ state _; do
                if [ "$state" = "RUNNING" ] && [[ "$name" != *.monitor ]]; then
                    return 0
                fi
            done <<< "$out"
            return 1
        fi
    fi
    return 1
}

log "privacy-shield-daemon started (interval=${POLL_INTERVAL}s)"
write_state

while true; do
    printf -v t '%(%s)T' -1

    if camera_in_use; then
        if [ "$cam_active" = false ]; then
            cam_active=true
            log "CAMERA ACTIVE"
            if [ $((t - last_cam_notify)) -ge "$COOLDOWN" ]; then
                notify-send -a "Privacy Shield" -u critical -t 5000 \
                    "Camera active" "An application is using the camera." 2>/dev/null || true
                last_cam_notify=$t
            fi
        fi
    else
        if [ "$cam_active" = true ]; then
            log "CAMERA IDLE"
        fi
        cam_active=false
    fi

    if mic_in_use; then
        if [ "$mic_active" = false ]; then
            mic_active=true
            log "MIC ACTIVE"
            if [ $((t - last_mic_notify)) -ge "$COOLDOWN" ]; then
                notify-send -a "Privacy Shield" -u critical -t 5000 \
                    "Microphone active" "An application is capturing audio." 2>/dev/null || true
                last_mic_notify=$t
            fi
        fi
    else
        if [ "$mic_active" = true ]; then
            log "MIC IDLE"
        fi
        mic_active=false
    fi

    write_state
    sleep "$POLL_INTERVAL"
done

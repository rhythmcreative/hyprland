#!/usr/bin/env bash
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
# wallpaper-bars: hide or reveal the bars around a wallpaper change.
#
#   wallpaper-bars hide    before the wallpaper is swapped
#   wallpaper-bars show    once the new wallpaper and palette are in place
#
# Shared by every wallpaper entry point so all of them animate the same way:
# the island and the dock slide away, the wallpaper changes, they come back.

get_focused_monitor() {
    hyprctl monitors -j 2>/dev/null \
        | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null \
        | head -n1
}

monitor="${2:-}"
if [ -z "$monitor" ]; then
    if [ "${1:-}" = "show" ] && [ -s /tmp/wallpaper-bars-monitor ]; then
        monitor=$(cat /tmp/wallpaper-bars-monitor)
    elif [ "${1:-}" = "show" ]; then
        monitor="all"
    else
        monitor=$(get_focused_monitor)
    fi
fi
[ -n "$monitor" ] && [ "$monitor" != "null" ] || monitor="all"

waybar_pids_for_monitor() {
    local pid cmd
    while read -r pid; do
        [ -n "$pid" ] || continue
        cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
        case "$cmd" in
            *"config-$monitor "*|*"config-$monitor"|*"--config $HOME/.config/waybar/config-$monitor"*)
                echo "$pid"
                ;;
        esac
    done < <(pgrep -x waybar 2>/dev/null; pgrep -x .waybar-wrapped 2>/dev/null || true)
}

dock_pids_for_monitor() {
    local pid cmd
    while read -r pid; do
        [ -n "$pid" ] || continue
        cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
        case "$cmd" in
            *" -o $monitor"|*" -o $monitor "*) echo "$pid" ;;
        esac
    done < <(pgrep -x rust-dock 2>/dev/null; pgrep -x .rust-dock-wrap 2>/dev/null; pgrep -x .rust-dock-wrapped 2>/dev/null || true)
}

case "${1:-}" in
    hide)
        echo "$monitor" > /tmp/wallpaper-bars-monitor
        if [ -f /tmp/wallpaper-bars-hidden ]; then
            if [ "$monitor" = "all" ]; then
                quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" \
                    --any-display call island hide "all" >/dev/null 2>&1 &
            fi
            exit 0
        fi
        touch /tmp/wallpaper-bars-hidden
        # Lanzar ambos IPC en paralelo (antes corrian en serie con 1s de escaneo /proc)
        quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" \
            --any-display call island hide "$monitor" >/dev/null 2>&1 &
        quickshell ipc -p "$HOME/.config/quickshell/dock/shell.qml" \
            --any-display call dock hide "$monitor" >/dev/null 2>&1 &
        if pgrep -x 'waybar|\.waybar-wrapped' >/dev/null 2>&1; then
            if [ "$monitor" = "all" ]; then
                pkill -SIGUSR1 -x waybar >/dev/null 2>&1 || pkill -SIGUSR1 -x .waybar-wrapped >/dev/null 2>&1 || true
            else
                "$HOME/.local/bin/dock-procs" waybar signal "$monitor" USR1 >/dev/null 2>&1 &
            fi
        fi
        if pgrep -x 'rust-dock|\.rust-dock-wrap|\.rust-dock-wrapped' >/dev/null 2>&1; then
            if [ "$monitor" = "all" ]; then
                pkill -SIGUSR1 -x rust-dock >/dev/null 2>&1 || pkill -SIGUSR1 -x .rust-dock-wrap >/dev/null 2>&1 || pkill -SIGUSR1 -x .rust-dock-wrapped >/dev/null 2>&1 || true
            else
                "$HOME/.local/bin/dock-procs" rust-dock signal "$monitor" USR1 >/dev/null 2>&1 &
            fi
        fi
        ;;
    show)
        rm -f /tmp/wallpaper-bars-hidden
        quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" \
            --any-display call island reveal "$monitor" >/dev/null 2>&1 &
        quickshell ipc -p "$HOME/.config/quickshell/dock/shell.qml" \
            --any-display call dock reveal "$monitor" >/dev/null 2>&1 &
        if pgrep -x 'waybar|\.waybar-wrapped' >/dev/null 2>&1; then
            if [ "$monitor" = "all" ]; then
                pkill -SIGUSR2 -x waybar >/dev/null 2>&1 || pkill -SIGUSR2 -x .waybar-wrapped >/dev/null 2>&1 || true
            else
                "$HOME/.local/bin/dock-procs" waybar signal "$monitor" USR2 >/dev/null 2>&1 &
            fi
        fi
        if pgrep -x 'rust-dock|\.rust-dock-wrap|\.rust-dock-wrapped' >/dev/null 2>&1; then
            if [ "$monitor" = "all" ]; then
                pkill -SIGUSR2 -x rust-dock >/dev/null 2>&1 || pkill -SIGUSR2 -x .rust-dock-wrap >/dev/null 2>&1 || pkill -SIGUSR2 -x .rust-dock-wrapped >/dev/null 2>&1 || true
            else
                "$HOME/.local/bin/dock-procs" rust-dock signal "$monitor" USR2 >/dev/null 2>&1 &
            fi
        fi
        rm -f /tmp/wallpaper-bars-monitor
        ;;
    *)
        echo "Usage: wallpaper-bars hide|show" >&2
        exit 1
        ;;
esac

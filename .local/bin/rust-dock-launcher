#!/bin/bash
# Lanza una instancia de rust-dock por cada monitor conectado

RUST_DOCK="$HOME/.local/bin/rust-dock"
STATE_FILE="/tmp/rust-dock-visible"
DOCK_CONF="$HOME/.config/rhythm/dock.conf"

# Estado persistente: si el usuario apago el dock, aqui no se relanza nunca.
# 'on' cuando no hay fichero, para que una instalacion nueva muestre el dock.
if [ -f "$DOCK_CONF" ] && [ "$(awk -F= '$1 == "enabled" {print $2; exit}' "$DOCK_CONF")" = "off" ]; then
    pkill -x rust-dock >/dev/null 2>&1 || true
    echo "hidden" > "$STATE_FILE" 2>/dev/null || true
    exit 0
fi

if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Detectar monitores activos de forma segura con reintentos
monitors=""
for _ in {1..6}; do
    if command -v hyprctl >/dev/null 2>&1 && [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        mon_json=$(hyprctl monitors -j 2>/dev/null || true)
        if [ -n "$mon_json" ] && [ "$mon_json" != "[]" ]; then
            monitors=$(echo "$mon_json" | jq -r '.[].name' 2>/dev/null || true)
            [ -n "$monitors" ] && break
        fi
    fi
    sleep 0.3
done

if [ -z "$monitors" ] || [ "$monitors" = "null" ]; then
    if ! pgrep -x rust-dock >/dev/null 2>&1; then
        "$RUST_DOCK" >/dev/null 2>&1 &
    fi
    echo "visible" > "$STATE_FILE" 2>/dev/null || true
    exit 0
fi

# PIDs de las INSTANCIAS REALES de rust-dock, y nada mas.
#
# Antes se buscaban con `pgrep -f "rust-dock.*-o"`, que compara la LINEA DE
# COMANDOS completa: no distingue un dock de una terminal, un editor o un script
# que simplemente mencionen esas dos palabras. Y como despues se hacía `kill`
# sobre lo que salia, cualquier proceso asi se llevaba por delante. Se ha visto
# matar shells y scripts que solo tenían "rust-dock" y "-o" en un comando.
#
# Aquí se compara el EJECUTABLE, y el `-o` se lee de la linea de comandos de ese
# proceso concreto. Es el mismo criterio que el lanzador de Waybar, por el mismo
# motivo escrito allí.
dock_pids() {
    local entry pid exe
    for entry in /proc/[0-9]*; do
        pid="${entry#/proc/}"
        exe=$(readlink "$entry/exe" 2>/dev/null) || continue
        case "$exe" in
            */rust-dock) ;;
            *) continue ;;
        esac
        echo "$pid"
    done
}

# Monitor (-o) en el que está un dock concreto.
dock_output() {
    tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -oP -- '-o\s+\K\S+' || true
}

dock_on_monitor() {
    local pid
    for pid in $(dock_pids); do
        [ "$(dock_output "$pid")" = "$1" ] && return 0
    done
    return 1
}

# Si hay alguna instancia genérica sin -o, terminarla para usar instancias por monitor
# pgrep -x compara el NOMBRE del proceso, así que aquí no hay riesgo: solo docks.
if pgrep -x rust-dock >/dev/null 2>&1 && ! dock_pids | grep -q .; then
    pkill -x rust-dock 2>/dev/null
    sleep 0.2
fi

# Cerrar instancias asociadas a monitores desconectados
for pid in $(dock_pids); do
    out=$(dock_output "$pid")
    if [ -n "$out" ] && ! echo "$monitors" | grep -qw "$out"; then
        kill "$pid" 2>/dev/null
    fi
done

while IFS= read -r monitor; do
    [ -z "$monitor" ] && continue
    dock_on_monitor "$monitor" || "$RUST_DOCK" -o "$monitor" >/dev/null 2>&1 &
done <<< "$monitors"

echo "visible" > "$STATE_FILE" 2>/dev/null || true

#!/bin/bash
STATE_FILE="/tmp/caffeine-active"
ACTION="${1:-toggle}"

case "$ACTION" in
    status)
        if [ -f "$STATE_FILE" ]; then
            echo "on"
        else
            echo "off"
        fi
        ;;
    on)
        touch "$STATE_FILE"
        pkill -STOP hypridle 2>/dev/null || true
        echo "on"
        ;;
    off)
        rm -f "$STATE_FILE"
        pkill -CONT hypridle 2>/dev/null || true
        echo "off"
        ;;
    toggle|*)
        if [ -f "$STATE_FILE" ]; then
            rm -f "$STATE_FILE"
            pkill -CONT hypridle 2>/dev/null || true
            echo "off"
        else
            touch "$STATE_FILE"
            pkill -STOP hypridle 2>/dev/null || true
            echo "on"
        fi
        ;;
esac

#!/bin/bash
# Enciende y apaga el dock inferior de forma persistente.
#
# El estado se guarda en ~/.config/rhythm/dock.conf, no en /tmp, para que el dock
# siga apagado despues de reiniciar o de apagar la maquina. rust-dock-launcher y
# rust-dock-monitor-watcher consultan ese mismo fichero, de modo que ni un cambio
# de tema ni una pantalla nueva pueden volver a levantar un dock apagado.

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_FILE="$RUNTIME/rust-dock-visible"
CONFIG_DIR="$HOME/.config/rhythm"
CONFIG_FILE="$CONFIG_DIR/dock.conf"
LAUNCHER="$HOME/.local/bin/rust-dock-launcher"

# 'on' por defecto: sin fichero de estado el dock se comporta como siempre.
dock_state() {
    local stored="on"
    if [ -f "$CONFIG_FILE" ]; then
        stored=$(awk -F= '$1 == "enabled" {print $2; exit}' "$CONFIG_FILE")
    fi
    case "$stored" in
        on|off) printf '%s\n' "$stored" ;;
        *) printf 'on\n' ;;
    esac
}

save_dock_state() {
    mkdir -p "$CONFIG_DIR"
    printf 'enabled=%s\n' "$1" > "$CONFIG_FILE.tmp.$$"
    mv -f "$CONFIG_FILE.tmp.$$" "$CONFIG_FILE"
}

dock_pids() {
    local entry pid exe
    for entry in /proc/[0-9]*; do
        pid="${entry#/proc/}"
        exe=$(readlink "$entry/exe" 2>/dev/null) || continue
        case "$exe" in
            *rust-dock*) ;;
            *) continue ;;
        esac
        echo "$pid"
    done
}

QS_DOCK_QML="$HOME/.config/quickshell/dock/shell.qml"

qs_dock_running() {
    local entry comm cmd
    for entry in /proc/[0-9]*; do
        comm=$(cat "$entry/comm" 2>/dev/null) || continue
        case "$comm" in
            bash|sh|zsh|dash|fish|grep|rg|cat|head|tail|less|more|python*|sleep) continue ;;
        esac
        cmd=$(tr '\0' ' ' < "$entry/cmdline" 2>/dev/null) || continue
        case "$cmd" in
            *quickshell*quickshell/dock/shell.qml*|*quickshell/dock/shell.qml*) return 0 ;;
        esac
    done
    return 1
}

dock_on() {
    save_dock_state "on"
    printf 'visible\n' > "$STATE_FILE" 2>/dev/null || true
    printf 'visible\n' > "/tmp/rust-dock-visible" 2>/dev/null || true
    if command -v quickshell >/dev/null 2>&1 && [ -f "$QS_DOCK_QML" ] && qs_dock_running; then
        timeout 1 quickshell ipc -p "$QS_DOCK_QML" --any-display call dock setEnabled on >/dev/null 2>&1 || true
        timeout 1 quickshell ipc -p "$QS_DOCK_QML" --any-display call dock reveal all >/dev/null 2>&1 || true
    else
        "$LAUNCHER" >/dev/null 2>&1 &
    fi
}

dock_off() {
    save_dock_state "off"
    if command -v quickshell >/dev/null 2>&1 && [ -f "$QS_DOCK_QML" ] && qs_dock_running; then
        timeout 1 quickshell ipc -p "$QS_DOCK_QML" --any-display call dock setEnabled off >/dev/null 2>&1 || true
    fi
    # Matar instancias legadas de rust-dock si quedara alguna
    for pid in $(dock_pids); do
        kill "$pid" 2>/dev/null || true
    done
    pkill -x rust-dock >/dev/null 2>&1 || true
    pkill -x .rust-dock-wrap >/dev/null 2>&1 || true
    pkill -x .rust-dock-wrapped >/dev/null 2>&1 || true
    sleep 0.1
    for pid in $(dock_pids); do
        kill -9 "$pid" 2>/dev/null || true
    done
    printf 'hidden\n' > "$STATE_FILE" 2>/dev/null || true
    printf 'hidden\n' > "/tmp/rust-dock-visible" 2>/dev/null || true
}

set_dock() {
    local target="$1"
    if [ "$(dock_state)" = "$target" ]; then
        # Ya estaba en ese estado: no relanzar nada.
        :
    elif [ "$target" = "on" ]; then
        dock_on
    else
        dock_off
    fi
    dock_state
}

case "${1:-toggle}" in
    status)
        dock_state
        ;;
    on)
        set_dock on
        ;;
    off)
        set_dock off
        ;;
    toggle)
        if [ "$(dock_state)" = "on" ]; then
            set_dock off
        else
            set_dock on
        fi
        ;;
    *)
        echo "Usage: rust-dock-toggle-all [toggle|on|off|status]" >&2
        exit 1
        ;;
esac

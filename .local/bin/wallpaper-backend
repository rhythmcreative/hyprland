#!/usr/bin/env bash
# wallpaper-backend: unified wallpaper engine (static + animated).
# Static (jpg/png/bmp/static webp) -> awww (transitions + effects).
# Animated (gif / animated webp)   -> mpvpaper + mpv (loop, auto-pause).
# Usage: wallpaper-backend apply <file> [--no-transition]
# Prints nothing; writes pywal source to ~/.cache/wallpaper-pywal-src
# and backend name to ~/.cache/wallpaper-backend.
set -euo pipefail

LOG_FILE="$HOME/.cache/wallpaper-theme.log"
BACKEND_FILE="$HOME/.cache/wallpaper-backend"
PYWAL_SRC="$HOME/.cache/wallpaper-pywal-src"
FRAME_FILE="/tmp/wallpaper-frame.png"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [backend] $1" >> "$LOG_FILE"; }

# Por que se resuelve aqui el entorno del compositor y no se da por puesto:
#
# El cliente de awww saca la ruta de su socket de $WAYLAND_DISPLAY
# ($XDG_RUNTIME_DIR/$WAYLAND_DISPLAY-awww-daemon.sock). Si la variable no esta,
# awww CAE en wayland-0, y en este portatil el compositor toma wayland-1: todo
# `awww img` salia con "Socket file .../wayland-0-awww-daemon.sock not found" y
# no pintaba NINGUNA pantalla.
#
# No se notaba porque las llamadas van con `>/dev/null 2>&1 || true` y el log de
# "static applied via awww" se escribia igual, sin comprobar nada. De ahi que el
# fondo se quedase en la pantalla del login, las demas quedaran en negro, y el
# watcher de monitores repintase en bucle cada 10s durante minutos sin que
# jamais saliera nada.
#
# La isla y los dos watchers de monitor lanzan este script desde unidades de
# systemd de usuario, que no heredan nada del compositor.
# wallpaper-selector y wallpaper-random ya resuelven esto; el camino automatico,
# que es el que tiene que poner el fondo solo, no.
#
# Se descubren con `ls -t` y no con un nombre fijo: tanto la firma como el
# numero de socket cambian entre sesiones, y un "wayland-1" escrito a mano
# seria el mismo bug con otra forma. El `-t` importa porque en un equipo con
# varias instancias el mas reciente es el vivo.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    _wl=$(ls -t "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww-daemon' | head -n1)
    if [ -n "$_wl" ]; then export WAYLAND_DISPLAY="$(basename "$_wl")"; fi
    unset _wl
fi
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    _sig=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$_sig" ]; then export HYPRLAND_INSTANCE_SIGNATURE="$_sig"; fi
    unset _sig
fi
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    log "AVISO: no se encuentra el socket de Wayland; awww no va a pintar nada"
fi

is_animated() {
    local f="$1"
    local ext="${f##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        gif|mp4|webm|mkv|mov) return 0 ;;
    esac
    if [ "$ext" = "webp" ] && command -v identify >/dev/null 2>&1; then
        local n
        n=$(identify -format "%n\n" "$f" 2>/dev/null | head -n1 || echo 1)
        [ "${n:-1}" -gt 1 ] 2>/dev/null && return 0
    fi
    return 1
}

monitors() {
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null
    fi
}

ensure_daemon() {
    if command -v awww >/dev/null 2>&1; then
        if ! pgrep -x "awww-daemon" >/dev/null 2>&1; then
            setsid awww-daemon --format xrgb --no-cache >/dev/null 2>&1 &
            for _ in $(seq 1 50); do
                awww query >/dev/null 2>&1 && break
                sleep 0.1
            done
        fi
    elif command -v swww >/dev/null 2>&1; then
        if ! pgrep -x "swww-daemon" >/dev/null 2>&1; then
            setsid swww-daemon --format xrgb --no-cache >/dev/null 2>&1 &
            for _ in $(seq 1 50); do
                swww query >/dev/null 2>&1 && break
                sleep 0.1
            done
        fi
    elif command -v hyprpaper >/dev/null 2>&1; then
        if ! pgrep -x "hyprpaper" >/dev/null 2>&1; then
            if [ ! -s "$HOME/.config/hypr/hyprpaper.conf" ] || ! grep -q "wallpaper" "$HOME/.config/hypr/hyprpaper.conf" 2>/dev/null; then
                local cur_f=""
                [ -f "$HOME/.cache/current-wallpaper" ] && cur_f=$(cat "$HOME/.cache/current-wallpaper" 2>/dev/null || true)
                [ -z "$cur_f" ] && [ -f "$HOME/.config/hypr/wallpapers/default.jpg" ] && cur_f="$HOME/.config/hypr/wallpapers/default.jpg"
                if [ -n "$cur_f" ] && [ -f "$cur_f" ]; then
                    printf "splash = false\nipc = on\npreload = %s\nwallpaper = ,%s\n" "$cur_f" "$cur_f" > "$HOME/.config/hypr/hyprpaper.conf" 2>/dev/null || true
                else
                    printf "splash = false\nipc = on\n" > "$HOME/.config/hypr/hyprpaper.conf" 2>/dev/null || true
                fi
            fi
            setsid hyprpaper >/dev/null 2>&1 &
            sleep 0.1
        fi
    fi
}

stop_mpvpaper() {
    pkill -x "mpvpaper" 2>/dev/null || true
    pkill -f ".local/bin/wallpaper-mpvpaper" 2>/dev/null || true
}

apply_static() {
    local f="$1" trans="$2"
    stop_mpvpaper
    ensure_daemon
    local ok=1
    local engine="none"

    if command -v awww >/dev/null 2>&1; then
        engine="awww"
        if [ "$trans" = "login" ]; then
            awww img "$f" --transition-type wave --transition-angle 120 --transition-duration 2.2 --transition-fps 60 >/dev/null 2>&1 || \
            awww img "$f" >/dev/null 2>&1 || ok=0
        elif [ "$trans" = "yes" ]; then
            awww img "$f" --transition-type grow --transition-pos center --transition-duration 1.5 --transition-fps 60 >/dev/null 2>&1 || \
            awww img "$f" >/dev/null 2>&1 || ok=0
        else
            awww img "$f" >/dev/null 2>&1 || ok=0
        fi
    elif command -v swww >/dev/null 2>&1; then
        engine="swww"
        if [ "$trans" = "login" ]; then
            swww img "$f" --transition-type wave --transition-angle 120 --transition-duration 2.2 --transition-fps 60 >/dev/null 2>&1 || \
            swww img "$f" >/dev/null 2>&1 || ok=0
        elif [ "$trans" = "yes" ]; then
            swww img "$f" --transition-type grow --transition-pos center --transition-duration 1.5 --transition-fps 60 >/dev/null 2>&1 || \
            swww img "$f" >/dev/null 2>&1 || ok=0
        else
            swww img "$f" >/dev/null 2>&1 || ok=0
        fi
    elif command -v hyprpaper >/dev/null 2>&1; then
        engine="hyprpaper"
        printf "splash = false\nipc = on\npreload = %s\nwallpaper = ,%s\n" "$f" "$f" > "$HOME/.config/hypr/hyprpaper.conf" 2>/dev/null || true
        hyprctl hyprpaper preload "$f" >/dev/null 2>&1 || true
        if hyprctl hyprpaper wallpaper ",$f" >/dev/null 2>&1; then
            ok=1
        elif command -v swaybg >/dev/null 2>&1; then
            engine="swaybg"
            pkill -x "swaybg" 2>/dev/null || true
            setsid swaybg -i "$f" -m fill >/dev/null 2>&1 &
            ok=1
        else
            ok=0
        fi
    elif command -v swaybg >/dev/null 2>&1; then
        engine="swaybg"
        pkill -x "swaybg" 2>/dev/null || true
        setsid swaybg -i "$f" -m fill >/dev/null 2>&1 &
        ok=1
    else
        ok=0
        log "ERROR: No hay ningún motor de wallpaper instalado (awww, swww, hyprpaper, swaybg)"
    fi

    echo "$engine" > "$BACKEND_FILE"
    echo "$f" > "$PYWAL_SRC"
    if [ "$ok" = "1" ]; then
        log "static applied via $engine: $(basename "$f")"
    else
        log "ERROR: $engine no pinto $(basename "$f") (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<sin>}); el fondo sigue como estaba"
    fi
}

apply_animated() {
    local f="$1"
    # awww and mpvpaper fight over the background layer: stop awww first
    if pgrep -x "awww-daemon" >/dev/null 2>&1; then
        pkill -x "awww-daemon" 2>/dev/null || true
        sleep 0.3
    fi
    stop_mpvpaper
    local mons
    mons=$(monitors)
    # mpvpaper no admite "todas": hay que darle un nombre por monitor. Antes, si
    # la lista salia vacia, se inventaba un "eDP-1" y se pintaba solo ahi: en una
    # maquina sin panel interno ese nombre no existe y el fondo no se ponia en
    # ninguna pantalla, sin un solo error que lo dijera. Es el mismo fallo que ya
    # se quito de wallpaper-apply.sh. Ahora se dice en voz alta y se avisa.
    if [ -z "$mons" ]; then
        log "AVISO: no se han podido detectar los monitores; mpvpaper no se lanza"
    fi
    # shellcheck disable=SC2086
    while IFS= read -r mon; do
        [ -z "$mon" ] && continue
        setsid mpvpaper -f -p -o "no-audio loop-file=inf" "$mon" "$f" >/dev/null 2>&1 &
    done <<< "$mons"
    sleep 0.5
    echo "mpvpaper" > "$BACKEND_FILE"
    # first frame for pywal / SDDM / thumbnails
    if command -v convert >/dev/null 2>&1; then
        convert "$f[0]" "$FRAME_FILE" 2>/dev/null && echo "$FRAME_FILE" > "$PYWAL_SRC" || echo "$f" > "$PYWAL_SRC"
    else
        echo "$f" > "$PYWAL_SRC"
    fi
    log "animated applied via mpvpaper: $(basename "$f")"
}

case "${1:-}" in
    apply)
        FILE="${2:-}"
        [ -n "$FILE" ] && [ -f "$FILE" ] || { echo "Usage: wallpaper-backend apply <file>" >&2; exit 1; }
        TRANS="yes"
        [ "${3:-}" = "--no-transition" ] && TRANS="no"
        [ "${3:-}" = "--login" ] && TRANS="login"
        echo "$FILE" > "$HOME/.cache/current-wallpaper"
        if is_animated "$FILE" && command -v mpvpaper >/dev/null 2>&1; then
            apply_animated "$FILE"
        else
            apply_static "$FILE" "$TRANS"
        fi
        ;;
    backend)
        cat "$BACKEND_FILE" 2>/dev/null || echo "awww"
        ;;
    pywal-src)
        if [ -f "$PYWAL_SRC" ]; then cat "$PYWAL_SRC"; else cat "$HOME/.cache/current-wallpaper" 2>/dev/null || true; fi
        ;;
    stop-animated)
        stop_mpvpaper
        ;;
    *)
        echo "Usage: wallpaper-backend {apply <file> [--no-transition|--login]|backend|pywal-src|stop-animated}" >&2
        exit 1
        ;;
esac

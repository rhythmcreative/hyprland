#!/usr/bin/env python3
"""
pywal-tela-sync: Sincroniza dinámicamente el tema de iconos Tela Circle
según la paleta de colores y el tono dominante de Pywal / wallpaper.
"""

import os
import sys
import json
import re
import colorsys
import subprocess

HOME = os.path.expanduser("~")
WAL_JSON = os.path.join(HOME, ".cache/wal/colors.json")
WAL_COLORS = os.path.join(HOME, ".cache/wal/colors")

# Directorios de iconos del sistema y del usuario (Arch y NixOS)
ICON_DIRS = [
    "/usr/share/icons",
    "/run/current-system/sw/share/icons",
    os.path.join(HOME, ".nix-profile/share/icons"),
    os.path.join(HOME, ".local/share/icons"),
    os.path.join(HOME, ".icons")
]

def get_installed_tela_themes():
    installed = set()
    for d in ICON_DIRS:
        if os.path.isdir(d):
            try:
                for name in os.listdir(d):
                    if name.startswith("Tela-circle"):
                        installed.add(name)
            except Exception:
                pass
    return installed

def hex_to_hsv(hex_str):
    hex_str = hex_str.strip().lstrip('#')
    if len(hex_str) != 6:
        return 0.0, 0.0, 0.0
    r = int(hex_str[0:2], 16) / 255.0
    g = int(hex_str[2:4], 16) / 255.0
    b = int(hex_str[4:6], 16) / 255.0
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    return h * 360.0, s, v

def classify_theme(hex_str):
    h, s, v = hex_to_hsv(hex_str)

    # Monocromático / neutro
    if s < 0.12:
        return 'Tela-circle-black' if v < 0.35 else 'Tela-circle-grey'

    # Clasificación por rueda de color (Hue 0-360)
    if h >= 345.0 or h < 15.0:
        return 'Tela-circle-red'
    elif 15.0 <= h < 42.0:
        if s >= 0.60 and v >= 0.60:
            return 'Tela-circle-orange'
        else:
            return 'Tela-circle-brown'
    elif 42.0 <= h < 68.0:
        return 'Tela-circle-yellow'
    elif 68.0 <= h < 150.0:
        return 'Tela-circle-green'
    elif 150.0 <= h < 175.0:
        return 'Tela-circle-manjaro'
    elif 175.0 <= h < 205.0:
        return 'Tela-circle-nord'
    elif 205.0 <= h < 255.0:
        return 'Tela-circle-blue'
    elif 255.0 <= h < 285.0:
        return 'Tela-circle-purple'
    elif 285.0 <= h < 315.0:
        return 'Tela-circle-dracula'
    else:  # 315.0 <= h < 345.0
        return 'Tela-circle-pink'

def get_accent_color():
    if os.path.exists(WAL_JSON):
        try:
            with open(WAL_JSON, 'r', encoding='utf-8') as f:
                data = json.load(f)
            colors = data.get('colors', {})
            c1 = colors.get('color1')
            if c1:
                _, s1, _ = hex_to_hsv(c1)
                if s1 >= 0.20:
                    return c1

            best_col = c1 or '#5677fc'
            best_sat = hex_to_hsv(best_col)[1]
            for i in range(1, 7):
                c = colors.get(f'color{i}')
                if c:
                    _, s, v = hex_to_hsv(c)
                    if s > best_sat and v > 0.20:
                        best_col = c
                        best_sat = s
            return best_col
        except Exception:
            pass

    if os.path.exists(WAL_COLORS):
        try:
            with open(WAL_COLORS, 'r', encoding='utf-8') as f:
                lines = [line.strip() for line in f if line.strip().startswith('#')]
            if len(lines) > 1:
                return lines[1]
        except Exception:
            pass

    return '#5677fc'

def update_ini_file(filepath, key, value):
    os.makedirs(os.path.dirname(filepath), exist_ok=True)
    if not os.path.exists(filepath):
        content = f"[Settings]\n{key}={value}\ngtk-theme-name=PywalSync-Mono\ngtk-cursor-theme-name=Bibata-Modern-Ice\ngtk-cursor-theme-size=24\ngtk-font-name=JetBrainsMono Nerd Font 10\ngtk-application-prefer-dark-theme=1\n"
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                f.write(content)
        except Exception:
            pass
        return
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            content = f.read()

        if re.search(rf'^{key}=.*$', content, flags=re.MULTILINE):
            content = re.sub(rf'^{key}=.*$', f'{key}={value}', content, flags=re.MULTILINE)
        else:
            if '[Settings]' in content:
                content = content.replace('[Settings]', f'[Settings]\n{key}={value}')
            else:
                content += f'\n[Settings]\n{key}={value}\n'

        with open(filepath, 'w', encoding='utf-8') as f:
            f.write(content)
    except Exception:
        pass

def update_xsettingsd(theme):
    conf_path = os.path.join(HOME, ".config/xsettingsd/xsettingsd.conf")
    if os.path.exists(conf_path):
        try:
            with open(conf_path, 'r', encoding='utf-8') as f:
                content = f.read()

            if re.search(r'^Net/IconThemeName\s+.*$', content, flags=re.MULTILINE):
                content = re.sub(r'^Net/IconThemeName\s+.*$', f'Net/IconThemeName "{theme}"', content, flags=re.MULTILINE)
                with open(conf_path, 'w', encoding='utf-8') as f:
                    f.write(content)
        except Exception:
            pass

def update_nwg_look(theme):
    nwg_path = os.path.join(HOME, ".local/share/nwg-look/gsettings")
    if os.path.exists(nwg_path):
        try:
            with open(nwg_path, 'r', encoding='utf-8') as f:
                content = f.read()

            if re.search(r'^icon-theme=.*$', content, flags=re.MULTILINE):
                content = re.sub(r'^icon-theme=.*$', f'icon-theme={theme}', content, flags=re.MULTILINE)
                with open(nwg_path, 'w', encoding='utf-8') as f:
                    f.write(content)
        except Exception:
            pass

def update_kde(theme):
    kde_path = os.path.join(HOME, ".config/kdeglobals")
    if os.path.exists(kde_path):
        try:
            with open(kde_path, 'r', encoding='utf-8') as f:
                content = f.read()

            if '[Icons]' in content:
                if re.search(r'^Theme=.*$', content, flags=re.MULTILINE):
                    content = re.sub(r'^Theme=.*$', f'Theme={theme}', content, flags=re.MULTILINE)
                else:
                    content = content.replace('[Icons]', f'[Icons]\nTheme={theme}')
            else:
                content += f'\n[Icons]\nTheme={theme}\n'

            with open(kde_path, 'w', encoding='utf-8') as f:
                f.write(content)
        except Exception:
            pass

def apply_icon_theme(theme):
    # 1. gsettings
    env = os.environ.copy()
    if 'DBUS_SESSION_BUS_ADDRESS' not in env:
        uid = os.getuid()
        bus_path = f"/run/user/{uid}/bus"
        if os.path.exists(bus_path):
            env['DBUS_SESSION_BUS_ADDRESS'] = f"unix:path={bus_path}"

    try:
        subprocess.run(
            ['gsettings', 'set', 'org.gnome.desktop.interface', 'icon-theme', theme],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False
        )
    except Exception:
        pass

    # 2. GTK 3 & GTK 4
    update_ini_file(os.path.join(HOME, ".config/gtk-3.0/settings.ini"), "gtk-icon-theme-name", theme)
    update_ini_file(os.path.join(HOME, ".config/gtk-4.0/settings.ini"), "gtk-icon-theme-name", theme)

    # 3. xsettingsd
    update_xsettingsd(theme)

    # 4. nwg-look
    update_nwg_look(theme)

    # 5. KDE / Qt
    update_kde(theme)

def main():
    installed = get_installed_tela_themes()

    # Si se pasa un argumento para forzar o consultar
    if len(sys.argv) > 1:
        if sys.argv[1] == "--get":
            accent = get_accent_color()
            detected = classify_theme(accent)
            print(detected if detected in installed else "Tela-circle")
            return
        elif sys.argv[1] == "--theme" and len(sys.argv) > 2:
            target_theme = sys.argv[2]
            apply_icon_theme(target_theme)
            print(f"Tema de iconos fijado: {target_theme}")
            return

    accent = get_accent_color()
    detected_theme = classify_theme(accent)

    # Validar que exista en el sistema
    if detected_theme not in installed:
        if "Tela-circle" in installed:
            final_theme = "Tela-circle"
        else:
            final_theme = list(installed)[0] if installed else "Tela-circle"
    else:
        final_theme = detected_theme

    apply_icon_theme(final_theme)
    print(f"Iconos sincronizados con Pywal ({accent}): {final_theme}")

if __name__ == "__main__":
    main()

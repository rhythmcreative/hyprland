#!/usr/bin/env bash
# notch-monitor-helper: display management backend for the Dynamic Island.
# list                        -> JSON array of monitors with available modes
# set <mon> <WxH@Hz>          -> apply resolution/refresh, keep position+scale
# scale <mon> <scale>         -> apply scale, keep mode+position
# pos <mon> <left|right|above|below> [of] -> place relative to focused monitor
# toggle <mon>                -> disable monitor, or re-enable with preferred mode
set -uo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | grep -v '\.lock$' | head -n1 || true)
    [ -n "$SIG" ] && export HYPRLAND_INSTANCE_SIGNATURE="$SIG"
fi

notify() { notify-send -a "Displays" "$1" "${2:-}" 2>/dev/null || true; }

# hyprland 0.56 lua parser rejects `keyword`: apply via eval hl.monitor()
apply_mon() {
    local mon="$1" mode="$2" pos="$3" scale="$4" extra="${5:-}"
    local lua="hl.monitor({ output = \"$mon\", mode = \"$mode\", position = \"$pos\", scale = \"$scale\""
    [ -n "$extra" ] && lua="$lua, $extra"
    lua="$lua })"
    hyprctl eval "$lua" >/dev/null 2>&1
}

cmd_list() {
    hyprctl monitors all -j 2>/dev/null | jq '
        [.[] | {
            name: .name,
            desc: (.description // "" | split(" ") | .[0:3] | join(" ")),
            width: .width, height: .height,
            refresh: ((.refreshRate // 60) | round),
            x: .x, y: .y, scale: .scale,
            focused: (.focused // false),
            disabled: (.disabled // false),
            transform: (.transform // 0),
            vrr: (.vrr // false),
            dpms: (.dpmsStatus // true),
            mirrorOf: (.mirrorOf // ""),
            modes: ([.availableModes[]? | select(test("^[0-9]+x[0-9]+@[0-9.]+"))] | unique | .[0:12])
        }] | (map(.x) | min) as $minx | (map(.y) | min) as $miny
          | (map(.x + .width) | max - $minx) as $bw | (map(.y + .height) | max - $miny) as $bh
          | {minx: $minx, miny: $miny, bw: $bw, bh: $bh} as $b
          | map(. + {bounds: $b, map: {x: (if $bw == 0 then 0 else (.x - $minx) / $bw end),
                           y: (if $bh == 0 then 0 else (.y - $miny) / $bh end),
                           w: (if $bw == 0 then 1 else .width / $bw end),
                           h: (if $bh == 0 then 1 else .height / $bh end)}})'
}

current_geom() {
    hyprctl monitors -j 2>/dev/null | jq -r --arg m "$1" '.[] | select(.name == $m) | "\(.width)x\(.height)@\(.refreshRate) \(.x)x\(.y) \(.scale)"'
}

cmd_set() {
    local mon="$1" mode="$2" g res rate scale pos
    g=$(current_geom "$mon")
    [ -z "$g" ] && { echo "Monitor not found: $mon" >&2; return 1; }
    res=$(echo "$mode" | grep -oE '^[0-9]+x[0-9]+')
    rate=$(echo "$mode" | grep -oE '[0-9.]+$')
    pos=$(echo "$g" | awk '{print $2}')
    scale=$(echo "$g" | awk '{print $3}')
    apply_mon "$mon" "$res@$rate" "$pos" "$scale"
    notify "Display updated" "$mon set to $res@$rate"
}

cmd_scale() {
    local mon="$1" sc="$2" g res rate pos
    g=$(current_geom "$mon")
    [ -z "$g" ] && { echo "Monitor not found: $mon" >&2; return 1; }
    res=$(echo "$g" | awk '{print $1}' | grep -oE '^[0-9]+x[0-9]+')
    rate=$(echo "$g" | awk '{print $1}' | grep -oE '[0-9.]+$')
    pos=$(echo "$g" | awk '{print $2}')
    apply_mon "$mon" "$res@$rate" "$pos" "$sc"
    notify "Display updated" "$mon scale set to $sc"
}

cmd_pos() {
    local mon="$1" dir="$2" of="${3:-}" fw fh fx fy mw mh pos
    if [ -z "$of" ]; then
        of=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name')
    fi
    [ "$of" = "$mon" ] && of=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$mon" '.[] | select(.name != $m) | .name' | head -n1)
    [ -z "$of" ] && { echo "No reference monitor found" >&2; return 1; }
    read -r fw fh fx fy < <(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$of" '.[] | select(.name == $m) | "\(.width) \(.height) \(.x) \(.y)"')
    read -r mw mh < <(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$mon" '.[] | select(.name == $m) | "\(.width) \(.height)"')
    local sc
    sc=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$mon" '.[] | select(.name == $m) | .scale')
    local res
    res=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$mon" '.[] | select(.name == $m) | "\(.width)x\(.height)@\(.refreshRate)"')
    case "$dir" in
        left)  pos="$((fx - mw))x${fy}" ;;
        right) pos="$((fx + fw))x${fy}" ;;
        above) pos="${fx}x$((fy - mh))" ;;
        below) pos="${fx}x$((fy + fh))" ;;
        *) echo "Usage: pos <monitor> <left|right|above|below> [of]" >&2; return 1 ;;
    esac
    apply_mon "$mon" "$res" "$pos" "$sc"
    notify "Display updated" "$mon placed $dir of $of"
}

cmd_preset() {
    local mode="$1" mons focused internal ext
    mons=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name')
    focused=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name')
    internal=$(echo "$mons" | grep -iE '^(eDP|LVDS)' | head -n1 || true)
    ext=$(echo "$mons" | grep -viE '^(eDP|LVDS)' | head -n1 || true)
    case "$mode" in
        extend)
            local x=0 w
            for m in $mons; do
                w=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$m" '.[] | select(.name == $m) | .width')
                apply_mon "$m" "preferred" "${x}x0" "1"
                x=$((x + w))
            done
            notify "Display layout" "Extended desktop" ;;
        mirror)
            [ -z "$focused" ] && focused=$(echo "$mons" | head -n1)
            for m in $mons; do
                if [ "$m" = "$focused" ]; then
                    apply_mon "$m" "preferred" "auto" "1"
                else
                    hyprctl eval "hl.monitor({ output = \"$m\", mirror = \"$focused\" })" >/dev/null 2>&1
                fi
            done
            notify "Display layout" "Mirrored to $focused" ;;
        laptop)
            [ -z "$internal" ] && { echo "No internal display found" >&2; return 1; }
            for m in $mons; do
                if [ "$m" = "$internal" ]; then
                    apply_mon "$m" "preferred" "auto" "1"
                else
                    hyprctl eval "hl.monitor({ output = \"$m\", disabled = true })" >/dev/null 2>&1
                fi
            done
            notify "Display layout" "Laptop display only" ;;
        external)
            [ -z "$ext" ] && { echo "No external display found" >&2; return 1; }
            for m in $mons; do
                if [ "$m" = "$ext" ]; then
                    apply_mon "$m" "preferred" "auto" "1"
                else
                    hyprctl eval "hl.monitor({ output = \"$m\", disabled = true })" >/dev/null 2>&1
                fi
            done
            notify "Display layout" "External display only" ;;
        *) echo "Usage: preset <extend|mirror|laptop|external>" >&2; return 1 ;;
    esac
}

cmd_configure() {
    local mon="$1" mode="$2" pos="$3" scale="$4" transform="$5" mirror="${6:-none}"
    local lua="hl.monitor({ output = \"$mon\", mode = \"$mode\", position = \"$pos\", scale = \"$scale\", transform = $transform"
    if [ "$mirror" != "none" ] && [ -n "$mirror" ]; then
        lua="$lua, mirror = \"$mirror\""
    fi
    lua="$lua })"
    hyprctl eval "$lua" >/dev/null 2>&1
    notify "Display applied" "$mon $mode $pos scale $scale"
}

cmd_vrr() {
    local mon="$1" st="$2" v=0
    [ "$st" = "on" ] && v=1
    hyprctl eval "hl.monitor({ output = \"$mon\", vrr = $v })" >/dev/null 2>&1
    notify "Adaptive sync" "$mon ${st}"
}

cmd_dpms() {
    local mon="$1" st="$2"
    hyprctl eval "hl.dsp.dpms(\"$st\", \"$mon\")" >/dev/null 2>&1
    notify "Display power" "$mon ${st}"
}

cmd_toggle() {
    local mon="$1" disabled
    local enabled_count
    enabled_count=$(hyprctl monitors -j 2>/dev/null | jq '[.[] | select((.disabled // false) == false)] | length')
    disabled=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$mon" '.[] | select(.name == $m) | (.disabled // false)')
    if [ "$disabled" != "true" ] && [ "${enabled_count:-1}" -le 1 ]; then
        notify "Displays" "Cannot disable the last active display"
        echo "Refusing to disable the last active display" >&2
        return 1
    fi
    if [ "$disabled" = "true" ]; then
        apply_mon "$mon" "preferred" "auto" "1"
        notify "Display enabled" "$mon"
    else
        hyprctl eval "hl.monitor({ output = \"$mon\", disabled = true })" >/dev/null 2>&1
        notify "Display disabled" "$mon"
    fi
}

case "${1:-list}" in
    list) cmd_list ;;
    set) shift; cmd_set "$1" "$2" ;;
    scale) shift; cmd_scale "$1" "$2" ;;
    pos) shift; cmd_pos "$1" "$2" "${3:-}" ;;
    toggle) shift; cmd_toggle "$1" ;;
    preset) shift; cmd_preset "$1" ;;
    configure) shift; cmd_configure "$1" "$2" "$3" "$4" "$5" "${6:-none}" ;;
    vrr) shift; cmd_vrr "$1" "$2" ;;
    dpms) shift; cmd_dpms "$1" "$2" ;;
    *) echo "Usage: notch-monitor-helper {list|set|scale|pos|toggle|preset|configure|vrr|dpms}" >&2; exit 1 ;;
esac

#!/usr/bin/env python3
import sys
import subprocess
import json
import re

def get_bt_status():
    try:
        out = subprocess.check_output(['bluetoothctl', 'show'], text=True, stderr=subprocess.DEVNULL)
        powered = 'Powered: yes' in out
    except Exception:
        powered = False

    devices = []
    if powered:
        try:
            raw_devs = subprocess.check_output(['bluetoothctl', 'devices'], text=True, stderr=subprocess.DEVNULL)
            for line in raw_devs.strip().split('\n'):
                if not line:
                    continue
                parts = line.split(' ')
                if len(parts) < 3:
                    continue
                mac = parts[1].strip()
                name = ' '.join(parts[2:]).strip()
                if not mac:
                    continue
                
                info = subprocess.check_output(['bluetoothctl', 'info', mac], text=True, stderr=subprocess.DEVNULL)
                connected = 'Connected: yes' in info
                paired = 'Paired: yes' in info
                icon_type = 'other'
                for il in info.split('\n'):
                    if 'Icon:' in il:
                        icon_type = il.split(':')[1].strip()
                        break
                devices.append({
                    'mac': mac,
                    'name': name,
                    'connected': connected,
                    'paired': paired,
                    'icon': icon_type
                })
        except Exception:
            pass

    devices.sort(key=lambda d: (not d['connected'], not d['paired'], d['name']))
    return {'powered': powered, 'devices': devices}

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'status'

    if cmd == 'status':
        print(json.dumps(get_bt_status()))
    elif cmd == 'toggle':
        try:
            status = get_bt_status()
            if status['powered']:
                subprocess.run(['bluetoothctl', 'power', 'off'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(json.dumps({'status': 'ok', 'powered': False}))
            else:
                subprocess.run(['rfkill', 'unblock', 'bluetooth'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(['bluetoothctl', 'power', 'on'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(json.dumps({'status': 'ok', 'powered': True}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    elif cmd == 'connect':
        if len(sys.argv) < 3:
            print(json.dumps({'status': 'error', 'message': 'Missing MAC'}))
            sys.exit(1)
        mac = sys.argv[2]
        try:
            res = subprocess.run(['bluetoothctl', 'connect', mac], capture_output=True, text=True, timeout=10)
            print(json.dumps({'status': 'ok' if res.returncode == 0 else 'error', 'message': res.stdout.strip() or res.stderr.strip()}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    elif cmd == 'disconnect':
        if len(sys.argv) < 3:
            print(json.dumps({'status': 'error', 'message': 'Missing MAC'}))
            sys.exit(1)
        mac = sys.argv[2]
        try:
            res = subprocess.run(['bluetoothctl', 'disconnect', mac], capture_output=True, text=True, timeout=10)
            print(json.dumps({'status': 'ok' if res.returncode == 0 else 'error', 'message': res.stdout.strip() or res.stderr.strip()}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    elif cmd == 'scan':
        try:
            subprocess.Popen(['bluetoothctl', '--timeout', '5', 'scan', 'on'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(json.dumps({'status': 'ok', 'message': 'scanning'}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    elif cmd == 'remove':
        if len(sys.argv) < 3:
            print(json.dumps({'status': 'error', 'message': 'Missing MAC'}))
            sys.exit(1)
        mac = sys.argv[2]
        try:
            res = subprocess.run(['bluetoothctl', 'remove', mac], capture_output=True, text=True, timeout=10)
            print(json.dumps({'status': 'ok' if res.returncode == 0 else 'error', 'message': res.stdout.strip() or res.stderr.strip()}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    else:
        print(json.dumps({'status': 'unknown_command'}))

if __name__ == '__main__':
    main()

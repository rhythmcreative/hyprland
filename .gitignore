.config/hypr/monitors.conf
.local/bin/rust-dock
__pycache__/
*.pyc

# Credenciales: van en el disco de cada uno, nunca en el repo.
# .config/waybar/openweather_api_key estuvo rastreado con una clave real y ya
# está publicada en el historial; copiar la plantilla no la devuelve. Rotárala
# en openweathermap.org y deja la real solo aquí.
.config/waybar/openweather_api_key

# Copias de seguridad que dejan los scripts al reescribirse. Hay dos en disco
# (bluetooth-pair-agent.bak-20260929, notch-bt-helper.bak-20260929) y son
# ejecutables: si uno entra en un commit, el update los despliega en cada maquina
# como si fueran scripts de verdad.
*.bak-*
*.bak

# Overrides del usuario. No deben entrar en el repo nunca: si user.lua o
# user.conf estan versionados, el update los despliega y machaca lo que el
# usuario tenga ahi, que es justo lo que el overlay de user_edits evita.
# El .example si se versiona, para que se vea como se usa.
.config/hypr/user.lua
.config/kitty/user.conf

# Estado del overlay y del ledger de materialize. Es de la maquina, no del repo.
user_edits/

# Ficheros de color que genera pywal y los scripts sync-*.
#
# Estaban versionados con los colores del momento en que se escribieron, y el
# deploy los ponia encima de los que pywal acababa de generar: tras cualquier
# update los colores volvian a los viejos. Se generan en la maquina.
.config/gtk-3.0/gtk.css
.config/gtk-3.0/nm-applet-waybar.css
.config/gtk-3.0/settings.ini
.config/gtk-4.0/gtk.css
.config/gtk-4.0/nm-applet-waybar.css
.config/gtk-4.0/settings.ini
.config/rofi/colors-pywal.rasi
.config/rofi/style-3-pywal.rasi
.config/mako/config
.config/waybar/colors-pywal.css

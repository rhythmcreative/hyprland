#!/usr/bin/env bash
# auto-power-profile: Automatic power management daemon for Hyprland
# Engages Power Saver when battery <= 20%, disengages when AC is reconnected.
# Standard: Zero emojis, English notifications.

set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

POWERSAVE_HELPER="$HOME/.local/bin/notch-powersave-helper"
STATUS_LOCK="/tmp/powersave-active"
BAT_PATH="/sys/class/power_supply/BAT0"
AC_PATH="/sys/class/power_supply/ADP0"

send_notif() {
    local title="$1"
    local msg="$2"
    local icon="${3:-battery}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -a "Power Management" -i "$icon" "$title" "$msg" 2>/dev/null || true
    fi
}

# If no battery hardware exists on this system, exit cleanly
if [ ! -d "$BAT_PATH" ]; then
    echo "No battery found at $BAT_PATH. Exiting."
    exit 0
fi

while true; do
    cap=100
    if [ -f "$BAT_PATH/capacity" ]; then
        cap=$(cat "$BAT_PATH/capacity" 2>/dev/null || echo 100)
    fi

    status="Discharging"
    if [ -f "$BAT_PATH/status" ]; then
        status=$(cat "$BAT_PATH/status" 2>/dev/null || echo "Discharging")
    fi

    ac_online=0
    if [ -f "$AC_PATH/online" ]; then
        ac_online=$(cat "$AC_PATH/online" 2>/dev/null || echo 0)
    elif [ "$status" = "Charging" ] || [ "$status" = "Full" ]; then
        ac_online=1
    fi

    # Condition 1: Low battery on battery power -> Engage Power Saver
    if [ "$ac_online" -eq 0 ] && [ "$status" != "Charging" ] && [ "$cap" -le 20 ]; then
        if [ ! -f "$STATUS_LOCK" ] && [ -x "$POWERSAVE_HELPER" ]; then
            "$POWERSAVE_HELPER" toggle >/dev/null 2>&1 || true
            send_notif "Power Saver Activated" "Battery is at ${cap}%. Power saver mode engaged automatically." "battery-low"
        fi
    fi

    # Condition 2: AC plugged back in -> Disengage Power Saver
    if [ "$ac_online" -eq 1 ] || [ "$status" = "Charging" ] || [ "$cap" -gt 35 ]; then
        if [ -f "$STATUS_LOCK" ] && [ "$ac_online" -eq 1 ] && [ -x "$POWERSAVE_HELPER" ]; then
            "$POWERSAVE_HELPER" toggle >/dev/null 2>&1 || true
            send_notif "Normal Mode Restored" "AC power connected. Power saver mode disengaged." "battery-charging"
        fi
    fi

    sleep 15
done

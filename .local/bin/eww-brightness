#!/bin/bash

# Get current brightness safely
dev_arg=""
dev=$(ls -1 /sys/class/backlight 2>/dev/null | head -n 1)
[ -n "$dev" ] && dev_arg="-d $dev"

BRIGHTNESS=$(brightnessctl $dev_arg g 2>/dev/null || brightnessctl g 2>/dev/null || true)
MAX=$(brightnessctl $dev_arg m 2>/dev/null || brightnessctl m 2>/dev/null || true)

if [ -n "$BRIGHTNESS" ] && [ -n "$MAX" ] && [ "$MAX" -gt 0 ] 2>/dev/null; then
    PERCENT=$((BRIGHTNESS * 100 / MAX))
else
    exit 0
fi

# Update EWW if installed
if command -v eww >/dev/null 2>&1; then
    eww update brightness-percent=$PERCENT 2>/dev/null || true
    eww update island-mode="brightness" 2>/dev/null || true
    (sleep 2 && eww update island-mode="idle" 2>/dev/null) &
fi

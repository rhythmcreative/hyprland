#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"
# Dice si la isla (waybar-island) esta corriendo. Uso:  island-running && ...
#
# Existe por el mismo motivo que se reescribio dock-procs: `pgrep -f` compara la
# LINEA DE COMANDOS entera, no el nombre del proceso. Con
# `pgrep -f "quickshell -p .*waybar-island"` cualquier cosa que mencionara esa
# ruta —una terminal, un script, el propio agente— contaba como isla corriendo.
# Eso hacia que modern-pywal-sync creyera que podia mandar un IPC, que
# settings-menu no la arrancara, y que show-hotkeys la ocultara sin existir.
#
# Y con `pkill -f` el fallo era peor: quickshell-island llego a matar el shell
# que lo invocaba por ese mismo motivo.
#
# pgrep -x compara solo el nombre del ejecutable, asi que ningun bash puede
# coincidir. Luego se filtra por linea de comandos para no contar otros
# quickshell que no sean la isla.

# El nombre del ejecutable no es "quickshell" en NixOS: nixpkgs envuelve el
# binario con makeWrapper y el proceso se llama .quickshell-wrapped, asi que
# `pgrep -x quickshell` no matchea nunca. Medido: la isla corriendo (pid 843080)
# con comm=.quickshell-wrapped, y el script contestando "no". Por eso
# hide_active_bars del launcher se saltaba el bloque del island y la barra no
# se ocultaba al abrir un menu.
#
# Y no se puede con `pgrep -x '.quickshell-wrapped'`: el kernel trunca comm a
# 15 caracteres (comm=.quickshell-wra) y pgrep -x rechaza en vez de truncar los
# patterns largos, asi que devuelve cero siempre.
#
# La solucion es el patron truncado de 15, que es lo que comm really tiene, y
# seguir filtrando por linea de comandos como hacia el resto: ningun bash
# coincide porque su comm no es este, y el filtro deja fuera otros quickshell
# que no sean la isla.
for _pid in $(pgrep -x quickshell 2>/dev/null; pgrep -x '.quickshell-wra' 2>/dev/null); do
    if tr '\0' ' ' < "/proc/$_pid/cmdline" 2>/dev/null | grep -q "waybar-island"; then
        echo yes
        exit 0
    fi
done

echo no
exit 1

#!/usr/bin/env bash
# Script para alternar la Dynamic Island de forma rapida y segura

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

export QT_QPA_PLATFORM="wayland"

if ! pgrep -f "quickshell -p .*waybar-island" >/dev/null; then
    quickshell -p "$HOME/.config/quickshell/waybar-island/shell.qml" >/dev/null 2>&1 &
    sleep 0.5
fi

ACTIVE_MON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
[ -n "$ACTIVE_MON" ] || ACTIVE_MON="eDP-1"
quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island toggle "$ACTIVE_MON" >/dev/null 2>&1

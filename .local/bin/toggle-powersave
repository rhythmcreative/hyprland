#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"
# toggle-powersave - Power saving manager for Dynamic Island and Hyprland
# Optimizes CPU frequency/EPP, display brightness, GPU effects and window/rofi opacity.
# Maintains full animations and leaves Waybar battery in its original configuration.

STATE_FILE="/tmp/powersave-active"
BRIGHTNESS_BACKUP="/tmp/powersave_brightness_backup"
ACTION="${1:-toggle}"

is_active() {
    [ -f "$STATE_FILE" ]
}

enable_powersave() {
    touch "$STATE_FILE"
    rm -f /tmp/hypr_performance_mode 2>/dev/null || true

    # 1. CPU Energy Performance Preference (EPP) to power-saving via powerprofilesctl
    if command -v powerprofilesctl >/dev/null 2>&1; then
        powerprofilesctl set power-saver >/dev/null 2>&1 || true
    elif [ "$EUID" -eq 0 ] && [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
        tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference <<< "power" >/dev/null 2>&1 || true
        tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor <<< "powersave" >/dev/null 2>&1 || true
    fi

    # 2. Dim brightness gently to eco level (35%) if currently higher
    if command -v brightnessctl >/dev/null 2>&1; then
        current_b=$(brightnessctl get 2>/dev/null)
        max_b=$(brightnessctl max 2>/dev/null)
        if [ -n "$current_b" ] && [ -n "$max_b" ] && [ "$max_b" -gt 0 ]; then
            pct=$(( current_b * 100 / max_b ))
            if [ "$pct" -gt 40 ]; then
                echo "$current_b" > "$BRIGHTNESS_BACKUP"
                brightnessctl set 35% >/dev/null 2>&1 || true
            fi
        fi
    fi

    # 3. Disable heavy Hyprland blur/shadows but PRESERVE animations (animations = true)
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl eval 'hl.config({ decoration = { active_opacity = 1.0, inactive_opacity = 0.98, blur = { enabled = false }, shadow = { enabled = false } }, animations = { enabled = true } })' >/dev/null 2>&1 || true
        hyprctl --batch "keyword decoration:active_opacity 1.0; keyword decoration:inactive_opacity 0.98; keyword decoration:blur:enabled 0; keyword decoration:shadow:enabled 0; keyword decoration:drop_shadow 0; keyword animations:enabled 1" >/dev/null 2>&1 || true
        hyprctl eval 'hl.window_rule({ name = "powersave-opaque", match = { class = ".*" }, opaque = true })' >/dev/null 2>&1 || \
            hyprctl keyword windowrulev2 "opaque,class:.*" >/dev/null 2>&1 || true
    fi

    # 4. Set kitty background opacity to 1.0 for solid dark terminal (no background bleed)
    for kconf in "$HOME/.config/kitty/kitty.conf"; do
        if [ -f "$kconf" ]; then
            sed -i 's/background_opacity [0-9.]*/background_opacity 1.0/' "$kconf" 2>/dev/null || true
        fi
    done
    pkill -SIGUSR1 kitty 2>/dev/null || true

    # 5. Los menus de rofi se vuelven macizos.
    "$HOME/.local/bin/rofi-colors" 2>/dev/null || true

    # 6. Desktop Notification
    notify-send -a "Battery Saver" -i battery-caution "Battery Saver Turned On" "Performance optimized and solid window surfaces" 2>/dev/null || true
    echo "on"
}

disable_powersave() {
    rm -f "$STATE_FILE"

    # 1. Restore CPU to balanced via powerprofilesctl or sysfs
    if command -v powerprofilesctl >/dev/null 2>&1; then
        powerprofilesctl set balanced >/dev/null 2>&1 || true
    elif [ "$EUID" -eq 0 ] && [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
        tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference <<< "performance" >/dev/null 2>&1 || true
    fi

    # 2. Restore previous brightness if saved
    if [ -f "$BRIGHTNESS_BACKUP" ] && command -v brightnessctl >/dev/null 2>&1; then
        saved_b=$(cat "$BRIGHTNESS_BACKUP")
        if [ -n "$saved_b" ]; then
            brightnessctl set "$saved_b" >/dev/null 2>&1 || true
        fi
        rm -f "$BRIGHTNESS_BACKUP"
    fi

    # 3. Reload Hyprland config to restore animations, blur, shadows, and default window transparency
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    fi

    # 4. Restore kitty background opacity to 0.85
    for kconf in "$HOME/.config/kitty/kitty.conf"; do
        if [ -f "$kconf" ]; then
            sed -i 's/background_opacity [0-9.]*/background_opacity 0.85/' "$kconf" 2>/dev/null || true
        fi
    done
    pkill -SIGUSR1 kitty 2>/dev/null || true

    # 5. De los fondos de rofi no hay que hacer nada aqui.
    #
    # rofi-colors mantiene los dos ficheros al dia con el color de pywal siempre,
    # asi que no hay nada que regenerar ni que borrar. Lo unico que decide si el
    # menu sale macizo o translucido es que /tmp/powersave-active exista, y eso
    # lo comprueba rofi-themed al arrancar. Antes este bloque truncaba el
    # fichero a vacio, que no era lo mismo que no existir.

    # 6. Desktop Notification
    notify-send -a "Battery Saver" -i battery-good "Battery Saver Turned Off" "Normal performance and visual effects restored" 2>/dev/null || true
    echo "off"
}

case "$ACTION" in
    status)
        if is_active; then
            echo "on"
        else
            echo "off"
        fi
        ;;
    on)
        enable_powersave
        ;;
    off)
        disable_powersave
        ;;
    toggle|*)
        if is_active; then
            disable_powersave
        else
            enable_powersave
        fi
        ;;
esac

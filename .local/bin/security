#!/usr/bin/env python3
"""Estado de seguridad de la maquina, en JSON para la isla.

    security scan
    security do <accion> [argumentos]

Todo lo de la seccion Security sale de aqui, para que la isla solo tenga que
leer un unico JSON en vez de lanzar un proceso por tarjeta.

Las piezas y de donde sale cada una:

  hardening   seis sysctl de mitigacion de exploits. Cinco ya estan bien en
              esta maquina; kernel.kptr_restrict estaba en 0, que deja que
              cualquier proceso del usuario lea los punteros del kernel.
  firewall    nftables. Sin esto la maquina no tiene ningun filtro: cualquier
              cosa en la red local la puede alcanzar.
  sensors     estado de micro y camara, y si el interruptor de cierre esta
              puesto. Los iconos de la isla son avisos pasivos; esto los
              apaga de verdad, para todos a la vez.
  clipboard   cuantas entradas guarda y si tienen caducidad.
  flatpak     apps flatpak con los permisos que tienen concedidos.
  isolation   apps nativas metidas en bubblewrap (lo escribe isolated-app).
"""

import glob
import json
import os
import re
import shutil
import subprocess
import sys

# (sysctl, valor recomendado, por que importa)
HARDENING = [
    ("kernel.kptr_restrict", "2",
     "Hide kernel pointers from unprivileged processes"),
    ("kernel.dmesg_restrict", "1",
     "Only root can read the kernel log"),
    ("kernel.perf_event_paranoid", "2",
     "No performance counters for normal users"),
    ("kernel.unprivileged_bpf_disabled", "2",
     "No unprivileged BPF"),
    ("kernel.yama.ptrace_scope", "1",
     "A process can only ptrace its own children"),
    ("vm.unprivileged_userfaultfd", "0",
     "No unprivileged userfaultfd"),
]

CLIP_CONF = os.path.expanduser("~/.config/rhythm/clipboard-expiry.conf")
KILL_FILE = os.path.expanduser("~/.config/rhythm/sensors-killed")


def leer_sysctl(key):
    try:
        with open("/proc/sys/" + key.replace(".", "/")) as f:
            return f.read().strip()
    except OSError:
        return None


def sysctl_num(key):
    v = leer_sysctl(key)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def esc(*argv):
    """Ejecuta y devuelve (rc, stdout, stderr) sinNunca romper el script."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=8)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except Exception as exc:                      # noqa: BLE001
        return 1, "", str(exc)


def root(*argv):
    return esc("sudo", "-n", *argv)


def nft_list(*args):
    rc, out, err = root("nft", *args)
    return out if rc == 0 else ""


# ── hardening ───────────────────────────────────────────────────────────────
def hardening():
    filas = []
    sueltos = 0
    for key, want, why in HARDENING:
        have = sysctl_num(key)
        ok = have is not None and have == int(want)
        if not ok:
            sueltos += 1
        filas.append({
            "key": key,
            "value": have,
            "want": int(want),
            "ok": ok,
            "why": why,
        })
    return {
        "items": filas,
        "total": len(filas),
        "loose": sueltos,
        "tight": len(filas) - sueltos,
    }


# ── firewall ────────────────────────────────────────────────────────────────
def firewall():
    # La tabla se llama inet rhythm. Se mira si existe y se cuentan los paquetes
    # que han caido en la regla final, que es un drop con contador.
    tablas = nft_list("list", "tables")
    activo = "table inet rhythm" in tablas
    bloqueados = 0
    reglas = 0
    if activo:
        rc, out, _ = root("nft", "list", "chain", "inet", "rhythm", "input")
        if rc == 0:
            # nft imprime cada regla como "counter packets N bytes M <veredicto>",
            # asi que el numero va en la posicion 1 despues de "counter", no en la 0.
            for linea in out.splitlines():
                t = linea.strip()
                if "counter packets" not in t:
                    continue
                partes = t.split("counter")[1].split()
                if len(partes) < 2 or not partes[1].isdigit():
                    continue
                if t.endswith("accept"):
                    reglas += 1
                elif t.endswith("drop"):
                    # el drop con contador es la ultima regla: cuenta lo bloqueado
                    bloqueados = int(partes[1])
    return {
        "active": activo,
        "blocked": bloqueados,
        "rules": reglas,
        "default": "deny" if activo else "allow (no filter)",
    }


# ── sensores ────────────────────────────────────────────────────────────────
def nodos_audio():
    """Sinks y sources de wpctl, con su id, su nombre y si estan muteados.

    El formato de "wpctl status" es de columnas con dibujitos:
        |  *   87. HUAWEI FreeBuds 7i       [vol: 0.53]
        |      57. Ryzen HD Audio ...       [MUTED]
    El asterisco marca el que esta por defecto, y el mute sale como [MUTED]
    en vez de [vol: x]. Conviene fiarse del dibujo, no de la posicion: cuenta.
    """
    rc, out, _ = esc("wpctl", "status")
    nodos = {"sink": [], "source": []}
    if rc != 0:
        return nodos
    seccion = None
    for linea in out.splitlines():
        t = linea.strip()
        for etiqueta, clave in (("Sinks:", "sink"), ("Sources:", "source")):
            if t.endswith(etiqueta):
                seccion = clave
                break
        if seccion is None:
            continue
        if t.startswith("Streams:") or t.startswith("Filters:") or t.startswith("Devices:"):
            seccion = None
            continue
        # "87. Nombre [vol: 0.53]" o "100. bluez_input... [Audio/Source]"
        if ". " not in t or "[" not in t:
            continue
        cab, cola = t.split(". ", 1)
        num = "".join(c for c in cab if c.isdigit())
        if not num:
            continue
        nombre = cola[:cola.rindex("[")].strip()
        nodos[seccion].append({
            "id": num,
            "name": nombre,
            "muted": "MUTED" in cola,
        })
    return nodos


def sensores():
    # El estado pasivo de los indicadores sale de privacy-status, que ya existia.
    rc2, out2, _ = esc(os.path.expanduser("~/.local/bin/privacy-status"))
    estado = {}
    if rc2 == 0:
        try:
            estado = json.loads(out2.strip() or "{}")
        except ValueError:
            estado = {}
    nodos = nodos_audio()
    return {
        "mic": bool(estado.get("mic")),
        "cam": bool(estado.get("cam")),
        # El interruptor esta puesto si queda el fichero con los nodos muteados.
        "killed": os.path.exists(KILL_FILE),
        "muted_sinks": sum(1 for n in nodos["sink"] if n["muted"]),
        "muted_sources": sum(1 for n in nodos["source"] if n["muted"]),
        "total_sinks": len(nodos["sink"]),
        "total_sources": len(nodos["source"]),
    }


# ── portapapeles ────────────────────────────────────────────────────────────
def clipboard():
    try:
        with open(os.path.expanduser("~/.config/rhythm/clipboard-expiry.conf")) as f:
            mins = int(f.read().strip() or "0")
    except (OSError, ValueError):
        mins = 0
    rc, out, _ = esc(os.path.expanduser("~/.local/bin/clipboard-list"))
    entradas = 0
    if rc == 0:
        try:
            datos = json.loads(out.strip() or "[]")
            # clipboard-list devuelve una lista pelada, pero si algum dia devuelve
            # un objeto con la lista dentro, se lee igual.
            if isinstance(datos, list):
                entradas = len(datos)
            elif isinstance(datos, dict):
                for clave in ("items", "entries", "clips"):
                    if isinstance(datos.get(clave), list):
                        entradas = len(datos[clave])
                        break
                else:
                    entradas = int(datos.get("count", 0))
        except (ValueError, TypeError):
            entradas = 0
    return {
        "entries": entradas,
        "expiry_minutes": mins,
        "expiring": mins > 0,
    }


# ── flatpak ─────────────────────────────────────────────────────────────────
def flatpak():
    """Apps flatpak con los permisos que tienen concedidos.

    "flatpak info --show-permissions" no lista un permiso por linea, sino una
    seccion [Context] con linea tipo "shared=ipc;network;", y dentro de cada
    una van varios valores separados por punto y coma. Hay que partirlos todos.
    """
    rc, out, _ = esc("flatpak", "list", "--app", "--columns=application")
    if rc != 0:
        return {"apps": [], "count": 0, "available": False}
    apps = []
    for linea in out.splitlines():
        app = linea.strip()
        if not app:
            continue
        permisos = []
        rc2, out2, _ = esc("flatpak", "info", "--show-permissions", app)
        if rc2 == 0:
            en_context = False
            for l in out2.splitlines():
                t = l.strip()
                if t.startswith("["):
                    en_context = (t == "[Context]")
                    continue
                if not en_context or "=" not in t:
                    continue
                clave, _, valores = t.partition("=")
                clave = clave.strip()
                if clave in ("unset-environment", "env", "build", "runtime"):
                    # no son permisos, son variables de entorno
                    continue
                for v in valores.split(";"):
                    v = v.strip()
                    if v and v not in ("none",):
                        revocable = clave in ("shared", "filesystems", "files",
                                              "features")
                        permisos.append({"kind": clave, "value": v,
                                         "revocable": revocable})
        apps.append({"id": app, "permissions": permisos, "count": len(permisos)})
    return {"apps": apps, "count": len(apps), "available": True}


# ── aislamiento ─────────────────────────────────────────────────────────────
def isolation():
    rc, out, _ = esc(os.path.expanduser("~/.local/bin/isolated-app"), "list")
    if rc != 0:
        return {"apps": [], "count": 0, "with_network": 0, "without_network": 0}
    try:
        return json.loads(out.strip() or "{}")
    except ValueError:
        return {"apps": [], "count": 0, "with_network": 0, "without_network": 0}


# Donde suele guardar cada app sus datos. Se usa para proposing las carpetas al
# aislarla, en vez de obligar a escribirlas a mano. Solo se montan las que
# existen de verdad, y ademas las de solo lectura.
CARPETAS_TIPICAS = [
    "~/.config/{app}",
    "~/.config/{app}/*",
    "~/.cache/{app}",
    "~/.local/share/{app}",
    "~/.local/state/{app}",
    "~/{app}",
    "~/.mozilla/firefox",
    "~/.mozilla/firefox/*",
    "~/.config/BraveSoftware",
    "~/.config/BraveSoftware/*",
    "~/.config/chromium",
    "~/.cache/BraveSoftware",
    "~/.cache/chromium",
    "~/.config/TelegramDesktop",
    "~/.local/share/TelegramDesktop",
    "~/.var/app/*",
]

# Apps que necesitan cosas que el aislamiento no da. No se ofrecen para aislar
# porque se romparian, y es mejor decirlo que dejar un boton que falla.
NO_AISLAR = {
    "virtualbox": "needs /dev/kvm and kernel modules",
    "steam": "manages its own sandbox and its own runtime",
    "virt-manager": "needs /dev/kvm",
    "wofi": "is the launcher itself",
    "rofi": "is the launcher itself",
    "anyrun": "is the launcher itself",
    "waybar": "is the bar itself",
    "quickshell": "is the island itself",
    "nwg-bar": "is the bar itself",
    "nwg-panel": "is the bar itself",
    "xfce4-appfinder": "is the launcher itself",
    "catfish": "",
}

# Apps que de verdad conviene aislar: las que tocan la red y datos personales.
# Las de configuracion del sistema no aportan nada y solo se rompen, asi que no
# salen en la lista de la isla (pero siguen contando en el total).
PRIORIDAD = (
    "brave", "brave-browser", "brave-origin-nightly", "chromium", "chromium-browser",
    "firefox", "epiphany", "vivaldi", "opera",
    "telegram-desktop", "vesktop", "discord", "slack", "signal-desktop", "hexchat",
    "thunderbird", "zapzap", "evolution", "kmail",
    "kitty", "alacritty", "foot", "ghostty", "wezterm",
    "syncthing", "nextcloud", "dropbox",
    "keepassxc", "bitwarden", "org.vaultwarden.desktop",
)


def lanzadores():
    """Todos los lanzadores graficos de la sesion, con su binario y su origen."""
    salida = []
    dirs = ["/usr/share/applications",
            os.path.expanduser("~/.local/share/applications"),
            "/var/lib/flatpak/exports/share/applications",
            os.path.expanduser("~/.local/share/flatpak/exports/share/applications")]
    vistos = set()
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for nombre in sorted(os.listdir(d)):
            if not nombre.endswith(".desktop") or nombre in vistos:
                continue
            ruta = os.path.join(d, nombre)
            try:
                txt = open(ruta, errors="replace").read()
            except OSError:
                continue
            if re.search(r"^NoDisplay=true", txt, re.M):
                continue
            if not re.search(r"^Type=Application", txt, re.M):
                continue
            if re.search(r"^Terminal=true", txt, re.M):
                continue
            m = re.search(r"^Name=(.+)$", txt, re.M)
            e = re.search(r"^Exec=(.+)$", txt, re.M)
            if not e:
                continue
            visto = vistos.add(nombre)
            execs = e.group(1).strip()
            # el ejecutable es el primer token; si es env, el segundo
            partes = execs.split()
            binario = partes[0] if partes else ""
            if binario == "env" and len(partes) > 1:
                binario = partes[1]
            elif binario in ("/usr/bin/env",):
                binario = partes[1] if len(partes) > 1 else binario
            salida.append({
                "desktop": nombre[:-len(".desktop")],
                "name": m.group(1).strip() if m else nombre,
                "bin": os.path.basename(binario),
                "path": binario if binario.startswith("/") else "",
                "dir": d,
                "flatpak": "flatpak" in d,
                "user": d.startswith(os.path.expanduser("~")),
            })
    return salida


def registro_aislamiento():
    conf = os.path.expanduser("~/.config/rhythm/isolated-apps.conf")
    datos = {}
    if os.path.exists(conf):
        for linea in open(conf):
            p = linea.strip().split("|")
            if len(p) >= 4:
                datos[os.path.basename(p[0])] = {
                    "profile": p[1], "data": p[2], "command": p[3]}
    return datos


def propone_carpetas(app):
    """Carpetas de datos que existen de verdad para esa app."""
    encontradas = []
    for patron in CARPETAS_TIPICAS:
        ruta = os.path.expanduser(patron.format(app=app))
        if "*" in patron:
            import glob as _glob
            for coincidencia in sorted(_glob.glob(ruta)):
                encontrada = coincidencia
                if not any(encontrada.startswith(x) for x in encontradas):
                    encontradas.append(encontrada)
        elif os.path.isdir(ruta):
            encontradas.append(ruta)
    return encontradas


def verificadas():
    """Apps que se han comprobado de verdad con isolated-app test."""
    marca = os.path.expanduser("~/.config/rhythm/isolated-verified.conf")
    datos = {}
    try:
        for l in open(marca):
            if "=" in l:
                k, _, v = l.strip().partition("=")
                datos[k] = v
    except OSError:
        pass
    return datos


def app_audit():
    registro = registro_aislamiento()
    apps = []
    for l in lanzadores():
        app = l["bin"]
        if not app or app.startswith("-"):
            continue
        entry = registro.get(app)
        bloqueado = NO_AISLAR.get(app)
        existe = bool(shutil.which(app)) or os.path.exists(l["path"])
        verificado = ""
        if entry:
            verificado = verificadas().get(app, "")
        apps.append({
            "desktop": l["desktop"],
            "name": l["name"],
            "bin": app,
            "flatpak": l["flatpak"],
            "isolated": entry is not None,
            "profile": entry["profile"] if entry else "",
            "no_isolar": bloqueado if bloqueado is not None else "",
            "exists": existe,
            "launcher": os.path.exists(os.path.expanduser(
                "~/.local/share/applications/aislada-%s.desktop" % app)),
            "verified": verificado,
        })
    # sin duplicar por binario
    unicos = {}
    for a in apps:
        unicos.setdefault(a["bin"], a)
    lista = list(unicos.values())
    aisladas = sum(1 for a in lista if a["isolated"])
    prioridad = [a for a in lista
                 if not a["isolated"] and not a["flatpak"] and not a["no_isolar"]
                 and any(a["bin"].startswith(p) or a["bin"] == p
                         for p in PRIORIDAD)]
    return {
        "priority": prioridad,
        "priority_count": len(prioridad),
        "apps": lista,
        "total": len(lista),
        "isolated": aisladas,
        "not_isolated": len(lista) - aisladas,
        "flatpak_already": sum(1 for a in lista if a["flatpak"]),
    }


def scan():
    return {
        "hardening": hardening(),
        "firewall": firewall(),
        "sensors": sensores(),
        "clipboard": clipboard(),
        "flatpak": flatpak(),
        "isolation": isolation(),
        "audit": app_audit(),
    }


# ── acciones ────────────────────────────────────────────────────────────────
def escribir_clipboard(mins):
    os.makedirs(os.path.dirname(CLIP_CONF), exist_ok=True)
    with open(CLIP_CONF, "w") as f:
        f.write("%d\n" % int(mins))


def do(accion, *args):
    if accion == "tighten":
        cambios = []
        for key, want, _ in HARDENING:
            if sysctl_num(key) != int(want):
                rc, _, err = root("sysctl", "-q", "-w", "%s=%s" % (key, want))
                if rc == 0 and sysctl_num(key) == int(want):
                    cambios.append(key)
                else:
                    print("no se pudo poner %s=%s%s" % (key, want, (": " + err) if err else ""))
        print("endurecidos: %d" % len(cambios))
        return 0

    if accion == "firewall-on":
        # La ultima regla de la cadena es el drop con contador: es la que cuenta
        # lo bloqueado. Sin "comment", que junto a "counter" no se deja escribir.
        reglas = """
table inet rhythm {
  chain input {
    type filter hook input priority filter; policy drop;
    iif lo counter accept
    ct state established,related counter accept
    ip protocol icmp counter accept
    ip6 nexthdr icmpv6 counter accept
    # DHCP, o al caducar la lease la maquina se queda sin red
    udp sport 68 udp dport 67 counter accept
    # descubrimiento local, para no perder Avahi
    udp sport 5353 udp dport 5353 counter accept
    udp sport 1900 udp dport 1900 counter accept
    counter drop
  }
  chain forward { type filter hook forward priority filter; policy drop; }
  chain output { type filter hook output priority filter; policy accept; }
}
"""
        # Se pasa primero por nft -c, que solo valida. Si la sintaxis esta mal no
        # se toca la maquina.
        p = subprocess.run(["sudo", "-n", "nft", "-c", "-f", "-"], input=reglas,
                           capture_output=True, text=True, timeout=8)
        if p.returncode != 0:
            print("regla invalida: " + (p.stderr.strip() or "sin detalle"))
            return 1
        p = subprocess.run(["sudo", "-n", "nft", "-f", "-"], input=reglas,
                           capture_output=True, text=True, timeout=8)
        if p.returncode != 0:
            print("nft: " + (p.stderr.strip() or "fallo desconocido"))
            return 1
        # que sobreviva a un reinicio
        # El fichero persistente se escribe con sudo: el script corre como usuario.
        root("mkdir", "-p", "/etc/nftables.d")
        p2 = subprocess.run(["sudo", "-n", "tee", "/etc/nftables.d/rhythm.conf"],
                            input=reglas, capture_output=True, text=True, timeout=8)
        root("systemctl", "enable", "--now", "nftables.service")
        print("cortafuegos activo, deny por defecto")
        return 0

    if accion == "firewall-off":
        root("nft", "delete", "table", "inet", "rhythm")
        # El fichero persistente es de root: sin sudo, PermissionError.
        if os.path.exists("/etc/nftables.d/rhythm.conf"):
            root("rm", "-f", "/etc/nftables.d/rhythm.conf")
        print("cortafuegos quitado: la red vuelve a estar abierta")
        return 0

    if accion in ("sensors-kill", "sensors-restore"):
        nodos = nodos_audio()
        if accion == "sensors-kill":
            muteados = []
            for clave in ("sink", "source"):
                for n in nodos[clave]:
                    esc("wpctl", "set-mute", n["id"], "1")
                    if n["id"] not in muteados:
                        muteados.append(n["id"])
            os.makedirs(os.path.dirname(KILL_FILE), exist_ok=True)
            with open(KILL_FILE, "w") as f:
                f.write("\n".join(muteados))
            print("silenciados %d nodos de audio" % len(muteados))
        else:
            try:
                with open(KILL_FILE) as f:
                    muteados = [x for x in f.read().splitlines() if x]
            except OSError:
                print("no habia ningun interruptor puesto")
                return 0
            for nid in muteados:
                esc("wpctl", "set-mute", nid, "0")
            os.remove(KILL_FILE)
            print("restaurados %d nodos de audio" % len(muteados))
        return 0

    if accion == "clipboard-clear":
        # El historico vive en cliphist, no en ficheros JSON sueltos: por eso
        # wipe y no un rm.
        esc("cliphist", "wipe")
        print("portapapeles vaciado")
        return 0

    if accion == "clipboard-expiry":
        if not args:
            print("0 = sin caducidad")
            return 1
        escribir_clipboard(args[0])
        print("caducidad: %s minutos" % args[0])
        return 0

    if accion == "flatpak-revoke":
        # "flatpak override" REEMPLAZA la lista entera de cada categoria, no
        # añade ni quita un elemento. Asi que para quitar un permiso hay que
        # reescribir la lista sin el, no poner un "no": con --socket=none se
        # quedaria sin Wayland y la app no abriria ventana.
        if len(args) < 3:
            print("uso: flatpak-revoke <app> <clave> <valor>")
            return 1
        app, clave, valor = args[0], args[1], args[2]
        rc, info, _ = esc("flatpak", "info", "--show-permissions", app)
        if rc != 0:
            print("no se pudo leer los permisos de " + app)
            return 1
        actuales = {}
        en_context = False
        for l in info.splitlines():
            t = l.strip()
            if t.startswith("["):
                en_context = (t == "[Context]")
                continue
            if en_context and "=" in t:
                k, _, v = t.partition("=")
                actuales[k.strip()] = [x.strip() for x in v.split(";") if x.strip()]

        if clave not in actuales or valor not in actuales[clave]:
            print("%s no tiene %s=%s" % (app, clave, valor))
            return 1

        # Comprobado en esta maquina con flatpak 1.x: hay tres categorias que se
        # pueden quitar y dos que NO.
        #
        #   shared      --unshare=      funciona
        #   filesystems --nofilesystem= funciona
        #   features    --disallow=     funciona
        #   sockets     NO hay forma negativa: --socket solo anade, y --socket=none
        #               no existe en esta version
        #   devices     igual que sockets
        #
        # Poner un boton que revoque un socket y se quede sin hacer nada es peor
        # que no ponerlo, asi que esas dos categorias lo dicen claramente.
        if clave in ("sockets", "devices"):
            print("%s: flatpak no deja quitar %s=%s uno a uno" % (app, clave, valor))
            print("solo se puede resetear la app con: flatpak override --user --reset " + app)
            return 1

        if clave == "shared":
            rc, _, err = esc("flatpak", "override", "--user", app,
                             "--unshare=" + valor)
        elif clave in ("filesystems", "files"):
            rc, _, err = esc("flatpak", "override", "--user", app,
                             "--nofilesystem=" + valor)
        elif clave == "features":
            rc, _, err = esc("flatpak", "override", "--user", app,
                             "--disallow=" + valor)
        else:
            print("esa categoria no se sabe revocar: " + clave)
            return 1

        if rc != 0:
            print("flatpak: " + (err or "fallo"))
            return 1
        print("%s: %s=%s revocado" % (app, clave, valor))
        return 0

    if accion == "isolate":
        # isolate <app> [perfil] : deduce las carpetas de datos, la registra y
        # escribe el lanzador del menu para que se lance ya aislada.
        if not args:
            print("uso: isolate <app> [strict|nonet|off]")
            return 1
        app = args[0]
        perfil = args[1] if len(args) > 1 else "nonet"
        if perfil not in ("strict", "nonet", "off"):
            print("perfil no valido: " + perfil)
            return 1
        if app in NO_AISLAR:
            print("%s no se aísla: %s" % (app, NO_AISLAR[app]))
            return 1
        if not (shutil.which(app) or any(a["bin"] == app for a in lanzadores())):
            print("no encuentro el binario " + app)
            return 1
        carpetas = propone_carpetas(app)
        orden = app
        # Los navegadores abren directorios que estan en la home, asi que sin
        # darlos la app arranca pero no puede leer ni escribir nada.
        for extra in ("~/Downloads", "~/Documents", "~/Pictures", "~/Videos",
                      "~/Music", "~/Desktop"):
            ruta = os.path.expanduser(extra)
            if os.path.isdir(ruta) and not any(ruta in c for c in carpetas):
                carpetas.append(ruta)
        rc, _, err = esc(os.path.expanduser("~/.local/bin/isolated-app"), "add",
                         app, perfil, ";".join(carpetas), orden)
        if rc != 0:
            print("isolated-app: " + (err or "fallo"))
            return 1
        rc2, _, _ = esc(os.path.expanduser("~/.local/bin/isolated-app"), "desktop", app)
        print("%s aislada (%s), %d carpetas" % (app, perfil, len(carpetas)))
        if rc2 != 0:
            print("ojo: no hay .desktop para %s, aislado solo desde la terminal" % app)
        return 0

    if accion == "unisolate":
        if not args:
            print("uso: unisolate <app>")
            return 1
        app = args[0]
        esc(os.path.expanduser("~/.local/bin/isolated-app"), "remove", app)
        lanz = os.path.expanduser("~/.local/share/applications/aislada-%s.desktop" % app)
        if os.path.exists(lanz):
            os.remove(lanz)
        print("%s ya no está aislada" % app)
        return 0

    if accion == "verify":
        # verify <app> : lanza el chequeo de isolated-app test dentro de la
        # sandbox y guarda si aguanta, para que la isla no diga "funciona" a
        # algo que en realidad no se ha podido abrir nunca.
        if not args:
            print("uso: verify <app>")
            return 1
        app = args[0]
        marca = os.path.expanduser("~/.config/rhythm/isolated-verified.conf")
        os.makedirs(os.path.dirname(marca), exist_ok=True)
        rc, out, _ = esc(os.path.expanduser("~/.local/bin/isolated-app"), "test", app)
        lineas = {}
        try:
            for l in open(marca):
                if "=" in l:
                    k, _, v = l.strip().partition("=")
                    lineas[k] = v
        except OSError:
            pass
        if rc == 0 and out.strip():
            lineas[app] = "ok"
            print("%s: aguanta la sandbox" % app)
            for l in out.splitlines():
                print("  " + l.strip())
        else:
            lineas[app] = "fallo"
            print("%s: NO aguanta la sandbox" % app)
        with open(marca, "w") as f:
            for k, v in lineas.items():
                f.write("%s=%s\n" % (k, v))
        return 0

    print("accion desconocida: " + accion)
    return 1


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    if sys.argv[1] == "scan":
        json.dump(scan(), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if sys.argv[1] == "do":
        return do(*sys.argv[2:])
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())

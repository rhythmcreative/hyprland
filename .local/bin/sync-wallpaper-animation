#!/usr/bin/env bash
# Sincronizador de transicion de wallpaper con Waybar, Quickshell y Rust-Dock

export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

WALLPAPER_PATH="$1"
if [ -z "$WALLPAPER_PATH" ] || [ ! -f "$WALLPAPER_PATH" ]; then
    echo "Usage: sync-wallpaper-animation <wallpaper_file>"
    exit 1
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    [ -n "$WL_DISP" ] && export WAYLAND_DISPLAY=$(basename "$WL_DISP") || export WAYLAND_DISPLAY="wayland-1"
fi
buscar_hypr_firma() {
    local d s dir
    for dir in "$XDG_RUNTIME_DIR/hypr" "/tmp/hypr"; do
        [ -d "$dir" ] || continue
        for d in $(ls -t "$dir" 2>/dev/null); do
            [ -d "$dir/$d" ] || continue
            s="$d"
            [ -n "$s" ] || continue
            if [ -S "$dir/$d/.socket2.sock" ] ||
               [ -S "$dir/$d.socket2.sock" ] ||
               [ -S "$dir/$d/.socket.sock" ]; then
                printf '%s\n' "$s"
                return 0
            fi
        done
    done
    return 1
}

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    if HYPR_SIG="$(buscar_hypr_firma)"; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    elif [ -d "$XDG_RUNTIME_DIR/hypr" ]; then
        HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | grep -v '\.lock$' | head -n1)
        [ -n "$HYPR_SIG" ] && export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

echo "$WALLPAPER_PATH" > "$HOME/.cache/current-wallpaper"

# Cuantas capas de cada barra hay ahora, para saber cuantas tienen que volver.
#
# Se cuentan ANTES de esconder nada porque la paleta (paso 3) mata y relanza
# waybar y rust-dock, asi que a mitad del cambio sus capas desaparecen aunque este
# script no las haya tocado. Sin este dato no hay forma de distinguir "todavia no
# ha vuelto" de "no estaba".
contar_capas() {
    local n
    n=$(hyprctl layers 2>/dev/null | grep -c "namespace: $1")
    [ -n "$n" ] || n=0
    printf '%s\n' "$n"
}

BARRAS_ANTES_WAYBAR=$(contar_capas waybar)
BARRAS_ANTES_DOCK=$(contar_capas rust-dock)

# 1. ANIMACION DE SALIDA: Ocultar barras suavemente
"$HOME/.local/bin/wallpaper-bars" hide

# 2. APLICAR WALLPAPER (awww para estaticos, mpvpaper para gif/webp animados)
if [ -x "$HOME/.local/bin/wallpaper-backend" ]; then
    "$HOME/.local/bin/wallpaper-backend" apply "$WALLPAPER_PATH" &
elif command -v awww &>/dev/null; then
    awww img "$WALLPAPER_PATH" --transition-type grow --transition-pos center --transition-duration 1.5 --transition-fps 60 &
fi

# 3. GENERAR PALETA DE COLORES Y ACTUALIZAR COMPONENTES (en segundo plano durante la transicion)
(
    # Generar colores con Pywal (usa primer frame en animados)
    if command -v wal &>/dev/null; then
        PYWAL_SRC="$WALLPAPER_PATH"
        case "${WALLPAPER_PATH##*.}" in
            gif|mp4|webm|mkv|mov)
                if command -v magick >/dev/null 2>&1; then
                    magick "${WALLPAPER_PATH}[0]" "/tmp/wallpaper-frame.png" 2>/dev/null && PYWAL_SRC="/tmp/wallpaper-frame.png"
                elif command -v convert >/dev/null 2>&1; then
                    convert "${WALLPAPER_PATH}[0]" "/tmp/wallpaper-frame.png" 2>/dev/null && PYWAL_SRC="/tmp/wallpaper-frame.png"
                elif command -v ffmpeg >/dev/null 2>&1; then
                    ffmpeg -y -i "$WALLPAPER_PATH" -vframes 1 "/tmp/wallpaper-frame.png" >/dev/null 2>&1 && PYWAL_SRC="/tmp/wallpaper-frame.png"
                fi
                ;;
            *)
                # Muestreo optimizado de 512px para extraer la paleta en < 0.1s sin procesar gigabytes en RAM
                SAMPLE_SRC="/tmp/wallpaper-pywal-sample.jpg"
                if command -v ffmpegthumbnailer >/dev/null 2>&1; then
                    ffmpegthumbnailer -i "$WALLPAPER_PATH" -o "$SAMPLE_SRC" -s 512 -q 8 2>/dev/null && PYWAL_SRC="$SAMPLE_SRC"
                elif command -v magick >/dev/null 2>&1; then
                    magick "$WALLPAPER_PATH" -resize 512x512^ "$SAMPLE_SRC" 2>/dev/null && PYWAL_SRC="$SAMPLE_SRC"
                elif command -v convert >/dev/null 2>&1; then
                    convert "$WALLPAPER_PATH" -resize 512x512^ "$SAMPLE_SRC" 2>/dev/null && PYWAL_SRC="$SAMPLE_SRC"
                fi
                ;;
        esac
        echo "$WALLPAPER_PATH" > "$HOME/.cache/wallpaper-pywal-src"
        wal -i "$PYWAL_SRC" -n -q
    fi

    # Actualizar GTK, Qt, Rofi, Mako y preparar Waybar/Rust-dock
    if [ -x "$HOME/.local/bin/modern-pywal-sync" ]; then
        "$HOME/.local/bin/modern-pywal-sync" >/dev/null 2>&1
    fi
) &
PYWAL_PID=$!

# 4. TRANSICION DEL WALLPAPER + PALETA: margen breve para transicion visual
sleep 0.35
# Margen breve para que pywal y sincronizaciones ligeras concluyan sin congelar la UI
for ((i = 0; i < 6; i++)); do
    kill -0 "$PYWAL_PID" 2>/dev/null || break
    sleep 0.1
done

# 5. ANIMACION DE ENTRADA SINCRONIZADA: Revelar Waybar, Dynamic Island y Rust-Dock
"$HOME/.local/bin/wallpaper-bars" show


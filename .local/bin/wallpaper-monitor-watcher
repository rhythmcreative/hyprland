#!/bin/bash
# Wallpaper monitor watcher: deja el fondo pintado en todos los monitores.
#
# Hay dos formas de que un monitor se quede sin fondo, y ninguna lanza un evento
# utilizable:
#
#   - Se desconecta y vuelve. El compositor pone la superficie de awww en alfa 0
#     y la deja ahi. awww sigue creyendo que la imagen esta puesta ("awww query"
#     la lista bien), asi que ni awww ni este script se enteran por ahi.
#   - Se apaga y se enciende. En el socket2 no existe evento dpms, solo
#     monitoradded, monitorremoved, focusedmon, openwindow, closewindow,
#     configreloaded y screencast.
#
# Por eso hay dos vias: los eventos del socket para lo que llega de golpe, y una
# revision periodica que compara el alfa de cada superficie con la posicion y el
# tamano de cada monitor (background-health).
#
# La revision periodica va en un subshell aparte a proposito. Antes estaba en el
# bucle principal, debajo del `socat ... | while read`, y eso no llegaba a
# ejecutarse nunca: socat se queda bloqueado leyendo el socket mientras el
# compositor viva, asi que el bucle exterior no volvia a girar. El script llevaba
# meses sin revisar nada.

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOG_FILE="$HOME/.cache/wallpaper-monitor-watcher.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG_FILE"
}

detect_socket() {
    # Se descubre de nuevo en cada vuelta y no se usa la variable exportada:
    # si Hyprland se reinicia cambia la firma, y leer la de siempre dejaria el
    # watcher conectado a un socket que ya no existe.
    local sig
    sig=$(ls -t "$RUNTIME/hypr/" 2>/dev/null | head -n1)
    [ -z "$sig" ] && sig="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    echo "$RUNTIME/hypr/$sig/.socket2.sock"
}

# POR QUE ESTO VA AQUI Y NO EN LA UNIDAD DE SYSTEMD
# ------------------------------------------------
# Este watcher lo arranca systemd --user, y systemd no hereda el entorno del
# compositor: el servicio se lanzaba con CERO variables HYPRLAND_*. Sin
# HYPRLAND_INSTANCE_SIGNATURE, hyprctl contesta "HYPRLAND_INSTANCE_SIGNATURE
# not set!" y background-health, que hace `hyprctl monitors -j ... || exit 0`,
# sale con la salida VACIA. El watcher lee vacio como "no hay nada roto", asi
# que la revision periodica no detectaba nunca un fondo sin pintar.
#
# O sea: el script llevaba meses announcing que se vigilaba el fondo y no
# hacia nada. El unico camino que funcionaba era el de los eventos del socket.
#
# No se arregla declarando la variable en la unidad porque la firma cambia en
# cada sesion de Hyprland y la unidad no se entera: habria que reescribirla en
# cada arranque. Resolverla aqui y exportarla vale para las dos vias.
# El entorno del compositor se resuelve DENTRO de cada vuelta, no una vez al
# arrancar. Esto es lo que hacia que la revision periodica estuviera muerta:
#
# La unidad es WantedBy=default.target, asi que systemd --user arranca este script
# al abrirse la sesion del usuario, y en ese momento Hyprland todavia no ha
# arrancado: $RUNTIME/hypr/ esta vacio. El script lo resolvia una unica vez aqui
# arriba, no encontraba firma, avisaba, y se quedaba sin
# HYPRLAND_INSTANCE_SIGNATURE PARA SIEMPRE. Con la variable sin puesto,
# background-health hace `hyprctl ... || exit 0`, sale con la lista vacia, y el
# watcher lee vacio como "no hay nada roto": la revision periodica no detectaba
# nunca un fondo sin pintar. El log lo delata:
#
#   17:13:24 AVISO: no se encuentra la firma de Hyprland; la revision periodica
#          no podra usar hyprctl
#
# y despues de esa linea no hay ni una sola revision mas en todo el arranque.
#
# Resolverlo en cada vuelta lo deja indiferente a cuando arranco systemd, que es
# lo unico que importa: el descubrimiento ya se hacia para el socket
# (detect_socket) y lo unico que faltaba era hacerlo tambien para hyprctl.
#
# WAYLAND_DISPLAY va aqui por el mismo motivo y por el mismo bug: lo necesita
# el cliente de awww, que sin la variable cae en wayland-0 y no encuentra su
# socket si el compositor esta en wayland-1.
resolver_entorno() {
    local sig wl
    sig=$(ls -t "$RUNTIME/hypr/" 2>/dev/null | head -n1)
    [ -n "$sig" ] && export HYPRLAND_INSTANCE_SIGNATURE="$sig"
    wl=$(ls -t "$RUNTIME"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww-daemon' | head -n1)
    [ -n "$wl" ] && export WAYLAND_DISPLAY="$(basename "$wl")"
    return 0
}

repintar() {
    [ -x "$HOME/.local/bin/load-last-wallpaper-fast" ] || return 0
    if [ -x "$HOME/.local/bin/background-health" ]; then
        local roto
        roto=$("$HOME/.local/bin/background-health" 2>/dev/null || true)
        if [ -z "$roto" ]; then
            return 0
        fi
    fi
    "$HOME/.local/bin/load-last-wallpaper-fast" >/dev/null 2>&1 &
}

# Revision periodica, en su propio hilo. Se queda en segundo plano y mira si
# algun monitor se ha quedado sin fondo; si lo hay, lo repinta.
revision_periodica() {
    local seguidas=0
    local avisado=0
    # Periodo de gracia inicial para permitir que el escritorio cargue limpiamente
    sleep 15
    while true; do
        sleep 10
        resolver_entorno
        if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
            if [ "$avisado" -eq 0 ]; then
                log "AVISO: todavia no hay compositor; la revision periodica espera"
                avisado=1
            fi
            continue
        fi
        avisado=0
        [ -x "$HOME/.local/bin/background-health" ] || continue
        roto=$("$HOME/.local/bin/background-health" 2>/dev/null)
        if [ -z "$roto" ]; then seguidas=0; continue; fi
        log "fondo sin pintar en: $(echo "$roto" | tr '\n' ' ')  (repintando)"
        repintar
        seguidas=$((seguidas + 1))
        if [ "$seguidas" -ge 3 ] && [ "$("$HOME/.local/bin/wallpaper-backend" backend 2>/dev/null)" = "awww" ]; then
            log "tres repintados sin efecto en: $(echo "$roto" | tr '\n' ' ') (reiniciando awww-daemon)"
            pkill -x awww-daemon 2>/dev/null || true
            sleep 1
            repintar
            seguidas=0
        fi
    done
}

revision_periodica &

while true; do
    resolver_entorno
    SOCKET=$(detect_socket)
    if [ -S "$SOCKET" ]; then
        socat -u "UNIX-CONNECT:$SOCKET" - 2>/dev/null | while read -r event; do
            case "$event" in
                monitoradded*)
                    sleep 1.0
                    repintar
                    # Verificar que ha vuelto. Si a los pocos segundos sigue sin
                    # fondo, queda escrito con fecha: antes el repintado iba a
                    # >/dev/null y un fallo aqui no dejaba rastro, asi que "a
                    # veces no vuelve" era indistinguible de "no se repinto".
                    ( sleep 8
                      resolver_entorno
                      roto=$("$HOME/.local/bin/background-health" 2>/dev/null)
                      [ -n "$roto" ] && log "tras monitoradded sigue sin fondo en: $(echo "$roto" | tr '\n' ' ')"
                    ) &
                    ;;
                monitorremoved*)
                    # Al desconectar un monitor, el compositor replantrea el
                    # resto y sus superficies de fondo se pueden quedar en alfa
                    # 0. Sin esto, al volver el escritorio se queda en
                    # negro hasta que se cambia el fondo a mano.
                    sleep 0.8
                    repintar
                    ( sleep 8
                      resolver_entorno
                      roto=$("$HOME/.local/bin/background-health" 2>/dev/null)
                      [ -n "$roto" ] && log "tras monitorremoved sigue sin fondo en: $(echo "$roto" | tr '\n' ' ')"
                    ) &
                    ;;
            esac
        done
    fi
    sleep 2
done
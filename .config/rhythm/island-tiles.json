{
  "_comment": "Tiles de Ajustes rapidos para la isla. El orden es el orden en pantalla. Se lee al arrancar la isla; si borras o renuevas este fichero, la isla vuelve a los chips de siempre. 'delay' es la espera antes de lanzar un menu de rofi: sin ella rofi no consigue el foco, se auto-selecciona la primera entrada y se cierra. 'close' cierra la isla al pulsar.",
  "tiles": [
    {
      "icon": "󰈢",
      "label": "WiFi",
      "cmd": "~/.local/bin/rofi-wifi-menu",
      "close": false,
      "delay": 0.6
    },
    {
      "icon": "󰂯",
      "label": "Bluetooth",

#!/usr/bin/env bash
# Mueve la ventana activa al workspace especial y vuelve al workspace anterior.
# Soporta Hyprland 0.55+ (Lua API) y Hyprland < 0.55 (legacy dispatch).

set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

command -v hyprctl >/dev/null 2>&1 || exit 1
command -v jq >/dev/null 2>&1 || exit 1

hypr_eval_ok() {
    local out
    out=$(hyprctl eval "$1" 2>&1) || return 1
    case "$out" in
        *error*|*unknown*|*"legacy parsers"*|"") return 1 ;;
    esac
    return 0
}

ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.name // empty' 2>/dev/null)
numero="${ws//[!0-9]/}"

if hypr_eval_ok "hl.dispatch(hl.dsp.window.move({workspace='special:magic', silent=true}))"; then
    if [ -n "$numero" ]; then
        sleep 0.1
        ahora=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.name // empty' 2>/dev/null)
        if [ "$ahora" != "$ws" ]; then
            hypr_eval_ok "hl.dispatch(hl.dsp.focus({workspace=$numero}))" || true
        fi
    fi
    exit 0
fi

hyprctl dispatch movetoworkspacesilent special:magic >/dev/null 2>&1 || exit 1
exit 0

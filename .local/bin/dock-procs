#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"
# Señalar las instancias REALES de rust-dock o waybar de un monitor.
#
# POR QUÉ EXISTE ESTO
# -------------------
# La forma que se venía usando era:
#
#     pkill -SIGUSR1 -f "rust-dock.*-o +$mon"
#
# `-f` compara la LÍNEA DE COMANDOS COMPLETA, así que ese patrón no distingue un
# dock de una terminal, un editor o un script que simplemente mencionen
# "rust-dock" y "-o". Y pkill no perdona: le manda la señal a todo lo que
# case. La acción por defecto de SIGUSR1 es terminar el proceso, así que
# cualquier proceso ajeno que tuviera esas dos palabras en una orden se
# llevaba por delante. Está observado: una shell de pruebas murió por escribir
# un comando con "rust-dock" y "-o" dentro.
#
# Aquí se compara el EJECUTABLE de cada proceso, que es lo único que no se puede
# falsificar por accident, y la señal se manda solo a los que de verdad son.
# Es el mismo criterio que ya aplica el lanzador de Waybar, por el mismo motivo.
#
# Uso:
#     dock-procs rust-dock signal  <monitor> <senal>   # p.ej. USR1
#     dock-procs rust-dock on     <monitor>
#     dock-procs waybar    signal <monitor> <senal>
#     dock-procs <tipo> list                          # un monitor por linea

set -u

kind="${1:-}"
action="${2:-}"
target="${3:-}"
signal="${4:-}"

[ -n "$kind" ] && [ -n "$action" ] || {
    echo "uso: dock-procs <rust-dock|waybar> <signal|on> <monitor> [senal]" >&2
    exit 2
}

# Ejecutables aceptados para cada tipo. Se comparan contra /proc/<pid>/exe, que
# es el binario de verdad, no una cadena de la linea de comandos.
#
# Un patron por tipo que cubre los dos nombres. Nix no trae /usr/bin/waybar
# sino un envoltorio cuyo comm es `.waybar-wrapped` y cuyo exe apunta dentro
# del store, con lo que `*/waybar` no cuadraba ahi: `pgrep -x waybar` no
# devolvia nada, el bucle no se ejecutaba, y las senales USR1/USR2 que ocultan
# y restauran las barras al abrir rofi no llegaban a nadie (barra, dock e isla
# se quedaban encima del menu).
#
# Un patron y no dos con `|`: en un `case` de bash la alternativa solo se
# parsea si la `|` esta en el fuente. Puesta en una variable llega al patron
# como un literal, y `*/waybar|*/.waybar-wrapped` no casa con NADA. Un solo
# glob `*waybar` cubre /usr/bin/waybar y /nix/store/.../.waybar-wrapped, y el
# `pgrep -x` de arriba ya acota que procesos entran.
case "$kind" in
    rust-dock) want_exe='*rust-dock' ;;
    # Un solo glob, no dos separados por `|`. Medido: '*waybar|*waybar-wrapped'
    # no casa con NADA -- bash reparte la linea en alternativas y el `|` se come
    # el `*` final del primer patron -- y '*waybar' a secas tampoco, porque el
    # ejecutable real de Nix es .waybar-wrapped y no termina en waybar.
    # '*waybar*' cubre los dos: /usr/bin/waybar y
    # /nix/store/.../bin/.waybar-wrapped.
    #
    # Sin esto pids_of_kind devolvia vacio con la barra corriendo, y por eso la
    # barra no se ocultaba al abrir un menu aunque el pgrep -x de abajo si la
    # encontrara.
    waybar)    want_exe='*waybar*' ;;
    *) echo "tipo desconocido: $kind" >&2; exit 2 ;;
esac

# Campo con el que se identifica el monitor en cada tipo.
#   rust-dock -> -o <monitor>
#   waybar    -> -c <ruta>/config-<monitor>
monitor_of() {
    local pid="$1" cmd
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
    case "$kind" in
        rust-dock) printf '%s' "$cmd" | grep -oP -- '-o\s+\K\S+' || true ;;
        waybar)    printf '%s' "$cmd" | grep -oP -- '-c\s+\S*config-\K\S+' || true ;;
    esac
}

pids_of_kind() {
    # `pgrep -x` compara el NOMBRE del proceso (comm), no la linea de comandos:
    # es preciso —una terminal que mencione "rust-dock" no se llama rust-dock—
    # y tarda ~40 ms.
    #
    # La primera version de esto recorria /proc/[0-9]* con un readlink por
    # entrada para no depender de comm. Sonaba bien y era seguro, pero costaba
    # mas de un segundo: las barras recibian la orden un segundo despues que la
    # isla, y al abrir y cerrar los menus se notaia clarisimo. Ahora el nombre
    # estrecha primero y el ejecutable confirma despues, sobre cuatro o cinco
    # procesos en vez de cuatrocientos.
    local pid exe
    # Se prueban los dos nombres, el normal y el de Nix (.foo-wrapped), porque
    # `pgrep -x` compara con comm y en NixOS no existe /usr/bin/<kind>.
    for pid in $(pgrep -x "$kind" 2>/dev/null; pgrep -x ".$kind-wrapped" 2>/dev/null); do
        exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
        case "$exe" in
            $want_exe) echo "$pid" ;;
        esac
    done
}

matched=0
for pid in $(pids_of_kind); do
    out=$(monitor_of "$pid")
    if [ "$action" = "list" ]; then
        # Un monitor por linea, para poder compararlo con la lista de Hyprland.
        [ -n "$out" ] && printf '%s\n' "$out"
        matched=1
        continue
    fi
    [ -n "$target" ] && [ "$out" != "$target" ] && continue
    matched=1
    case "$action" in
        signal) kill "-$signal" "$pid" 2>/dev/null || true ;;
        on)     : ;;
    esac
done

[ "$matched" = "1" ] && exit 0 || exit 1

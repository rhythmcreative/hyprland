#!/bin/bash
# Touchpad toggle (Omarchy-style).
# Disables/enables the touchpad via hyprctl device keyword and persists the
# disabled device name so Hyprland autostart can re-apply it (--restore).
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
STATE_FILE="$STATE_DIR/touchpad-disabled"
ACTION="${1:-toggle}"

find_touchpad() {
    hyprctl devices -j 2>/dev/null | jq -r '.mice[]? | select(.name | test("touchpad"; "i")) | .name' | head -n1
}

current_dev() {
    if [ -s "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    else
        find_touchpad
    fi
}

tp_notify() {
    notify-send "Touchpad" "$1" 2>/dev/null || true
}

# hyprland.lua uses the non-legacy (Lua) parser, so `hyprctl keyword` is
# rejected at runtime - apply device state via `hyprctl eval` instead.
set_enabled() {
    hyprctl eval "hl.device({ name = \"$2\", enabled = $1 })" >/dev/null 2>&1 || true
}

tp_off() {
    local dev
    dev="$(current_dev)"
    if [ -n "$dev" ]; then
        mkdir -p "$STATE_DIR"
        echo "$dev" > "$STATE_FILE"
        set_enabled false "$dev"
    fi
    echo "off"
}

tp_on() {
    local dev
    dev="$(current_dev)"
    if [ -n "$dev" ]; then
        set_enabled true "$dev"
    fi
    rm -f "$STATE_FILE"
    echo "on"
}

case "$ACTION" in
    status)
        if [ -f "$STATE_FILE" ]; then
            echo "off"
        else
            echo "on"
        fi
        ;;
    on)
        tp_on
        tp_notify "Enabled"
        ;;
    off)
        tp_off
        tp_notify "Disabled"
        ;;
    restore)
        if [ -f "$STATE_FILE" ]; then
            tp_off >/dev/null
        fi
        ;;
    toggle|*)
        if [ -f "$STATE_FILE" ]; then
            tp_on
            tp_notify "Enabled"
        else
            tp_off
            tp_notify "Disabled"
        fi
        ;;
esac

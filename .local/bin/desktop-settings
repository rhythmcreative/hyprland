#!/usr/bin/env bash
# Launcher for Desktop Settings Application

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    sig=$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | grep -v '\.lock$' | head -n 1)
    export HYPRLAND_INSTANCE_SIGNATURE="$sig"
fi

PAGE="${1:-}"

# Check if already running
PID=$(pgrep -f "quickshell -p .*desktop-settings" | head -n1)

if [ -n "$PID" ]; then
    if [ -n "$PAGE" ]; then
        quickshell ipc -p "$HOME/.config/quickshell/desktop-settings/shell.qml" call settingsApp open "$PAGE" 2>/dev/null || true
    else
        quickshell ipc -p "$HOME/.config/quickshell/desktop-settings/shell.qml" call settingsApp toggle 2>/dev/null || true
    fi
    hyprctl dispatch focuswindow "class:org.quickshell.desktop-settings" 2>/dev/null || true
else
    quickshell -p "$HOME/.config/quickshell/desktop-settings/shell.qml" &
    if [ -n "$PAGE" ]; then
        sleep 0.5
        quickshell ipc -p "$HOME/.config/quickshell/desktop-settings/shell.qml" call settingsApp open "$PAGE" 2>/dev/null || true
    fi
fi

#!/usr/bin/env bash
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# modern-pywal-sync: El script DEFINITIVO de sincronización
# Este script ignora temas externos y aplica los colores directamente
# sobre el tema base de GTK para asegurar que NADA se quede "estancado".

STARTUP=0
INSTALL_MODE=0
for arg in "$@"; do
    case "$arg" in
        --startup) STARTUP=1 ;;
        --install) INSTALL_MODE=1 ;;
    esac
done

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "/run/user/$(id -u)/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    fi
fi

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# ── paleta de reserva ────────────────────────────────────────────────────────
#
# ESTOS COLORES SON LOS MISMOS que .config/hypr/hyprland.lua lleva escritos a
# mano en color0..color15, a proposito: si pywal no llega a correr, el escritorio
# se ve igual de coordenado que con pywal, no con los colores por defecto de GTK.
# Si se cambian aqui, hay que cambiarlos tambien alla.
PALETA_FALLBACK_COLOR0="#101012"
PALETA_FALLBACK_COLOR1="#546065"
PALETA_FALLBACK_COLOR2="#A45E4C"
PALETA_FALLBACK_COLOR3="#E59A78"
PALETA_FALLBACK_COLOR4="#5B7A84"
PALETA_FALLBACK_COLOR5="#6F8C94"
PALETA_FALLBACK_COLOR6="#9A9D9E"
PALETA_FALLBACK_COLOR7="#c2c8c9"
PALETA_FALLBACK_COLOR8="#878c8c"
PALETA_FALLBACK_COLOR9="#546065"
PALETA_FALLBACK_COLOR10="#A45E4C"
PALETA_FALLBACK_COLOR11="#E59A78"
PALETA_FALLBACK_COLOR12="#5B7A84"
PALETA_FALLBACK_COLOR13="#6F8C94"
PALETA_FALLBACK_COLOR14="#9A9D9E"
PALETA_FALLBACK_COLOR15="#c2c8c9"
PALETA_FALLBACK_BACKGROUND="$PALETA_FALLBACK_COLOR0"
PALETA_FALLBACK_FOREGROUND="$PALETA_FALLBACK_COLOR7"

# La imagen de la que pywal saca la paleta, en orden de preferencia: la que hay
# puesta ahora, la que trae el repo, y la primera de la biblioteca del usuario.
resolver_wallpaper_paleta() {
    local cache="$HOME/.cache/current-wallpaper"
    local ruta
    if [ -f "$cache" ]; then
        ruta=$(cat "$cache" 2>/dev/null || true)
        if [ -n "$ruta" ] && [ -f "$ruta" ]; then
            printf '%s\n' "$ruta"
            return 0
        fi
    fi
    if [ -f "$HOME/.config/hypr/wallpapers/default.jpg" ]; then
        printf '%s\n' "$HOME/.config/hypr/wallpapers/default.jpg"
        return 0
    fi
    ruta=$(find "$HOME/Pictures/Wallpapers" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        -print -quit 2>/dev/null || true)
    [ -n "$ruta" ] && printf '%s\n' "$ruta" && return 0
    return 1
}

# Los dos ficheros que los temas IMPORTAN, escritos a mano cuando pywal no ha
# podido generarlos.
#
# Esto es lo que arregla "waybar sin tema" y "rofi sin tema": style.css y los
# cuatro .rasi hacen @import de colors-pywal.css / colors-pywal.rasi, y GTK y
# rofi DESCARTAN el tema entero si un import no se resuelve — no es que se
# vea sin colores, es que no se ve el tema. Los dos ficheros estan en
# .gitignore porque los genera pywal, asi que en una maquina donde wal nunca ha
# corrido no existen y el @import falla siempre.
escribir_colores_waybar_fallback() {
    mkdir -p "$HOME/.config/waybar" "$HOME/.cache/wal"
    cat > "$HOME/.config/waybar/colors-pywal.css" <<EOF
/* Paleta de reserva. La escribe modern-pywal-sync cuando pywal no ha podido
   generar la suya; se regenera sola en cuanto wal corre. */
@define-color background ${PALETA_FALLBACK_BACKGROUND};
@define-color foreground ${PALETA_FALLBACK_FOREGROUND};
@define-color color0 ${PALETA_FALLBACK_COLOR0};
@define-color color1 ${PALETA_FALLBACK_COLOR1};
@define-color color2 ${PALETA_FALLBACK_COLOR2};
@define-color color3 ${PALETA_FALLBACK_COLOR3};
@define-color color4 ${PALETA_FALLBACK_COLOR4};
@define-color color5 ${PALETA_FALLBACK_COLOR5};
@define-color color6 ${PALETA_FALLBACK_COLOR6};
@define-color color7 ${PALETA_FALLBACK_COLOR7};
@define-color color8 ${PALETA_FALLBACK_COLOR8};
@define-color color9 ${PALETA_FALLBACK_COLOR9};
@define-color color10 ${PALETA_FALLBACK_COLOR10};
@define-color color11 ${PALETA_FALLBACK_COLOR11};
@define-color color12 ${PALETA_FALLBACK_COLOR12};
@define-color color13 ${PALETA_FALLBACK_COLOR13};
@define-color color14 ${PALETA_FALLBACK_COLOR14};
@define-color color15 ${PALETA_FALLBACK_COLOR15};
EOF
    cp -f "$HOME/.config/waybar/colors-pywal.css" "$HOME/.cache/wal/colors-waybar.css" 2>/dev/null || true
}

escribir_colores_rofi_fallback() {
    mkdir -p "$HOME/.config/rofi" "$HOME/.cache/wal"
    cat > "$HOME/.config/rofi/colors-pywal.rasi" <<EOF
/* Paleta de reserva. La escribe modern-pywal-sync cuando pywal no ha podido
   generar la suya; se regenera sola en cuanto wal corre. */
* {
    background:     ${PALETA_FALLBACK_BACKGROUND};
    background-alt: ${PALETA_FALLBACK_COLOR0};
    foreground:     ${PALETA_FALLBACK_FOREGROUND};
    foreground-alt: ${PALETA_FALLBACK_COLOR8};
    selected:       ${PALETA_FALLBACK_COLOR1};
    active:         ${PALETA_FALLBACK_COLOR2};
    urgent:         ${PALETA_FALLBACK_COLOR3};
    color0:         ${PALETA_FALLBACK_COLOR0};
    color1:         ${PALETA_FALLBACK_COLOR1};
    color2:         ${PALETA_FALLBACK_COLOR2};
    color3:         ${PALETA_FALLBACK_COLOR3};
    color4:         ${PALETA_FALLBACK_COLOR4};
    color5:         ${PALETA_FALLBACK_COLOR5};
    color6:         ${PALETA_FALLBACK_COLOR6};
    color7:         ${PALETA_FALLBACK_COLOR7};
    color8:         ${PALETA_FALLBACK_COLOR8};
    color9:         ${PALETA_FALLBACK_COLOR9};
    color10:        ${PALETA_FALLBACK_COLOR10};
    color11:        ${PALETA_FALLBACK_COLOR11};
    color12:        ${PALETA_FALLBACK_COLOR12};
    color13:        ${PALETA_FALLBACK_COLOR13};
    color14:        ${PALETA_FALLBACK_COLOR14};
    color15:        ${PALETA_FALLBACK_COLOR15};
    background-trans:     ${PALETA_FALLBACK_BACKGROUND}CC;
    background-alt-trans: ${PALETA_FALLBACK_COLOR0}AA;
    selected-trans:       ${PALETA_FALLBACK_COLOR1}DD;
}
EOF
    cp -f "$HOME/.config/rofi/colors-pywal.rasi" "$HOME/.cache/wal/colors-rofi.rasi" 2>/dev/null || true

    cat > "$HOME/.cache/wal/colors-rofi-dark.rasi" <<EOF
* {
    active-background: ${PALETA_FALLBACK_COLOR2};
    active-foreground: @foreground;
    normal-background: @background;
    normal-foreground: @foreground;
    urgent-background: ${PALETA_FALLBACK_COLOR1};
    urgent-foreground: @foreground;

    alternate-active-background: @background;
    alternate-active-foreground: @foreground;
    alternate-normal-background: @background;
    alternate-normal-foreground: @foreground;
    alternate-urgent-background: @background;
    alternate-urgent-foreground: @foreground;

    selected-active-background: ${PALETA_FALLBACK_COLOR1};
    selected-active-foreground: @foreground;
    selected-normal-background: ${PALETA_FALLBACK_COLOR6};
    selected-normal-foreground: @foreground;
    selected-urgent-background: ${PALETA_FALLBACK_COLOR3};
    selected-urgent-foreground: @foreground;

    background-color: @background;
    background: ${PALETA_FALLBACK_BACKGROUND};
    foreground: ${PALETA_FALLBACK_FOREGROUND};
    border-color: @background;
    spacing: 2;
}

#window {
    background-color: @background;
    border: 0;
    padding: 2.5ch;
}

#mainbox {
    border: 0;
    padding: 0;
}

#message {
    border: 2px 0px 0px;
    border-color: @border-color;
    padding: 1px;
}

#textbox {
    text-color: @foreground;
}

#inputbar {
    children: [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

#textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}

#listview {
    fixed-height: 0;
    border: 2px 0px 0px;
    border-color: @border-color;
    spacing: 2px;
    scrollbar: true;
    padding: 2px 0px 0px;
}

#element {
    border: 0;
    padding: 1px;
}

#element.normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

#element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

#element.selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

#element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

#element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}

#element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}

#element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}
EOF
    cp -f "$HOME/.cache/wal/colors-rofi-dark.rasi" "$HOME/.config/rofi/colors-rofi-dark.rasi" 2>/dev/null || true
}

escribir_colores_rofi_dark() {
    mkdir -p "$HOME/.cache/wal"
    cat > "$HOME/.cache/wal/colors-rofi-dark.rasi" <<EOF
* {
    active-background: ${color2};
    active-foreground: @foreground;
    normal-background: @background;
    normal-foreground: @foreground;
    urgent-background: ${color1};
    urgent-foreground: @foreground;

    alternate-active-background: @background;
    alternate-active-foreground: @foreground;
    alternate-normal-background: @background;
    alternate-normal-foreground: @foreground;
    alternate-urgent-background: @background;
    alternate-urgent-foreground: @foreground;

    selected-active-background: ${color1};
    selected-active-foreground: @foreground;
    selected-normal-background: ${color6};
    selected-normal-foreground: @foreground;
    selected-urgent-background: ${color3};
    selected-urgent-foreground: @foreground;

    background-color: @background;
    background: ${background};
    foreground: ${foreground};
    border-color: @background;
    spacing: 2;
}

#window {
    background-color: @background;
    border: 0;
    padding: 2.5ch;
}

#mainbox {
    border: 0;
    padding: 0;
}

#message {
    border: 2px 0px 0px;
    border-color: @border-color;
    padding: 1px;
}

#textbox {
    text-color: @foreground;
}

#inputbar {
    children: [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

#textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}

#listview {
    fixed-height: 0;
    border: 2px 0px 0px;
    border-color: @border-color;
    spacing: 2px;
    scrollbar: true;
    padding: 2px 0px 0px;
}

#element {
    border: 0;
    padding: 1px;
}

#element.normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

#element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

#element.selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

#element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

#element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}

#element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}

#element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}
EOF
    cp -f "$HOME/.cache/wal/colors-rofi-dark.rasi" "$HOME/.config/rofi/colors-rofi-dark.rasi" 2>/dev/null || true
}

# 1. Cargar colores de Pywal
#
# ANTES era un `exit 1` seco si ~/.cache/wal/colors.sh no existia. Ese es el
# punto de rotura de casi todo lo que se veia sin tema: el unico `wal` del
# installer vivia dentro del bloque de SDDM (install.sh step_system), asi que
# en una instalacion limpia el cache no existia todavia y este script se
# negaba a trabajar. Y en el camino de update ni siquiera se intentaba.
#
# Ahora, en este orden: si wal esta y hay una imagen, se genera la paleta de
# verdad; si no, se escribe una paleta fija. En los dos casos, de aqui en
# adelante los ficheros existen.
WALLPAPER_PALETA=""
if [ ! -f "$HOME/.cache/wal/colors.sh" ]; then
    if WALLPAPER_PALETA=$(resolver_wallpaper_paleta) \
        && command -v wal >/dev/null 2>&1; then
        echo "Pywal no habia corrido; se genera la paleta desde $(basename "$WALLPAPER_PALETA")..."
        timeout 15 wal -i "$WALLPAPER_PALETA" -n -q >/dev/null 2>&1 || true
    fi
fi

if [ ! -f "$HOME/.cache/wal/colors.sh" ]; then
    echo "Pywal no disponible; se usa la paleta base de Rhythm."
    mkdir -p "$HOME/.cache/wal"
    cat > "$HOME/.cache/wal/colors.sh" <<EOF
# Paleta de reserva de Rhythm. La escribe modern-pywal-sync cuando pywal no ha
# podido generar una. pywal la sobreescribe en cuanto corre.
background='${PALETA_FALLBACK_BACKGROUND}'
foreground='${PALETA_FALLBACK_FOREGROUND}'
color0='${PALETA_FALLBACK_COLOR0}'
color1='${PALETA_FALLBACK_COLOR1}'
color2='${PALETA_FALLBACK_COLOR2}'
color3='${PALETA_FALLBACK_COLOR3}'
color4='${PALETA_FALLBACK_COLOR4}'
color5='${PALETA_FALLBACK_COLOR5}'
color6='${PALETA_FALLBACK_COLOR6}'
color7='${PALETA_FALLBACK_COLOR7}'
color8='${PALETA_FALLBACK_COLOR8}'
color9='${PALETA_FALLBACK_COLOR9}'
color10='${PALETA_FALLBACK_COLOR10}'
color11='${PALETA_FALLBACK_COLOR11}'
color12='${PALETA_FALLBACK_COLOR12}'
color13='${PALETA_FALLBACK_COLOR13}'
color14='${PALETA_FALLBACK_COLOR14}'
color15='${PALETA_FALLBACK_COLOR15}'
wal_colors_pywal_version='15'
EOF
fi

source "$HOME/.cache/wal/colors.sh"

# Los dos ficheros importados por los temas se resuelven aqui, antes de que el
# resto del script los toque, para que los pasos 6 y 7 de abajo solo los
# sobreescriban si pywal ha dejado los suyos.
[ -e "$HOME/.config/waybar/colors-pywal.css" ] || escribir_colores_waybar_fallback
[ -e "$HOME/.config/rofi/colors-pywal.rasi" ] || escribir_colores_rofi_fallback

echo "Iniciando Sincronización Maestra..."

# 2. Sincronizar GTK 3 y 4 (Método Directo)
# Copiamos directamente a .config para que sea la prioridad #1 del sistema
echo "  • GTK 3/4..."
mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"

# Sincronizar nm-applet (Generar CSS dinámico ultra-agresivo)
echo "  • nm-applet (System Tray)..."
cat > "$HOME/.config/gtk-3.0/nm-applet-waybar.css" <<EOF
/* nm-applet styling DEFINITIVO con Pywal */
window, .background, .nm-applet-window, #nm-applet, #nm-applet-menu, .menu {
    background-color: $background;
    color: $foreground;
}
menu, .menu, menuitem, .menuitem {
    background-color: $background;
    color: $foreground;
}
menuitem:hover, .menuitem:hover, menuitem *:hover {
    background-color: $color6;
    color: $background;
}
/* Específico para el texto del menú */
label {
    color: inherit;
}
button {
    background-color: $color6;
    color: $background;
}
EOF
# Copiar a GTK 4
cp "$HOME/.config/gtk-3.0/nm-applet-waybar.css" "$HOME/.config/gtk-4.0/nm-applet-waybar.css"

# GTK 3
if [ -f "$HOME/.cache/wal/gtk3.css" ]; then
    echo '@import "nm-applet-waybar.css";' > "$HOME/.config/gtk-3.0/gtk.css"
    cat "$HOME/.cache/wal/gtk3.css" >> "$HOME/.config/gtk-3.0/gtk.css"
fi

# GTK 4
if [ -f "$HOME/.cache/wal/gtk4.css" ]; then
    echo '@import "nm-applet-waybar.css";' > "$HOME/.config/gtk-4.0/gtk.css"
    cat "$HOME/.cache/wal/gtk4.css" >> "$HOME/.config/gtk-4.0/gtk.css"
fi

# 3. Sincronizar Iconos (Tela Circle)
echo "  • Iconos (Tela-Circle)..."
if [ -x "$HOME/.local/bin/pywal-tela-sync" ]; then
    "$HOME/.local/bin/pywal-tela-sync" >/dev/null 2>&1 &
fi

# 4. Forzar Recarga de GTK (Reset de tema)
if command -v gsettings &>/dev/null; then
    timeout 2 gsettings set org.gnome.desktop.interface gtk-theme "PywalSync-Mono" 2>/dev/null || true
    timeout 2 gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
fi

# 5. Sincronizar Qt / KDE (Dolphin, etc.)
echo "  • Qt/KDE..."
if [ -x "$HOME/.local/bin/sync-qt-pywal" ]; then
    "$HOME/.local/bin/sync-qt-pywal" >/dev/null 2>&1 &
fi

# 6. Sincronizar Waybar — reinicio completo para sincronizar todos los colores
echo "  • Waybar..."
if [ -f "$HOME/.cache/wal/colors-waybar.css" ]; then
    ln -sf "$HOME/.cache/wal/colors-waybar.css" "$HOME/.config/waybar/colors-pywal.css"
elif [ -f "$HOME/.config/waybar/colors-pywal.css" ]; then
    mkdir -p "$HOME/.cache/wal"
    cp -f "$HOME/.config/waybar/colors-pywal.css" "$HOME/.cache/wal/colors-waybar.css" 2>/dev/null || true
fi

COMPOSITOR_RUNNING=0
if [ "$INSTALL_MODE" -ne 1 ] && [ "$STARTUP" -ne 1 ] && command -v hyprctl >/dev/null 2>&1 && hyprctl monitors >/dev/null 2>&1; then
    COMPOSITOR_RUNNING=1
fi

if [ "$STARTUP" -eq 1 ]; then
    # En arranque de sesión, Waybar ya arranca desde el autostart de Hyprland.
    # Se invoca launch.sh sin --force para asegurar idempotencia sin matar nada.
    "$HOME/.config/waybar/launch.sh" >/dev/null 2>&1 &
elif [ "$COMPOSITOR_RUNNING" -eq 1 ]; then
    # Reinicio rapido en segundo plano (SIGHUP mata a waybar: no usar)
    # --force: la paleta cambio y Waybar no relee el CSS en caliente, asi que aqui
    # si toca reconstruir aunque las barras ya esten donde deben.
    (
        pkill -x waybar 2>/dev/null || true
        sleep 0.3
        "$HOME/.config/waybar/launch.sh" --force >/dev/null 2>&1
        sleep 1
        pkill -x nm-applet 2>/dev/null || true
        nm-applet --indicator >/dev/null 2>&1 &
    ) &
fi

if [ "$COMPOSITOR_RUNNING" -eq 1 ] || [ "$STARTUP" -eq 1 ]; then
    # 6b. rust-dock: relanzar para que recoja la paleta nueva
    echo "  • rust-dock..."
    setsid bash -c '
        sleep 0.2
        for pid in $(for entry in /proc/[0-9]*; do [ -e "$entry/exe" ] && readlink "$entry/exe" 2>/dev/null | grep -q "rust-dock" && echo "${entry#/proc/}"; done); do
            kill "$pid" 2>/dev/null || true
        done
        pkill -x rust-dock >/dev/null 2>&1 || true
        pkill -x .rust-dock-wrap >/dev/null 2>&1 || true
        pkill -x .rust-dock-wrapped >/dev/null 2>&1 || true
        pkill -f "rust-dock" >/dev/null 2>&1 || true
        sleep 0.15
        "$HOME/.local/bin/rust-dock-launcher" >/dev/null 2>&1
    ' >/dev/null 2>&1 </dev/null &

    # 6c. Auto-hide disabled: waybar stays always visible (SIGUSR2 = show)
    pkill -x waybar_auto_hi 2>/dev/null || true
    pkill -SIGUSR2 -x waybar 2>/dev/null || true
    pkill -SIGUSR2 -x .waybar-wrapped 2>/dev/null || true

    # 6d. Asegurar Dynamic Island corriendo y recargar colores de Pywal
    echo "  • Dynamic Island (Quickshell)..."
    if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
        timeout 2 quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call theme reload >/dev/null 2>&1 || true
    else
        "$HOME/.local/bin/quickshell-island" &
    fi
fi

# 7. Sincronizar Rofi
echo "  • Rofi..."
# sync-rofi-pywal se prefiere: genera colors-pywal.rasi Y style-3-pywal.rasi, y
# este ultimo es el que usa el lanzador de aplicaciones (SUPER+A).
if [ -x "$HOME/.local/bin/sync-rofi-pywal" ]; then
    "$HOME/.local/bin/sync-rofi-pywal" >/dev/null 2>&1 || true
fi
# Escribir colors-rofi-dark.rasi en ~/.cache/wal para powermenu y confirm dialogs
escribir_colores_rofi_dark
if [ -f "$HOME/.config/rofi/colors-pywal.rasi" ]; then
    cp -f "$HOME/.config/rofi/colors-pywal.rasi" "$HOME/.cache/wal/colors-rofi.rasi" 2>/dev/null || true
elif [ -f "$HOME/.cache/wal/colors-rofi.rasi" ]; then
    cp -f "$HOME/.cache/wal/colors-rofi.rasi" "$HOME/.config/rofi/colors-pywal.rasi" 2>/dev/null || true
else
    escribir_colores_rofi_fallback
fi

# 8. Sincronizar SDDM (Wallpaper y Colores)
echo "  • SDDM (Login Screen)..."
if [ -x "$HOME/.local/bin/sddm-sync-wrapper" ]; then
    # Usamos el wrapper que maneja pkexec para los privilegios
    "$HOME/.local/bin/sddm-sync-wrapper" >/dev/null 2>&1 &
fi

# 9. Sincronizar Mako (Notificaciones)
echo "  • Mako..."
if [ -x "$HOME/.local/bin/sync-mako-pywal" ]; then
    "$HOME/.local/bin/sync-mako-pywal" >/dev/null 2>&1 || true
fi

# 9b. Sincronizar Hyprlock (Colores mejorados para bloqueo)
echo "  • Hyprlock..."
mkdir -p "$HOME/.cache/wal"
cat > "$HOME/.cache/wal/colors-hyprland-enhanced.conf" <<EOF
# Hyprland enhanced colors generated for hyprlock
\$color0 = rgb(${color0#'#'})
\$color1 = rgb(${color1#'#'})
\$color2 = rgb(${color2#'#'})
\$color3 = rgb(${color3#'#'})
\$color4 = rgb(${color4#'#'})
\$color5 = rgb(${color5#'#'})
\$color6 = rgb(${color6#'#'})
\$color7 = rgb(${color7#'#'})
\$color8 = rgb(${color8#'#'})
\$color9 = rgb(${color9#'#'})
\$color10 = rgb(${color10#'#'})
\$color11 = rgb(${color11#'#'})
\$color12 = rgb(${color12#'#'})
\$color13 = rgb(${color13#'#'})
\$color14 = rgb(${color14#'#'})
\$color15 = rgb(${color15#'#'})

\$background = rgb(${background#'#'})
\$foreground = rgb(${foreground#'#'})
\$cursor = rgb(${cursor#'#'})

\$primary_accent = \$color1
\$secondary_accent = \$color2
\$error_color = \$color9
\$warning_color = \$color11
\$text_color = \$foreground
\$dim_text = \$color7
\$bg_dark = \$color0
\$bg_medium = \$color8
EOF

# 10. Recargar Hyprland (Bordes y colores de ventana)
if [ "$COMPOSITOR_RUNNING" -eq 1 ]; then
    echo "  • Hyprland..."
    timeout 3 hyprctl reload >/dev/null 2>&1 || true
fi

# 11. Sincronización completada silenciosamente
echo "¡Hecho! El sistema ahora debería reflejar los nuevos colores."

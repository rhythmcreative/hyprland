#!/bin/bash
# wallpaper-random: Pick a random wallpaper from ~/Pictures/Wallpapers and apply it.
# Zero emojis. English notifications.

set -euo pipefail

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
LOG_FILE="$HOME/.cache/wallpaper-random.log"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

if [ ! -d "$WALLPAPER_DIR" ]; then
    notify-send -u low "Wallpaper" "Wallpaper directory not found: $WALLPAPER_DIR" 2>/dev/null || true
    exit 1
fi

# Pick a random image file (png, jpg, jpeg, webp)
SELECTED=$(find "$WALLPAPER_DIR" -maxdepth 2 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif" \) 2>/dev/null | shuf -n 1)

if [ -z "$SELECTED" ]; then
    notify-send -u low "Wallpaper" "No wallpaper images found in $WALLPAPER_DIR" 2>/dev/null || true
    exit 1
fi

log "Random wallpaper selected: $SELECTED"

# Ensure awww-daemon is running
if ! pgrep -x "awww-daemon" > /dev/null 2>&1; then
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export WAYLAND_DISPLAY XDG_RUNTIME_DIR
    awww-daemon --format xrgb --no-cache &
    sleep 0.5
fi

# Apply wallpaper (backend picks awww or mpvpaper)
if "$HOME/.local/bin/wallpaper-backend" apply "$SELECTED"; then
    log "Wallpaper applied: $SELECTED"
    notify-send -u low "Wallpaper" "$(basename "$SELECTED")" 2>/dev/null || true
else
    log "Failed to apply wallpaper with backend"
    exit 1
fi
PYWAL_SRC=$("$HOME/.local/bin/wallpaper-backend" pywal-src 2>/dev/null || echo "$SELECTED")

# Sync pywal colors if available
if command -v wal > /dev/null 2>&1; then
    if [ -x "$HOME/.local/bin/pywal-wallpaper-sync" ]; then
        "$HOME/.local/bin/pywal-wallpaper-sync" "$SELECTED" >> "$LOG_FILE" 2>&1 || true
    else
        [ -f "$PYWAL_SRC" ] || PYWAL_SRC="$SELECTED"
        wal -i "$PYWAL_SRC" -n -q >> "$LOG_FILE" 2>&1 || true
    fi
fi

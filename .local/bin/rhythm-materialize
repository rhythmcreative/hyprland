#!/usr/bin/env bash
# rhythm-materialize: despliega la config base del repo y encima las
# ediciones del usuario, sin perder unas ni otras.
#
# El modelo, dos arboles:
#
#   base        ~/.config            lo envia el repo, se re-pone entero
#   user_edits  ~/.local/state/rhythm/user_edits   disperso, solo lo tuyo
#
# El overlay se aplica AL FINAL, asi que un fichero ahi gana en su ruta espejo.
# Hyprland carga la base y despues user.lua; kitty globincluye user.conf. La
# base esta debajo, asi que un bind nuevo de arriba te llega igual, y el tuyo
# gana en lo que pone.
#
# Lo que mas importa: si editas A MANO un fichero que el repo envia, esto lo
# nota. Los bytes no coinciden ni con lo que se puso la ultima vez ni con lo
# que envia el repo, asi que antes de pisar copia ese fichero al overlay como
# fork y avisa. No se pierde trabajo nunca.
#
#   rhythm-materialize            despliega
#   rhythm-materialize --dry-run  dice que haria, no toca nada
#   rhythm-materialize --status   solo informa

set -uo pipefail

MODE="${1:-apply}"
DRY=0
case "$MODE" in
    --dry-run) DRY=1 ;;
    --status)  MODE=status ;;
esac

REPO_DIR="${RHYTHM_DOTFILES_DIR:-$HOME/hyprland}"
if [ ! -d "$REPO_DIR/.git" ]; then
    _self=$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$_self" ] && REPO_DIR="$_self"
    if [ ! -d "$REPO_DIR/.git" ] && [ -d "$HOME/dotfiles/.git" ]; then
        REPO_DIR="$HOME/dotfiles"
    fi
fi

OVERLAY="$HOME/.local/state/rhythm/user_edits"
LEDGER="$HOME/.local/state/rhythm/materialized.ledger"

COPIED=0; SKIPPED=0; FORKED=0; APPLIED=0

# Ficheros que pywal (u otra herramienta) regenera por su cuenta.
#
# El overlay no puede tocar estos. Si un fichero generado acaba rescatado como
# fork, el overlay se aplica encima cada vez y pisa lo que la herramienta acaba
# de escribir: se ve en vivo, pywal ponia el color bueno y el siguiente
# materialize devolvia el viejo. Peor: nunca se vuelve a sincronizar el color,
# porque el overlay gana siempre.
#
# Se comparan por ruta relativa completa, porque "settings.ini" existe en gtk-3.0
# y en gtk-4.0 y los dos estan generados.
generados_por_herramientas() {
    case "$1" in
        .config/rofi/colors-pywal.rasi)        return 0 ;;
        .config/rofi/style-3-pywal.rasi)       return 0 ;;
        .config/gtk-3.0/gtk.css)              return 0 ;;
        .config/gtk-3.0/nm-applet-waybar.css) return 0 ;;
        .config/gtk-3.0/settings.ini)          return 0 ;;
        .config/gtk-4.0/gtk.css)              return 0 ;;
        .config/gtk-4.0/nm-applet-waybar.css) return 0 ;;
        .config/gtk-4.0/settings.ini)          return 0 ;;
        .config/mako/config)                   return 0 ;;
        .cache/wal/*)                          return 0 ;;
        *) return 1 ;;
    esac
}

if [ "$DRY" = 1 ]; then echo "(dry-run: no se escribe nada)"; fi
run() { if [ "$DRY" = 1 ]; then echo "  haria: $*"; else "$@" 2>/dev/null; fi; }

# Si un fichero ya desplegado cambio respecto a lo que se puso la ultima vez,
# es edicion del usuario: se copia al overlay antes de pisarlo.
rescatar_edicion() {
    local live="$1" shipped="$2" rel="$3"
    # Nada que rescatar en ficheros que otra herramienta regenera.
    generados_por_herramientas "$rel" && return 0
    [ -f "$live" ] || return 0
    # El ledger es un DIRECTORIO con una copia de lo que se puso. `[ -f ]` sobre un
# directorio siempre es falso, con lo que esta guarda hacia fuera y nunca se
# rescataba ninguna edicion.
[ -d "$LEDGER" ] || return 0

    local previo="$LEDGER/$rel"
    [ -f "$previo" ] || return 0

    # Igual a lo de la ultima vez: no es edicion suya.
    cmp -s "$live" "$previo" && return 0
    # Ya esta en el overlay: otro fork anterior, no duplicar.
    [ -f "$OVERLAY/$rel" ] && return 0

    mkdir -p "$(dirname "$OVERLAY/$rel")" 2>/dev/null
    if [ "$DRY" = 1 ]; then
        echo "  AVISO: $rel lo editaste a mano, se guardaria como fork en el overlay"
    elif cp -p "$live" "$OVERLAY/$rel" 2>/dev/null; then
        printf '  fork: %s (tu edicion guardada en el overlay)\n' "$rel"
        FORKED=$((FORKED+1))
    fi
}

registrar() {
    [ "$DRY" = 1 ] && return 0
    mkdir -p "$(dirname "$LEDGER/$1")" 2>/dev/null
    cp -p "$2" "$LEDGER/$1" 2>/dev/null || true
}

# ── .config ──────────────────────────────────────────────────────────────────
desplegar_config() {
    local src="$REPO_DIR/.config"
    [ -d "$src" ] || return 0
    mkdir -p "$HOME/.config"

    local f rel_path rel target
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        rel_path="${f#"$src"/}"
        case "$rel_path" in
            *__pycache__*|*.pyc|*.swp|*.bak*) continue ;;
        esac
        rel=".config/$rel_path"
        target="$HOME/$rel"

        if [ -f "$target" ]; then
            if cmp -s "$f" "$target"; then
                SKIPPED=$((SKIPPED+1))
                continue
            fi
            # Rescatar ANTES de sobrescribir: en cuanto se copia el
            # fichero del repo, la edicion del usuario ya no esta en
            # ningun sitio y no hay forma de compararla con el ledger.
            rescatar_edicion "$target" "$f" "$rel"
        fi
        mkdir -p "$(dirname "$target")" 2>/dev/null
        run cp -f "$f" "$target"
        registrar "$rel" "$target"
        COPIED=$((COPIED+1))
    done < <(find "$src" -type f 2>/dev/null)
}

# ── overlay ──────────────────────────────────────────────────────────────────
aplicar_overlay() {
    [ -d "$OVERLAY" ] || return 0
    # El overlay se espeja sobre ~/.config entero, y los forks viven a
    # user_edits/.config/... Es decir, hay que recorrer TODO el arbol con
    # `find`, no solo un nivel: un recorrido de un nivel encuentra
    # user_edits/.config y se queda ahi, sin aplicar nada.
    local f rel
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        # /…/user_edits/<algo>  ->  <algo> bajo ~/.config
        rel="${f#"$OVERLAY"/}"
        case "$rel" in
            .config/*) ;;
            .local/bin/*) ;;
            *) continue ;;
        esac
        # Los generados por pywal y compañía van straight del repo: el overlay
        # aplicandose encima impediria que se sincronizaran nunca mas.
        generados_por_herramientas "$rel" && continue
        mkdir -p "$HOME/$(dirname "$rel")" 2>/dev/null
        run cp -f "$f" "$HOME/$rel"
        APPLIED=$((APPLIED+1))
    done < <(find "$OVERLAY" -type f 2>/dev/null)
}

# ── .local/bin ───────────────────────────────────────────────────────────────
desplegar_bin() {
    local src="$REPO_DIR/.local/bin"
    [ -d "$src" ] || return 0
    mkdir -p "$HOME/.local/bin"
    local f rel_path rel target
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        rel_path="${f#"$src"/}"
        case "$rel_path" in
            *__pycache__*|*.pyc|*.swp|*.bak*) continue ;;
        esac
        rel=".local/bin/$rel_path"
        target="$HOME/$rel"

        if [ -f "$target" ]; then
            if cmp -s "$f" "$target"; then
                SKIPPED=$((SKIPPED+1))
                continue
            fi
            rescatar_edicion "$target" "$f" "$rel"
        fi
        mkdir -p "$(dirname "$target")" 2>/dev/null
        run cp -f "$f" "$target"
        run chmod 755 "$target"
        registrar "$rel" "$target"
        COPIED=$((COPIED+1))
    done < <(find "$src" -type f 2>/dev/null)
}

# ── informacion ──────────────────────────────────────────────────────────────
estado() {
    echo "user_edits: $OVERLAY"
    if [ -d "$OVERLAY" ]; then
        local n
        n=$(find "$OVERLAY" -type f 2>/dev/null | wc -l)
        echo "  $n fichero(s) de override:"
        find "$OVERLAY" -type f 2>/dev/null | sed "s|$OVERLAY/|    |"
    else
        echo "  (vacio: todo lo que hay en ~/.config viene del repo)"
    fi

    echo
    echo "ledger: $LEDGER"
    if [ -d "$LEDGER" ]; then
        echo "  $(find "$LEDGER" -type f 2>/dev/null | wc -l) fichero(s) registrados"
    else
        echo "  (vacio: es la primera vez que se despliega)"
    fi
}

case "$MODE" in
    status) estado ;;
    *)
        if [ "$MODE" != "--status" ]; then
            desplegar_config
            desplegar_bin
            aplicar_overlay
            echo "materialize: $COPIED del repo, $SKIPPED sin cambios, $APPLIED del overlay"
            # Con `&&` al final de la linea, cuando no hay forks el test es
            # falso y el case se cierra con codigo 1. system-ota lee ese
            # codigo, lo contaba como despliegue fallido y任何一个 update
            # acababa avisando de problemas aunque todo estuviera bien.
            if [ "$FORKED" -gt 0 ]; then
                echo "materialize: $FORKED edicion(es) tuyas guardada(s) como fork"
            fi
        fi
        ;;
esac

# Sin forks que rescatar, el despliegue fue correcto: sale 0 siempre.
exit 0
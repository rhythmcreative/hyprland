#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"

# Menu interactivo de Bluetooth para Rofi y Hyprland
# Tema y colores sincronizados con Pywal

THEME_FILE="$HOME/.config/rofi/settings.rasi"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Prefer opening on the focused monitor's Dynamic Island
ACTIVE_MON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
[ -n "$ACTIVE_MON" ] || ACTIVE_MON="eDP-1"
if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
    quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call settings open_bt "$ACTIVE_MON" >/dev/null 2>&1
    exit 0
fi

get_active_monitor() {
    local mon=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
    [ -n "$mon" ] && [ "$mon" != "null" ] && echo "$mon" && return
    echo "eDP-1"
}
ACTIVE_MON=$(get_active_monitor)

# Hide Waybar, Rust-Dock and Quickshell while Rofi is open (ONLY on active monitor)
if [ -z "$_BARS_HIDDEN" ] && [ -n "$ACTIVE_MON" ]; then
    export _BARS_HIDDEN=1
    if "$HOME/.local/bin/dock-procs" waybar signal "$ACTIVE_MON" USR1 >/dev/null 2>&1; then
        export _WAYBAR_WAS_VISIBLE=true
    elif pgrep -x waybar >/dev/null 2>&1 || pgrep -x .waybar-wrapped >/dev/null 2>&1; then
        export _WAYBAR_WAS_VISIBLE=true
        pkill -SIGUSR1 -x waybar 2>/dev/null || pkill -SIGUSR1 -x .waybar-wrapped 2>/dev/null &
    fi
    if "$HOME/.local/bin/dock-procs" rust-dock signal "$ACTIVE_MON" USR1 >/dev/null 2>&1; then
        export _RUST_DOCK_WAS_VISIBLE=true
    elif pgrep -x rust-dock >/dev/null 2>&1 || pgrep -x .rust-dock-wrap >/dev/null 2>&1 || pgrep -x .rust-dock-wrapped >/dev/null 2>&1; then
        export _RUST_DOCK_WAS_VISIBLE=true
        pkill -SIGUSR1 -x rust-dock 2>/dev/null || pkill -SIGUSR1 -x .rust-dock-wrap 2>/dev/null || pkill -SIGUSR1 -x .rust-dock-wrapped 2>/dev/null &
    fi
    if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
        export _QUICKSHELL_WAS_VISIBLE=true
        quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island hide "$ACTIVE_MON" >/dev/null 2>&1 &
    fi
fi

restore_bars() {
    if [ -n "$ACTIVE_MON" ]; then
        [ "$_WAYBAR_WAS_VISIBLE" = "true" ] && { "$HOME/.local/bin/dock-procs" waybar signal "$ACTIVE_MON" USR2 >/dev/null 2>&1 || pkill -SIGUSR2 -x waybar 2>/dev/null || pkill -SIGUSR2 -x .waybar-wrapped 2>/dev/null & }
        [ "$_RUST_DOCK_WAS_VISIBLE" = "true" ] && { "$HOME/.local/bin/dock-procs" rust-dock signal "$ACTIVE_MON" USR2 >/dev/null 2>&1 || pkill -SIGUSR2 -x rust-dock 2>/dev/null || pkill -SIGUSR2 -x .rust-dock-wrap 2>/dev/null || pkill -SIGUSR2 -x .rust-dock-wrapped 2>/dev/null & }
        [ "$_QUICKSHELL_WAS_VISIBLE" = "true" ] && quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island reveal "$ACTIVE_MON" >/dev/null 2>&1 &
    fi
}
trap restore_bars EXIT

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 3000 -i bluetooth "Bluetooth" "$1"
    fi
}

# Obtener estado de Bluetooth y cadenas traducidas
BT_STATUS=$(bluetoothctl show 2>/dev/null | grep -i "powered" | awk '{print $2}')

T_DIS_BT=$(hypr-i18n bt.toggle_off 2>/dev/null || echo "󰂲  Disable Bluetooth")
T_EN_BT=$(hypr-i18n bt.toggle_on 2>/dev/null || echo "󰂯  Enable Bluetooth")
T_RESCAN=$(hypr-i18n bt.rescan 2>/dev/null || echo "󰑐  Scan nearby devices")
T_OPEN_MGR=$(hypr-i18n bt.open_manager 2>/dev/null || echo "󰒓  Open Bluetooth Manager (blueman-manager)")
T_CONN=$(hypr-i18n bt.connected 2>/dev/null || echo "Connected")
T_PAIRED=$(hypr-i18n bt.paired 2>/dev/null || echo "Paired")
T_BACK=$(hypr-i18n bt.back 2>/dev/null || echo "󰅁  Back")
T_REMOVE=$(hypr-i18n bt.remove 2>/dev/null || echo "󰆴  Remove device")
T_UNPAIR=$(hypr-i18n bt.unpair 2>/dev/null || echo "󰆴  Unpair device")
T_PROMPT=$(hypr-i18n bt.prompt 2>/dev/null || echo "Bluetooth Devices")

if [ "$BT_STATUS" = "yes" ]; then
    POWER_OPTION="$T_DIS_BT"
else
    POWER_OPTION="$T_EN_BT"
fi

# Si esta apagado, mostrar opcion rapida
if [ "$BT_STATUS" != "yes" ]; then
    CHOSEN=$(echo -e "$POWER_OPTION\n$T_OPEN_MGR" | rofi-themed -dmenu -i -p "$T_PROMPT" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    case "$CHOSEN" in
        *"Activar Bluetooth"*|*"Enable Bluetooth"*)
            rfkill unblock bluetooth 2>/dev/null || true
            sleep 0.2
            bluetoothctl power on
            notify "$(hypr-i18n bluetooth.enabled 2>/dev/null || echo "Bluetooth enabled")"
            sleep 1
            exec "$0"
            ;;
        *"Abrir Administrador"*|*"Open Bluetooth Manager"*)
            blueman-manager &
            ;;
    esac
    exit 0
fi

# Obtener dispositivos conocidos y emparejados
RAW_DEVICES=$(bluetoothctl devices 2>/dev/null)

DEV_ITEMS=""
while IFS= read -r line; do
    [ -z "$line" ] && continue
    mac=$(echo "$line" | awk '{print $2}')
    name=$(echo "$line" | cut -d' ' -f3-)
    [ -z "$mac" ] && continue

    info=$(bluetoothctl info "$mac" 2>/dev/null)
    connected=$(echo "$info" | grep -i "Connected:" | awk '{print $2}')
    paired=$(echo "$info" | grep -i "Paired:" | awk '{print $2}')
    icon_type=$(echo "$info" | grep -i "Icon:" | awk '{print $2}')

    icon="󰂯"
    case "$icon_type" in
        *"audio"*|*"headset"*|*"headphones"*) icon="󰋋" ;;
        *"keyboard"*) icon="󰌌" ;;
        *"mouse"*) icon="󰍽" ;;
        *"phone"*) icon="󰄡" ;;
        *"gamepad"*) icon="󰊴" ;;
    esac

    if [ "$connected" = "yes" ]; then
        DEV_ITEMS="${DEV_ITEMS}${icon}  ${name} ($T_CONN) │ MAC: ${mac} │ $T_PAIRED\n"
    elif [ "$paired" = "yes" ]; then
        DEV_ITEMS="${DEV_ITEMS}${icon}  ${name} │ MAC: ${mac} │ $T_PAIRED\n"
    else
        DEV_ITEMS="${DEV_ITEMS}${icon}  ${name} │ MAC: ${mac}\n"
    fi
done <<< "$RAW_DEVICES"

# Cabecera de acciones
HEADER="$POWER_OPTION\n$T_RESCAN\n$T_OPEN_MGR\n────────────────────────────────────────"

MENU_CONTENT=$(echo -e "${HEADER}\n${DEV_ITEMS}")

CHOSEN=$(echo -e "$MENU_CONTENT" | rofi-themed -dmenu -i -p "$T_PROMPT" -theme "$THEME_FILE" -m "$ACTIVE_MON")

[ -z "$CHOSEN" ] && exit 0
[[ "$CHOSEN" =~ ^─ ]] && exit 0

case "$CHOSEN" in
    *"Desactivar Bluetooth"*|*"Disable Bluetooth"*)
        bluetoothctl power off
        notify "$(hypr-i18n bluetooth.disabled 2>/dev/null || echo "Bluetooth disabled")"
        exit 0
        ;;
    *"Activar Bluetooth"*|*"Enable Bluetooth"*)
        rfkill unblock bluetooth 2>/dev/null || true
        sleep 0.2
        bluetoothctl power on
        notify "$(hypr-i18n bluetooth.enabled 2>/dev/null || echo "Bluetooth enabled")"
        exit 0
        ;;
    *"Escanear dispositivos"*|*"Scan nearby devices"*)
        notify "$(hypr-i18n bt.scanning 2>/dev/null || echo "Scanning nearby devices...")"
        bluetoothctl --timeout 5 scan on >/dev/null 2>&1
        exec "$0"
        ;;
    *"Abrir Administrador"*|*"Open Bluetooth Manager"*)
        blueman-manager &
        exit 0
        ;;
esac

# Extraer MAC del dispositivo
TARGET_MAC=$(echo "$CHOSEN" | awk -F'│' '{print $2}' | sed 's/MAC://' | tr -d ' ')
TARGET_NAME=$(echo "$CHOSEN" | awk -F'│' '{print $1}' | sed -E 's/^[󰂯󰋋󰌌󰍽󰄡󰊴* ]+//' | sed -E "s/ \($T_CONN|Conectado|Connected\)//" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

[ -z "$TARGET_MAC" ] && exit 0

# Comprobar si esta conectado
IS_CONN=$(bluetoothctl info "$TARGET_MAC" 2>/dev/null | grep -i "Connected:" | awk '{print $2}')

if [ "$IS_CONN" = "yes" ]; then
    T_DISCONN_ACTION=$(hypr-i18n bt.disconnect "$TARGET_NAME" 2>/dev/null || echo "󰅖  Disconnect from $TARGET_NAME")
    ACTION=$(echo -e "$T_DISCONN_ACTION\n$T_UNPAIR\n$T_BACK" | rofi-themed -dmenu -i -p "$TARGET_NAME" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    case "$ACTION" in
        *"Desconectar"*|*"Disconnect"*)
            notify "$(hypr-i18n bt.disconnected_from "$TARGET_NAME" 2>/dev/null || echo "Disconnected from $TARGET_NAME")"
            bluetoothctl disconnect "$TARGET_MAC"
            ;;
        *"Desvincular"*|*"Unpair"*|*"Remove"*)
            bluetoothctl remove "$TARGET_MAC"
            notify "$(hypr-i18n bt.removed "$TARGET_NAME" 2>/dev/null || echo "Device $TARGET_NAME removed")"
            ;;
    esac
else
    T_CONN_ACTION=$(hypr-i18n bt.connect "$TARGET_NAME" 2>/dev/null || echo "󰂱  Connect to $TARGET_NAME")
    T_PAIR_ACTION=$(hypr-i18n bt.pair 2>/dev/null || echo "󰌷  Pair device")
    ACTION=$(echo -e "$T_CONN_ACTION\n$T_PAIR_ACTION\n$T_REMOVE\n$T_BACK" | rofi-themed -dmenu -i -p "$TARGET_NAME" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    case "$ACTION" in
        *"Conectar"*|*"Connect"*)
            if bluetoothctl connect "$TARGET_MAC"; then
                notify "$(hypr-i18n bt.connected_to "$TARGET_NAME" 2>/dev/null || echo "Connected successfully to $TARGET_NAME")"
            else
                notify "$(hypr-i18n bt.connect_failed "$TARGET_NAME" 2>/dev/null || echo "Failed to connect to $TARGET_NAME")"
            fi
            ;;
        *"Emparejar"*|*"Pair"*)
            bluetoothctl pair "$TARGET_MAC"
            bluetoothctl trust "$TARGET_MAC"
            bluetoothctl connect "$TARGET_MAC"
            ;;
        *"Eliminar"*|*"Remove"*)
            bluetoothctl remove "$TARGET_MAC"
            notify "$(hypr-i18n bt.removed "$TARGET_NAME" 2>/dev/null || echo "Device removed")"
            ;;
    esac
fi

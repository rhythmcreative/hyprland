#!/usr/bin/env bash
# Persistent Night Light settings and hyprsunset runtime controls.

set -u

CONFIG_DIR="$HOME/.config/rhythm"
CONFIG_FILE="$CONFIG_DIR/night-light.conf"
DEFAULT_TEMPERATURE=4500
DEFAULT_GAMMA=100
DEFAULT_SCHEDULE=off
ACTION="${1:-toggle}"

read_settings() {
    TEMPERATURE="$DEFAULT_TEMPERATURE"
    GAMMA="$DEFAULT_GAMMA"
    SCHEDULE="$DEFAULT_SCHEDULE"
    SCHEDULE_START=""
    SCHEDULE_END=""
    if [ -f "$CONFIG_FILE" ]; then
        local stored
        stored=$(awk -F= '$1 == "temperature" {print $2; exit}' "$CONFIG_FILE")
        [[ "$stored" =~ ^[0-9]+$ ]] && TEMPERATURE="$stored"
        stored=$(awk -F= '$1 == "gamma" {print $2; exit}' "$CONFIG_FILE")
        [[ "$stored" =~ ^[0-9]+$ ]] && GAMMA="$stored"
        stored=$(awk -F= '$1 == "schedule" {print $2; exit}' "$CONFIG_FILE")
        [ "$stored" = "on" ] && SCHEDULE="on"
        SCHEDULE_START=$(awk -F= '$1 == "schedule_start" {print $2; exit}' "$CONFIG_FILE")
        SCHEDULE_END=$(awk -F= '$1 == "schedule_end" {print $2; exit}' "$CONFIG_FILE")
    fi
}

save_settings() {
    mkdir -p "$CONFIG_DIR"
    local tmp="$CONFIG_FILE.tmp.$$"
    {
        printf 'temperature=%s\n' "$TEMPERATURE"
        printf 'gamma=%s\n' "$GAMMA"
        printf 'schedule=%s\n' "$SCHEDULE"
        printf 'schedule_start=%s\n' "$SCHEDULE_START"
        printf 'schedule_end=%s\n' "$SCHEDULE_END"
    } > "$tmp"
    mv -f "$tmp" "$CONFIG_FILE"
}

# El estado es el del servicio, no un pgrep. Con un pgrep habia dos falsos
# positivos: un hyprsunset de otra sesion contaba como activo, y uno a medio
# morir seguia contando durante unos segundos.
SUNSET_UNIT="rhythm-hyprsunset.service"

is_on() {
    if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet "$SUNSET_UNIT" 2>/dev/null; then
        return 0
    fi
    pgrep -u "$UID" -x hyprsunset >/dev/null 2>&1
}

start_nightlight() {
    read_settings
    local started=0
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload >/dev/null 2>&1 || true
        if systemctl --user start "$SUNSET_UNIT" >/dev/null 2>&1; then
            started=1
        fi
    fi
    if [ "$started" -eq 0 ]; then
        pkill -u "$UID" -x hyprsunset >/dev/null 2>&1 || true
        nohup hyprsunset -t "$TEMPERATURE" -g "$GAMMA" >/dev/null 2>&1 &
        sleep 0.1
        if pgrep -u "$UID" -x hyprsunset >/dev/null 2>&1; then
            started=1
        fi
    fi
    if [ "$started" -eq 1 ]; then
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl hyprsunset temperature "$TEMPERATURE" >/dev/null 2>&1 || true
        fi
        return 0
    fi
    return 1
}

stop_nightlight() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop "$SUNSET_UNIT" >/dev/null 2>&1 || true
    fi
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl hyprsunset identity >/dev/null 2>&1 || true
    fi
    pkill -u "$UID" -x hyprsunset >/dev/null 2>&1 || true
}

set_temperature() {
    local value="${1:-}"
    [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -ge 1000 ] && [ "$value" -le 20000 ] || {
        echo "Temperature must be between 1000 and 20000 K." >&2
        return 2
    }
    read_settings
    TEMPERATURE="$value"
    save_settings
    if is_on; then
        if command -v hyprctl >/dev/null 2>&1 && hyprctl hyprsunset temperature "$TEMPERATURE" >/dev/null 2>&1; then
            :
        elif command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet "$SUNSET_UNIT" 2>/dev/null; then
            systemctl --user restart "$SUNSET_UNIT" >/dev/null 2>&1 || start_nightlight
        else
            start_nightlight
        fi
    fi
    echo "$TEMPERATURE"
}

set_gamma() {
    local value="${1:-}"
    [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -ge 20 ] && [ "$value" -le 100 ] || {
        echo "Gamma must be between 20 and 100 percent." >&2
        return 2
    }
    read_settings
    GAMMA="$value"
    save_settings
    if is_on; then
        local g_val
        g_val=$(awk "BEGIN {printf \"%.2f\", $value / 100}")
        if command -v hyprctl >/dev/null 2>&1 && hyprctl hyprsunset gamma "$g_val" >/dev/null 2>&1; then
            :
        elif command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet "$SUNSET_UNIT" 2>/dev/null; then
            systemctl --user restart "$SUNSET_UNIT" >/dev/null 2>&1 || start_nightlight
        else
            start_nightlight
        fi
    fi
    echo "$GAMMA"
}

case "$ACTION" in
    status)
        is_on && echo "on" || echo "off"
        ;;
    settings)
        read_settings
        if is_on; then enabled=true; else enabled=false; fi
        if [ "$SCHEDULE" = "on" ]; then schedule_enabled=true; else schedule_enabled=false; fi
        printf '{"enabled":%s,"temperature":%s,"gamma":%s,"schedule_enabled":%s,"schedule_start":"%s","schedule_end":"%s"}\n' \
            "$enabled" "$TEMPERATURE" "$GAMMA" "$schedule_enabled" "$SCHEDULE_START" "$SCHEDULE_END"
        ;;
    on)
        if start_nightlight; then
            echo "on"
        else
            echo "Could not start the Night Light service." >&2
            exit 1
        fi
        ;;
    off)
        stop_nightlight
        echo "off"
        ;;
    toggle)
        if is_on; then
            stop_nightlight
            echo "off"
        else
            start_nightlight
            echo "on"
        fi
        ;;
    temperature|set-temperature)
        set_temperature "${2:-}"
        ;;
    gamma|set-gamma)
        set_gamma "${2:-}"
        ;;
    reset)
        TEMPERATURE="$DEFAULT_TEMPERATURE"
        GAMMA="$DEFAULT_GAMMA"
        save_settings
        if is_on; then start_nightlight; fi
        echo "reset"
        ;;
    schedule)
        read_settings
        case "${2:-}" in
            on)
                start_time="${3:-}"
                end_time="${4:-}"
                time_re='^([01][0-9]|2[0-3]):[0-5][0-9]$'
                [[ "$start_time" =~ $time_re && "$end_time" =~ $time_re && "$start_time" != "$end_time" ]] || {
                    echo "Enter different start and end times in HH:MM (24-hour) format." >&2
                    exit 2
                }
                SCHEDULE="on"
                SCHEDULE_START="$start_time"
                SCHEDULE_END="$end_time"
                save_settings
                # Las unidades las despliega el instalador en ~/.config/systemd/user;
                # tras un install recien hecho el gestor de usuario todavia no las
                # conoce, asi que recargar antes de activarlas.
                #
                # Lo que se activa es el TIMER, no el servicio. El servicio es de
                # una sola pasada y el timer la repite cada minuto. Antes era un
                # servicio permanente con un bucle dentro, y como el script se
                # reescribia en una actualizacion, bash dejaba de ejecutar la
                # parte que aplica y el horario se quedaba sin hacer nada.
                systemctl --user daemon-reload >/dev/null 2>&1 || true
                if ! systemctl --user enable --now rhythm-nightlight-schedule.timer; then
                    SCHEDULE="off"
                    save_settings
                    echo "Could not start the Night Light schedule timer." >&2
                    exit 1
                fi
                # Comprobacion inmediata, para que el boton no espere al primer
                # tick: si ya estamos dentro de la ventana, se enciende ya.
                systemctl --user start rhythm-nightlight-schedule.service >/dev/null 2>&1 || true
                echo "schedule-on"
                ;;
            off)
                SCHEDULE="off"
                save_settings
                systemctl --user disable --now rhythm-nightlight-schedule.timer 2>/dev/null || true
                systemctl --user stop rhythm-nightlight-schedule.service 2>/dev/null || true
                echo "schedule-off"
                ;;
            *)
                echo "Usage: toggle-nightlight schedule on HH:MM HH:MM | off" >&2
                exit 2
                ;;
        esac
        ;;
    *)
        echo "Usage: toggle-nightlight status|settings|on|off|toggle|temperature K|gamma PERCENT|reset" >&2
        exit 2
        ;;
esac

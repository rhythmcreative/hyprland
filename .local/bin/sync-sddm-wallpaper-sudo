#!/bin/bash

# Script wrapper para sincronizar el wallpaper de SDDM usando sudo
# Este script se puede llamar sin permisos de root

LOG_FILE="$HOME/.cache/sddm-wallpaper-sync.log"

# Función de logging
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

log "Ejecutando sincronización de wallpaper de SDDM con sudo"

# Ejecutar el sincronizador preferido
if [[ -x "$HOME/.local/bin/sddm-sync-wrapper" ]]; then
    "$HOME/.local/bin/sddm-sync-wrapper"
elif [[ -x /usr/local/lib/rhythm/sddm-auto-sync-local ]]; then
    sudo -n /usr/local/lib/rhythm/sddm-auto-sync-local || sudo /usr/local/lib/rhythm/sddm-auto-sync-local
elif [[ -x "$HOME/.local/bin/sddm-auto-sync-local" ]]; then
    sudo "$HOME/.local/bin/sddm-auto-sync-local"
else
    sudo "$HOME/.local/bin/sync-sddm-wallpaper"
fi

if [[ $? -eq 0 ]]; then
    log "Sincronización completada exitosamente"
else
    log "ERROR: Fallo en la sincronización"
    notify-send "SDDM Wallpaper" "Error al sincronizar wallpaper con SDDM"
fi

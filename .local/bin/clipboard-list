#!/usr/bin/env bash
# Lista del historial en JSON para la isla:
# [{"id":2,"title":"...","sub":"...","image":false,"thumb":""}, ...]
#
# Como el launcher de impasto: cada fila lleva titulo y subtitulo. El titulo es
# la vista previa (o "Imagen" si es imagen, que se identifica por su miniatura)
# y el subtitulo el tipo con el tamano. Los thumbs van a
# ~/.cache/rhythm/clip-thumbs/<id>.png y los huerfanos se borran.

set -u

THUMB_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/rhythm/clip-thumbs"
mkdir -p "$THUMB_DIR" 2>/dev/null || true

cliphist list 2>/dev/null | head -30 | python3 -c '
import json, os, re, subprocess, sys

thumb_dir = os.environ.get("THUMB_DIR", os.path.expanduser("~/.cache/rhythm/clip-thumbs"))
os.makedirs(thumb_dir, exist_ok=True)

out = []
vivos = set()
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line or "\t" not in line:
        continue
    sid, _, prev = line.partition("\t")
    try:
        iid = int(sid)
    except ValueError:
        continue
    vivos.add(iid)
    m = re.match(r"\[\[ binary data (.+) (\w+) (\d+x\d+) \]\]", prev)
    if m:
        size, fmt, dims = m.groups()
        path = os.path.join(thumb_dir, "%d.png" % iid)
        if not os.path.exists(path) or os.path.getsize(path) == 0:
            try:
                data = subprocess.run(["cliphist", "decode", str(iid)],
                                      capture_output=True, timeout=10).stdout
                if data[:8].startswith(b"\x89PNG\r\n\x1a\n"):
                    open(path, "wb").write(data)
                else:
                    path = ""
            except Exception:
                path = ""
        out.append({"id": iid, "title": "Imagen",
                    "sub": "Imagen %s · %s · %s" % (fmt.upper(), dims, size),
                    "image": bool(path), "thumb": path})
    else:
        prev = " ".join(prev.split())
        sub = "Texto · %d caracteres" % len(prev)
        out.append({"id": iid,
                    "title": prev[:120] if prev else "(vacio)",
                    "sub": sub, "image": False, "thumb": ""})

for f in os.listdir(thumb_dir):
    if f.endswith(".png"):
        try:
            if int(f[:-4]) not in vivos:
                os.remove(os.path.join(thumb_dir, f))
        except ValueError:
            pass

print(json.dumps(out))
'

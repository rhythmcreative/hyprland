#!/bin/bash
# Escribe el fondo macizo del modo ahorro de energia con el color actual de
# pywal:  colors-powersave.rasi
#
# Sin ahorro este script no hace falta: rofi-themed no aplica nada y cada menu
# conserva el fondo translucent que trae su propio tema, que es el de siempre y
# el que deja ver el desenfoque del compositor. Solo el ahorro lo cambia, y para
# eso hace falta este unico fichero.
#
# Vive aqui y no dentro de toggle-powersave porque al cambiar el fondo con el
# ahorro activo el macizo se quedaba con el color del fondo anterior; medido:
# fondo #884400 y colors-powersave.rasi seguia en #151921. rofi-themed lo llama
# en cada apertura de menu, asi que da igual que script cambiase el fondo.
# Solo escribe si el contenido cambia, asi que no toca el disco si no hace falta.

set -u

dir="$HOME/.config/rofi"
mkdir -p "$dir" 2>/dev/null || exit 0

# El color de fondo de pywal es la primera linea de colors.
bg=$(head -n1 "$HOME/.cache/wal/colors" 2>/dev/null | tr -d '[:space:]')
if [[ ! "$bg" =~ ^\#[0-9a-fA-F]{6,8}$ ]]; then
    bg="#101516"
fi

macizo="* { bgcolor: ${bg}; background-trans: ${bg}; background-alt-trans: ${bg}; }
window { background-color: ${bg}; }
mainbox { background-color: ${bg}; }"

escribir() {
    # $1 ruta, $2 contenido. El fichero no lleva comentarios: su contenido se
    # pasa a rofi con -theme-str y un comentario se interpretaria como tema.
    if [ -f "$1" ] && [ "$(cat "$1" 2>/dev/null)" = "$2" ]; then
        return 0
    fi
    printf '%s\n' "$2" > "$1" 2>/dev/null || true
}

escribir "$dir/colors-powersave.rasi" "$macizo"

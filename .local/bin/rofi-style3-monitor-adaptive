#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"

# Script de rofi launcher con detección automática de monitor
# Usa style-3.rasi y se adapta a cada monitor
# Autor: rhythmcreative

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Log file para depuración
LOG_FILE="$HOME/.cache/rofi-style3-launcher.log"

# Función de logging sin forks (bash builtin printf)
log_debug() {
    printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$1" >> "$LOG_FILE"
}

# Función rápida para detectar el monitor activo (cursor -> focused -> fallback)
get_active_monitor() {
    local monitors cursor_info cursor_x cursor_y mon
    monitors=$(hyprctl monitors -j 2>/dev/null)
    if [ -n "$monitors" ]; then
        cursor_info=$(hyprctl cursorpos 2>/dev/null)
        if [ -n "$cursor_info" ]; then
            cursor_x="${cursor_info%%,*}"
            cursor_y="${cursor_info#*,}"
            cursor_x="${cursor_x// /}"
            cursor_y="${cursor_y// /}"
            mon=$(printf '%s' "$monitors" | jq -r --argjson cx "${cursor_x:-0}" --argjson cy "${cursor_y:-0}" '
                (.[] | select($cx >= .x and $cx < (.x + .width) and $cy >= .y and $cy < (.y + .height)) | .name),
                (.[] | select(.focused == true) | .name),
                (.[0].name)
            ' 2>/dev/null | head -n1)
        else
            mon=$(printf '%s' "$monitors" | jq -r '(.[] | select(.focused == true) | .name), (.[0].name)' 2>/dev/null | head -n1)
        fi
        if [ -n "$mon" ] && [ "$mon" != "null" ]; then
            echo "$mon"
            return
        fi
    fi
    echo "eDP-1"
}

# Estado previo de visibilidad
_RUST_DOCK_WAS_VISIBLE=false
_QUICKSHELL_WAS_VISIBLE=false
_WAYBAR_WAS_VISIBLE=false

# Ocultar barras en paralelo SIN bloquear el arranque de rofi (0ms de espera)
hide_active_bars() {
    local mon="$ACTIVE_MONITOR"
    [ -n "$mon" ] || return 0
    _QUICKSHELL_WAS_VISIBLE=true
    _RUST_DOCK_WAS_VISIBLE=true
    quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island hide "$mon" >/dev/null 2>&1 &
    quickshell ipc -p "$HOME/.config/quickshell/dock/shell.qml" --any-display call dock hide "$mon" >/dev/null 2>&1 &
    if pgrep -x 'waybar|\.waybar-wrapped' >/dev/null 2>&1; then
        _WAYBAR_WAS_VISIBLE=true
        "$HOME/.local/bin/dock-procs" waybar signal "$mon" USR1 >/dev/null 2>&1 &
    fi
    if pgrep -x 'rust-dock|\.rust-dock-wrap|\.rust-dock-wrapped' >/dev/null 2>&1; then
        "$HOME/.local/bin/dock-procs" rust-dock signal "$mon" USR1 >/dev/null 2>&1 &
    fi
}

# Restaurar barras en paralelo al cerrar rofi
show_active_bars() {
    local mon="$ACTIVE_MONITOR"
    [ -n "$mon" ] || return 0
    if [ "$_QUICKSHELL_WAS_VISIBLE" = true ]; then
        quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island reveal "$mon" >/dev/null 2>&1 &
    fi
    if [ "$_RUST_DOCK_WAS_VISIBLE" = true ]; then
        quickshell ipc -p "$HOME/.config/quickshell/dock/shell.qml" --any-display call dock reveal "$mon" >/dev/null 2>&1 &
        if pgrep -x 'rust-dock|\.rust-dock-wrap|\.rust-dock-wrapped' >/dev/null 2>&1; then
            "$HOME/.local/bin/dock-procs" rust-dock signal "$mon" USR2 >/dev/null 2>&1 &
        fi
    fi
    if [ "$_WAYBAR_WAS_VISIBLE" = true ]; then
        "$HOME/.local/bin/dock-procs" waybar signal "$mon" USR2 >/dev/null 2>&1 &
    fi
}

# Función de cleanup al salir
cleanup() {
    trap - EXIT INT TERM
    log_debug "Ejecutando cleanup..."
    show_active_bars
    exit 0
}

# Configurar trap para cleanup
trap cleanup EXIT INT TERM

# Crear directorio de cache si no existe
mkdir -p "$(dirname "$LOG_FILE")"

log_debug "=== Iniciando rofi-style3-monitor-adaptive ==="
log_debug "DISPLAY: $DISPLAY"
log_debug "WAYLAND_DISPLAY: $WAYLAND_DISPLAY"

# Detectar monitor activo
ACTIVE_MONITOR=$(get_active_monitor)
log_debug "Monitor activo detectado: $ACTIVE_MONITOR"

# Sincronizar los colores de rofi con pywal ANTES de elegir tema.
#
# ORDEN, QUE ANTES ESTABA INVERTIDO Y NO TENIA SENTIDO: esto se llamaba dentro
# de launch_rofi, es decir DESPUES de que select_best_theme hubiera elegido. Y
# el unico generador de style-3-pywal.rasi es sync-rofi-pywal, que es
# justamente a quien se llama aqui. O sea que la condicion de la prioridad 1
#
#     -f colors-pywal.rasi && -f style-3-pywal.rasi
#
# no se podia cumplir nunca la primera vez: el script exigia un fichero que el
# unico sitio que lo creaba se dejaba para despues. En una maquina nueva,
# SUPER+A moria con "No se encontraron temas de rofi disponibles" y no habia
# forma de generar el tema con el propio atajo que lo necesita.
# Solo regenerar colores/tema si faltan o si pywal cambió (0ms cuando ya están al día)
sync_rofi_colors() {
    local c_file="$HOME/.config/rofi/colors-pywal.rasi"
    local t_file="$HOME/.config/rofi/style-3-pywal.rasi"
    local w_file="$HOME/.cache/wal/colors.sh"
    if [ -f "$c_file" ] && [ -f "$t_file" ]; then
        if [ ! -f "$w_file" ] || { [ "$c_file" -nt "$w_file" ] && [ "$t_file" -nt "$w_file" ]; }; then
            return 0
        fi
    fi
    if [[ -x "$HOME/.local/bin/sync-rofi-pywal" ]]; then
        "$HOME/.local/bin/sync-rofi-pywal" > /dev/null 2>&1
        return 0
    fi
    return 1
}

sync_rofi_colors

# Función para seleccionar el mejor tema disponible
select_best_theme() {
    local monitor="$1"
    local theme_file=""
    
    # PRIORIDAD 1: Tema pywal si está disponible y colores han sido generados
    if [[ -f "$HOME/.config/rofi/colors-pywal.rasi" ]] && [[ -f "$HOME/.config/rofi/style-3-pywal.rasi" ]]; then
        theme_file="$HOME/.config/rofi/style-3-pywal.rasi"
        log_debug "Usando tema con colores pywal: $theme_file"
        echo "$theme_file"
        return
    fi
    
    # PRIORIDAD 2: Tema específico para el monitor con pywal
    if [[ -f "$HOME/.config/rofi/colors-pywal.rasi" ]] && [[ -f "$HOME/.config/rofi/style-3-pywal-${monitor}.rasi" ]]; then
        theme_file="$HOME/.config/rofi/style-3-pywal-${monitor}.rasi"
        log_debug "Usando tema pywal específico para monitor $monitor: $theme_file"
        echo "$theme_file"
        return
    fi
    
    # PRIORIDAD 3: Tema base en Downloads
    if [[ -f "$HOME/Downloads/style-3.rasi" ]]; then
        theme_file="$HOME/Downloads/style-3.rasi"
        log_debug "Usando tema base desde Downloads: $theme_file"
        echo "$theme_file"
        return
    fi
    
    # PRIORIDAD 4: Tema en cache si existe
    if [[ -f "$HOME/.cache/rofi-style3-themes/style-3-powermenu-fonts.rasi" ]]; then
        theme_file="$HOME/.cache/rofi-style3-themes/style-3-powermenu-fonts.rasi"
        log_debug "Usando tema en cache: $theme_file"
        echo "$theme_file"
        return
    fi
    
    # Si no encontramos ningún tema
    log_debug "ERROR: No se encontró ningún tema disponible"
    echo ""
}

# Seleccionar el mejor tema disponible
BASE_STYLE=$(select_best_theme "$ACTIVE_MONITOR")

if [[ -z "$BASE_STYLE" ]]; then
    log_debug "ERROR: No se encontró ningún tema disponible"
    notify-send "Error" "No rofi themes found" -u critical
    exit 1
fi

log_debug "Tema seleccionado: $BASE_STYLE"

# Crear directorio temporal para el tema adaptado
TEMP_DIR="$HOME/.cache/rofi-style3-themes"
mkdir -p "$TEMP_DIR"

# Determinar si necesitamos crear una versión adaptada
if [[ "$BASE_STYLE" == *"-pywal.rasi" ]]; then
    # Ya es un tema pywal, usar directamente
    ADAPTED_STYLE="$BASE_STYLE"
    log_debug "Usando tema pywal directamente: $ADAPTED_STYLE"
else
    # Crear versión del tema con fuentes del powermenu
    ADAPTED_STYLE="${TEMP_DIR}/style-3-powermenu-fonts.rasi"
    
    log_debug "Creando versión adaptada con fuentes del powermenu: $ADAPTED_STYLE"
    
    # Copiar el archivo original y modificar solo las fuentes
    cp "$BASE_STYLE" "$ADAPTED_STYLE"
    
    # Reemplazar las fuentes con versiones más gruesas y anchas
    sed -i 's/"JetBrainsMono Nerd Font 16"/"JetBrainsMono Nerd Font ExtraBold 18"/g' "$ADAPTED_STYLE"
    sed -i 's/"JetBrainsMono Nerd Font 15"/"JetBrainsMono Nerd Font ExtraBold 17"/g' "$ADAPTED_STYLE"
    
    # Si hay colores pywal disponibles, añadir importación
    if [[ -f "$HOME/.config/rofi/colors-pywal.rasi" ]] && ! grep -q '@import "colors-pywal.rasi"' "$ADAPTED_STYLE"; then
        # Crear archivo temporal con la importación
        local temp_file="$(mktemp)"
        echo '@import "colors-pywal.rasi"' > "$temp_file"
        echo '' >> "$temp_file"
        cat "$ADAPTED_STYLE" >> "$temp_file"
        mv "$temp_file" "$ADAPTED_STYLE"
        
        log_debug "Importación de colores pywal añadida al tema adaptado"
    fi
    
    log_debug "Fuentes actualizadas en el tema adaptado"
fi

# NUEVA FUNCIÓN: Sincronizar automáticamente colores de rofi con pywal
# (sync_rofi_colors se define y se llama ANTES de select_best_theme, mas arriba.)

# Función principal para lanzar rofi
launch_rofi() {
    hide_active_bars
    
    # Lanzar rofi de inmediato con el tema adaptado
    local _t0 _rc _dt
    printf -v _t0 '%(%s)T' -1
    rofi-themed -show drun \
         -theme "$ADAPTED_STYLE" \
         -m "$ACTIVE_MONITOR" >>"$LOG_FILE" 2>&1
    _rc=$?
    local _t1
    printf -v _t1 '%(%s)T' -1
    _dt=$(( _t1 - _t0 ))
    # rc=0 (seleccion) y rc=1 (Esc/cancelar) y 130/143 (SIGINT/SIGTERM) son salidas normales
    if [ "$_dt" -lt 2 ] && [ "$_rc" -gt 1 ] && [ "$_rc" -lt 128 ]; then
        log_debug "Cierre anomalo (exit=$_rc): reintento con tema por defecto."
        notify-send "Rofi" "Theme $ADAPTED_STYLE failed (exit $_rc), retrying..." 2>/dev/null || true
        rofi-themed -show drun -m "$ACTIVE_MONITOR" >>"$LOG_FILE" 2>&1
    fi
}

# Ejecutar rofi
launch_rofi

log_debug "=== Finalizando rofi-style3-monitor-adaptive ==="

# Al salir del script, el trap ejecutará cleanup automáticamente

#!/bin/sh
# Configuración rápida y atómica de monitores para SDDM

# Obtener query de xrandr rápidamente (máximo 2 reintentos de 50ms)
XR_OUT=""
for _ in 1 2 3; do
    XR_OUT=$(xrandr --query 2>/dev/null)
    if printf '%s\n' "$XR_OUT" | grep -q "connected"; then
        break
    fi
    sleep 0.05
done

if [ -z "$XR_OUT" ]; then
    xrandr --auto 2>/dev/null || true
    exit 0
fi

# Detect outputs that are connected AND expose at least one usable mode.
# Some hybrid-GPU setups report phantom outputs as connected but with no modes
# (e.g. DP-1-0 on the SDDM Xorg seat). Passing those to xrandr --auto makes the
# entire multi-output command fail and can leave the greeter without a display.
CONNECTED=$(printf '%s\n' "$XR_OUT" | awk '
    function flush_output() {
        if (name != "" && has_mode) print name
    }
    $2 == "connected" {
        flush_output()
        name = $1
        has_mode = ($0 ~ /[0-9]+x[0-9]+/)
        next
    }
    name != "" && /^[[:space:]]+[0-9]+x[0-9]+/ { has_mode = 1; next }
    name != "" && !/^[[:space:]]/ { flush_output(); name = ""; has_mode = 0 }
    END { flush_output() }
')
if [ -z "$CONNECTED" ]; then
    xrandr --auto 2>/dev/null || true
    exit 0
fi

EXTERNALS=$(printf '%s\n' "$CONNECTED" | grep -vE '^(eDP|LVDS)' || true)
INTERNAL=$(printf '%s\n' "$CONNECTED" | grep -E '^(eDP|LVDS)' || true)

get_width() {
    printf '%s\n' "$XR_OUT" | awk -v m="$1" '
        $1 == m && /connected/ { f=1; next }
        f && /^[[:space:]]+[0-9]+x/ { split($1,a,"x"); print a[1]; exit }
        f && !/^[[:space:]]/ { exit }
    '
}

X=0
FIRST=true
CMD="xrandr"

for mon in $EXTERNALS; do
    W=$(get_width "$mon")
    [ -z "$W" ] && W=1920
    if [ "$FIRST" = true ]; then
        CMD="$CMD --output $mon --auto --pos ${X}x0 --primary"
        FIRST=false
    else
        CMD="$CMD --output $mon --auto --pos ${X}x0"
    fi
    X=$((X + W))
done

for mon in $INTERNAL; do
    W=$(get_width "$mon")
    [ -z "$W" ] && W=1920
    if [ "$FIRST" = true ]; then
        CMD="$CMD --output $mon --auto --pos ${X}x0 --primary"
        FIRST=false
    else
        CMD="$CMD --output $mon --auto --pos ${X}x0"
    fi
    X=$((X + W))
done

eval "$CMD" 2>/dev/null || xrandr --auto 2>/dev/null || true

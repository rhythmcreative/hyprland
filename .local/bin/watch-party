#!/bin/bash
# watch-party: synchronized watch parties on Linux (Kast alternative).
# No args -> opens Syncplay GUI (pick file, room and server like Kast).
# With args: watch-party <room> [server] [media-file] -> joins directly with mpv.
set -uo pipefail

if [ $# -eq 0 ]; then
    exec syncplay --player-path /usr/bin/mpv 2>/dev/null || exec syncplay
fi

ROOM="$1"
SERVER="${2:-syncplay.pl:8999}"
MEDIA="${3:-}"
USERNAME="${USER:-watcher}"
ARGS=(--host "$SERVER" --room "$ROOM" --name "$USERNAME" --player-path /usr/bin/mpv)
[ -n "$MEDIA" ] && ARGS+=("$MEDIA")
exec syncplay "${ARGS[@]}"

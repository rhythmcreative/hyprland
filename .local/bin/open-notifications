#!/bin/bash
# Open the Dynamic Island notification center directly.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    [ -n "$WL_DISP" ] && export WAYLAND_DISPLAY=$(basename "$WL_DISP") || export WAYLAND_DISPLAY="wayland-1"
fi
ACTIVE_MON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
[ -n "$ACTIVE_MON" ] || ACTIVE_MON="eDP-1"
quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island openNotifications "$ACTIVE_MON" >/dev/null 2>&1

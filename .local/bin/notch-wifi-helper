#!/usr/bin/env python3
import sys
import subprocess
import json
import re

def get_saved_wifi_profiles():
    # Return saved Wi-Fi SSID/NAME -> UUID mappings from NetworkManager.
    profiles = {}
    try:
        out = subprocess.check_output(
            ['nmcli', '-t', '-f', 'UUID,TYPE,NAME', 'connection', 'show'],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in out.splitlines():
            parts = line.split(':')
            if len(parts) >= 3 and parts[1] == '802-11-wireless' and parts[0]:
                uuid = parts[0].strip()
                name = parts[2].replace(r'\:', ':').strip()
                if name and uuid:
                    profiles.setdefault(name, uuid)
    except Exception:
        pass
    return profiles


def is_enterprise_security(sec):
    s = (sec or '').upper()
    return any(k in s for k in ['802.1X', 'ENTERPRISE', 'EAP'])

def get_wifi_list(rescan=False):
    saved_profiles = get_saved_wifi_profiles()
    try:
        args = ['nmcli', '-t', '-f', 'IN-USE,SSID,SECURITY,BARS,SIGNAL', 'device', 'wifi', 'list']
        if not rescan:
            args.extend(['--rescan', 'no'])
        out = subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL)
        networks = []
        seen = set()
        for line in out.strip().split('\n'):
            if not line:
                continue
            parts = re.split(r'(?<!\\):', line)
            if len(parts) < 5:
                continue
            in_use = parts[0].strip() == '*'
            ssid = parts[1].replace(r'\:', ':').strip()
            if not ssid:
                continue
            # Deduplicate by SSID, preferring connected or strongest signal
            if ssid in seen:
                continue
            seen.add(ssid)
            sec = parts[2].replace(r'\:', ':').strip() or 'Open'
            bars = parts[3].strip()
            try:
                signal = int(parts[4].strip())
            except ValueError:
                signal = 0

            networks.append({
                'ssid': ssid,
                'connected': in_use,
                'security': sec,
                'bars': bars,
                'signal': signal,
                'saved': ssid in saved_profiles,
                'is_enterprise': is_enterprise_security(sec)
            })
        # Sort connected first, then by signal descending
        networks.sort(key=lambda x: (not x['connected'], -x['signal']))
        return networks
    except Exception as e:
        return []

def connect_enterprise(ssid, identity, password, anon_identity=None):
    try:
        # If anonymous identity is not explicitly given and identity is an email/realm (e.g. user@domain.edu),
        # eduroam and 802.1X standards require outer identity as anonymous@domain.edu for RADIUS proxy routing.
        if not anon_identity and '@' in identity:
            realm = identity.split('@', 1)[1].strip()
            if realm:
                anon_identity = f'anonymous@{realm}'

        enterprise_params = [
            'wifi-sec.key-mgmt', 'wpa-eap',
            '802-1x.eap', 'peap',
            '802-1x.phase2-auth', 'mschapv2',
            '802-1x.identity', identity,
            '802-1x.password', password,
            '802-1x.password-flags', '0',
            '802-11-wireless.cloned-mac-address', 'stable',
            '802-11-wireless.powersave', '2',
            'connection.autoconnect', 'yes',
            'connection.autoconnect-retries', '0'
        ]
        if anon_identity:
            enterprise_params.extend(['802-1x.anonymous-identity', anon_identity])

        saved_uuid = get_saved_wifi_profiles().get(ssid)
        if saved_uuid:
            mod_args = ['nmcli', 'connection', 'modify', saved_uuid] + enterprise_params
            subprocess.run(mod_args, check=True, capture_output=True, text=True, timeout=10)
            call_args = ['nmcli', 'connection', 'up', 'uuid', saved_uuid]
        else:
            add_args = [
                'nmcli', 'connection', 'add',
                'type', 'wifi',
                'con-name', ssid,
                'ssid', ssid
            ] + enterprise_params
            subprocess.run(add_args, check=True, capture_output=True, text=True, timeout=10)
            call_args = ['nmcli', 'connection', 'up', ssid]

        res = subprocess.run(call_args, capture_output=True, text=True, timeout=25)
        if res.returncode == 0:
            print(json.dumps({'status': 'ok', 'message': res.stdout.strip()}))
        else:
            print(json.dumps({'status': 'error', 'message': res.stderr.strip() or res.stdout.strip()}))
    except subprocess.CalledProcessError as e:
        err_msg = e.stderr.strip() if e.stderr else str(e)
        print(json.dumps({'status': 'error', 'message': err_msg}))
    except Exception as e:
        print(json.dumps({'status': 'error', 'message': str(e)}))

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'list'

    if cmd == 'list':
        print(json.dumps(get_wifi_list()))
    elif cmd == 'rescan':
        try:
            subprocess.run(['nmcli', 'device', 'wifi', 'rescan'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
        except Exception:
            pass
        print(json.dumps(get_wifi_list()))
    elif cmd == 'toggle':
        try:
            state = subprocess.check_output(['nmcli', '-fields', 'WIFI', 'g'], text=True).strip().split()[-1]
            new_state = 'off' if 'enabled' in state else 'on'
            subprocess.run(['nmcli', 'radio', 'wifi', new_state], check=True)
            print(json.dumps({'status': 'ok', 'enabled': new_state == 'on'}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    elif cmd == 'connect':
        if len(sys.argv) < 3:
            print(json.dumps({'status': 'error', 'message': 'Missing SSID'}))
            sys.exit(1)
        ssid = sys.argv[2]
        if len(sys.argv) >= 5:
            # Invoked as: connect <ssid> <identity> <password> [anonymous_identity]
            identity = sys.argv[3]
            password = sys.argv[4]
            anon_identity = sys.argv[5] if len(sys.argv) > 5 else None
            connect_enterprise(ssid, identity, password, anon_identity)
            return

        password = sys.argv[3] if len(sys.argv) > 3 else None
        try:
            saved_uuid = get_saved_wifi_profiles().get(ssid)
            if saved_uuid and not password:
                # Reuse NetworkManager's saved profile and secret; ensure stability flags are applied
                try:
                    subprocess.run(
                        ['nmcli', 'connection', 'modify', saved_uuid,
                         '802-11-wireless.cloned-mac-address', 'stable',
                         '802-11-wireless.powersave', '2',
                         'connection.autoconnect-retries', '0'],
                        capture_output=True, text=True, timeout=3
                    )
                except Exception:
                    pass
                call_args = ['nmcli', 'connection', 'up', 'uuid', saved_uuid]
            else:
                call_args = ['nmcli', 'dev', 'wifi', 'connect', ssid]
                if password:
                    call_args.extend(['password', password])
            res = subprocess.run(call_args, capture_output=True, text=True, timeout=20)
            if res.returncode == 0:
                print(json.dumps({'status': 'ok', 'message': res.stdout.strip()}))
            else:
                print(json.dumps({'status': 'error', 'message': res.stderr.strip() or res.stdout.strip()}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    elif cmd == 'connect-enterprise':
        if len(sys.argv) < 5:
            print(json.dumps({'status': 'error', 'message': 'Missing SSID, identity, or password'}))
            sys.exit(1)
        ssid = sys.argv[2]
        identity = sys.argv[3]
        password = sys.argv[4]
        anon_identity = sys.argv[5] if len(sys.argv) > 5 else None
        connect_enterprise(ssid, identity, password, anon_identity)
    elif cmd == 'check-portal':
        status = "unknown"
        try:
            res = subprocess.check_output(['nmcli', 'networking', 'connectivity', 'check'], text=True, timeout=3).strip()
            status = res
        except Exception:
            pass

        portal_url = None
        is_captive = False

        if status in ['portal', 'limited', 'unknown']:
            import urllib.request
            endpoints = [
                "http://connectivitycheck.gstatic.com/generate_204",
                "http://detectportal.firefox.com/canonical.html",
                "http://clients3.google.com/generate_204"
            ]

            class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
                def redirect_request(self, req, fp, code, msg, headers, newurl):
                    nonlocal portal_url
                    portal_url = newurl
                    return None

            opener = urllib.request.build_opener(NoRedirectHandler)
            for ep in endpoints:
                try:
                    req = urllib.request.Request(ep, headers={'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64)'})
                    resp = opener.open(req, timeout=3)
                    if resp.getcode() not in [200, 204]:
                        is_captive = True
                        break
                except urllib.error.HTTPError as e:
                    if e.code in [301, 302, 307, 308]:
                        is_captive = True
                        portal_url = e.headers.get('Location', portal_url)
                        break
                except Exception:
                    pass

        if status == 'portal':
            is_captive = True

        print(json.dumps({
            'status': status,
            'is_captive': is_captive,
            'portal_url': portal_url or "http://connectivitycheck.gstatic.com/generate_204"
        }))
    elif cmd == 'open-portal':
        target_url = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else "http://connectivitycheck.gstatic.com/generate_204"
        try:
            subprocess.Popen(['xdg-open', target_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(json.dumps({'status': 'ok', 'url': target_url}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    elif cmd == 'disconnect':
        try:
            # Find active wifi interface
            out = subprocess.check_output(['nmcli', '-t', '-f', 'DEVICE,TYPE,STATE', 'dev'], text=True)
            for line in out.strip().split('\n'):
                parts = re.split(r'(?<!\\):', line)
                if len(parts) >= 3 and parts[1].replace(r'\:', ':') == 'wifi' and parts[2].replace(r'\:', ':') == 'connected':
                    subprocess.run(['nmcli', 'device', 'disconnect', parts[0].replace(r'\:', ':')], check=True)
                    break
            print(json.dumps({'status': 'ok'}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))
    else:
        print(json.dumps({'status': 'unknown_command'}))

if __name__ == '__main__':
    main()

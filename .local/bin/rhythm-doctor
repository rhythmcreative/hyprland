#!/usr/bin/env bash
# rhythm-doctor: reconciliador idempotente del estado que el despliegue no
# puede expresar en ficheros.
#
# El despliegue (install.sh / system-ota update) solo llega a ~/.config y
# ~/.local/bin. Hay cosas que salen de ahi y por tanto nunca convergen: un
# update las arregla en el repo y el usuario no las recibe nunca. Este guion es
# la red de seguridad para eso.
#
# Idempotente: se puede ejecutar en cada update, y tambien a mano, sin miedo.
# Cada comprobacion mira el estado real contra la copia que envia el repo y
# re-pone solo lo que difiere.
#
#   rhythm-doctor            revisa e informa
#   rhythm-doctor --fix      revisa y corrige lo corregible
#   rhythm-doctor --verify   solo verifica, nunca escribe (para CI)

set -uo pipefail

MODE="${1:-check}"
case "$MODE" in
    --verify) MODE=verify ;;
    --fix)    MODE=fix ;;
    check|--check|"") MODE=check ;;
esac

# Repo de los dotfiles: misma resolucion que system-ota.
REPO_DIR="${RHYTHM_DOTFILES_DIR:-$HOME/hyprland}"
if [ ! -d "$REPO_DIR/.git" ]; then
    _self=$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$_self" ] && REPO_DIR="$_self"
fi

PROBLEMS=0
FIXED=0
DRY="" [ "$MODE" = "fix" ] || DRY="echo would"

IS_NIXOS=0
if [ -e /etc/NIXOS ] || { [ -f /etc/os-release ] && grep -q '^ID=nixos' /etc/os-release; }; then
    IS_NIXOS=1
fi

ok()   { printf '  \033[32mok\033[0m    %s\n' "$1"; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; PROBLEMS=$((PROBLEMS+1)); }
fixed(){ printf '  \033[32mfixed\033[0m %s\n' "$1"; FIXED=$((FIXED+1)); }
note() { printf '        %s\n' "$1"; }

echo "rhythm-doctor: $MODE (repo: $REPO_DIR)"

if [ ! -d "$REPO_DIR" ]; then
    echo "  can't find the dotfiles repo at $REPO_DIR" >&2
    exit 1
fi

# ────────────────────────────────────────────────────────────────────────────
# 1. /etc/sddm.conf.d/xsetup.conf
#
# Es lo unico que se instala FUERA de ~/.config, en un directorio de root, y
# se hace una sola vez. Una correccion en sddm/Xsetup llega al repo pero no a
# ninguna maquina que ya habia instalado, que es el fallo clasico de un
# install-once: fija cada maquina en el release con el que se instalo.
# ────────────────────────────────────────────────────────────────────────────
check_xsetup() {
    if [ "$IS_NIXOS" -eq 1 ]; then
        ok "SDDM managed declaratively via NixOS module (modules/nixos/sddm.nix)"
        return
    fi
    if ! command -v sddm >/dev/null 2>&1; then
        note "sddm is not installed; skipping Xsetup check"
        return
    fi
    # Ojo con las rutas: /etc/sddm.conf.d/xsetup.conf esta DESHABILITADO a
    # proposito (el login es Wayland, asi que Xsetup no debe correr), y el
    # script de verdad va a /etc/sddm/Xsetup. Mirar el otro path daria un FAIL
    # falso en una maquina perfectamente bien.
    local shipped="$REPO_DIR/sddm/Xsetup"
    local live="/etc/sddm/Xsetup"

    if [ ! -f "$shipped" ]; then
        warn "sddm/Xsetup is not in the repo, nothing to verify"
        return
    fi
    if [ ! -e "$live" ]; then
        bad "/etc/sddm/Xsetup does not exist"
        note "it is copied in the installer's SDDM step; if the greeter works, it isn't needed"
        return
    fi
    if diff -q "$shipped" "$live" >/dev/null 2>&1; then
        ok "/etc/sddm/Xsetup is up to date"
    else
        bad "/etc/sddm/Xsetup is out of date (the repo moved it in updates)"
    fi

    # El .disabled tiene que seguir desactivado: si alguien lo rehabilita sin
    # querer, el greeter intenta arrancar X11 en una sesion Wayland.
    if [ -e /etc/sddm.conf.d/xsetup.conf.disabled ]; then
        ok "xsetup.conf.disabled is present (X11 stays off, correct)"
    else
        note "no xsetup.conf.disabled; if the login is Wayland it should exist"
    fi
}

# ────────────────────────────────────────────────────────────────────────────
# 2. Verificacion de entrega
#
# Lo que el repo despliega tiene que existir en la maquina. Si algo no llega,
# es que hay un config que nadie recibe, y eso no se nota hasta que un usuario
# pregunta por una tecla que no hace nada.
# ────────────────────────────────────────────────────────────────────────────
check_delivery() {
    if [ "$IS_NIXOS" -eq 1 ]; then
        local missing=0
        for b in rhythm quickshell-island wallpaper-backend powermenu-with-monitor-detection system-ota; do
            if [ ! -x "$HOME/.local/bin/$b" ] && ! command -v "$b" >/dev/null 2>&1; then
                bad "helper not on PATH or in ~/.local/bin: $b"
                missing=$((missing+1))
            fi
        done
        [ "$missing" -eq 0 ] && ok "NixOS helpers and user environment are present"
        return
    fi
    local missing=0

    # Unidades de usuario: cada ExecStart tiene que existir y ser ejecutable.
    for u in "$REPO_DIR"/.config/systemd/user/*.service; do
        [ -f "$u" ] || continue
        local name unit
        name=$(basename "$u")
        unit="$HOME/.config/systemd/user/$name"
        if [ ! -f "$unit" ]; then
            bad "unit not deployed: $name"
            missing=$((missing+1))
            continue
        fi
        # El ExecStart del repo, con %h resuelto.
        local exe
        exe=$(grep -m1 '^ExecStart=' "$u" | sed 's/^ExecStart=//; s/^-\?//' | awk '{print $1}' | sed "s|%h|$HOME|g")
        case "$exe" in
            /*) ;;
            *) continue ;;
        esac
        if [ ! -x "$exe" ]; then
            bad "$name points at something not executable: $exe"
            missing=$((missing+1))
        fi
    done

    if [ "$missing" -eq 0 ]; then
        ok "all deployed units point at real executables"
    fi

    # Scripts de ~/.local/bin referenciados por las unidades.
    for b in "$REPO_DIR"/.local/bin/*; do
        [ -f "$b" ] || continue
        local base
        base=$(basename "$b")
        # Solo los que la unit ejecuta; el resto se copia igual.
        grep -rqs "$base" "$REPO_DIR"/.config/systemd/user/ || continue
        if [ ! -x "$HOME/.local/bin/$base" ]; then
            bad "script not deployed or not executable: $base"
            missing=$((missing+1))
        fi
    done
    [ "$missing" -eq 0 ] && ok "scripts referenced by the units are present"
}

# ────────────────────────────────────────────────────────────────────────────
# 3. Estado legible que el despliegue no debe pisar
#
# Ryoku llama a esto "nunca escribas en una ruta que las herramientas del
# usuario escriben". El repo manda .config/rhythm/ para la isla; si el estado
# mutable viviera ahi, un update podria pisarlo.
# ────────────────────────────────────────────────────────────────────────────
check_state_separation() {
    local conf="$HOME/.config/rhythm/battery-limit.conf"
    # XDG_STATE_HOME puede no existir, y con `set -u` referring a el sin
    # guarding es un fallo antes de empezar.
    local state="${XDG_STATE_HOME:-$HOME/.local/state}/rhythm/battery-limit.conf"

    if [ -f "$conf" ] && [ ! -f "$state" ]; then
        bad "battery-limit.conf is still in ~/.config (state in a place the update overwrites)"
        note "it migrates by itself when a new limit is applied, or by hand:"
        note "  mkdir -p \$(dirname $state) && mv $conf $state"
    elif [ -f "$state" ]; then
        ok "battery-limit.conf in ~/.local/state"
    else
        note "no battery limit set (normal if none was ever chosen)"
    fi
}

# ────────────────────────────────────────────────────────────────────────────
# 4. Conf que el usuario haya editado y el update va a pisar
#
# Detecta los ficheros de ~/.config que difieren del repo. No es un fallo: es
# informacion, porque con el overlay de user_edits estos se conservan, y sin
# el overlay hay que saber cuales son antes del update.
# ────────────────────────────────────────────────────────────────────────────
check_local_edits() {
    local diverged=0
    for f in "$REPO_DIR"/.config/hypr/*.conf; do
        [ -f "$f" ] || continue
        local rel live
        rel=".config/hypr/$(basename "$f")"
        live="$HOME/$rel"
        [ -f "$live" ] || continue
        if ! diff -q "$f" "$live" >/dev/null 2>&1; then
            diverged=$((diverged+1))
            warn "$rel was edited by hand (the update will take it from the repo)"
        fi
    done
    [ "$diverged" -eq 0 ] && ok "no local edits in .config/hypr"
}

# El greeter de SDDM vive en /usr y /etc, que el update NO sincroniza (solo
# ~/.config y ~/.local/bin). Sin esta comprobacion, un despliegue a medias
# pasava desapercibido: el sddm.conf del sistema apuntando al start-hyprland de
# siempre, sin envoltorio y sin cursor, mientras el repo ya traia la
# plantilla nueva.
check_greeter() {
    if [ "$IS_NIXOS" -eq 1 ]; then
        ok "SDDM greeter configured declaratively via NixOS module"
        return
    fi
    if ! command -v sddm >/dev/null 2>&1; then
        note "sddm is not installed on this system; skipping greeter check"
        return
    fi
    if command -v systemctl >/dev/null 2>&1; then
        if ! systemctl is-enabled --quiet sddm 2>/dev/null && { systemctl is-enabled --quiet gdm 2>/dev/null || systemctl is-enabled --quiet lightdm 2>/dev/null; }; then
            note "another display manager is active; skipping SDDM greeter check"
            return
        fi
    fi
    if [ ! -x "$HOME/.local/bin/rhythm-sddm-deploy" ]; then
        bad "rhythm-sddm-deploy is not in ~/.local/bin; the greeter can't be deployed"
        return
    fi
    local out
    out=$("$HOME/.local/bin/rhythm-sddm-deploy" --check 2>&1)
    local rc=$?
    echo "$out" | sed 's/^/  /'
    if [ "$rc" -ne 0 ]; then
        warn "the SDDM greeter doesn't match the repo: sudo ~/.local/bin/rhythm-sddm-deploy"
    fi
}

# ────────────────────────────────────────────────────────────────────────────
# 5. Estado en vivo: lo desplegado tambien tiene que estar corriendo
#
# Todo lo anterior mira ficheros. Un servicio habilitado pero muerto, la isla
# sin capa o el fondo sin pintar no salen en ningun fichero, asi que el
# instalador los daba por buenos. Estas comprobaciones solo corren con
# compositor delante; instalado desde TTY se saltan con una nota, porque ahi
# todavia no hay nada que pueda estar vivo.
# ────────────────────────────────────────────────────────────────────────────
check_runtime() {
    # Sin compositor no hay nada vivo que comprobar. El instalador corre a
    # menudo desde TTY, y fallar ahi seria ruido, no senal.
    if ! hyprctl monitors >/dev/null 2>&1; then
        note "no compositor running (normal during install); live checks skipped"
        return
    fi

    for u in waybar-island.service wallpaper-monitor-watcher.service; do
        if systemctl --user is-active --quiet "$u" 2>/dev/null; then
            ok "$u is running"
        elif [ "$u" = "waybar-island.service" ] && "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
            ok "$u is running (process active)"
        elif [ "$u" = "wallpaper-monitor-watcher.service" ] && pgrep -f "wallpaper-monitor-watcher" >/dev/null 2>&1; then
            ok "$u is running (process active)"
        else
            bad "$u is not running"
        fi
    done

    if hyprctl layers 2>/dev/null | grep -q "namespace: quickshell"; then
        ok "the island has a compositor layer"
    else
        bad "quickshell is running but has no layer (the island is invisible)"
    fi

    if [ -x "$HOME/.local/bin/background-health" ]; then
        if [ -z "$("$HOME/.local/bin/background-health" 2>/dev/null)" ]; then
            ok "wallpaper painted on every monitor"
        else
            bad "a monitor is missing its wallpaper"
        fi
    fi

    if pgrep -x hypridle >/dev/null 2>&1; then
        ok "hypridle is watching for idle time"
    else
        bad "hypridle is not running (no locking, no screen off)"
    fi

    if systemctl is-enabled --quiet sddm 2>/dev/null \
        || systemctl is-enabled --quiet display-manager 2>/dev/null \
        || systemctl is-enabled --quiet gdm 2>/dev/null \
        || systemctl is-enabled --quiet lightdm 2>/dev/null \
        || systemctl is-enabled --quiet greetd 2>/dev/null; then
        ok "display manager starts at boot"
    elif [ -x /sbin/openrc ] && (rc-status default 2>/dev/null | grep -qE "sddm|display-manager|lightdm|greetd"); then
        ok "display manager starts at boot"
    else
        bad "no display manager is enabled (no login screen after reboot)"
    fi
}

echo
check_xsetup
check_delivery
check_greeter
check_state_separation
check_local_edits
check_runtime

echo
if [ "$PROBLEMS" -eq 0 ]; then
    if [ "$FIXED" -gt 0 ]; then
        echo "doctor: $FIXED fixed, nothing pending."
    else
        echo "doctor: everything correct."
    fi
    exit 0
else
    echo "doctor: $PROBLEMS problem(s).$([ "$MODE" = "fix" ] && echo " Fix the ones marked FAIL." || echo " Use --fix for the fixable ones.")"
    exit 1
fi
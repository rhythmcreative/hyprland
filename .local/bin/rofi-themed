#!/bin/bash
# Envoltorio de rofi: le añade el fondo translúcido común y, con el ahorro de
# energía activo, el macizo por encima.
#
# Existe porque cada menú se ponyía el fondo por su cuenta y se le olvidaba a la
# mitad. Estos dos atajos se llegaron a arreglar tres veces distintas y en las
# tres había un menú más sin tocar:
#
#     SUPER + A            -> rofi-style3-monitor-adaptive
#     SUPER + SHIFT + W    -> wallpaper-selector        <- no wallpaper-changer
#     SUPER + ALT + W      -> wallpaper-changer-with-waybar-sync
#
# Con el envoltorio los menus no tienen que acordarse de nada: se lanzan igual
# que siempre y el fondo sale bien.
#
# Se añaden al final porque rofi fusiona los -theme-str en orden y gana el
# último, así que el macizo tiene que ir después del translúcido.
#
# -theme-str y no un segundo -theme: rofi ignora un segundo fichero de tema y se
# queda con el primero. Y van como array porque el css tiene espacios; metido en
# una cadena sin entrecomillar se parte en montones de argumentos sueltos.

# Los ficheros de fondo se dejan al dia antes de leerlos. Antes cada uno los
# escribia su propio script y cambiaban en momentos distintos: tras cambiar el
# fondo, el translucido seguia con el color viejo hasta que se abria el menu
# principal, y el macizo se quedaba con el del fondo anterior hasta que se
# togglaba el ahorro. Aqui se regeneran siempre, y rofi-colors solo escribe si
# el contenido cambia.
"$HOME/.local/bin/rofi-colors" 2>/dev/null || true

args=("$@")

comun="$HOME/.config/rofi/colors-window.rasi"
macizo="$HOME/.config/rofi/colors-powersave.rasi"

if [ -f "$comun" ]; then
    args+=(-theme-str "$(cat "$comun")")
fi
if [ -f /tmp/powersave-active ] && [ -f "$macizo" ]; then
    args+=(-theme-str "$(cat "$macizo")")
fi

exec rofi "${args[@]}"

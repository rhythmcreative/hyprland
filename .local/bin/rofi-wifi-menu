#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"

# Menu interactivo de Wi-Fi para Rofi y Hyprland
# Tema y colores sincronizados con Pywal

THEME_FILE="$HOME/.config/rofi/settings.rasi"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Prefer opening on the focused monitor's Dynamic Island
ACTIVE_MON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
[ -n "$ACTIVE_MON" ] || ACTIVE_MON="eDP-1"
if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
    quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call settings open_wifi "$ACTIVE_MON" >/dev/null 2>&1
    exit 0
fi

get_active_monitor() {
    local mon=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
    [ -n "$mon" ] && [ "$mon" != "null" ] && echo "$mon" && return
    echo "eDP-1"
}
ACTIVE_MON=$(get_active_monitor)

# Hide Waybar, Rust-Dock and Quickshell while Rofi is open (ONLY on active monitor)
if [ -z "$_BARS_HIDDEN" ] && [ -n "$ACTIVE_MON" ]; then
    export _BARS_HIDDEN=1
    if "$HOME/.local/bin/dock-procs" waybar signal "$ACTIVE_MON" USR1 >/dev/null 2>&1; then
        export _WAYBAR_WAS_VISIBLE=true
    elif pgrep -x waybar >/dev/null 2>&1 || pgrep -x .waybar-wrapped >/dev/null 2>&1; then
        export _WAYBAR_WAS_VISIBLE=true
        pkill -SIGUSR1 -x waybar 2>/dev/null || pkill -SIGUSR1 -x .waybar-wrapped 2>/dev/null &
    fi
    if "$HOME/.local/bin/dock-procs" rust-dock signal "$ACTIVE_MON" USR1 >/dev/null 2>&1; then
        export _RUST_DOCK_WAS_VISIBLE=true
    elif pgrep -x rust-dock >/dev/null 2>&1 || pgrep -x .rust-dock-wrap >/dev/null 2>&1 || pgrep -x .rust-dock-wrapped >/dev/null 2>&1; then
        export _RUST_DOCK_WAS_VISIBLE=true
        pkill -SIGUSR1 -x rust-dock 2>/dev/null || pkill -SIGUSR1 -x .rust-dock-wrap 2>/dev/null || pkill -SIGUSR1 -x .rust-dock-wrapped 2>/dev/null &
    fi
    if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
        export _QUICKSHELL_WAS_VISIBLE=true
        quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island hide "$ACTIVE_MON" >/dev/null 2>&1 &
    fi
fi

restore_bars() {
    if [ -n "$ACTIVE_MON" ]; then
        [ "$_WAYBAR_WAS_VISIBLE" = "true" ] && { "$HOME/.local/bin/dock-procs" waybar signal "$ACTIVE_MON" USR2 >/dev/null 2>&1 || pkill -SIGUSR2 -x waybar 2>/dev/null || pkill -SIGUSR2 -x .waybar-wrapped 2>/dev/null & }
        [ "$_RUST_DOCK_WAS_VISIBLE" = "true" ] && { "$HOME/.local/bin/dock-procs" rust-dock signal "$ACTIVE_MON" USR2 >/dev/null 2>&1 || pkill -SIGUSR2 -x rust-dock 2>/dev/null || pkill -SIGUSR2 -x .rust-dock-wrap 2>/dev/null || pkill -SIGUSR2 -x .rust-dock-wrapped 2>/dev/null & }
        [ "$_QUICKSHELL_WAS_VISIBLE" = "true" ] && quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island reveal "$ACTIVE_MON" >/dev/null 2>&1 &
    fi
}
trap restore_bars EXIT

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 3000 -i network-wireless "Wi-Fi" "$1"
    fi
}

# Obtener estado de Wi-Fi y cadenas traducidas
WIFI_STATE=$(nmcli -fields WIFI g 2>/dev/null | tail -n 1 | tr -d ' ')

T_DIS_WIFI=$(hypr-i18n wifi.toggle_off 2>/dev/null || echo "󰖪  Disable Wi-Fi")
T_EN_WIFI=$(hypr-i18n wifi.toggle_on 2>/dev/null || echo "󰖩  Enable Wi-Fi")
T_RESCAN=$(hypr-i18n wifi.rescan 2>/dev/null || echo "󰑐  Scan networks again")
T_OPEN_MGR=$(hypr-i18n wifi.open_settings 2>/dev/null || echo "󰒓  Open Connection Editor (nm-connection-editor)")
T_HIDDEN=$(hypr-i18n wifi.connect_hidden 2>/dev/null || echo "󱛂  Connect to hidden network (Manual)")
T_CONN=$(hypr-i18n wifi.connected 2>/dev/null || echo "Connected")
T_SIGNAL=$(hypr-i18n wifi.signal 2>/dev/null || echo "Signal")
T_OPEN=$(hypr-i18n wifi.open_network 2>/dev/null || echo "Open")
T_FORGET=$(hypr-i18n wifi.forget 2>/dev/null || echo "󰆴  Forget this network")
T_BACK=$(hypr-i18n wifi.back 2>/dev/null || echo "󰅁  Back")
T_PROMPT=$(hypr-i18n wifi.prompt 2>/dev/null || echo "Wi-Fi Networks")

if [[ "$WIFI_STATE" =~ enabled ]] || [ "$WIFI_STATE" = "enabled" ]; then
    TOGGLE_TEXT="$T_DIS_WIFI"
else
    TOGGLE_TEXT="$T_EN_WIFI"
fi

# Si el Wi-Fi esta desactivado, mostrar opcion para activarlo
if [ "$WIFI_STATE" != "enabled" ]; then
    CHOSEN=$(echo -e "$TOGGLE_TEXT\n$T_OPEN_MGR" | rofi-themed -dmenu -i -p "$T_PROMPT" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    case "$CHOSEN" in
        *"Activar Wi-Fi"*|*"Enable Wi-Fi"*)
            nmcli radio wifi on
            notify "$(hypr-i18n wifi.scanning 2>/dev/null || echo "Wi-Fi enabled. Scanning networks...")"
            sleep 2
            exec "$0"
            ;;
        *"Abrir Administrador"*|*"Open Connection Editor"*)
            nm-connection-editor &
            ;;
    esac
    exit 0
fi

# Escanear y listar redes disponibles (instantaneo usando cache de NetworkManager)
RAW_NETWORKS=$(nmcli -t -f "IN-USE,SSID,SECURITY,BARS,SIGNAL" device wifi list 2>/dev/null | awk -F: '$2 != "" && !seen[$2]++ { print }')

ACTIVE_CONN=""
NET_ITEMS=""

while IFS=: read -r in_use ssid security bars signal; do
    [ -z "$ssid" ] && continue
    sec_label="$T_OPEN"
    [ -n "$security" ] && [ "$security" != "--" ] && sec_label="$security"

    if [ "$in_use" = "*" ]; then
        ACTIVE_CONN="$ssid"
        NET_ITEMS="${NET_ITEMS}󰤨  $ssid ($T_CONN) │ $T_SIGNAL: ${signal}% ($bars) │ $sec_label\n"
    else
        # Icono segun senal
        if [ "$signal" -ge 75 ]; then
            icon="󰤨"
        elif [ "$signal" -ge 50 ]; then
            icon="󰤥"
        elif [ "$signal" -ge 25 ]; then
            icon="󰤢"
        else
            icon="󰤟"
        fi
        [ "$sec_label" != "$T_OPEN" ] && icon="${icon}"
        NET_ITEMS="${NET_ITEMS}${icon}  $ssid │ $T_SIGNAL: ${signal}% ($bars) │ $sec_label\n"
    fi
done <<< "$RAW_NETWORKS"

# Cabecera de acciones
HEADER="$TOGGLE_TEXT\n$T_RESCAN\n$T_OPEN_MGR\n$T_HIDDEN\n────────────────────────────────────────"

MENU_CONTENT=$(echo -e "${HEADER}\n${NET_ITEMS}")

CHOSEN=$(echo -e "$MENU_CONTENT" | rofi-themed -dmenu -i -p "$T_PROMPT" -theme "$THEME_FILE" -m "$ACTIVE_MON")

[ -z "$CHOSEN" ] && exit 0
[[ "$CHOSEN" =~ ^─ ]] && exit 0

case "$CHOSEN" in
    *"Desactivar Wi-Fi"*|*"Disable Wi-Fi"*)
        nmcli radio wifi off
        notify "$(hypr-i18n wifi.disabled 2>/dev/null || echo "Wi-Fi disabled")"
        exit 0
        ;;
    *"Activar Wi-Fi"*|*"Enable Wi-Fi"*)
        nmcli radio wifi on
        notify "$(hypr-i18n wifi.enabled 2>/dev/null || echo "Wi-Fi enabled")"
        exit 0
        ;;
    *"Escanear redes"*|*"Scan networks"*)
        notify "$(hypr-i18n wifi.scanning 2>/dev/null || echo "Scanning available networks...")"
        nmcli device wifi rescan 2>/dev/null || true
        sleep 1.5
        exec "$0"
        ;;
    *"Abrir Administrador"*|*"Open Connection Editor"*)
        nm-connection-editor &
        exit 0
        ;;
    *"red oculta"*|*"hidden network"*)
        HIDDEN_SSID=$(rofi-themed -dmenu -p "$(hypr-i18n wifi.ssid_prompt 2>/dev/null || echo "Network Name (SSID)")" -theme "$THEME_FILE" -m "$ACTIVE_MON")
        [ -z "$HIDDEN_SSID" ] && exit 0
        HIDDEN_PASS=$(rofi-themed -dmenu -password -p "$(hypr-i18n wifi.pass_prompt "$HIDDEN_SSID" 2>/dev/null || echo "Password for $HIDDEN_SSID")" -theme "$THEME_FILE" -m "$ACTIVE_MON")
        if [ -n "$HIDDEN_PASS" ]; then
            nmcli dev wifi connect "$HIDDEN_SSID" password "$HIDDEN_PASS" hidden yes
        else
            nmcli dev wifi connect "$HIDDEN_SSID" hidden yes
        fi
        exit 0
        ;;
esac

# Extraer el SSID seleccionado
SELECTED_SSID=$(echo "$CHOSEN" | awk -F'│' '{print $1}' | sed -E 's/^[󰤨󰤥󰤢󰤟󰖩󰖪* ]+//' | sed -E "s/ \($T_CONN|Conectado|Connected\)//" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

[ -z "$SELECTED_SSID" ] && exit 0

# Si es la red activa, ofrecer desconectar u olvidar
if [ "$SELECTED_SSID" = "$ACTIVE_CONN" ]; then
    T_DISCONN_ACTION=$(hypr-i18n wifi.disconnect "$SELECTED_SSID" 2>/dev/null || echo "󰅖  Disconnect from $SELECTED_SSID")
    ACTION=$(echo -e "$T_DISCONN_ACTION\n$T_FORGET\n$T_BACK" | rofi-themed -dmenu -i -p "$SELECTED_SSID" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    case "$ACTION" in
        *"Desconectar"*|*"Disconnect"*)
            nmcli connection down id "$SELECTED_SSID" 2>/dev/null || nmcli device disconnect wlan0 2>/dev/null
            notify "$(hypr-i18n wifi.disconnected_from "$SELECTED_SSID" 2>/dev/null || echo "Disconnected from $SELECTED_SSID")"
            ;;
        *"Olvidar"*|*"Forget"*)
            nmcli connection delete id "$SELECTED_SSID" 2>/dev/null
            notify "$(hypr-i18n wifi.forgot "$SELECTED_SSID" 2>/dev/null || echo "Network $SELECTED_SSID removed")"
            ;;
    esac
    exit 0
fi

# Verificar si la conexion ya existe en el sistema
SAVED_CONN=$(nmcli -t -f NAME connection show | grep -Fx "$SELECTED_SSID" | head -n 1)

if [ -n "$SAVED_CONN" ]; then
    notify "Conectando a red guardada: $SELECTED_SSID..."
    if nmcli connection up id "$SELECTED_SSID" 2>/dev/null; then
        notify "Conectado exitosamente a $SELECTED_SSID"
    else
        notify "Fallo al conectar a $SELECTED_SSID. Intentando reconectar..."
        nmcli dev wifi connect "$SELECTED_SSID"
    fi
else
    # Red nueva: verificar si requiere contraseña
    SEC_TYPE=$(echo "$CHOSEN" | awk -F'│' '{print $3}' | tr -d ' ')
    if [ "$SEC_TYPE" = "Abierta" ] || [ -z "$SEC_TYPE" ] || [ "$SEC_TYPE" = "--" ]; then
        notify "Conectando a red abierta: $SELECTED_SSID..."
        nmcli dev wifi connect "$SELECTED_SSID"
    elif [[ "$SEC_TYPE" =~ (802\.1X|Enterprise|EAP) ]]; then
        WIFI_USER=$(rofi-themed -dmenu -p "Usuario / Identity ($SELECTED_SSID)" -theme "$THEME_FILE" -m "$ACTIVE_MON")
        [ -z "$WIFI_USER" ] && exit 0
        WIFI_PASSWORD=$(rofi-themed -dmenu -password -p "Contraseña ($SELECTED_SSID)" -theme "$THEME_FILE" -m "$ACTIVE_MON")
        [ -z "$WIFI_PASSWORD" ] && exit 0
        notify "Conectando a red WPA Enterprise: $SELECTED_SSID..."
        if "$HOME/.local/bin/notch-wifi-helper" connect-enterprise "$SELECTED_SSID" "$WIFI_USER" "$WIFI_PASSWORD"; then
            notify "Conectado exitosamente a $SELECTED_SSID"
        else
            notify "Error de autenticación al conectar a $SELECTED_SSID"
        fi
    else
        WIFI_PASSWORD=$(rofi-themed -dmenu -password -p "Contraseña ($SELECTED_SSID)" -theme "$THEME_FILE" -m "$ACTIVE_MON")
        [ -z "$WIFI_PASSWORD" ] && exit 0
        notify "Conectando a $SELECTED_SSID..."
        if nmcli dev wifi connect "$SELECTED_SSID" password "$WIFI_PASSWORD"; then
            notify "Conectado exitosamente a $SELECTED_SSID"
        else
            notify "Error de autenticacion al conectar a $SELECTED_SSID"
        fi
    fi
fi

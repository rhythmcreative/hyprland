#!/usr/bin/env bash
# Despliega las piezas de SISTEMA del greeter de SDDM.
#
# POR QUE EXISTE ESTE SCRIPT Y NO ESTA EN EL INSTALLER
# ---------------------------------------------------
# El login se pinta con tres ficheros que NO viven en ~/.config, sino en /usr y
# en /etc:
#
#   /usr/local/lib/rhythm/sddm-greeter-monitor   el envoltorio que decide que
#                                                 salida se enciende
#   /usr/share/sddm/hyprland.lua                  la plantilla que ese
#                                                 envoltorio rellena
#   /etc/sddm.conf.d/10-wayland.conf              quien llama al envoltorio
#   /etc/systemd/system/sddm.service.d/cursor.conf  el tema de cursor del login
#
# El installer los desplegaba, pero el OTA no: rhythm-materialize solo sincroniza
# ~/.config y ~/.local/bin. O sea que tras una actualizacion, el sddm.conf
# seguia apuntando al start-hyprland de siempre y las tres piezas nuevas se
# quedaban a medias, que es peor que no tenerlas: el repositorio ya trae la
# plantilla con la marca de monitor, pero el sddm.conf deployed no la usa.
#
# Este script es el unico sitio que escribe esos cuatro ficheros, y lo usan los
# dos caminos: el installer y el OTA. Una sola fuente de verdad.
#
# USO
#   rhythm-sddm-deploy            aplica
#   rhythm-sddm-deploy --check    solo compara con lo desplegado (sin sudo, lo
#                                 puede llamar rhythm-doctor)
#
# CONFIANZA
# ---------
# Copia ficheros del repo, que es del usuario, a rutas de root. install.sh ya lo
# hacia con el mismo repo, asi que no se abre ninguna capacidad nueva: quien
# pueda escribir en el repo ya podia escalar ejecutando el installer. Lo que si
# se evita es hacerlo en segundo plano desde un timer sin que nadie lo pidiera,
# asi que --check es lo que el doctor usa para avisar, no un despliegue
# automatico.

set -uo pipefail

# El repo puede llegar como argumento, no solo por el entorno. Tiene que ser un
# argumento porque al re-ejecutarse con sudo se pierde el entorno y el HOME pasa
# a ser /root: con RHYTHM_DOTFILES_DIR en el entorno, sudo lo borra y el script
# iba a buscar las plantillas en /root/hyprland, que no existe.
REPO_DIR="${RHYTHM_DOTFILES_DIR:-$HOME/hyprland}"
modo_check=0
for arg in "$@"; do
    case "$arg" in
        --check) modo_check=1 ;;
        "") ;;
        *) REPO_DIR="$arg" ;;
    esac
done

_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd || true)"
if [ ! -d "$REPO_DIR/sddm" ]; then
    if [ -n "$_script_dir" ] && [ -d "$_script_dir/sddm" ]; then
        REPO_DIR="$_script_dir"
    elif [ -n "${DOTFILES_DIR:-}" ] && [ -d "$DOTFILES_DIR/sddm" ]; then
        REPO_DIR="$DOTFILES_DIR"
    elif [ -d "$PWD/sddm" ]; then
        REPO_DIR="$PWD"
    elif [ -n "${SUDO_USER:-}" ] && [ -d "/home/$SUDO_USER/hyprland/sddm" ]; then
        REPO_DIR="/home/$SUDO_USER/hyprland"
    elif [ -n "${SUDO_USER:-}" ] && [ -d "/home/$SUDO_USER/dotfiles/sddm" ]; then
        REPO_DIR="/home/$SUDO_USER/dotfiles"
    elif [ -d "$HOME/hyprland/sddm" ]; then
        REPO_DIR="$HOME/hyprland"
    elif [ -d "$HOME/dotfiles/sddm" ]; then
        REPO_DIR="$HOME/dotfiles"
    fi
fi

# El log tiene que quedarse en el home del usuario, no en el de root, que es
# donde cae si el script se re-ejecuta con sudo.
LOGHOME="$HOME"
if [ -n "${SUDO_USER:-}" ]; then
    _h=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)
    [ -n "$_h" ] && LOGHOME="$_h"
    unset _h
fi
[ -d "$LOGHOME" ] || LOGHOME=/tmp
LOG="$LOGHOME/.cache/rhythm-sddm-deploy.log"
log() { mkdir -p "$(dirname "$LOG")" 2>/dev/null; echo "$(date '+%Y-%m-%d %H:%M:%S') $1" | tee -a "$LOG" >&2; }

# ── ajustes que el usuario puede cambiar ─────────────────────────────────────
#
# Tema de cursor del login. Ha de ser un NOMBRE de tema instalado en
# /usr/share/icons, no una ruta: el greeter corre como root y en su propia VT, y
# su compositor es el suyo, asi que no ve nada de la sesion.
#
# Variantes zurdas de Bibata: Bibata-Modern-Ice-Right. Si el tema no esta
# instalado, el login sale con el cursor por defecto: es cosmetico y no se
# avisa como error.
SDDM_CURSOR_THEME="Bibata-Modern-Ice"

# ── contenido generado ──────────────────────────────────────────────────────

conf_sddm() {
    local sddm_ver=""
    if command -v sddm >/dev/null 2>&1; then
        sddm_ver=$(sddm --version 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -n 1 || true)
    fi
    local major=0 minor=0
    if [ -n "$sddm_ver" ]; then
        major=$(echo "$sddm_ver" | cut -d. -f1)
        minor=$(echo "$sddm_ver" | cut -d. -f2)
    fi
    if [ "$major" -eq 0 ] && [ "$minor" -lt 20 ]; then
        # SDDM < 0.20 (e.g. Debian 12 Bookworm) does not support DisplayServer=wayland
        cat <<EOF
[General]
DisplayServer=x11

[X11]
DisplayCommand=/etc/sddm/Xsetup
EOF
    else
        cat <<EOF
[General]
DisplayServer=wayland
GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

[Wayland]
CompositorCommand=/usr/local/lib/rhythm/sddm-greeter-monitor
EOF
    fi
}

conf_cursor() {
    cat <<EOF
[Service]
Environment=XCURSOR_THEME=$SDDM_CURSOR_THEME
EOF
}

conf_tema() {
    cat <<EOF
[Theme]
Current=sddm-astronaut-theme
ThemeDir=/usr/share/sddm/themes
EOF
}

# ── comparación (sin sudo) ──────────────────────────────────────────────────

fallos=0
avisa() { echo "  $1"; }
marca() { if [ "$fallos" -eq 0 ]; then echo "  OK"; else echo "  FAIL"; fi; }

comparar_fichero() {
    local desc="$1" instalado="$2" origen="$3"
    if [ ! -e "$instalado" ]; then
        avisa "$desc: not deployed ($instalado)"; fallos=$((fallos + 1)); return
    fi
    if [ ! -e "$origen" ]; then
        avisa "$desc: source not found ($origen)"; fallos=$((fallos + 1)); return
    fi
    if cmp -s "$origen" "$instalado"; then
        avisa "$desc: correct"
    else
        avisa "$desc: deployed but differs from the repo"
        fallos=$((fallos + 1))
    fi
}

# Para el contenido que se genera: la funcion escribe el fichero entero, con su
# salto de linea final, y se compara contra ese temporal.
#
# Antes se hacia `esperado=$(cat fichero)` y luego `printf '%s' "$esperado"`, y
# eso NUNCA cuadraba: la sustitucion de comando se come el salto de linea final,
# el temporal acababa un byte mas corto que el fichero real y cmp reportaba
# diferencia siempre. Daba igual que estuviera todo en su sitio.
comparar_generado() {
    local desc="$1" instalado="$2"
    shift 2
    local tmp
    tmp=$(mktemp)
    "$@" >"$tmp"
    comparar_fichero "$desc" "$instalado" "$tmp"
    rm -f "$tmp"
}

if [ "$modo_check" -eq 1 ]; then
    echo "SDDM greeter:"
    comparar_fichero "wrapper" \
        /usr/local/lib/rhythm/sddm-greeter-monitor \
        "$REPO_DIR/sddm/sddm-greeter-monitor"
    if [ -f "$REPO_DIR/sddm/hyprland.conf" ]; then
        comparar_fichero "template (conf)" \
            /usr/share/sddm/hyprland.conf \
            "$REPO_DIR/sddm/hyprland.conf"
    fi
    if [ -f "$REPO_DIR/sddm/hyprland.lua" ]; then
        comparar_fichero "template (lua)" \
            /usr/share/sddm/hyprland.lua \
            "$REPO_DIR/sddm/hyprland.lua"
    fi
    comparar_generado "sddm.conf" /etc/sddm.conf.d/10-wayland.conf conf_sddm
    comparar_generado "login cursor" \
        /etc/systemd/system/sddm.service.d/cursor.conf conf_cursor
    comparar_generado "theme" /etc/sddm.conf.d/theme.conf conf_tema
    comparar_fichero "Xsetup (X11 fallback)" \
        /etc/sddm/Xsetup \
        "$REPO_DIR/sddm/Xsetup"

    if [ -d /usr/share/icons/"$SDDM_CURSOR_THEME"/cursors ]; then
        avisa "cursor theme '$SDDM_CURSOR_THEME' is installed"
    else
        avisa "cursor theme '$SDDM_CURSOR_THEME' is not in /usr/share/icons: the login will use the default cursor"
        fallos=$((fallos + 1))
    fi
    marca
    exit "$([ "$fallos" -eq 0 ] && echo 0 || echo 1)"
fi

# ── despliegue ──────────────────────────────────────────────────────────────

if [ "$(id -u)" -ne 0 ]; then
    # En un terminal se pide la contrasena; en un timer no hay quien la escriba,
    # asi que se dice con claridad en vez de colgarse esperando.
    if [ -t 0 ] && [ -t 1 ]; then
        exec sudo "$0" "$@"
    fi
    if sudo -n true 2>/dev/null; then
        exec sudo -n "$0" "$@"
    fi
    log "sudo with a password is required; run it by hand:  sudo $0"
    exit 1
fi

[ -d /usr/local/lib/rhythm ] || mkdir -p /usr/local/lib/rhythm
chmod 755 /usr/local/lib/rhythm /usr/local/lib 2>/dev/null || true
[ -d /usr/share/sddm ] || mkdir -p /usr/share/sddm
chmod 755 /usr/share/sddm 2>/dev/null || true
[ -d /etc/sddm ] || mkdir -p /etc/sddm
[ -d /etc/sddm.conf.d ] || mkdir -p /etc/sddm.conf.d
[ -d /etc/systemd/system/sddm.service.d ] || mkdir -p /etc/systemd/system/sddm.service.d

fallo=0

if [ -f "$REPO_DIR/sddm/sddm-greeter-monitor" ]; then
    # install -T y no cp: si en el repo hubiera un symlink, cp lo seguiria y
    # acabaria linking a donde apunte. install -T trata el destino como fichero
    # normal, asi que el contenido sale del repo o no se copia.
    install -T -m 755 "$REPO_DIR/sddm/sddm-greeter-monitor" \
        /usr/local/lib/rhythm/sddm-greeter-monitor || fallo=1
    chown root:root /usr/local/lib/rhythm/sddm-greeter-monitor 2>/dev/null
    chmod 755 /usr/local/lib/rhythm/sddm-greeter-monitor 2>/dev/null
else
    log "missing $REPO_DIR/sddm/sddm-greeter-monitor"; fallo=1
fi

if [ -f "$REPO_DIR/.local/bin/sddm-auto-sync-local" ]; then
    install -T -m 755 "$REPO_DIR/.local/bin/sddm-auto-sync-local" \
        /usr/local/lib/rhythm/sddm-auto-sync-local || fallo=1
    chown root:root /usr/local/lib/rhythm/sddm-auto-sync-local 2>/dev/null
    chmod 755 /usr/local/lib/rhythm/sddm-auto-sync-local 2>/dev/null

    # Sudoers NOPASSWD para permitir sddm-sync-wrapper sin pedir contraseña
    target_sync_user="${SUDO_USER:-$USER}"
    if [ "$target_sync_user" = "root" ]; then
        target_sync_user=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' /etc/passwd 2>/dev/null || echo "$USER")
    fi
    if [ -n "$target_sync_user" ] && [ "$target_sync_user" != "root" ]; then
        mkdir -p /etc/sudoers.d
        echo "$target_sync_user ALL=(root) NOPASSWD: /usr/local/lib/rhythm/sddm-auto-sync-local" > /etc/sudoers.d/sddm-sync
        chmod 440 /etc/sudoers.d/sddm-sync
    fi
fi

if [ -f "$REPO_DIR/sddm/hyprland.conf" ]; then
    install -T -m 644 "$REPO_DIR/sddm/hyprland.conf" /usr/share/sddm/hyprland.conf || fallo=1
    chown root:root /usr/share/sddm/hyprland.conf 2>/dev/null
    chmod 644 /usr/share/sddm/hyprland.conf 2>/dev/null
fi

if [ -f "$REPO_DIR/sddm/hyprland.lua" ]; then
    install -T -m 644 "$REPO_DIR/sddm/hyprland.lua" /usr/share/sddm/hyprland.lua || fallo=1
    chown root:root /usr/share/sddm/hyprland.lua 2>/dev/null
    chmod 644 /usr/share/sddm/hyprland.lua 2>/dev/null
fi

conf_sddm > /etc/sddm.conf.d/10-wayland.conf || fallo=1
chmod 644 /etc/sddm.conf.d/10-wayland.conf 2>/dev/null

conf_tema > /etc/sddm.conf.d/theme.conf || fallo=1
chmod 644 /etc/sddm.conf.d/theme.conf 2>/dev/null

# Sincronizar o ajustar /etc/sddm.conf si existe para no anular el tema
if [ -f /etc/sddm.conf ]; then
    if grep -q "^\[Theme\]" /etc/sddm.conf 2>/dev/null; then
        if grep -q "^Current=" /etc/sddm.conf 2>/dev/null; then
            sed -i 's/^Current=.*/Current=sddm-astronaut-theme/' /etc/sddm.conf 2>/dev/null || true
        else
            sed -i '/^\[Theme\]/a Current=sddm-astronaut-theme' /etc/sddm.conf 2>/dev/null || true
        fi
        if grep -q "^ThemeDir=" /etc/sddm.conf 2>/dev/null; then
            sed -i 's|^ThemeDir=.*|ThemeDir=/usr/share/sddm/themes|' /etc/sddm.conf 2>/dev/null || true
        else
            sed -i '/^\[Theme\]/a ThemeDir=\/usr\/share\/sddm\/themes' /etc/sddm.conf 2>/dev/null || true
        fi
    else
        printf "\n[Theme]\nCurrent=sddm-astronaut-theme\nThemeDir=/usr/share/sddm/themes\n" >> /etc/sddm.conf 2>/dev/null || true
    fi
else
    mkdir -p /etc
    printf "[Theme]\nCurrent=sddm-astronaut-theme\nThemeDir=/usr/share/sddm/themes\n" > /etc/sddm.conf 2>/dev/null || true
fi

# Xsetup es la red de seguridad por si hay que volver a X11. Vive en /etc, asi
# que sin esto tampoco lo actualizaba el OTA.
if [ -f "$REPO_DIR/sddm/Xsetup" ]; then
    install -T -m 755 "$REPO_DIR/sddm/Xsetup" /etc/sddm/Xsetup || fallo=1
    chown root:root /etc/sddm/Xsetup 2>/dev/null
    chmod 755 /etc/sddm/Xsetup 2>/dev/null
else
    log "missing $REPO_DIR/sddm/Xsetup"; fallo=1
fi

# Despliegue inicial o reparacion del tema si no existe
if [ -d "$REPO_DIR/sddm/sddm-astronaut-theme" ]; then
    mkdir -p /usr/share/sddm/themes
    if [ ! -d /usr/share/sddm/themes/sddm-astronaut-theme ] || [ ! -f /usr/share/sddm/themes/sddm-astronaut-theme/Main.qml ]; then
        rm -rf /usr/share/sddm/themes/sddm-astronaut-theme
        cp -r "$REPO_DIR/sddm/sddm-astronaut-theme" /usr/share/sddm/themes/
    fi
    # Garantizar que Themes/theme1.conf exista y coincida con theme.conf
    if [ -f /usr/share/sddm/themes/sddm-astronaut-theme/theme.conf ]; then
        mkdir -p /usr/share/sddm/themes/sddm-astronaut-theme/Themes
        cp -f /usr/share/sddm/themes/sddm-astronaut-theme/theme.conf /usr/share/sddm/themes/sddm-astronaut-theme/Themes/theme1.conf 2>/dev/null || true
    fi
    chmod -R a+rX /usr/share/sddm/themes/sddm-astronaut-theme 2>/dev/null || true
fi

# Instalar fuentes del tema si estan disponibles
if [ -d "$REPO_DIR/sddm/sddm-astronaut-theme/Fonts" ]; then
    mkdir -p /usr/share/fonts/truetype/sddm-astronaut
    cp -n "$REPO_DIR/sddm/sddm-astronaut-theme/Fonts"/*.ttf /usr/share/fonts/truetype/sddm-astronaut/ 2>/dev/null || true
    chmod 644 /usr/share/fonts/truetype/sddm-astronaut/*.ttf 2>/dev/null || true
    command -v fc-cache >/dev/null 2>&1 && fc-cache -f /usr/share/fonts/truetype/sddm-astronaut >/dev/null 2>&1 || true
fi

# Preconfigurar sesion por defecto a Hyprland en state.conf para SDDM 0.20+ (Qt6)
mkdir -p /var/lib/sddm 2>/dev/null || true
if [ ! -f /var/lib/sddm/state.conf ] || ! grep -q "Session=" /var/lib/sddm/state.conf 2>/dev/null; then
    printf "[Last]\nSession=/usr/share/wayland-sessions/hyprland.desktop\n" > /var/lib/sddm/state.conf 2>/dev/null || true
    id -u sddm >/dev/null 2>&1 && chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true
elif grep -q "Session=hyprland.desktop" /var/lib/sddm/state.conf 2>/dev/null; then
    sed -i 's|Session=hyprland.desktop|Session=/usr/share/wayland-sessions/hyprland.desktop|' /var/lib/sddm/state.conf 2>/dev/null || true
fi

if [ -n "$SDDM_CURSOR_THEME" ]; then
    conf_cursor > /etc/systemd/system/sddm.service.d/cursor.conf || fallo=1
    chmod 644 /etc/systemd/system/sddm.service.d/cursor.conf 2>/dev/null
    if [ -d "/usr/share/icons/$SDDM_CURSOR_THEME/cursors" ]; then
        log "login cursor: $SDDM_CURSOR_THEME (applied on next boot)"
    else
        log "WARNING: theme '$SDDM_CURSOR_THEME' is not installed; the login will use the default cursor"
    fi
fi

# El drop-in del cursor es del servicio de SDDM, asi que la recarga es del
# gestor de sistema, no del de usuario. Sin esto, el fichero esta pero systemd
# no lo mira hasta el siguiente apagado.
systemctl daemon-reload >/dev/null 2>&1 || log "warning: daemon-reload failed"

if [ "$fallo" -eq 0 ]; then
    log "SDDM greeter deployed"
    exit 0
fi
log "the greeter deployment ended with errors"
exit 1

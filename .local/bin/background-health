#!/usr/bin/env bash
# Lista los monitores encendidos cuya superficie de fondo no se esta viendo.
#
#   eDP-1        (uno por linea, vacio si todo esta bien)
#
# El compositor pone la superficie de fondo en alfa 0 cuando un monitor se
# enciende despues de haber estado apagado, o cuando se desconecta y vuelve.
# awww sigue creyendo que tiene la imagen puesta — "awww query" la lista sin
# problema — asi que ni awww ni el watcher se enteran: no hay evento dpms en el
# socket2 de Hyprland, solo monitoradded, monitorremoved, focusedmon,
# openwindow, closewindow, configreloaded y screencast.
#
# Medido: DP-6 con la superficie en a:0 y sin fondo visible, y forzando el
# pintado pasa a a:1.
#
# La unica senal fiable es el alfa de la capa, asi que se cruzan las superficies
# de awww de hyprctl layers con la posicion y el tamano de cada monitor.

set -u

mons=$(hyprctl monitors -j 2>/dev/null) || exit 0
layers=$(hyprctl layers 2>/dev/null) || exit 0
[ -n "$mons" ] && [ -n "$layers" ] || exit 0

# Superficies de fondo de awww, agrupadas por monitor con awk. Se guardan como
# "X,Y WxH ALFA" para comparar.
#
# El campo "a: ALFA" se busco siempre, y Hyprland 0.56 dejo de emitirlo: ahora
# la linea es "xywh: X Y W H, namespace: awww-daemon, pid: N" y nada mas. Con
# el patron viejo el match no se producia nunca, la lista de capas salia
# vacia, todos los monitores se daban por rotos y el watcher reiniciaba
# awww-daemon en bucle -- cada reinicio aborta con SIGABRT, asi que eso fueron
# cientos de coredumps. El alfa pasa a ser opcional: si la linea no lo trae se
# asume 1, que es lo que significa una superficie de fondo visible.
awk '
  /^Monitor /            { mon = $2; sub(/:$/, "", mon) }
  /namespace: awww-daemon/ {
      if (match($0, /xywh: [0-9]+ [0-9]+ [0-9]+ [0-9]+/)) {
          head = substr($0, RSTART, RLENGTH)
          # "xywh: X Y W H" partido por ":" y "," deja las cuatro medidas
          # juntas en un unico campo separadas por espacios, asi que ese
          # campo se parte otra vez. Sin este segundo split, w y h salian a 0.
          split(head, f, /[:,]/)
          split(f[2], g, " ")
          x = g[1] + 0; y = g[2] + 0; w = g[3] + 0; h = g[4] + 0
          a = 1
          if (match($0, /, a: [0-9]+/)) {
              a = substr($0, RSTART + 4, RLENGTH - 4) + 0
          }
          printf "%s\t%d,%d %dx%d %d\n", mon, x, y, w, h, a
      }
  }
' <<< "$layers" > /tmp/.bg-layers.$$ 2>/dev/null || { rm -f /tmp/.bg-layers.$$; exit 0; }

jq -r '.[] | select(.active == true or .dpmsStatus == true) | [.name, (.x|tostring), (.y|tostring), (.width|tostring), (.height|tostring)] | @tsv' \
    <<< "$mons" 2>/dev/null | while IFS=$'\t' read -r name x y w h; do
        [ -n "$name" ] || continue
        # Superficie de fondo de awww en ESTE monitor con alfa a 1.
        # Las -v van ANTES del programa: despues las tomaba como nombres de
        # fichero, asi que x/y/w/h nunca existian, la comparacion nunca se
        # cumplia y todos los monitores salian como rotos siempre.
        good=$(awk -F'\t' -v m="$name" -v x="$x" -v y="$y" -v w="$w" -v h="$h" '$1 == m {
                        split($2, p, " "); split(p[1], c, ",")
                        # p[1]=posicion p[2]=tamano p[3]=alfa. El alfa va dentro de
                        # $2 separado por un espacio, no en $3: con -F tab solo hay
                        # dos campos, asi que se comparaba contra un $3 vacio y por
                        # eso ningun monitor pasaba nunca la comprobacion.
                        if (c[1] == x && c[2] == y && p[2] == w "x" h && p[3] == 1) found = 1
                    }
                    END { print found + 0 }' "/tmp/.bg-layers.$$" 2>/dev/null)
        [ "${good:-0}" = "1" ] || echo "$name"
    done

rm -f "/tmp/.bg-layers.$$"

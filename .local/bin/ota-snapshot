#!/usr/bin/env bash
# ota-snapshot: Pre-OTA filesystem snapshot helper.
# Creates a read-only btrfs snapshot when possible, uses timeshift/snapper
# when available, and falls back to a config-only backup otherwise.
# English output, no emojis. Never fatal: callers must append "|| true".

set -euo pipefail

SNAP_ID="ota-$(date +%Y%m%d_%H%M%S)"
KEEP=5
HOME_SNAP_BASE="$HOME/.snapshots"
ROOT_SNAP_BASE="/.snapshots"
BACKUP_BASE="$HOME/.config.backup"
REPO_DIR="/home/rhythmcreative/hyprland"

usage() {
    cat << 'EOF'
ota-snapshot: Pre-OTA filesystem snapshot helper

Usage: ota-snapshot [options]

Options:
  --list        List existing snapshots/backups and exit
  --fs-only     Only attempt filesystem snapshots, skip config fallback
  -h, --help    Show this help and exit

Behavior:
  1. If btrfs with subvolumes is detected, creates read-only snapshots
     of /home (user level, no sudo) and / (sudo, /.snapshots).
     Keeps the last 5 snapshots in each location.
  2. Else if timeshift or snapper is installed, uses it.
  3. Else falls back to a config-only backup under ~/.config.backup,
     same layout as "system-ota backup".
EOF
}

is_btrfs_mount() {
    local target="$1"
    local fstype
    fstype=$(findmnt -n -o FSTYPE "$target" 2>/dev/null || true)
    [ "$fstype" = "btrfs" ]
}

btrfs_has_subvolumes() {
    btrfs subvolume list / >/dev/null 2>&1 || sudo -n btrfs subvolume list / >/dev/null 2>&1
}

prune_dir() {
    # prune_dir <base> <sudo?> : keep newest $KEEP entries, delete the rest
    local base="$1"
    local use_sudo="${2:-false}"
    local entries
    if [ "$use_sudo" = "true" ]; then
        entries=$(sudo -n ls -1t "$base" 2>/dev/null || true)
    else
        entries=$(ls -1t "$base" 2>/dev/null || true)
    fi
    local count=0
    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        count=$((count + 1))
        if [ "$count" -gt "$KEEP" ]; then
            if [ "$use_sudo" = "true" ]; then
                sudo -n btrfs subvolume delete "$base/$entry" >/dev/null 2>&1 \
                    || sudo -n rm -rf "$base/$entry" >/dev/null 2>&1 || true
            else
                btrfs subvolume delete "$base/$entry" >/dev/null 2>&1 \
                    || sudo -n btrfs subvolume delete "$base/$entry" >/dev/null 2>&1 \
                    || rm -rf "$base/$entry" >/dev/null 2>&1 || true
            fi
        fi
    done <<< "$entries"
}

snapshot_home_btrfs() {
    # Snapshot /home subvolume into $HOME/.snapshots.
    # Tries without sudo first, falls back to passwordless sudo
    # (unprivileged subvolume creation requires CAP_SYS_ADMIN).
    is_btrfs_mount "/home" || is_btrfs_mount "/" || return 1
    mkdir -p "$HOME_SNAP_BASE"
    if btrfs subvolume snapshot -r /home "$HOME_SNAP_BASE/$SNAP_ID" >/dev/null 2>&1; then
        echo "Home snapshot created at $HOME_SNAP_BASE/$SNAP_ID."
        prune_dir "$HOME_SNAP_BASE" "false"
        return 0
    fi
    if sudo -n btrfs subvolume snapshot -r /home "$HOME_SNAP_BASE/$SNAP_ID" >/dev/null 2>&1; then
        echo "Home snapshot created at $HOME_SNAP_BASE/$SNAP_ID (via sudo)."
        prune_dir "$HOME_SNAP_BASE" "false"
        return 0
    fi
    return 1
}

snapshot_root_btrfs() {
    # Snapshot / into /.snapshots (requires sudo).
    is_btrfs_mount "/" || return 1
    sudo -n mkdir -p "$ROOT_SNAP_BASE" >/dev/null 2>&1 || return 1
    if sudo -n btrfs subvolume snapshot -r / "$ROOT_SNAP_BASE/$SNAP_ID" >/dev/null 2>&1; then
        echo "Root snapshot created at $ROOT_SNAP_BASE/$SNAP_ID."
        prune_dir "$ROOT_SNAP_BASE" "true"
        return 0
    fi
    return 1
}

snapshot_timeshift_snapper() {
    if command -v timeshift >/dev/null 2>&1; then
        echo "Creating timeshift snapshot..."
        sudo -n timeshift --create --comments "ota-$SNAP_ID" >/dev/null 2>&1 \
            || sudo timeshift --create --comments "ota-$SNAP_ID" >/dev/null 2>&1 || return 1
        echo "Timeshift snapshot created."
        return 0
    fi
    if command -v snapper >/dev/null 2>&1; then
        echo "Creating snapper snapshot..."
        sudo -n snapper -c root create -d "ota-$SNAP_ID" >/dev/null 2>&1 \
            || sudo snapper -c root create -d "ota-$SNAP_ID" >/dev/null 2>&1 || return 1
        echo "Snapper snapshot created."
        return 0
    fi
    return 1
}

config_fallback_backup() {
    # Same layout as "system-ota backup" so rollback keeps working.
    local target="$BACKUP_BASE/$SNAP_ID"
    mkdir -p "$target"
    echo "No filesystem snapshot available, creating config backup at $target..."
    if [ -d "$HOME/.config/hypr" ]; then cp -r "$HOME/.config/hypr" "$target/"; fi
    if [ -d "$HOME/.config/waybar" ]; then cp -r "$HOME/.config/waybar" "$target/"; fi
    if [ -d "$HOME/.config/quickshell" ]; then cp -r "$HOME/.config/quickshell" "$target/"; fi
    if [ -d "$HOME/.local/bin" ]; then cp -r "$HOME/.local/bin" "$target/"; fi
    local commit="unknown"
    if [ -d "$REPO_DIR/.git" ]; then
        commit=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo "unknown")
    fi
    local version="unknown"
    if [ -f "$REPO_DIR/.version" ]; then
        version=$(tr -d '[:space:]' < "$REPO_DIR/.version")
    fi
    cat > "$target/checkpoint.json" << EOF
{
  "id": "$SNAP_ID",
  "created_at": "$(date -Iseconds)",
  "version": "$version",
  "commit": "$commit"
}
EOF
    echo "Config backup $SNAP_ID created."
}

list_snapshots() {
    echo "=== Home btrfs snapshots ($HOME_SNAP_BASE) ==="
    ls -1t "$HOME_SNAP_BASE" 2>/dev/null || echo "(none)"
    echo ""
    echo "=== Root btrfs snapshots ($ROOT_SNAP_BASE) ==="
    sudo -n ls -1t "$ROOT_SNAP_BASE" 2>/dev/null || ls -1t "$ROOT_SNAP_BASE" 2>/dev/null || echo "(none)"
    echo ""
    echo "=== Config backups ($BACKUP_BASE) ==="
    ls -1t "$BACKUP_BASE" 2>/dev/null || echo "(none)"
}

FS_ONLY=false
for arg in "$@"; do
    case "$arg" in
        --list) list_snapshots; exit 0 ;;
        --fs-only) FS_ONLY=true ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $arg"; usage; exit 1 ;;
    esac
done

did_snapshot=false

if command -v btrfs >/dev/null 2>&1 && btrfs_has_subvolumes; then
    snapshot_home_btrfs || true
    snapshot_root_btrfs || true
    # Success if at least one snapshot directory appeared for this run.
    if [ -d "$HOME_SNAP_BASE/$SNAP_ID" ] || [ -d "$ROOT_SNAP_BASE/$SNAP_ID" ]; then
        did_snapshot=true
    fi
elif snapshot_timeshift_snapper; then
    did_snapshot=true
fi

if [ "$did_snapshot" = "true" ]; then
    echo "Pre-OTA snapshot $SNAP_ID finished."
    exit 0
fi

if [ "$FS_ONLY" = "true" ]; then
    echo "No filesystem snapshot backend available, skipping (fs-only mode)."
    exit 1
fi

config_fallback_backup
echo "Pre-OTA snapshot $SNAP_ID finished."

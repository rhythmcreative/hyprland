#!/usr/bin/env bash
# ota-updater: Wrapper delegating to system-ota
# Kept for backward compatibility across scripts, commands, and shortcuts.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

if [ -x "$SCRIPT_DIR/system-ota" ]; then
    exec "$SCRIPT_DIR/system-ota" "$@"
elif [ -x "$HOME/.local/bin/system-ota" ]; then
    exec "$HOME/.local/bin/system-ota" "$@"
elif command -v system-ota >/dev/null 2>&1; then
    exec system-ota "$@"
else
    echo "Error: system-ota executable not found." >&2
    exit 1
fi

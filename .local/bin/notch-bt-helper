#!/usr/bin/env python3
import sys
import os
import subprocess
import json
import re
import time

MAC_RE = re.compile(r'^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$')
ANSI = re.compile(r'\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07|\r')


def read_info(mac):
    """`bluetoothctl info` for one device, or '' when BlueZ has dropped it.

    A device that bluez has forgotten is the normal state of something that was
    never paired, so a failure here is information, not a crash.
    """
    try:
        return subprocess.check_output(['bluetoothctl', 'info', mac],
                                       text=True, stderr=subprocess.DEVNULL, timeout=10)
    except Exception:
        return ''


def first_error(out):
    """The bluez error inside a command's output, or '' if there is none.

    bluez answers `pair` with exit code 0 even while reporting a failure, so the
    code is never the signal — the text is.
    """
    for line in (out or '').splitlines():
        line = ANSI.sub('', line).strip()
        if line.startswith('Failed to') or 'org.bluez.Error' in line:
            return line
    return ''


def _state_dir():
    runtime = os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())
    return os.path.join(runtime, 'rhythm-bluetooth-pairing')


def mark_pending(mac):
    """Tell the agent which device this pair attempt is for."""
    try:
        os.makedirs(_state_dir(), exist_ok=True)
        with open(os.path.join(_state_dir(), 'pending.json'), 'w') as handle:
            json.dump({'mac': mac}, handle)
    except OSError:
        pass


def clear_pending():
    try:
        os.remove(os.path.join(_state_dir(), 'pending.json'))
    except OSError:
        pass


def get_bt_status():
    try:
        sh = subprocess.check_output(['bluetoothctl', 'show'], text=True, stderr=subprocess.DEVNULL)
        powered = 'Powered: yes' in sh
        discovering = 'Discovering: yes' in sh
    except Exception:
        powered = False
        discovering = False

    devices = []
    if powered:
        seen_macs = set()
        paired_macs = set()

        # 1. Paired devices
        try:
            raw_paired = subprocess.check_output(['bluetoothctl', 'devices', 'Paired'], text=True, stderr=subprocess.DEVNULL)
            for line in raw_paired.strip().split('\n'):
                if not line.startswith('Device '):
                    continue
                parts = line.split(' ', 2)
                if len(parts) >= 3:
                    mac = parts[1].strip()
                    name = parts[2].strip()
                    seen_macs.add(mac)
                    paired_macs.add(mac)
                    devices.append({
                        'mac': mac,
                        'name': name,
                        'paired': True,
                        'connected': False,
                        'has_name': True,
                        'icon': 'other',
                        'rssi': None
                    })
        except Exception:
            pass

        # 2. Scanned / known devices
        try:
            raw_all = subprocess.check_output(['bluetoothctl', 'devices'], text=True, stderr=subprocess.DEVNULL)
            for line in raw_all.strip().split('\n'):
                if not line.startswith('Device '):
                    continue
                parts = line.split(' ', 2)
                if len(parts) >= 2:
                    mac = parts[1].strip()
                    name = parts[2].strip() if len(parts) >= 3 else ''
                    if mac not in seen_macs:
                        seen_macs.add(mac)
                        devices.append({
                            'mac': mac,
                            'name': name,
                            'paired': False,
                            'connected': False,
                            'has_name': False,
                            'icon': 'other',
                            'rssi': None
                        })
        except Exception:
            pass

        # 3. Enrich info from bluetoothctl info
        clean_devs = []
        for d in devices:
            mac = d['mac']
            # bluetoothctl colorea la salida cuando cree que hay terminal; los
            # códigos se cuelan delante del nombre de la propiedad y rompen los
            # `startswith` de abajo, así que se van primero.
            info = ANSI.sub('', read_info(mac))

            d['connected'] = 'Connected: yes' in info
            d['paired'] = 'Paired: yes' in info or (mac in paired_macs)

            real_name = None
            alias = None
            icon = 'other'
            rssi = None

            for il in info.split('\n'):
                il = il.strip()
                if il.startswith('Name:'):
                    real_name = il.split(':', 1)[1].strip()
                elif il.startswith('Alias:'):
                    alias = il.split(':', 1)[1].strip()
                elif il.startswith('Icon:'):
                    icon = il.split(':', 1)[1].strip()
                elif il.startswith('RSSI:'):
                    try:
                        rssi_val = il.split('(', 1)[1].replace(')', '').strip()
                        rssi = int(rssi_val)
                    except Exception:
                        pass

            # Detect if name is a real human name or just MAC
            best_name = real_name or alias or d['name'] or ''
            # Check if name is MAC-like (e.g. 63-DF-71-6D-8A-D2 or 63:DF:71:6D:8A:D2)
            is_mac_like = bool(re.match(r'^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$', best_name.strip()))

            if not best_name or is_mac_like:
                d['has_name'] = False
                d['name'] = 'Unknown Device'
            else:
                d['has_name'] = True
                d['name'] = best_name

            d['icon'] = icon
            d['rssi'] = rssi
            clean_devs.append(d)

        # Sort: Connected first, then Paired, then Named devices, then signal strength, then name
        clean_devs.sort(key=lambda x: (
            not x['connected'],
            not x['paired'],
            not x['has_name'],
            -(x['rssi'] or -999),
            x['name'].lower()
        ))
        devices = clean_devs

    return {'powered': powered, 'discovering': discovering, 'devices': devices}

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'status'

    if cmd == 'status':
        print(json.dumps(get_bt_status()))

    elif cmd == 'on':
        try:
            subprocess.run(['rfkill', 'unblock', 'bluetooth'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(['bluetoothctl', 'power', 'on'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.3)
            print(json.dumps({'status': 'ok', 'powered': True}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

    elif cmd == 'off':
        try:
            subprocess.run(['bluetoothctl', 'power', 'off'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.3)
            print(json.dumps({'status': 'ok', 'powered': False}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

    elif cmd == 'toggle':
        try:
            status = get_bt_status()
            if status['powered']:
                subprocess.run(['bluetoothctl', 'power', 'off'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(0.3)
                print(json.dumps({'status': 'ok', 'powered': False}))
            else:
                subprocess.run(['rfkill', 'unblock', 'bluetooth'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(['bluetoothctl', 'power', 'on'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(0.3)
                print(json.dumps({'status': 'ok', 'powered': True}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

    elif cmd == 'scan':
        try:
            # Run scan in background for 15 seconds
            subprocess.Popen(['bluetoothctl', '--timeout', '15', 'scan', 'on'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(json.dumps({'status': 'ok', 'message': 'scanning'}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

    elif cmd == 'stop_scan':
        try:
            subprocess.run(['bluetoothctl', 'scan', 'off'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(json.dumps({'status': 'ok', 'message': 'scan_stopped'}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

    elif cmd == 'connect':
        if len(sys.argv) < 3:
            print(json.dumps({'status': 'error', 'message': 'Missing MAC'}))
            sys.exit(1)
        mac = sys.argv[2]
        # La MAC acaba en una orden de shell en la isla: se comprueba el
        # formato. Viene de bluez, pero no se le hace caso al remitente.
        if not re.match(r'^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$', mac):
            print(json.dumps({'status': 'error', 'message': 'Invalid MAC'}))
            sys.exit(1)
        try:
            info = read_info(mac)

            if 'Paired: yes' not in info:
                # CONFiar antes de emparejar era el bug que rompía todo esto.
                #
                # `bluetoothctl trust` es una escritura de propiedad: no negocia
                # nada, no espera a nadie y por eso NUNCA falla. Se quedaba
                # puesto mientras `pair` —que sí necesita al agente— se caía, y
                # el aparato acababa en `Trusted: yes / Paired: no`: una
                # confianza sin clave de enlace, que bluez conserva en su árbol
                # y la lista enseña como si fuera utilizable. Al reintentarlo,
                # bluez reutiliza ese objeto a medias y el emparejamiento vuelve
                # a caer. Por eso aquí ya no hay ni un aparato emparejado.
                #
                # Así que primero se limpia el estado a medias, luego se empareja
                # de verdad y solo entonces se confía.
                if 'Trusted: yes' in info:
                    # `remove` borra el objeto incompleto, no el enlace: aquí no
                    # hay ninguno que perder.
                    subprocess.run(['bluetoothctl', 'remove', mac],
                                   capture_output=True, text=True, timeout=10)

                # `pair` bloquea mientras el agente pide la confirmación en la
                # isla. El agente tiene 28s de ventana, así que el proceso se le
                # da bastante más: cortarlo antes produce justo el
                # trusted-sin-paired que se está limpiando aquí.
                # Este bluetoothctl es un cliente pelado y NO registra agente,
                # así que la negociación le llega al agente que corre aparte
                # (bluetooth-pair-agent) y el diálogo sale en la isla.
                #
                # El prompt del agente va por adaptador, no por aparato: sin
                # dejar la MAC escrita aquí, la isla preguntaría por emparejar
                # algo que no sabe nombrar.
                mark_pending(mac)
                try:
                    res = subprocess.run(['bluetoothctl', 'pair', mac],
                                         capture_output=True, text=True, timeout=60)
                finally:
                    clear_pending()
                out = ((res.stdout or '') + (res.stderr or '')).strip()
                if 'Pairing successful' not in out:
                    # El código de salida no sirve: bluez contesta 0 incluso
                    # cuando contesta «not available». Solo vale la respuesta.
                    print(json.dumps({'status': 'error',
                                      'message': first_error(out) or 'Pairing failed'}))
                    return

                # Emparejado de verdad: ahora la confianza sí significa algo.
                subprocess.run(['bluetoothctl', 'trust', mac],
                               capture_output=True, text=True, timeout=10)

            res = subprocess.run(['bluetoothctl', 'connect', mac], capture_output=True, text=True, timeout=20)
            out = ((res.stdout or '') + (res.stderr or '')).strip()
            print(json.dumps({'status': 'ok' if 'Connection successful' in out else 'error',
                              'message': out or first_error(out)}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

    elif cmd == 'disconnect':
        if len(sys.argv) < 3:
            print(json.dumps({'status': 'error', 'message': 'Missing MAC'}))
            sys.exit(1)
        mac = sys.argv[2]
        try:
            res = subprocess.run(['bluetoothctl', 'disconnect', mac], capture_output=True, text=True, timeout=10)
            print(json.dumps({'status': 'ok' if res.returncode == 0 else 'error', 'message': res.stdout.strip() or res.stderr.strip()}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

    elif cmd == 'remove':
        if len(sys.argv) < 3:
            print(json.dumps({'status': 'error', 'message': 'Missing MAC'}))
            sys.exit(1)
        mac = sys.argv[2]
        try:
            res = subprocess.run(['bluetoothctl', 'remove', mac], capture_output=True, text=True, timeout=10)
            print(json.dumps({'status': 'ok' if res.returncode == 0 else 'error', 'message': res.stdout.strip() or res.stderr.strip()}))
        except Exception as e:
            print(json.dumps({'status': 'error', 'message': str(e)}))

if __name__ == '__main__':
    main()

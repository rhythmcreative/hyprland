{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "exclusive": true,
  "on-sigusr1": "hide",
  "on-sigusr2": "show",
  "modules-left": [
    "hyprland/workspaces",
    "group/system-info",
    "custom/cava"
  ],
  "modules-center": [
        "clock",
        "custom/weather",
        "custom/music",
        "custom/pomodoro",
        "custom/uptime"
    ],
  "modules-right": [
    "hyprland/language",
    "bluetooth",
    "tray",
    "pulseaudio",
    "backlight",
    "battery"
  ],
  "hyprland/language": {
    "format": "󰌌 {}",
    "format-en": "US",
    "format-es": "ES",
    "tooltip-format": "{long} ({short}) - click to switch",
    "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next",
    "format-us": "US",
    "keyboard-name": "at-translated-set-2-keyboard"
  },
  "custom/desktop-power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Alimentación CA (Sin batería)"
  },
  "battery#bat0": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}% <span foreground='#9a9ea3'>│</span>",
    "format-charging": "󰂄 {capacity}% <span foreground='#9a9ea3'>│</span>",
    "format-plugged": "󰂄 {capacity}% <span foreground='#9a9ea3'>│</span>",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "battery#bat1": {
    "bat": "BAT1",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "custom/battery-mode": {
    "format": "󰂄",
    "tooltip-format": "Modo de batería",
    "on-click": "true"
  },
  "hyprland/workspaces": {
    "format": "{name} {icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "group/system-info": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "custom/cpu-temp",
      "custom/nvidia-temp"
    ]
  },
  "bluetooth": {
    "format": "{icon}",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected": "{icon} {num_connections}",
    "format-disabled": "{icon}",
    "format-icons": {
      "enabled": "󰂯",
      "disabled": "󰂲",
      "off": "󰂲",
      "on": "󰂯",
      "connected": "󰂱"
    },
    "on-click": "blueman-manager",
    "tooltip-format": "{status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "custom/music": {
    "format": "  {}",
    "escape": true,
    "interval": 5,
    "tooltip": false,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "blueman-manager",
    "max-length": 50
  },
  "clock": {
    "timezone": "Europe/Madrid",
    "tooltip": false,
    "format": "{:%H:%M:%S  -  %A, %d}",
    "interval": 1
  },
  "custom/weather": {
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 300,
    "tooltip": true,
    "on-click": "blueman-manager",
    "signal": 8,
    "restart-interval": 30
  },
  "network": {
    "format-wifi": "󰤢 {signalStrength}%",
    "format-ethernet": "󰈀 Connected",
    "format-disconnected": "󰤠 Disconnected",
    "format-linked": "󰈁 {ifname}",
    "interval": 5,
    "tooltip-format": "Network: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)\nIP: {ipaddr}\nFrequency: {frequency}MHz",
    "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}\nSpeed: {bandwidthUpBits}/{bandwidthDownBits}",
    "tooltip-format-disconnected": "Network Disconnected",
    "on-click": "blueman-manager",
    "on-click-right": "nm-applet"
  },
  "cpu": {
    "interval": 2,
    "format": "󰍛 {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "on-click": "blueman-manager"
  },
  "memory": {
    "interval": 5,
    "format": "󰘚 {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },
  "custom/uptime": {
    "format": "{}",
    "format-icon": [
      ""
    ],
    "tooltip": false,
    "interval": 1600,
    "exec": "$HOME/.config/waybar/scripts/uptime.sh"
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": [
      "",
      "󰃜",
      "󰃛",
      "󰃞",
      "󰃝",
      "󰃟",
      "󰃠"
    ],
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": [
        "󰋋",
        "󰋋",
        "󰋋"
      ],
      "hands-free": [
        "󰋋",
        "󰋋",
        "󰋋"
      ],
      "headset": [
        "󰋋",
        "󰋋",
        "󰋋"
      ],
      "phone": [
        "󰏲",
        "󰏲",
        "󰏲"
      ],
      "portable": [
        "󰦢",
        "󰦢",
        "󰦢"
      ],
      "car": [
        "󰄋",
        "󰄋",
        "󰄋"
      ],
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 2,
    "max-volume": 100
  },
  "custom/dual-battery": {
    "exec": "$HOME/.config/waybar/scripts/dual_battery_real.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "tooltip": true,
    "on-click": "true"
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0s; hyprlock)' & disown",
    "format": ""
  },
  "custom/pomodoro": {
    "format": "{}",
    "return-type": "json",
    "exec": "waybar-module-pomodoro --no-work-icons",
    "on-click": "blueman-manager",
    "on-click-right": "nm-applet"
  },
  "custom/cpu-temp": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/cpu_temp.sh",
    "interval": 10,
    "class": "cpu-temp"
  },
  "temperature#cpu": {
    "critical-threshold": 85,
    "format": "󰔏 {temperatureC}°C",
    "format-critical": "󰸁 {temperatureC}°C",
    "tooltip": true,
    "tooltip-format": "CPU Temperature: {temperatureC}°C",
    "interval": 10
  },
  "custom/nvidia-temp": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/nvidia-temp.sh",
    "interval": 10,
    "tooltip": true
  },
  "custom/cava": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/cava.sh",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}

#!/bin/bash
# toggle-powersave - Power saving manager for Dynamic Island, Waybar and Hyprland
# Optimizes CPU frequency/EPP, display brightness, GPU/Hyprland effects and window opacity.

STATE_FILE="/tmp/powersave-active"
BRIGHTNESS_BACKUP="/tmp/powersave_brightness_backup"
ACTION="${1:-toggle}"

is_active() {
    [ -f "$STATE_FILE" ]
}

enable_powersave() {
    touch "$STATE_FILE"

    # 1. CPU Energy Performance Preference (EPP) to power-saving
    if [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
        sudo tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference <<< "power" >/dev/null 2>&1 || true
        sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor <<< "powersave" >/dev/null 2>&1 || true
    fi

    # 2. Dim brightness gently to eco level (35%) if currently higher
    if command -v brightnessctl >/dev/null 2>&1; then
        current_b=$(brightnessctl get 2>/dev/null)
        max_b=$(brightnessctl max 2>/dev/null)
        if [ -n "$current_b" ] && [ -n "$max_b" ] && [ "$max_b" -gt 0 ]; then
            pct=$(( current_b * 100 / max_b ))
            if [ "$pct" -gt 40 ]; then
                echo "$current_b" > "$BRIGHTNESS_BACKUP"
                brightnessctl set 35% >/dev/null 2>&1 || true
            fi
        fi
    fi

    # 3. Disable heavy Hyprland visual effects and ensure solid/opaque windows (no background bleed-through)
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl eval 'hl.config({ decoration = { active_opacity = 1.0, inactive_opacity = 0.98, blur = { enabled = false }, shadow = { enabled = false } }, animations = { enabled = false } })' >/dev/null 2>&1 || true
        hyprctl eval 'hl.window_rule({ name = "powersave-opaque", match = { class = ".*" }, opaque = true })' >/dev/null 2>&1 || true
    fi

    # Set kitty background opacity to 1.0 for solid dark terminal
    for kconf in "$HOME/.config/kitty/kitty.conf" "/home/rhythmcreative/.config/kitty/kitty.conf"; do
        if [ -f "$kconf" ]; then
            sed -i 's/background_opacity [0-9.]*/background_opacity 1.0/' "$kconf" 2>/dev/null || true
        fi
    done
    pkill -SIGUSR1 kitty 2>/dev/null || true

    # 4. Waybar dynamic battery color (Android Yellow #f1c40f)
    for dir in "$HOME/.config/waybar" "/home/rhythmcreative/.config/waybar"; do
        if [ -d "$dir" ]; then
            cat > "$dir/powersave.css" << 'EOF'
/* Modo ahorro de bateria activado (estilo Android) */
window#waybar #battery:not(.charging),
window#waybar #battery.bat0:not(.charging),
window#waybar #battery.bat1:not(.charging),
window#waybar #custom-desktop-power {
    color: #f1c40f;
}
EOF
        fi
    done
    pkill -SIGUSR2 waybar >/dev/null 2>&1 || true

    # 5. Desktop Notification
    notify-send -a "Ahorro de Batería" -i battery-caution "Ahorro de batería activado" "Rendimiento optimizado, ventanas sólidas y bajo consumo" 2>/dev/null || true
    echo "on"
}

disable_powersave() {
    rm -f "$STATE_FILE"

    # 1. Restore CPU to performance / balanced
    if [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
        sudo tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference <<< "performance" >/dev/null 2>&1 || true
    fi

    # 2. Restore previous brightness if saved
    if [ -f "$BRIGHTNESS_BACKUP" ] && command -v brightnessctl >/dev/null 2>&1; then
        saved_b=$(cat "$BRIGHTNESS_BACKUP")
        if [ -n "$saved_b" ]; then
            brightnessctl set "$saved_b" >/dev/null 2>&1 || true
        fi
        rm -f "$BRIGHTNESS_BACKUP"
    fi

    # 3. Reload Hyprland config to restore animations, blur, shadows, and default window transparency
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    fi

    # Restore kitty background opacity to 0.85
    for kconf in "$HOME/.config/kitty/kitty.conf" "/home/rhythmcreative/.config/kitty/kitty.conf"; do
        if [ -f "$kconf" ]; then
            sed -i 's/background_opacity [0-9.]*/background_opacity 0.85/' "$kconf" 2>/dev/null || true
        fi
    done
    pkill -SIGUSR1 kitty 2>/dev/null || true

    # 4. Waybar restore standard palette colors
    for dir in "$HOME/.config/waybar" "/home/rhythmcreative/.config/waybar"; do
        if [ -d "$dir" ]; then
            > "$dir/powersave.css"
        fi
    done
    pkill -SIGUSR2 waybar >/dev/null 2>&1 || true

    # 5. Desktop Notification
    notify-send -a "Ahorro de Batería" -i battery-good "Ahorro de batería desactivado" "Rendimiento y efectos visuales normales restaurados" 2>/dev/null || true
    echo "off"
}

case "$ACTION" in
    status)
        if is_active; then
            echo "on"
        else
            echo "off"
        fi
        ;;
    on)
        enable_powersave
        ;;
    off)
        disable_powersave
        ;;
    toggle|*)
        if is_active; then
            disable_powersave
        else
            enable_powersave
        fi
        ;;
esac

#!/usr/bin/env bash
# Sincronizador de transicion de wallpaper con Waybar, Quickshell y Rust-Dock

WALLPAPER_PATH="$1"
if [ -z "$WALLPAPER_PATH" ] || [ ! -f "$WALLPAPER_PATH" ]; then
    echo "Usage: sync-wallpaper-animation <wallpaper_file>"
    exit 1
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    [ -n "$WL_DISP" ] && export WAYLAND_DISPLAY=$(basename "$WL_DISP") || export WAYLAND_DISPLAY="wayland-1"
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | grep -v '\.lock$' | head -n1)
fi

echo "$WALLPAPER_PATH" > "$HOME/.cache/current-wallpaper"

# 1. ANIMACION DE SALIDA: Ocultar barras suavemente
quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island hide >/dev/null 2>&1 || true
pkill -SIGUSR1 waybar 2>/dev/null || true
pkill -SIGUSR1 rust-dock 2>/dev/null || true

# 2. INICIAR TRANSICION DE WALLPAPER CON AWWW (1.5 segundos)
if command -v awww &>/dev/null; then
    awww img "$WALLPAPER_PATH" --transition-type grow --transition-pos center --transition-duration 1.5 --transition-fps 60 &
fi

# 3. GENERAR PALETA DE COLORES Y ACTUALIZAR COMPONENTES (en segundo plano durante la transicion)
(
    # Generar colores con Pywal
    if command -v wal &>/dev/null; then
        wal -i "$WALLPAPER_PATH" -n -q
    fi

    # Actualizar GTK, Qt, Rofi, Mako y preparar Waybar/Rust-dock
    if [ -x "$HOME/.local/bin/modern-pywal-sync" ]; then
        "$HOME/.local/bin/modern-pywal-sync" >/dev/null 2>&1
    fi
) &

# 4. ESPERAR A QUE LA TRANSICION DEL WALLPAPER CASI COMPLETE (1.3s)
sleep 1.3

# 5. ANIMACION DE ENTRADA SINCRONIZADA: Revelar Waybar, Dynamic Island y Rust-Dock al unisono
quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island reveal >/dev/null 2>&1 || true
pkill -SIGUSR2 waybar 2>/dev/null || true
pkill -SIGUSR2 rust-dock 2>/dev/null || true


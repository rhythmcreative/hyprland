#!/bin/bash
# mic-osd-toggle - Global mic mute toggle with notify-send OSD.
#
# Usage:
#   mic-osd-toggle [toggle|mute|unmute|status|ptt-down|ptt-up]
#     toggle   flip mute state (default)
#     mute     force mute
#     unmute   force unmute
#     status   print MUTED or LIVE
#     ptt-down momentary push-to-talk press (unmute)
#     ptt-up   momentary push-to-talk release (mute)
#
# Push-to-talk wiring (if your Hyprland build exposes key-release binds):
#   bind SUPER+SHIFT+N to `mic-osd-toggle ptt-down` on press and
#   `mic-osd-toggle ptt-up` on release. Until then, SUPER+SHIFT+M toggle
#   plus XF86AudioMicMute (also routed here for OSD) covers daily use.
#
# Backend: wpctl preferred, pactl fallback. English notifications, no emojis.
set -euo pipefail

APP="Microphone"
REPLACE_ID=9101

is_muted() {
    if command -v wpctl >/dev/null 2>&1; then
        if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q "MUTED"; then
            return 0
        else
            return 1
        fi
    fi
    local m
    m=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null || echo "Mute: no")
    [[ "$m" == *"yes"* ]]
}

do_mute() {
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1
    else
        pactl set-source-mute @DEFAULT_SOURCE@ 1
    fi
    notify-send -a "$APP" -r "$REPLACE_ID" -t 1500 -u normal "Microphone MUTED" "Input is muted." 2>/dev/null || true
}

do_unmute() {
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
    else
        pactl set-source-mute @DEFAULT_SOURCE@ 0
    fi
    notify-send -a "$APP" -r "$REPLACE_ID" -t 1500 -u low "Microphone LIVE" "Input is live." 2>/dev/null || true
}

case "${1:-toggle}" in
    mute|ptt-up)
        do_mute
        ;;
    unmute|ptt-down)
        do_unmute
        ;;
    status)
        if is_muted; then
            echo "MUTED"
        else
            echo "LIVE"
        fi
        ;;
    toggle|*)
        if is_muted; then
            do_unmute
        else
            do_mute
        fi
        ;;
esac

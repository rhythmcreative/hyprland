#!/bin/bash
# toggle-caffeine: persistent idle/sleep inhibitor for the Dynamic Island.

STATE_FILE="/tmp/caffeine-active"
ACTION="${1:-toggle}"
SERVICE="rhythm-caffeine.service"

stop_hypridle() {
    pkill -STOP -x hypridle 2>/dev/null || true
}

cont_hypridle() {
    pkill -CONT -x hypridle 2>/dev/null || true
}

enable() {
    touch "$STATE_FILE"
    stop_hypridle
    if ! systemctl --user start "$SERVICE"; then
        rm -f "$STATE_FILE"
        cont_hypridle
        notify-send "Awake Mode" "Could not start the idle inhibitor service." 2>/dev/null || true
        echo "error"
        return 1
    fi
    echo "on"
}

disable() {
    rm -f "$STATE_FILE"
    systemctl --user stop "$SERVICE" 2>/dev/null || true
    cont_hypridle
    echo "off"
}

case "$ACTION" in
    status)
        if [ -f "$STATE_FILE" ]; then
            # Recover the supervised inhibitor if it was interrupted.
            systemctl --user is-active --quiet "$SERVICE" || systemctl --user start "$SERVICE" >/dev/null 2>&1 || true
            stop_hypridle
            echo "on"
        else
            echo "off"
        fi
        ;;
    on)
        enable
        ;;
    off)
        disable
        ;;
    toggle|*)
        if [ -f "$STATE_FILE" ]; then
            disable
        else
            enable
        fi
        ;;
esac

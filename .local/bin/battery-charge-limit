#!/usr/bin/env bash
# Limite de carga de las baterias, para cualquier dispositivo.
#
#   battery-charge-limit              muestra el limite actual de cada bateria
#   battery-charge-limit 80           pone el limite al 80 % en todas
#   battery-charge-limit 80 BAT1      solo en BAT1
#   battery-charge-limit off          quita el limite (100 %)
#   battery-charge-limit --apply      reaplica el limite guardado en
#                                     ~/.config/rhythm/battery-limit.conf
#
# Se escribe en /sys/class/power_supply/BAT*/charge_control_end_threshold, que es
# la interfaz del kernel y funciona en cualquier portatil que la soporte, sin
# depender de la marca. El fichero es de root, asi que el script se reejecuta
# con sudo o pkexec una sola vez para todos los dispositivos, en vez de uno por
# uno y con una contrasena por bateria.
#
# Se comprueba despues de escribir que el valor ha quedado puesto: algunos
# controladores la ignoran en silencio si el numero no es uno de los que
# aceptan, y sin comprobarlo la isla dira que el limite esta puesto y no lo
# estara. Los limites que suelen aceptar van del 50 al 95 y el 100.

set -u
BASE="/sys/class/power_supply"

# Fichero con el limite elegido desde la isla, que --apply vuelve a poner.
#
# Vive en ~/.local/state y no en ~/.config porque es estado mutable de la
# maquina, no configuracion del usuario: el repo despliega .config/rhythm/ (la
# isla lee ahi) y meter estado dentro de un directorio que el update re-pone
# es la Via rapida a que un dia lo pise. La ruta vieja se sigue leyendo si
# existe, para no perder el valor de quien ya lo tenga puesto a mano.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rhythm"
CONF_NEW="$STATE_DIR/battery-limit.conf"
CONF_OLD="${XDG_CONFIG_HOME:-$HOME/.config}/rhythm/battery-limit.conf"
CONF="$CONF_NEW"

migrar_conf() {
    # Si solo existe en la ruta vieja, se lleva a la nueva. Se hace al leer,
    # no en el arranque del sistema, para que mover el fichero no dependa de
    # cuando se ejecuta esto.
    if [ ! -f "$CONF_NEW" ] && [ -f "$CONF_OLD" ]; then
        mkdir -p "$STATE_DIR" 2>/dev/null && mv "$CONF_OLD" "$CONF_NEW" 2>/dev/null
    fi
}

# Lee charge_limit de ese fichero. Acepta "80", "off", "max"... con o sin
# espacios alrededor del "=", que es como lo puede haber escrito a mano.
leer_conf() {
    migrar_conf
    [ -r "$CONF" ] || return 1
    local v
    v=$(sed -n 's/^[[:space:]]*charge_limit[[:space:]]*=[[:space:]]*//p' "$CONF" | head -n1)
    [ -n "$v" ] || return 1
    printf '%s' "$v"
}

# Guarda el limite para que --apply lo vuelva a poner tras un reinicio. Sin
# esto la isla escribia en el kernel y el valor se perdia al reiniciar, que es
# justo lo que rhythm-battery-limit.service existe para arreglar.
guardar_conf() {
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf 'charge_limit=%s\n' "$1" > "$CONF" 2>/dev/null || true
}

baterias() {
    for d in "$BASE"/BAT*; do
        [ -d "$d" ] || continue
        [ -e "$d/capacity" ] || continue
        basename "$d"
    done
}

limite_actual() {
    local d="$BASE/$1/charge_control_end_threshold"
    [ -e "$d" ] && cat "$d" 2>/dev/null || echo ""
}

# Sin argumentos: solo informar.
if [ $# -eq 0 ]; then
    for b in $(baterias); do
        lim=$(limite_actual "$b")
        printf '%s\t%s\n' "$b" "${lim:-sin limite}"
    done
    exit 0
fi

# --apply: reaplica el limite guardado en el conf.
#
# El kernel no guarda charge_control_end_threshold entre arranques, asi que al
# reiniciar vuelve a 100. rhythm-battery-limit.service llama a esto en cada
# arranque para volver a dejar el limite como estaba.
#
# A proposito NO hace falta ningun argumento mas: lo lee todo del conf. Si se
# pasara el valor por aqui, la unidad tendria que duplicar la ruta del fichero
# y podrian desincronizarse.
if [ "${1:-}" = "--apply" ]; then
    if ! pct=$(leer_conf); then
        # Sin conf no hay nada que reaplicar. No es un fallo: recien instalar,
        # o si el usuario todavia no ha elegido limite. Salir 0 para que la
        # unidad no se quede en failed y ensucie `systemctl --failed`.
        echo "battery-charge-limit: sin $CONF, nada que aplicar" >&2
        exit 0
    fi

    # Se normaliza con las mismas reglas que un argumento normal, para que un
    # conf con "off" o "95" se comporten igual que escribiendolo a mano.
    case "$pct" in
        off|off-|max|full|100) pct=100 ;;
        [0-9]*) ;;
        *) echo "battery-charge-limit: valor no valido en $CONF: $pct" >&2; exit 1 ;;
    esac
    if [ "$pct" -lt 20 ] 2>/dev/null || [ "$pct" -gt 100 ] 2>/dev/null; then
        echo "battery-charge-limit: el limite va de 20 a 100" >&2
        exit 1
    fi

    targets=$(baterias)
    if [ -z "$targets" ]; then
        echo "battery-charge-limit: no hay baterias" >&2
        exit 1
    fi
    set -- "$pct" $targets
    # Marca de que este limite viene del conf y no de una eleccion nueva: no
    # se vuelve a guardar, o un conf corrupto se reescribiria a si mismo.
    _DESDE_CONF=1
fi

# Reejecucion con privilegios: este guion reejecutandose a si mismo con
# --escribir, que salta toda la validacion y solo escribe.
if [ "${1:-}" = "--escribir" ]; then
    shift
    _valor="$1"; shift
    for _b in "$@"; do
        echo "$_valor" > "$BASE/$_b/charge_control_end_threshold" 2>/dev/null
    done
    exit 0
fi

pct="$1"; shift

# "off" o "max" significan quitar el limite.
case "$pct" in
    off|off-|max|full|100) valor=100 ;;
    [0-9]*) valor="$pct" ;;
    *) echo "battery-charge-limit: porcentaje no valido: $pct" >&2; exit 1 ;;
esac

if [ "$valor" -lt 20 ] 2>/dev/null || [ "$valor" -gt 100 ] 2>/dev/null; then
    echo "battery-charge-limit: el limite va de 20 a 100" >&2
    exit 1
fi

targets="$*"
[ -n "$targets" ] || targets=$(baterias)
[ -n "$targets" ] || { echo "battery-charge-limit: no hay baterias" >&2; exit 1; }

# Una eleccion explicita se guarda para que sobreviva a un reinicio. Antes la
# isla escribia solo en el kernel: el limite se perdia al apagar, y
# rhythm-battery-limit.service no tenia de donde leerlo porque nadie escribia
# el conf. Eso es justo lo que rompia la unit en cada arranque.
if [ "${_DESDE_CONF:-0}" != "1" ] && [ "$valor" != "100" ]; then
    guardar_conf "$valor"
fi

escribir() {
    local b
    for b in $targets; do
        echo "$valor" > "$BASE/$b/charge_control_end_threshold" 2>/dev/null
    done
}

if [ "$(id -u)" = "0" ]; then
    escribir
else
    # Un solo ascenso de privilegios para todas las baterias. Se reejecuta
    # con --escribir para no dejar un comando con formato en el arbol de procesos del root.
    _helper="/usr/local/lib/rhythm/battery-charge-limit"
    if [ -x "$_helper" ] && sudo -n "$_helper" --escribir "$valor" $targets 2>/dev/null; then
        :
    elif sudo -n true 2>/dev/null; then
        sudo -n "$0" --escribir "$valor" $targets 2>/dev/null
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec "$0" --escribir "$valor" $targets 2>/dev/null
    else
        echo "battery-charge-limit: hace falta sudo o pkexec" >&2
        exit 1
    fi
fi

# Verificar. El exit code lo decide lo que quedo realmente puesto.
fallos=0
for b in $targets; do
    ahora=$(limite_actual "$b")
    if [ "$ahora" != "$valor" ]; then
        echo "battery-charge-limit: $b se quedo en ${ahora:-desconocido}, no en $valor" >&2
        fallos=$((fallos + 1))
    else
        echo "$b $valor"
    fi
done
[ "$fallos" -eq 0 ] || exit 1
exit 0
#!/usr/bin/env bash
# ota-snapshot: Non-interactive pre-OTA filesystem & config snapshot helper.
# Cross-distro: btrfs subvolumes, timeshift, snapper, or config fallback.
# Strictly non-interactive (sudo -n / doas -n only) so detached OTA never hangs.

set -euo pipefail

SNAP_ID="ota-$(date +%Y%m%d_%H%M%S)"
KEEP=5
HOME_SNAP_BASE="$HOME/.snapshots"
ROOT_SNAP_BASE="/.snapshots"
BACKUP_BASE="$HOME/.config.backup"

REPO_DIR="${RHYTHM_DOTFILES_DIR:-$HOME/hyprland}"
if [ ! -d "$REPO_DIR/.git" ]; then
    _self_repo=$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$_self_repo" ] && [ -d "$_self_repo/.git" ]; then
        REPO_DIR="$_self_repo"
    elif [ -d "$HOME/dotfiles/.git" ]; then
        REPO_DIR="$HOME/dotfiles"
    fi
fi

# Non-interactive privilege runner (never blocks on password prompts)
run_priv_ni() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        sudo -n "$@"
    elif command -v doas >/dev/null 2>&1 && doas -n true 2>/dev/null; then
        doas -n "$@"
    else
        return 1
    fi
}

usage() {
    cat << 'EOF'
ota-snapshot: Pre-OTA filesystem snapshot helper (non-interactive)

Usage: ota-snapshot [options]

Options:
  --list        List existing snapshots/backups and exit
  --fs-only     Only attempt filesystem snapshots, skip config fallback
  -h, --help    Show this help and exit
EOF
}

is_btrfs_mount() {
    local fstype
    fstype=$(findmnt -n -o FSTYPE "$1" 2>/dev/null || true)
    [ "$fstype" = "btrfs" ]
}

btrfs_has_subvolumes() {
    btrfs subvolume list / >/dev/null 2>&1 || run_priv_ni btrfs subvolume list / >/dev/null 2>&1
}

prune_dir() {
    local base="$1" use_priv="${2:-false}" entries count=0 entry
    if [ "$use_priv" = "true" ]; then
        entries=$(run_priv_ni ls -1t "$base" 2>/dev/null || true)
    else
        entries=$(ls -1t "$base" 2>/dev/null || true)
    fi
    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        count=$((count + 1))
        if [ "$count" -gt "$KEEP" ]; then
            if [ "$use_priv" = "true" ]; then
                run_priv_ni btrfs subvolume delete "$base/$entry" >/dev/null 2>&1 \
                    || run_priv_ni rm -rf "$base/$entry" >/dev/null 2>&1 || true
            else
                btrfs subvolume delete "$base/$entry" >/dev/null 2>&1 \
                    || run_priv_ni btrfs subvolume delete "$base/$entry" >/dev/null 2>&1 \
                    || rm -rf "$base/$entry" >/dev/null 2>&1 || true
            fi
        fi
    done <<< "$entries"
}

snapshot_home_btrfs() {
    is_btrfs_mount "/home" || is_btrfs_mount "/" || return 1
    mkdir -p "$HOME_SNAP_BASE"
    if btrfs subvolume snapshot -r /home "$HOME_SNAP_BASE/$SNAP_ID" >/dev/null 2>&1; then
        echo "Home snapshot created at $HOME_SNAP_BASE/$SNAP_ID."
        prune_dir "$HOME_SNAP_BASE" "false"
        return 0
    fi
    if run_priv_ni btrfs subvolume snapshot -r /home "$HOME_SNAP_BASE/$SNAP_ID" >/dev/null 2>&1; then
        echo "Home snapshot created at $HOME_SNAP_BASE/$SNAP_ID."
        prune_dir "$HOME_SNAP_BASE" "false"
        return 0
    fi
    return 1
}

snapshot_root_btrfs() {
    is_btrfs_mount "/" || return 1
    run_priv_ni mkdir -p "$ROOT_SNAP_BASE" >/dev/null 2>&1 || return 1
    if run_priv_ni btrfs subvolume snapshot -r / "$ROOT_SNAP_BASE/$SNAP_ID" >/dev/null 2>&1; then
        echo "Root snapshot created at $ROOT_SNAP_BASE/$SNAP_ID."
        prune_dir "$ROOT_SNAP_BASE" "true"
        return 0
    fi
    return 1
}

snapshot_timeshift_snapper() {
    if command -v timeshift >/dev/null 2>&1; then
        if run_priv_ni timeshift --create --comments "ota-$SNAP_ID" >/dev/null 2>&1; then
            echo "Timeshift snapshot created."
            return 0
        fi
    fi
    if command -v snapper >/dev/null 2>&1; then
        if run_priv_ni snapper -c root create -d "ota-$SNAP_ID" >/dev/null 2>&1; then
            echo "Snapper snapshot created."
            return 0
        fi
    fi
    return 1
}

config_fallback_backup() {
    local target="$BACKUP_BASE/$SNAP_ID" dir
    mkdir -p "$target"
    echo "Creating config backup at $target..."
    for dir in hypr waybar quickshell rofi kitty mako rust-dock rhythm; do
        [ -d "$HOME/.config/$dir" ] && cp -a "$HOME/.config/$dir" "$target/$dir" 2>/dev/null || true
    done
    [ -d "$HOME/.local/bin" ] && cp -a "$HOME/.local/bin" "$target/bin" 2>/dev/null || true

    local commit="unknown" version="unknown"
    [ -d "$REPO_DIR/.git" ] && commit=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo "unknown")
    [ -f "$REPO_DIR/.version" ] && version=$(tr -d '[:space:]' < "$REPO_DIR/.version")

    if command -v jq >/dev/null 2>&1; then
        jq -n --arg id "$SNAP_ID" --arg created_at "$(date -Iseconds)" --arg version "$version" --arg commit "$commit" \
            '{id: $id, created_at: $created_at, version: $version, commit: $commit}' > "$target/checkpoint.json"
    else
        printf '{"id":"%s","created_at":"%s","version":"%s","commit":"%s"}\n' \
            "$SNAP_ID" "$(date -Iseconds)" "$version" "$commit" > "$target/checkpoint.json"
    fi
    prune_dir "$BACKUP_BASE" "false"
    echo "Config backup $SNAP_ID created."
}

list_snapshots() {
    echo "=== Home btrfs snapshots ($HOME_SNAP_BASE) ==="
    ls -1t "$HOME_SNAP_BASE" 2>/dev/null || echo "(none)"
    echo ""
    echo "=== Root btrfs snapshots ($ROOT_SNAP_BASE) ==="
    run_priv_ni ls -1t "$ROOT_SNAP_BASE" 2>/dev/null || ls -1t "$ROOT_SNAP_BASE" 2>/dev/null || echo "(none)"
    echo ""
    echo "=== Config backups ($BACKUP_BASE) ==="
    ls -1t "$BACKUP_BASE" 2>/dev/null || echo "(none)"
}

FS_ONLY=false
for arg in "$@"; do
    case "$arg" in
        --list) list_snapshots; exit 0 ;;
        --fs-only) FS_ONLY=true ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $arg" >&2; usage >&2; exit 1 ;;
    esac
done

did_snapshot=false
if command -v btrfs >/dev/null 2>&1 && btrfs_has_subvolumes; then
    snapshot_home_btrfs || true
    snapshot_root_btrfs || true
    if [ -d "$HOME_SNAP_BASE/$SNAP_ID" ] || [ -d "$ROOT_SNAP_BASE/$SNAP_ID" ]; then
        did_snapshot=true
    fi
elif snapshot_timeshift_snapper; then
    did_snapshot=true
fi

if [ "$did_snapshot" = "true" ]; then
    echo "Pre-OTA snapshot $SNAP_ID finished."
    exit 0
fi

if [ "$FS_ONLY" = "true" ]; then
    echo "No filesystem snapshot backend available (fs-only mode)."
    exit 1
fi

config_fallback_backup
echo "Pre-OTA snapshot $SNAP_ID finished."

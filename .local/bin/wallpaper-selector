#!/bin/bash
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# Selector de Wallpapers Premium - Versión SÚPER RÁPIDA
# Optimizado para carga instantánea y sincronización inmediata de UI/GTK

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi
buscar_hypr_firma() {
    local d s dir
    for dir in "$XDG_RUNTIME_DIR/hypr" "/tmp/hypr"; do
        [ -d "$dir" ] || continue
        for d in $(ls -t "$dir" 2>/dev/null); do
            [ -d "$dir/$d" ] || continue
            s="$d"
            [ -n "$s" ] || continue
            if [ -S "$dir/$d/.socket2.sock" ] ||
               [ -S "$dir/$d.socket2.sock" ] ||
               [ -S "$dir/$d/.socket.sock" ]; then
                printf '%s\n' "$s"
                return 0
            fi
        done
    done
    return 1
}

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    if HYPR_SIG="$(buscar_hypr_firma)"; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    elif [ -d "$XDG_RUNTIME_DIR/hypr" ]; then
        HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
        [ -n "$HYPR_SIG" ] && export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

if [ ! -f "$HOME/.config/rofi/colors-pywal.rasi" ] || [ ! -f "$HOME/.config/rofi/colors-rofi-dark.rasi" ]; then
    mkdir -p "$HOME/.config/rofi" "$HOME/.cache/wal"
    if [ ! -f "$HOME/.config/rofi/colors-pywal.rasi" ]; then
        cat > "$HOME/.config/rofi/colors-pywal.rasi" <<'ROFI_EOF'
* {
    background: #101012;
    background-alt: #101012;
    foreground: #c2c8c9;
    foreground-alt: #878c8c;
    selected: #546065;
    active: #A45E4C;
    urgent: #E59A78;
    color0: #101012;
    color1: #546065;
    color2: #A45E4C;
    color3: #E59A78;
    color4: #5B7A84;
    color5: #6F8C94;
    color6: #9A9D9E;
    color7: #c2c8c9;
    color8: #878c8c;
    color9: #546065;
    color10: #A45E4C;
    color11: #E59A78;
    color12: #5B7A84;
    color13: #6F8C94;
    color14: #9A9D9E;
    color15: #c2c8c9;
    background-trans: #101012CC;
    background-alt-trans: #101012AA;
    selected-trans: #546065DD;
}
ROFI_EOF
        cp -f "$HOME/.config/rofi/colors-pywal.rasi" "$HOME/.cache/wal/colors-rofi.rasi" 2>/dev/null || true
    fi
    if [ ! -f "$HOME/.config/rofi/colors-rofi-dark.rasi" ] && [ ! -f "$HOME/.cache/wal/colors-rofi-dark.rasi" ]; then
        cat > "$HOME/.cache/wal/colors-rofi-dark.rasi" <<'ROFI_EOF'
* {
    active-background: #A45E4C;
    active-foreground: @foreground;
    normal-background: @background;
    normal-foreground: @foreground;
    urgent-background: #546065;
    urgent-foreground: @foreground;
    alternate-active-background: @background;
    alternate-active-foreground: @foreground;
    alternate-normal-background: @background;
    alternate-normal-foreground: @foreground;
    selected-active-background: #A45E4C;
    selected-active-foreground: @foreground;
    selected-normal-background: #546065;
    selected-normal-foreground: @foreground;
    selected-urgent-background: #546065;
    selected-urgent-foreground: @foreground;
    background-color: @background;
    border-color: @background;
    spacing: 2;
}
ROFI_EOF
        cp -f "$HOME/.cache/wal/colors-rofi-dark.rasi" "$HOME/.config/rofi/colors-rofi-dark.rasi" 2>/dev/null || true
    fi
    if [ -x "$HOME/.local/bin/modern-pywal-sync" ]; then
        "$HOME/.local/bin/modern-pywal-sync" >/dev/null 2>&1 &
    fi
fi

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"

# Pantalla activa: las barras se ocultan solo en la pantalla enfocada, igual que
# hacen los menus de red, para que el resto de pantallas no se queden a medias.
get_active_monitor() {
    local mon
    mon=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
    [ -n "$mon" ] && [ "$mon" != "null" ] && echo "$mon" && return
    echo ""
}
ISLAND_TARGET="$(get_active_monitor)"
[ -n "$ISLAND_TARGET" ] || ISLAND_TARGET="all"
PREVIEW_DIR="$HOME/.cache/wallpaper-previews"
ROFI_THEME="$HOME/.config/rofi/wallpaper-select-pywal.rasi"

# Hide/reveal only the active monitor's bars. wallpaper-bars targets the
# matching Waybar config, rust-dock -o output, and Quickshell screen.
hide_all_bars() {
    "$HOME/.local/bin/wallpaper-bars" hide "$ISLAND_TARGET"
}

show_all_bars() {
    "$HOME/.local/bin/wallpaper-bars" show "$ISLAND_TARGET"
}

cleanup() {
    show_all_bars
    rm -f "$TEMP_LIST" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Verificar si el directorio existe o sembrar default si está vacío
mkdir -p "$WALLPAPER_DIR" "$PREVIEW_DIR"
if ! compgen -G "$WALLPAPER_DIR/*" >/dev/null 2>&1; then
    for def in "$HOME/.config/hypr/wallpapers/default.jpg" "/usr/share/hypr/wall0.png"; do
        if [ -f "$def" ]; then
            cp -f "$def" "$WALLPAPER_DIR/default.jpg" 2>/dev/null || true
            break
        fi
    done
fi

# 1. Obtener lista de imágenes (cacheada en variable para velocidad)
mapfile -t images < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.bmp" \) | sort)

if [[ ${#images[@]} -eq 0 ]]; then
    rofi-themed -e "No se encontraron imágenes en $WALLPAPER_DIR"
    exit 1
fi

# 2. Generar miniaturas que falten en paralelo antes de abrir Rofi
missing_thumbs=()
for img in "${images[@]}"; do
    bname="${img##*/}"
    pthumb="$PREVIEW_DIR/${bname%.*}_thumb.jpg"
    [ ! -f "$pthumb" ] && missing_thumbs+=("$img")
done

if [ ${#missing_thumbs[@]} -gt 0 ]; then
    conv="magick"
    command -v magick >/dev/null 2>&1 || conv="convert"
    if command -v "$conv" >/dev/null 2>&1; then
        printf '%s\n' "${missing_thumbs[@]}" | xargs -P 4 -I {} sh -c '
            img="$1"
            base="$(basename "$img")"
            thumb="'"$PREVIEW_DIR"'/${base%.*}_thumb.jpg"
            "'"$conv"'" "$img" -thumbnail 300x200^ -gravity center -extent 300x200 "$thumb" 2>/dev/null || true
        ' _ {} || true
    fi
fi

# 3. Generar lista para rofi (Buscador oculto por CSS, filtrado por texto activo)
TEMP_LIST=$(mktemp)
for img in "${images[@]}"; do
    basename_img="${img##*/}"
    clean_name="${basename_img%.*}"
    preview_path="$PREVIEW_DIR/${basename_img%.*}_thumb.jpg"
    
    # Icono inteligente (usa preview optimizado)
    if [[ -f "$preview_path" ]]; then
        icon_path="$preview_path"
    else
        icon_path="$img"
    fi
    
    echo -e "$basename_img\0icon\x1f$icon_path" >> "$TEMP_LIST"
done

# 4. Mostrar rofi (Carga instantánea)
hide_all_bars
selected=$(rofi-themed -dmenu -i \
    -p "Wallpapers" \
    -theme "$ROFI_THEME" \
    -show-icons \
    -markup-rows \
    < "$TEMP_LIST")

rm -f "$TEMP_LIST"

# Si no se seleccionó nada, restaurar barras y salir
if [[ -z "$selected" ]]; then
    show_all_bars
    exit 0
fi

# Encontrar ruta completa
selected_path="$WALLPAPER_DIR/$selected"
if [[ ! -f "$selected_path" ]]; then
    show_all_bars
    exit 1
fi

# 5. APLICACIÓN CON ANIMACIÓN SINCRONIZADA
# Desarmar el trap de salida para evitar que show_all_bars parpadee antes de tiempo
trap - EXIT INT TERM
rm -f "$TEMP_LIST" 2>/dev/null || true

# Ejecutar transicion suave (las barras ya estan ocultas, sin parpadeos dobles)
"$HOME/.local/bin/sync-wallpaper-animation" "$selected_path"

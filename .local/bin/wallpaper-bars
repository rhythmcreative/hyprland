#!/usr/bin/env bash
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
# wallpaper-bars: hide or reveal the bars around a wallpaper change.
#
#   wallpaper-bars hide    before the wallpaper is swapped
#   wallpaper-bars show    once the new wallpaper and palette are in place
#
# Shared by every wallpaper entry point so all of them animate the same way:
# the island and the dock slide away, the wallpaper changes, they come back.

get_focused_monitor() {
    hyprctl monitors -j 2>/dev/null \
        | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null \
        | head -n1
}

monitor="${2:-}"
if [ -z "$monitor" ]; then
    if [ "${1:-}" = "show" ] && [ -s /tmp/wallpaper-bars-monitor ]; then
        monitor=$(cat /tmp/wallpaper-bars-monitor)
    else
        monitor=$(get_focused_monitor)
    fi
fi
[ -n "$monitor" ] && [ "$monitor" != "null" ] || monitor="all"

waybar_pids_for_monitor() {
    local pid cmd
    while read -r pid; do
        [ -n "$pid" ] || continue
        cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
        case "$cmd" in
            *"config-$monitor "*|*"config-$monitor"|*"--config $HOME/.config/waybar/config-$monitor"*)
                echo "$pid"
                ;;
        esac
    done < <(pgrep -x waybar 2>/dev/null; pgrep -x .waybar-wrapped 2>/dev/null || true)
}

dock_pids_for_monitor() {
    local pid cmd
    while read -r pid; do
        [ -n "$pid" ] || continue
        cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
        case "$cmd" in
            *" -o $monitor"|*" -o $monitor "*) echo "$pid" ;;
        esac
    done < <(pgrep -x rust-dock 2>/dev/null; pgrep -x .rust-dock-wrap 2>/dev/null; pgrep -x .rust-dock-wrapped 2>/dev/null || true)
}

case "${1:-}" in
    hide)
        if [ -f /tmp/wallpaper-bars-hidden ]; then
            exit 0
        fi
        touch /tmp/wallpaper-bars-hidden
        [ "$monitor" = "all" ] || echo "$monitor" > /tmp/wallpaper-bars-monitor
        if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
            quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" \
                --any-display call island hide "$monitor" >/dev/null 2>&1 || true
        fi
        if [ "$monitor" = "all" ]; then
            pkill -SIGUSR1 -x waybar >/dev/null 2>&1 || true
            pkill -SIGUSR1 -x .waybar-wrapped >/dev/null 2>&1 || true
            pkill -SIGUSR1 -x rust-dock >/dev/null 2>&1 || true
            pkill -SIGUSR1 -x .rust-dock-wrap >/dev/null 2>&1 || true
            pkill -SIGUSR1 -x .rust-dock-wrapped >/dev/null 2>&1 || true
        else
            matched=0
            while read -r pid; do [ -n "$pid" ] && { kill -USR1 "$pid" 2>/dev/null || true; matched=1; }; done < <(waybar_pids_for_monitor)
            if [ "$matched" -eq 0 ]; then
                "$HOME/.local/bin/dock-procs" waybar signal "$monitor" USR1 2>/dev/null || \
                pkill -SIGUSR1 -x waybar 2>/dev/null || \
                pkill -SIGUSR1 -x .waybar-wrapped 2>/dev/null || true
            fi
            matched_d=0
            while read -r pid; do [ -n "$pid" ] && { kill -USR1 "$pid" 2>/dev/null || true; matched_d=1; }; done < <(dock_pids_for_monitor)
            if [ "$matched_d" -eq 0 ]; then
                "$HOME/.local/bin/dock-procs" rust-dock signal "$monitor" USR1 2>/dev/null || \
                pkill -SIGUSR1 -x rust-dock 2>/dev/null || \
                pkill -SIGUSR1 -x .rust-dock-wrap 2>/dev/null || \
                pkill -SIGUSR1 -x .rust-dock-wrapped 2>/dev/null || true
            fi
        fi
        ;;
    show)
        rm -f /tmp/wallpaper-bars-hidden
        if [ "$monitor" = "all" ]; then
            pkill -SIGUSR2 -x waybar >/dev/null 2>&1 || true
            pkill -SIGUSR2 -x .waybar-wrapped >/dev/null 2>&1 || true
            pkill -SIGUSR2 -x rust-dock >/dev/null 2>&1 || true
            pkill -SIGUSR2 -x .rust-dock-wrap >/dev/null 2>&1 || true
            pkill -SIGUSR2 -x .rust-dock-wrapped >/dev/null 2>&1 || true
        else
            matched=0
            while read -r pid; do [ -n "$pid" ] && { kill -USR2 "$pid" 2>/dev/null || true; matched=1; }; done < <(waybar_pids_for_monitor)
            if [ "$matched" -eq 0 ]; then
                "$HOME/.local/bin/dock-procs" waybar signal "$monitor" USR2 2>/dev/null || \
                pkill -SIGUSR2 -x waybar 2>/dev/null || \
                pkill -SIGUSR2 -x .waybar-wrapped 2>/dev/null || true
            fi
            matched_d=0
            while read -r pid; do [ -n "$pid" ] && { kill -USR2 "$pid" 2>/dev/null || true; matched_d=1; }; done < <(dock_pids_for_monitor)
            if [ "$matched_d" -eq 0 ]; then
                "$HOME/.local/bin/dock-procs" rust-dock signal "$monitor" USR2 2>/dev/null || \
                pkill -SIGUSR2 -x rust-dock 2>/dev/null || \
                pkill -SIGUSR2 -x .rust-dock-wrap 2>/dev/null || \
                pkill -SIGUSR2 -x .rust-dock-wrapped 2>/dev/null || true
            fi
        fi
        if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
            quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" \
                --any-display call island reveal "$monitor" >/dev/null 2>&1 || true
        fi
        rm -f /tmp/wallpaper-bars-monitor
        ;;
    *)
        echo "Usage: wallpaper-bars hide|show" >&2
        exit 1
        ;;
esac

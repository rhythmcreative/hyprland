#!/usr/bin/env bash
# Script para alternar la Dynamic Island de forma rapida y segura

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    elif [ -e "$XDG_RUNTIME_DIR/wayland-0" ]; then
        export WAYLAND_DISPLAY="wayland-0"
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

export QT_QPA_PLATFORM="wayland"

# Arrancar SIEMPRE por la unidad de systemd, para que haya un solo dueño y su
# Restart=always pueda supervisionarla.
#
# Antes se lanzaba quickshell directamente desde aqui, y entonces la isla quedaba
# fuera de la unidad: si se caia, nadie la volvia a levantar. Ese proceso se
# quedaba huerfano, con PPID 1 y en el cgroup session-5.scope, mientras
# waybar-island.service seguia inactive (dead) sin una sola entrada en el journal.
if ! "$HOME/.local/bin/island-running" >/dev/null; then
    if systemctl --user is-enabled waybar-island.service >/dev/null 2>&1; then
        systemctl --user start waybar-island.service >/dev/null 2>&1
    else
        "$HOME/.local/bin/quickshell-island" >/dev/null 2>&1 &
    fi
    sleep 0.8
fi

ACTIVE_MON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
[ -n "$ACTIVE_MON" ] || ACTIVE_MON="eDP-1"
quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island toggle "$ACTIVE_MON" >/dev/null 2>&1

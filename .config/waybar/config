{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "exclusive": true,
  "on-sigusr1": "hide",
  "on-sigusr2": "show",
  "modules-left": [
    "hyprland/workspaces",
    "group/system-info",
    "custom/cava"
  ],
  "modules-center": [],
  "modules-right": [
    "hyprland/language",
    "bluetooth",
    "tray",
    "pulseaudio",
    "backlight",
    "battery"
  ],
  "hyprland/language": {
    "format": "\udb80\udf0c {}",
    "format-en": "US",
    "format-es": "ES",
    "tooltip-format": "Teclado: {long}",
    "on-click": "hyprctl switchxkblayout all next"
  },
  "custom/desktop-power": {
    "format": "\udb81\udea5",
    "tooltip-format": "Equipo de Escritorio - Conectado a CA"
  },
  "battery#bat0": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\udb80\udc84 {capacity}%",
    "format-plugged": "\udb80\udc84 {capacity}%",
    "format-icons": [
      "\udb80\udc7a",
      "\udb80\udc7b",
      "\udb80\udc7c",
      "\udb80\udc7d",
      "\udb80\udc7e",
      "\udb80\udc7f",
      "\udb80\udc80",
      "\udb80\udc81",
      "\udb80\udc82",
      "\udb80\udc79"
    ],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "battery#bat1": {
    "bat": "BAT1",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\udb80\udc84 {capacity}%",
    "format-plugged": "\udb80\udc84 {capacity}%",
    "format-icons": [
      "\udb80\udc7a",
      "\udb80\udc7b",
      "\udb80\udc7c",
      "\udb80\udc7d",
      "\udb80\udc7e",
      "\udb80\udc7f",
      "\udb80\udc80",
      "\udb80\udc81",
      "\udb80\udc82",
      "\udb80\udc79"
    ],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\udb80\udc84 {capacity}%",
    "format-plugged": "\udb80\udc84 {capacity}%",
    "format-icons": [
      "\udb80\udc7a",
      "\udb80\udc7b",
      "\udb80\udc7c",
      "\udb80\udc7d",
      "\udb80\udc7e",
      "\udb80\udc7f",
      "\udb80\udc80",
      "\udb80\udc81",
      "\udb80\udc82",
      "\udb80\udc79"
    ],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "custom/battery-mode": {
    "format": "\udb80\udc84",
    "tooltip-format": "Modo de bater\u00eda",
    "on-click": "true"
  },
  "hyprland/workspaces": {
    "format": "{name} {icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "group/system-info": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature#cpu",
      "custom/nvidia-temp"
    ]
  },
  "bluetooth": {
    "format": "{icon}",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected": "{icon} {num_connections}",
    "format-disabled": "{icon}",
    "format-icons": {
      "enabled": "\udb80\udcaf",
      "disabled": "\udb80\udcb2",
      "off": "\udb80\udcb2",
      "on": "\udb80\udcaf",
      "connected": "\udb80\udcb1"
    },
    "on-click": "blueman-manager",
    "tooltip-format": "{status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "custom/music": {
    "format": "\uf001  {}",
    "escape": true,
    "interval": 5,
    "tooltip": false,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "blueman-manager",
    "max-length": 50
  },
  "clock": {
    "timezone": "Europe/Madrid",
    "tooltip": false,
    "format": "{:%H:%M:%S  -  %A, %d}",
    "interval": 1
  },
  "custom/weather": {
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 300,
    "tooltip": true,
    "on-click": "blueman-manager",
    "signal": 8,
    "restart-interval": 30
  },
  "network": {
    "format-wifi": "\udb82\udd22 {signalStrength}%",
    "format-ethernet": "\udb80\ude00 Connected",
    "format-disconnected": "\udb82\udd20 Disconnected",
    "format-linked": "\udb80\ude01 {ifname}",
    "interval": 5,
    "tooltip-format": "Network: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)\nIP: {ipaddr}\nFrequency: {frequency}MHz",
    "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}\nSpeed: {bandwidthUpBits}/{bandwidthDownBits}",
    "tooltip-format-disconnected": "Network Disconnected",
    "on-click": "blueman-manager",
    "on-click-right": "nm-applet"
  },
  "cpu": {
    "interval": 2,
    "format": "\udb80\udf5b {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": [
      "\u2581",
      "\u2582",
      "\u2583",
      "\u2584",
      "\u2585",
      "\u2586",
      "\u2587",
      "\u2588"
    ],
    "on-click": "blueman-manager"
  },
  "memory": {
    "interval": 5,
    "format": "\udb81\ude1a {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },
  "custom/uptime": {
    "format": "{}",
    "format-icon": [
      "\uf062"
    ],
    "tooltip": false,
    "interval": 1600,
    "exec": "$HOME/.config/waybar/scripts/uptime.sh"
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": [
      "\ue38d",
      "\udb80\udcdc",
      "\udb80\udcdb",
      "\udb80\udcde",
      "\udb80\udcdd",
      "\udb80\udcdf",
      "\udb80\udce0"
    ],
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "\udb81\udf5f",
    "format-icons": {
      "headphone": [
        "\udb80\udecb",
        "\udb80\udecb",
        "\udb80\udecb"
      ],
      "hands-free": [
        "\udb80\udecb",
        "\udb80\udecb",
        "\udb80\udecb"
      ],
      "headset": [
        "\udb80\udecb",
        "\udb80\udecb",
        "\udb80\udecb"
      ],
      "phone": [
        "\udb80\udff2",
        "\udb80\udff2",
        "\udb80\udff2"
      ],
      "portable": [
        "\udb82\udda2",
        "\udb82\udda2",
        "\udb82\udda2"
      ],
      "car": [
        "\udb80\udd0b",
        "\udb80\udd0b",
        "\udb80\udd0b"
      ],
      "default": [
        "\udb81\udd7f",
        "\udb81\udd80",
        "\udb81\udd7e"
      ]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 2,
    "max-volume": 100
  },
  "custom/dual-battery": {
    "exec": "$HOME/.config/waybar/scripts/dual_battery_real.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "tooltip": true,
    "on-click": "true"
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0s; hyprlock)' & disown",
    "format": "\uf023"
  },
  "custom/pomodoro": {
    "format": "{}",
    "return-type": "json",
    "exec": "waybar-module-pomodoro --no-work-icons",
    "on-click": "blueman-manager",
    "on-click-right": "nm-applet"
  },
  "temperature#cpu": {
    "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
    "critical-threshold": 85,
    "format": "\udb81\udd0f {temperatureC}\u00b0C",
    "format-critical": "\udb83\ude01 {temperatureC}\u00b0C",
    "tooltip": true,
    "tooltip-format": "CPU Temperature: {temperatureC}\u00b0C",
    "interval": 10
  },
  "custom/nvidia-temp": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/nvidia-temp.sh",
    "interval": 10,
    "tooltip": true
  },
  "custom/cava": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/cava.sh",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}
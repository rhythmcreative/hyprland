#!/usr/bin/env bash
# Daemon launcher para Dynamic Island de Waybar

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

# Localizar el socket de Wayland.
#
# El numero no se puede dar por supuesto: el compositor elige el primero libre, y
# si se cierra otra sesion puede quedar como wayland-2 o wayland-3. Se descarta
# el .lock, que no es un socket, y el de awww, que es otro compositor.
buscar_socket() {
    local s
    for s in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        case "$s" in
            *.lock|*/wayland-[0-9]*-awww*) continue ;;
        esac
        [ -S "$s" ] && { printf '%s\n' "$s"; return 0; }
    done
    return 1
}

# Esperar a que exista la pantalla.
#
# La unidad arranca con default.target, que se activa antes de que Hyprland cree
# el socket, y quickshell aborta si arranca sin pantalla:
#
#     WARN : Failed to create wl_display (No such file or directory)
#     FATAL: This application failed to start because no Qt platform plugin could be initialized
#
# Antes esto no pasaba porque la unidad nunca llegaba a arrancar: apuntaba a
# graphical-session.target, que está inactivo, así que no se ejecutaba nunca. Al
# corregirlo apareció el fallo contrario, seis reinicios y start-limit-hit, y la
# isla se quedaba sin arrancar del todo.
#
# Sesenta segundos de margen: el socket aparece en cuanto arranca el compositor,
# normalmente en el primer segundo. Se reescanea en cada vuelta porque puede no
# existir ninguno todavia.
esperar_pantalla() {
    local i
    for ((i = 1; i <= 120; i++)); do
        if WAYLAND_DISPLAY="$(buscar_socket)"; then
            export WAYLAND_DISPLAY="$(basename "$WAYLAND_DISPLAY")"
            [ -n "$WAYLAND_DISPLAY" ] && return 0
        fi
        sleep 0.5
    done
    return 1
}

if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    :                       # ya viene con una pantalla valida en el entorno
elif ! esperar_pantalla; then
    echo "quickshell-island: no aparecio ningun socket de Wayland en $XDG_RUNTIME_DIR" >&2
    exit 1                # systemd reintentara cuando se haya arreglado
fi

export QT_QPA_PLATFORM="wayland"

# HYPRLAND_INSTANCE_SIGNATURE
#
# El lanzador ya resolvia el socket de Wayland, pero no la firma de Hyprland, y
# por eso la isla corria con CERO variables HYPRLAND_*. Eso no hacia falta para
# pintar la isla, pero si para todo lo que la isla lanza: cada Process que
# quickshell crea hereda su entorno, asi que cualquier script que use hyprctl
# (island-fullscreens, wallpaper-apply, background-health...) recibe
# "HYPRLAND_INSTANCE_SIGNATURE not set!" y falla en silencio. De ahi que la
# transicion del fondo saliera solo en el panel interno, o que la isla no se
# ocultara con un video a pantalla completa.
#
# No se puede declarar en la unidad: la firma cambia en cada sesion y la unidad
# no se entera de cual es. Se espera igual que se espera la pantalla, y si
# Hyprland no aparece se arranca igualmente: la isla tiene que salir aunque el
# compositor no este, porque si no no habria forma de recuperarlo desde ella.
buscar_firma() {
    local d s dir
    for dir in "$XDG_RUNTIME_DIR/hypr" "/tmp/hypr"; do
        [ -d "$dir" ] || continue
        for d in $(ls -t "$dir" 2>/dev/null); do
            [ -d "$dir/$d" ] || continue
            s="$d"
            [ -n "$s" ] || continue
            if [ -S "$dir/$d/.socket2.sock" ] ||
               [ -S "$dir/$d.socket2.sock" ] ||
               [ -S "$dir/$d/.socket.sock" ]; then
                printf '%s\n' "$s"
                return 0
            fi
        done
    done
    return 1
}

esperar_firma() {
    local i
    for ((i = 1; i <= 60; i++)); do
        if HYPRLAND_INSTANCE_SIGNATURE="$(buscar_firma)"; then
            export HYPRLAND_INSTANCE_SIGNATURE
            [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && return 0
        fi
        sleep 0.5
    done
    return 1
}

if HYPRLAND_INSTANCE_SIGNATURE="$(buscar_firma)"; then
    export HYPRLAND_INSTANCE_SIGNATURE
elif ! esperar_firma; then
    echo "quickshell-island: aviso, no se encontro la firma de Hyprland; hyprctl no funcionara en la isla" >&2
fi

# Si corre bajo un servicio systemd activo y se invoco manualmente, delegar reinicio
if [ -z "$INVOCATION_ID" ] && systemctl --user is-active waybar-island.service >/dev/null 2>&1; then
    exec systemctl --user restart waybar-island.service
fi

# Matar la instancia anterior por NOMBRE de proceso y luego filtrando por linea de
# comandos, nunca con pkill -f.
#
# pkill -f casa contra la linea de comandos completa, y ahi se cuela cualquiera
# que mencione la ruta: una terminal, un script, o el propio agente. Con
# "quickshell -p .*waybar-island" llego a matar el shell que lo invoco. pgrep -x
# compara solo el nombre del ejecutable, asi que un bash nunca puede coincidir.
#
# Ni pgrep -x ni pkill -f funcionan aqui en NixOS: el ejecutable se llama
# .quickshell-wrapped, no "quickshell", asi que el match por nombre no se
# daba nunca y las instancias anteriores sobrevivian. Se termina walkando
# /proc y comparando la linea de comandos, que si lleva el nombre real, y sin
# restricting el patron a un unico PID.
#
# Se hace DESPUES de esperar la pantalla a proposito: si se hiciera antes y luego
# la pantalla no apareciera, se habria quedado sin isla y sin instance nueva.
for _proc in /proc/[0-9]*; do
    _pid="${_proc#/proc/}"
    [ "$_pid" = "$$" ] && continue
    _comm="$(cat "$_proc/comm" 2>/dev/null)" || continue
    case "$_comm" in
        bash|sh|zsh|dash|fish|grep|rg|cat|head|tail|less|more|nano|vim|nvim|code|git|python*|sleep)
            continue
            ;;
    esac
    _cmd="$(tr '\0' ' ' < "$_proc/cmdline" 2>/dev/null)" || continue
    case "$_cmd" in
        *quickshell*waybar-island*|*waybar-island*shell.qml*) kill "$_pid" 2>/dev/null || true ;;
    esac
done
sleep 0.2

if ! command -v quickshell >/dev/null 2>&1; then
    echo "quickshell-island: quickshell binary not found in PATH" >&2
    exit 1
fi

exec quickshell -p "$HOME/.config/quickshell/waybar-island/shell.qml"

#!/bin/bash
# Watches Hyprland IPC for monitor add/remove events and synchronizes:
# 1. Rust-Dock (one per connected screen)
# 2. Waybar (displays bar across all screens)
# 3. Wallpaper (awww applies current wallpaper to new monitors)

LAUNCHER="$HOME/.local/bin/rust-dock-launcher"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_FILE="$RUNTIME/rust-dock-visible"

# Solo una instancia. Hyprland lo arranca en el autostart y systemd lo
# supervisa, asi que sin este guardia hay dos vigilantes y cada evento de
# monitor reinicia las barras el doble de veces.
PIDFILE="$RUNTIME/rust-dock-monitor-watcher.pid"
if [ -f "$PIDFILE" ]; then
    owner=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
        exit 0
    fi
fi
printf '%s\n' "$$" > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

buscar_hypr_firma() {
    local d s dir
    for dir in "$RUNTIME/hypr" "/tmp/hypr"; do
        [ -d "$dir" ] || continue
        for d in $(ls -t "$dir" 2>/dev/null); do
            [ -d "$dir/$d" ] || continue
            s="$d"
            [ -n "$s" ] || continue
            if [ -S "$dir/$d/.socket2.sock" ] ||
               [ -S "$dir/$d.socket2.sock" ] ||
               [ -S "$dir/$d/.socket.sock" ]; then
                printf '%s\n' "$s"
                return 0
            fi
        done
    done
    return 1
}

detect_socket() {
    local sig="${HYPRLAND_INSTANCE_SIGNATURE}"
    if [ -z "$sig" ]; then
        sig="$(buscar_hypr_firma)" || true
    fi
    if [ -z "$sig" ]; then
        sig=$(ls -t "$RUNTIME/hypr/" 2>/dev/null | head -n1)
    fi
    if [ -S "$RUNTIME/hypr/$sig/.socket2.sock" ]; then
        echo "$RUNTIME/hypr/$sig/.socket2.sock"
    elif [ -S "/tmp/hypr/$sig/.socket2.sock" ]; then
        echo "/tmp/hypr/$sig/.socket2.sock"
    else
        echo "$RUNTIME/hypr/$sig/.socket2.sock"
    fi
}

restart_dock() {
    # El dock apagado por el usuario manda sobre los eventos de monitor y sobre
    # la reconciliacion periodica: si esta apagado, aqui no se relanza.
    if [ -f "$HOME/.config/rhythm/dock.conf" ] && \
       [ "$(awk -F= '$1 == "enabled" {print $2; exit}' "$HOME/.config/rhythm/dock.conf")" = "off" ]; then
        return 0
    fi
    "$LAUNCHER" >/dev/null 2>&1 &
}

# PIDs de las INSTANCIAS REALES de rust-dock, y nada mas.
dock_pids() {
    local entry pid exe
    for entry in /proc/[0-9]*; do
        pid="${entry#/proc/}"
        exe=$(readlink "$entry/exe" 2>/dev/null) || continue
        case "$exe" in
            *rust-dock*) ;;
            *) continue ;;
        esac
        echo "$pid"
    done
}

# Salida (-o) en la que esta un dock concreto.
dock_output() {
    tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="-o") {print $(i+1); exit}}'
}

# Make sure there is exactly one dock instance per connected monitor.
# Event driven handling alone is not enough: an event that arrives while the
# script is restarting, a monitor with a slow handshake, or an instance that
# dies on its own leaves the dock on the wrong screen until the next event.
reconcile_docks() {
    command -v hyprctl >/dev/null 2>&1 || return 0

    local monitors
    monitors=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
    [ -z "$monitors" ] && return 0

    local m pid out needs=0
    while IFS= read -r m; do
        [ -z "$m" ] && continue
        found=0
        for pid in $(dock_pids); do
            out=$(dock_output "$pid")
            [ "$out" = "$m" ] && { found=1; break; }
        done
        [ "$found" = "0" ] && { needs=1; break; }
    done <<< "$monitors"

    if [ "$needs" = "0" ]; then
        for pid in $(dock_pids); do
            out=$(dock_output "$pid")
            if [ -z "$out" ] || ! echo "$monitors" | grep -qw "$out"; then
                kill "$pid" 2>/dev/null || true
            fi
        done
    fi

    [ "$needs" = "1" ] && restart_dock
    return 0
}

# Waybar no lo supervisa ningun servicio: si muere, la barra desaparece hasta
# el proximo evento de monitor. Comprobarlo aqui lo deja solo.
#
# UNA BARRA POR MONITOR, no "alguna barra". Antes era `pgrep -x waybar`: con la
# barra de la pantalla principal en pie, ese check daba el visto bueno y una
# pantalla nueva se quedaba SIN BARRA para siempre. Pasaba al arrancar, porque
# el dock y la barra se lanzan a la vez y el monitor externo todavia no aparece
# en `hyprctl monitors` cuando launch.sh pregunta (por eso el log solo hacia
# falta a eDP-1). Y no habia red de seguridad: la comprobacion periodica era
# justo la que no se enteraba. El dock ya lo hacia bien en reconcile_docks; aqui
# faltaba el equivalente.
#
# El enfriamiento evita martillear: relanzar mata TODAS las barras con pkill -9
# y las reconstruye, asi que si algo no converge no se repite cada 15s.
# El enfriamiento va en el runtime dir del usuario, que es 0700 y propio, y
# no en /tmp con un nombre adivinable.
#
# En /tmp, otro usuario de la maquina podia crear este fichero primero con un
# contenido como `$(id > /tmp/x)`, y la linea de abajo lo metia en $((now -
# last)): bash expande el valor como expresion aritmetica, y ahi una
# sustitucion de comando se ejecuta. Es decir, escribir en un fichero de /tmp
# significa ejecutar como este usuario.
COOLDOWN_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.rust-dock-reconcile-cooldown"
reconcile_waybar() {
    [ -x "$HOME/.config/waybar/launch.sh" ] || return 0
    command -v hyprctl >/dev/null 2>&1 || return 0

    local monitors
    monitors=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
    [ -z "$monitors" ] && return 0

    local m missing=0
    while IFS= read -r m; do
        [ -z "$m" ] && continue
        # launch.sh lanza `waybar -c <dir>/config-<monitor> -s <estilo>`, asi que
        # el output se lee del propio cmdline. El ancla evita que config-DP-1
        # case con config-DP-11.
        #
        # El nombre del proceso no sirve: en Nix el binario es
        # .waybar-wrapped, no "waybar", asi que cualquier criterio por nombre
        # (pgrep -x, o este mismo -f con "waybar " al principio) daba falso
        # negativo. Con el criterio roto la barra parecia ausente siempre, y
        # reconcile la relanzaba cada 90 s: aparecia y desaparecia sola. Se
        # busca el ejecutable real, .waybar-wrapped, o el nombre en cualquier
        # posicion de la linea de comandos.
        pgrep -f "[w]aybar.*-c .*config-$m(\$| )" >/dev/null 2>&1 \
            || pgrep -f "[w]aybar-wrapped.*-c .*config-$m(\$| )" >/dev/null 2>&1 \
            || { missing=1; break; }
    done <<< "$monitors"

    # Retirar las barras de monitores que ya no estan.
    #
    # Faltaba la otra mitad: al desenchufar un monitor, su barra se quedaba
    # corriendo. reconcile_docks cierra los docks sobrantes y las barras se
    # quedaban ahi, invisibles pero vivas, arrastrando su modulo de Cava con
    # ellas. Nadie lo notaba porque no se ven, pero es un proceso menos por
    # cada monitor que se ha enchufado alguna vez.
    #
    # Se comparan los monitors que Hyprland reporta con los que atienden las
    # barras vivas, y se termina lo que no encaje. Con dock-procs, que compara
    # el ejecutable de verdad y no la linea de comandos.
    local PROCS="$HOME/.local/bin/dock-procs"
    if [ -x "$PROCS" ]; then
        for out in $("$PROCS" waybar list 2>/dev/null); do
            [ -z "$out" ] && continue
            echo "$monitors" | grep -qw "$out" || "$PROCS" waybar signal "$out" TERM
        done
    fi

    [ "$missing" = "0" ] && { rm -f "$COOLDOWN_FILE" 2>/dev/null; return 0; }

    local now last
    now=$(date +%s)
    # El contenido tiene que ser un numero entero. Aunque el fichero ya no este
    # en un sitio que otro usuario pueda escribir, validar aqui evita que un
    # fichero corrupto (o uno de una version anterior) acabe en una expresion
    # aritmetica con algo que no es un numero.
    last=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
    case "$last" in
        ''|*[!0-9]*) last=0 ;;
    esac
    # 90s: se autorrecupera solo, pero no se martillea.
    [ $((now - last)) -lt 90 ] && return 0
    printf '%s\n' "$now" > "$COOLDOWN_FILE" 2>/dev/null || true

    "$HOME/.config/waybar/launch.sh" >/dev/null 2>&1 &
    return 0
}

handle_monitor_event() {
    sleep 0.8

    # 1. Asegurar Waybar en todos los monitores de forma idempotente
    if [ -x "$HOME/.config/waybar/launch.sh" ]; then
        "$HOME/.config/waybar/launch.sh" >/dev/null 2>&1 &
    fi

    # 2. Relanzar Rust-Dock en todas las pantallas
    restart_dock
}

# Reconciliación inicial para monitores con handshake retardado (DisplayPort o
# HDMI externo tardan segundos en aparecer en `hyprctl monitors`).
#
# ANTES esto era un `handle_monitor_event`, que reinicia barra y dock enteros.
# Como el autostart de Hyprland ya habia arrancado la barra, cada arranque la
# mataba y la reconstruia sin motivo: el tercer fogonazo de los tres que se veian
# al iniciar sesion.
#
# Aqui solo se reconcilia, que ya significa "soluciona lo que falte": si cada
# monitor tiene su barra y su dock, no se toca nada. Se repite varias veces
# porque el monitor puede tardar en aparecer, y cada pasada sale sola si todo
# esta bien.
(
    for _ in 1 2 3 4 5 6; do
        sleep 5
        reconcile_docks < /dev/null
        reconcile_waybar < /dev/null
    done
) &

# Reconciliación periódica: el dock y la barra siempre quedan en la pantalla
# correcta, aunque se pierda un evento o una instancia muera sola.
(
    while true; do
        sleep 15
        reconcile_docks < /dev/null
        reconcile_waybar < /dev/null
    done
) &

while true; do
    SOCKET=$(detect_socket)
    if [ -S "$SOCKET" ]; then
        # Hyprland sends its events as lines on this socket. Bash cannot read
        # it: `open()` on a socket node returns ENXIO, so the classic
        # `while read ... done < "$SOCKET"` never worked, and this loop used to
        # check that the socket existed and then read stdin — which under
        # systemd is /dev/null, so it got an instant EOF and no monitor event
        # was ever handled. `connect()` is what works, so the stream is read by
        # a helper that does exactly that and nothing else.
        #
        # The burst collapsing lives there too: one plug makes Hyprland emit
        # several events, and rebuilding Waybar once per event is the flicker
        # this whole arrangement was supposed to avoid.
        STREAM="$HOME/.local/bin/hypr-event-stream"
        if [ -x "$STREAM" ]; then
            "$STREAM" "$SOCKET" | while IFS= read -r event; do
                case "$event" in
                    monitoradded*|monitorremoved*)
                        handle_monitor_event < /dev/null &
                        ;;
                esac
            done
        fi
    fi
    sleep 2
done

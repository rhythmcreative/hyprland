#!/usr/bin/env python3
# Backend helper for Desktop Settings Application
# Handles hardware queries, network, bluetooth, audio, displays, wallpapers, and compositor

import sys
import os
import subprocess
import json
import glob
import re

# Ensure runtime environment
xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
os.environ["XDG_RUNTIME_DIR"] = xdg_runtime

if "HYPRLAND_INSTANCE_SIGNATURE" not in os.environ:
    sig_paths = glob.glob(f"{xdg_runtime}/hypr/*")
    if sig_paths:
        sig_paths.sort(key=os.path.getmtime, reverse=True)
        for sp in sig_paths:
            base = os.path.basename(sp)
            if not base.endswith(".lock"):
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = base
                break

def run_cmd(cmd_list, timeout=10):
    try:
        res = subprocess.run(cmd_list, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)
        return res.stdout.strip()
    except Exception:
        return ""

def get_system_info():
    # CPU
    cpu = ""
    try:
        lscpu = run_cmd(["lscpu"])
        for line in lscpu.splitlines():
            if "Model name:" in line:
                cpu = line.split(":", 1)[1].strip()
                break
    except Exception:
        pass
    if not cpu:
        cpu = "AMD / Intel Processor"

    # GPU
    gpus = []
    try:
        lspci = run_cmd(["lspci"])
        for line in lspci.splitlines():
            if "VGA compatible controller" in line or "3D controller" in line:
                part = line.split(":", 2)[-1].strip()
                # Clean up chip name
                part = re.sub(r"\(rev.*?\)", "", part).strip()
                gpus.append(part)
    except Exception:
        pass
    gpu = " / ".join(gpus) if gpus else "Integrated Graphics"

    # Memory
    mem_used = "0 GiB"
    mem_total = "0 GiB"
    mem_pct = 0
    try:
        free_out = run_cmd(["free", "-m"])
        lines = free_out.splitlines()
        if len(lines) > 1:
            parts = lines[1].split()
            total_m = int(parts[1])
            used_m = int(parts[2])
            mem_pct = round((used_m / total_m) * 100) if total_m > 0 else 0
            mem_used = f"{round(used_m / 1024, 1)} GiB"
            mem_total = f"{round(total_m / 1024, 1)} GiB"
    except Exception:
        pass

    # Disk
    disk_used = "0G"
    disk_total = "0G"
    disk_pct = 0
    try:
        df_out = run_cmd(["df", "-h", "/"])
        lines = df_out.splitlines()
        if len(lines) > 1:
            parts = lines[1].split()
            disk_total = parts[1]
            disk_used = parts[2]
            disk_pct = int(parts[4].replace("%", ""))
    except Exception:
        pass

    # Kernel & Hostname & Uptime
    kernel = run_cmd(["uname", "-r"])
    hostname = run_cmd(["uname", "-n"])
    uptime = run_cmd(["uptime", "-p"]).replace("up ", "")

    # Hyprland version
    hypr_ver = "Hyprland"
    try:
        ver_out = run_cmd(["hyprctl", "version"])
        for line in ver_out.splitlines():
            if "Tag:" in line or "version:" in line:
                hypr_ver = line.strip()
                break
    except Exception:
        pass

    return {
        "os": "Arch Linux",
        "cpu": cpu,
        "gpu": gpu,
        "ram_used": mem_used,
        "ram_total": mem_total,
        "ram_pct": mem_pct,
        "disk_used": disk_used,
        "disk_total": disk_total,
        "disk_pct": disk_pct,
        "kernel": kernel,
        "hostname": hostname,
        "uptime": uptime,
        "hyprland": hypr_ver
    }

def get_wifi_status():
    wifi_enabled = run_cmd(["nmcli", "-t", "-f", "WIFI", "g"]).lower() == "enabled"
    active_ssid = ""
    active_signal = 0
    active_ip = ""
    
    # Get active connection
    active_lines = run_cmd(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "c", "show", "--active"]).splitlines()
    for l in active_lines:
        parts = l.split(":")
        if len(parts) >= 2 and ("wireless" in parts[1] or "wifi" in parts[1]):
            active_ssid = parts[0]
            dev = parts[2] if len(parts) > 2 else ""
            if dev:
                ip_out = run_cmd(["ip", "-4", "addr", "show", dev])
                m = re.search(r"inet\s+([0-9.]+)", ip_out)
                if m:
                    active_ip = m.group(1)
            break

    # Available networks
    networks = []
    seen = set()
    wifi_list = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"]).splitlines()
    for l in wifi_list:
        parts = l.split(":")
        if len(parts) >= 4:
            in_use = parts[0].strip() == "*"
            ssid = parts[1].strip()
            if not ssid or ssid in seen:
                continue
            seen.add(ssid)
            try:
                sig = int(parts[2].strip())
            except ValueError:
                sig = 50
            sec = parts[3].strip() or "Open"
            if in_use:
                active_signal = sig
            networks.append({
                "ssid": ssid,
                "signal": sig,
                "security": sec,
                "connected": in_use
            })
            if len(networks) >= 15:
                break

    return {
        "enabled": wifi_enabled,
        "connected": bool(active_ssid),
        "ssid": active_ssid,
        "signal": active_signal,
        "ip": active_ip,
        "networks": networks
    }

def get_bt_status():
    show_out = run_cmd(["bluetoothctl", "show"])
    powered = "Powered: yes" in show_out
    discoverable = "Discoverable: yes" in show_out

    devices = []
    paired_out = run_cmd(["bluetoothctl", "devices", "Paired"]).splitlines()
    for l in paired_out:
        parts = l.split()
        if len(parts) >= 3 and parts[0] == "Device":
            mac = parts[1]
            name = " ".join(parts[2:])
            info_out = run_cmd(["bluetoothctl", "info", mac])
            connected = "Connected: yes" in info_out
            icon = "audio" if any(x in name.lower() for x in ["airpod", "headset", "buds", "speaker", "audio"]) else "generic"
            devices.append({
                "mac": mac,
                "name": name,
                "connected": connected,
                "icon": icon
            })

    return {
        "powered": powered,
        "discoverable": discoverable,
        "devices": devices
    }

def get_audio_status():
    # Output Sink
    sink_name = "Default Output"
    sink_vol = 50
    sink_muted = False
    
    vol_out = run_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    sink_muted = "[MUTED]" in vol_out
    m = re.search(r"Volume:\s+([0-9.]+)", vol_out)
    if m:
        try:
            sink_vol = int(round(float(m.group(1)) * 100))
        except ValueError:
            sink_vol = 50

    # Input Source
    source_name = "Default Microphone"
    source_vol = 50
    source_muted = False

    src_out = run_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"])
    source_muted = "[MUTED]" in src_out
    m2 = re.search(r"Volume:\s+([0-9.]+)", src_out)
    if m2:
        try:
            source_vol = int(round(float(m2.group(1)) * 100))
        except ValueError:
            source_vol = 50

    # Device names
    status_out = run_cmd(["wpctl", "status"])
    section = None
    for l in status_out.splitlines():
        if "Sinks:" in l:
            section = "sinks"
            continue
        elif "Sources:" in l:
            section = "sources"
            continue
        elif "Filters:" in l or "Streams:" in l:
            section = None

        if section == "sinks" and "*" in l:
            cleaned = re.sub(r"^[^a-zA-Z0-9]+[0-9]+\.\s*", "", l)
            sink_name = re.sub(r"\[.*?\]", "", cleaned).strip()
        elif section == "sources" and "*" in l:
            cleaned = re.sub(r"^[^a-zA-Z0-9]+[0-9]+\.\s*", "", l)
            source_name = re.sub(r"\[.*?\]", "", cleaned).strip()

    return {
        "sink_name": sink_name,
        "sink_vol": sink_vol,
        "sink_muted": sink_muted,
        "source_name": source_name,
        "source_vol": source_vol,
        "source_muted": source_muted
    }

def get_display_status():
    monitors = []
    try:
        raw = run_cmd(["hyprctl", "monitors", "-j"])
        data = json.loads(raw)
        for m in data:
            monitors.append({
                "id": m.get("id", 0),
                "name": m.get("name", "eDP-1"),
                "model": m.get("model", ""),
                "width": m.get("width", 1920),
                "height": m.get("height", 1080),
                "refresh": round(m.get("refreshRate", 60)),
                "scale": m.get("scale", 1.0),
                "focused": m.get("focused", False)
            })
    except Exception:
        pass

    # Brightness
    bright_pct = 50
    try:
        cur_b = run_cmd(["brightnessctl", "g"])
        max_b = run_cmd(["brightnessctl", "m"])
        if cur_b and max_b:
            bright_pct = int(round((int(cur_b) / int(max_b)) * 100))
    except Exception:
        pass

    return {
        "monitors": monitors,
        "brightness": bright_pct
    }

def get_wallpapers(limit=24, offset=0):
    wp_dir = os.path.expanduser("~/Pictures/Wallpapers")
    current_wp = ""
    cache_wp = os.path.expanduser("~/.cache/current-wallpaper")
    if os.path.exists(cache_wp):
        try:
            with open(cache_wp, "r") as f:
                current_wp = f.read().strip()
        except Exception:
            pass

    files = []
    if os.path.isdir(wp_dir):
        patterns = ["*.jpg", "*.jpeg", "*.png", "*.webp"]
        for p in patterns:
            files.extend(glob.glob(os.path.join(wp_dir, p)))
    files.sort(key=os.path.getmtime, reverse=True)

    total = len(files)
    selected = files[offset:offset+limit]

    return {
        "current": current_wp,
        "total": total,
        "wallpapers": selected
    }

def main():
    if len(sys.argv) < 2:
        print(json.dumps({"error": "No action specified"}))
        return

    action = sys.argv[1]

    if action == "system-info":
        print(json.dumps(get_system_info()))
    elif action == "wifi-status":
        print(json.dumps(get_wifi_status()))
    elif action == "wifi-toggle":
        cur = run_cmd(["nmcli", "-t", "-f", "WIFI", "g"]).lower() == "enabled"
        new_state = "off" if cur else "on"
        subprocess.run(["nmcli", "radio", "wifi", new_state])
        print(json.dumps({"success": True, "state": new_state}))
    elif action == "wifi-connect" and len(sys.argv) > 2:
        ssid = sys.argv[2]
        pwd = sys.argv[3] if len(sys.argv) > 3 else ""
        cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        if pwd:
            cmd.extend(["password", pwd])
        out = run_cmd(cmd)
        print(json.dumps({"success": "successfully" in out.lower(), "msg": out}))
    elif action == "bt-status":
        print(json.dumps(get_bt_status()))
    elif action == "bt-toggle":
        show_out = run_cmd(["bluetoothctl", "show"])
        powered = "Powered: yes" in show_out
        subprocess.run(["bluetoothctl", "power", "off" if powered else "on"])
        print(json.dumps({"success": True}))
    elif action == "bt-connect" and len(sys.argv) > 2:
        mac = sys.argv[2]
        subprocess.run(["bluetoothctl", "connect", mac])
        print(json.dumps({"success": True}))
    elif action == "bt-disconnect" and len(sys.argv) > 2:
        mac = sys.argv[2]
        subprocess.run(["bluetoothctl", "disconnect", mac])
        print(json.dumps({"success": True}))
    elif action == "audio-status":
        print(json.dumps(get_audio_status()))
    elif action == "audio-set-vol" and len(sys.argv) > 3:
        target = "@DEFAULT_AUDIO_SINK@" if sys.argv[2] == "sink" else "@DEFAULT_AUDIO_SOURCE@"
        vol = sys.argv[3]
        subprocess.run(["wpctl", "set-volume", target, f"{vol}%"])
        print(json.dumps({"success": True}))
    elif action == "audio-toggle-mute" and len(sys.argv) > 2:
        target = "@DEFAULT_AUDIO_SINK@" if sys.argv[2] == "sink" else "@DEFAULT_AUDIO_SOURCE@"
        subprocess.run(["wpctl", "set-mute", target, "toggle"])
        print(json.dumps({"success": True}))
    elif action == "display-status":
        print(json.dumps(get_display_status()))
    elif action == "display-set-brightness" and len(sys.argv) > 2:
        b = sys.argv[2]
        subprocess.run(["brightnessctl", "set", f"{b}%"])
        print(json.dumps({"success": True}))
    elif action == "wallpapers":
        limit = int(sys.argv[2]) if len(sys.argv) > 2 else 24
        offset = int(sys.argv[3]) if len(sys.argv) > 3 else 0
        print(json.dumps(get_wallpapers(limit, offset)))
    elif action == "set-wallpaper" and len(sys.argv) > 2:
        wp_path = sys.argv[2]
        script = os.path.expanduser("~/.local/bin/setwall.sh")
        if os.path.exists(script) and os.path.exists(wp_path):
            subprocess.Popen([script, wp_path])
            print(json.dumps({"success": True}))
        else:
            print(json.dumps({"success": False, "error": "file not found"}))
    elif action == "dock-toggle":
        subprocess.run(["pkill", "-SIGUSR1", "rust-dock"])
        print(json.dumps({"success": True}))
    elif action == "dock-restart":
        subprocess.run(["pkill", "-9", "rust-dock"])
        dock_bin = os.path.expanduser("~/.local/bin/rust-dock")
        if os.path.exists(dock_bin):
            subprocess.Popen([dock_bin])
        print(json.dumps({"success": True}))
    else:
        print(json.dumps({"error": f"Unknown action: {action}"}))

if __name__ == "__main__":
    main()

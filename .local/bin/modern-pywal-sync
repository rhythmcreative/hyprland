#!/usr/bin/env bash

# modern-pywal-sync: El script DEFINITIVO de sincronización
# Este script ignora temas externos y aplica los colores directamente
# sobre el tema base de GTK para asegurar que NADA se quede "estancado".

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "/run/user/$(id -u)/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    fi
fi

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# 1. Cargar colores de Pywal
if [ ! -f "$HOME/.cache/wal/colors.sh" ]; then
    echo "Error: Pywal no ha generado colores aún."
    exit 1
fi
source "$HOME/.cache/wal/colors.sh"

echo "Iniciando Sincronización Maestra..."

# 2. Sincronizar GTK 3 y 4 (Método Directo)
# Copiamos directamente a .config para que sea la prioridad #1 del sistema
echo "  • GTK 3/4..."
mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"

# Sincronizar nm-applet (Generar CSS dinámico ultra-agresivo)
echo "  • nm-applet (System Tray)..."
cat > "$HOME/.config/gtk-3.0/nm-applet-waybar.css" <<EOF
/* nm-applet styling DEFINITIVO con Pywal */
window, .background, .nm-applet-window, #nm-applet, #nm-applet-menu, .menu {
    background-color: $background;
    color: $foreground;
}
menu, .menu, menuitem, .menuitem {
    background-color: $background;
    color: $foreground;
}
menuitem:hover, .menuitem:hover, menuitem *:hover {
    background-color: $color6;
    color: $background;
}
/* Específico para el texto del menú */
label {
    color: inherit;
}
button {
    background-color: $color6;
    color: $background;
}
EOF
# Copiar a GTK 4
cp "$HOME/.config/gtk-3.0/nm-applet-waybar.css" "$HOME/.config/gtk-4.0/nm-applet-waybar.css"

# GTK 3
if [ -f "$HOME/.cache/wal/gtk3.css" ]; then
    echo '@import "nm-applet-waybar.css";' > "$HOME/.config/gtk-3.0/gtk.css"
    cat "$HOME/.cache/wal/gtk3.css" >> "$HOME/.config/gtk-3.0/gtk.css"
fi

# GTK 4
if [ -f "$HOME/.cache/wal/gtk4.css" ]; then
    echo '@import "nm-applet-waybar.css";' > "$HOME/.config/gtk-4.0/gtk.css"
    cat "$HOME/.cache/wal/gtk4.css" >> "$HOME/.config/gtk-4.0/gtk.css"
fi

# 3. Sincronizar Iconos (Tela Circle)
echo "  • Iconos (Tela-Circle)..."
if [ -x "$HOME/.local/bin/pywal-tela-sync" ]; then
    "$HOME/.local/bin/pywal-tela-sync" >/dev/null 2>&1
fi

# 4. Forzar Recarga de GTK (Reset de tema)
if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface gtk-theme "PywalSync-Mono"
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
fi

# 5. Sincronizar Qt / KDE (Dolphin, etc.)
echo "  • Qt/KDE..."
if [ -x "$HOME/.local/bin/sync-qt-pywal" ]; then
    "$HOME/.local/bin/sync-qt-pywal" >/dev/null 2>&1 || true
fi

# 6. Sincronizar Waybar — reinicio completo para sincronizar todos los colores
echo "  • Waybar..."
if [ -f "$HOME/.cache/wal/colors-waybar.css" ]; then
    ln -sf "$HOME/.cache/wal/colors-waybar.css" "$HOME/.config/waybar/colors-pywal.css"
fi

# Reinicio rapido en segundo plano (SIGHUP mata a waybar: no usar)
# --force: la paleta cambio y Waybar no relee el CSS en caliente, asi que aqui
# si toca reconstruir aunque las barras ya esten donde deben. Sin esto el
# sincronizador se saltaria el reinicio en el arranque y la barra saldria con
# los colores viejos.
(
    pkill -x waybar 2>/dev/null || true
    sleep 0.3
    "$HOME/.config/waybar/launch.sh" --force >/dev/null 2>&1
    sleep 1
    pkill -x nm-applet 2>/dev/null || true
    nm-applet --indicator >/dev/null 2>&1 &
) &

# 6b. rust-dock: relanzar para que recoja la paleta nueva
# El panel del dock lo pinta el gtk.css global (window_bg_color) y GTK4 solo lee
# ese fichero al arrancar la aplicacion, nunca en caliente: sin relanzarlo, el
# dock se queda con la paleta anterior. Se hace en segundo plano y con retardo
# para no cortar la animacion del cambio de wallpaper.
echo "  • rust-dock..."
# setsid: el reinicio no debe bloquear a quien llama a este script (el flujo de
# wallpaper espera a que termine para volver a mostrar las barras).
setsid bash -c '
    sleep 0.8
    pkill -x rust-dock >/dev/null 2>&1 || true
    sleep 0.15
    "$HOME/.local/bin/rust-dock-launcher" >/dev/null 2>&1
' >/dev/null 2>&1 </dev/null &

# 6c. Auto-hide disabled: waybar stays always visible (SIGUSR2 = show)
pkill -x waybar_auto_hi 2>/dev/null || true
pkill -SIGUSR2 -x waybar 2>/dev/null || true

# 6d. Asegurar Dynamic Island corriendo y recargar colores de Pywal
echo "  • Dynamic Island (Quickshell)..."
if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
    quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call theme reload >/dev/null 2>&1 || true
else
    "$HOME/.local/bin/quickshell-island" &
fi

# 7. Sincronizar Rofi
echo "  • Rofi..."
if [ -f "$HOME/.cache/wal/colors-rofi.rasi" ]; then
    cp -f "$HOME/.cache/wal/colors-rofi.rasi" "$HOME/.config/rofi/colors-pywal.rasi"
fi

# 8. Sincronizar SDDM (Wallpaper y Colores)
echo "  • SDDM (Login Screen)..."
if [ -x "$HOME/.local/bin/sddm-sync-wrapper" ]; then
    # Usamos el wrapper que maneja pkexec para los privilegios
    "$HOME/.local/bin/sddm-sync-wrapper" >/dev/null 2>&1 &
fi

# 9. Sincronizar Mako (Notificaciones)
echo "  • Mako..."
if [ -x "$HOME/.local/bin/sync-mako-pywal" ]; then
    "$HOME/.local/bin/sync-mako-pywal" >/dev/null 2>&1 || true
fi

# 10. Recargar Hyprland (Bordes y colores de ventana)
echo "  • Hyprland..."
hyprctl reload >/dev/null 2>&1 || true

# 11. Sincronización completada silenciosamente
echo "¡Hecho! El sistema ahora debería reflejar los nuevos colores."

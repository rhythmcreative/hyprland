#!/bin/bash
# Lanza una instancia de rust-dock por cada monitor conectado

RUST_DOCK="$HOME/.local/bin/rust-dock"
STATE_FILE="/tmp/rust-dock-visible"

if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Detectar monitores activos de forma segura con reintentos
monitors=""
for _ in {1..6}; do
    if command -v hyprctl >/dev/null 2>&1 && [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        mon_json=$(hyprctl monitors -j 2>/dev/null || true)
        if [ -n "$mon_json" ] && [ "$mon_json" != "[]" ]; then
            monitors=$(echo "$mon_json" | jq -r '.[].name' 2>/dev/null || true)
            [ -n "$monitors" ] && break
        fi
    fi
    sleep 0.3
done

if [ -z "$monitors" ] || [ "$monitors" = "null" ]; then
    if ! pgrep -x rust-dock >/dev/null 2>&1; then
        "$RUST_DOCK" >/dev/null 2>&1 &
    fi
    echo "visible" > "$STATE_FILE" 2>/dev/null || true
    exit 0
fi

# Si hay alguna instancia genérica sin -o, terminarla para usar instancias por monitor
if pgrep -x rust-dock >/dev/null 2>&1 && ! pgrep -f "rust-dock -o" >/dev/null 2>&1; then
    pkill -x rust-dock 2>/dev/null
    sleep 0.2
fi

while IFS= read -r monitor; do
    [ -z "$monitor" ] && continue
    if ! pgrep -f "rust-dock.*-o +$monitor(\$| )" >/dev/null 2>&1; then
        "$RUST_DOCK" -o "$monitor" >/dev/null 2>&1 &
    fi
done <<< "$monitors"

echo "visible" > "$STATE_FILE" 2>/dev/null || true

#!/bin/bash
# toggle-powersave - Power saving manager for Dynamic Island and Hyprland
# Optimizes CPU frequency/EPP, display brightness, GPU effects and window/rofi opacity.
# Maintains full animations and leaves Waybar battery in its original configuration.

STATE_FILE="/tmp/powersave-active"
BRIGHTNESS_BACKUP="/tmp/powersave_brightness_backup"
ACTION="${1:-toggle}"

is_active() {
    [ -f "$STATE_FILE" ]
}

enable_powersave() {
    touch "$STATE_FILE"

    # 1. CPU Energy Performance Preference (EPP) to power-saving
    if [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
        sudo tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference <<< "power" >/dev/null 2>&1 || true
        sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor <<< "powersave" >/dev/null 2>&1 || true
    fi

    # 2. Dim brightness gently to eco level (35%) if currently higher
    if command -v brightnessctl >/dev/null 2>&1; then
        current_b=$(brightnessctl get 2>/dev/null)
        max_b=$(brightnessctl max 2>/dev/null)
        if [ -n "$current_b" ] && [ -n "$max_b" ] && [ "$max_b" -gt 0 ]; then
            pct=$(( current_b * 100 / max_b ))
            if [ "$pct" -gt 40 ]; then
                echo "$current_b" > "$BRIGHTNESS_BACKUP"
                brightnessctl set 35% >/dev/null 2>&1 || true
            fi
        fi
    fi

    # 3. Disable heavy Hyprland blur/shadows but PRESERVE animations (animations = true)
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl eval 'hl.config({ decoration = { active_opacity = 1.0, inactive_opacity = 0.98, blur = { enabled = false }, shadow = { enabled = false } }, animations = { enabled = true } })' >/dev/null 2>&1 || true
        hyprctl eval 'hl.window_rule({ name = "powersave-opaque", match = { class = ".*" }, opaque = true })' >/dev/null 2>&1 || true
    fi

    # 4. Set kitty background opacity to 1.0 for solid dark terminal (no background bleed)
    for kconf in "$HOME/.config/kitty/kitty.conf" "/home/rhythmcreative/.config/kitty/kitty.conf"; do
        if [ -f "$kconf" ]; then
            sed -i 's/background_opacity [0-9.]*/background_opacity 1.0/' "$kconf" 2>/dev/null || true
        fi
    done
    pkill -SIGUSR1 kitty 2>/dev/null || true

    # 5. Make Rofi completely solid/opaque in powersave mode
    local bg_c
    bg_c=$(head -n 1 "$HOME/.cache/wal/colors" 2>/dev/null || echo "#101516")
    [ -n "$bg_c" ] || bg_c="#101516"
    for rdir in "$HOME/.config/rofi" "/home/rhythmcreative/.config/rofi"; do
        if [ -d "$rdir" ]; then
            # Esto es una version SEMI-TRANSPARENTE a proposito, igual que el tema
        # normal: el ahorro viene de quitar el blur, no de poner el panel opaco.
        # Con el color sin alfa el menu salia macizo, tapaba el escritorio de
        # fondo y se veía raro, cuando en theory solo deberia verse sin desenfoque.
        # Los sufijos son los mismos que genera pywal en colors-pywal.rasi:
        # CC = 80%, AA = 67%.
        cat > "$rdir/colors-powersave.rasi" << EOF
* {
    bgcolor: ${bg_c}CC;
    background-trans: ${bg_c}CC;
    background-alt-trans: ${bg_c}AA;
}
window {
    background-color: ${bg_c}CC;
}
mainbox {
    background-color: ${bg_c}AA;
}
EOF
        fi
    done

    # 6. Desktop Notification
    notify-send -a "Battery Saver" -i battery-caution "Battery Saver Turned On" "Performance optimized and solid window surfaces" 2>/dev/null || true
    echo "on"
}

disable_powersave() {
    rm -f "$STATE_FILE"

    # 1. Restore CPU to performance / balanced
    if [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
        sudo tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference <<< "performance" >/dev/null 2>&1 || true
    fi

    # 2. Restore previous brightness if saved
    if [ -f "$BRIGHTNESS_BACKUP" ] && command -v brightnessctl >/dev/null 2>&1; then
        saved_b=$(cat "$BRIGHTNESS_BACKUP")
        if [ -n "$saved_b" ]; then
            brightnessctl set "$saved_b" >/dev/null 2>&1 || true
        fi
        rm -f "$BRIGHTNESS_BACKUP"
    fi

    # 3. Reload Hyprland config to restore animations, blur, shadows, and default window transparency
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    fi

    # 4. Restore kitty background opacity to 0.85
    for kconf in "$HOME/.config/kitty/kitty.conf" "/home/rhythmcreative/.config/kitty/kitty.conf"; do
        if [ -f "$kconf" ]; then
            sed -i 's/background_opacity [0-9.]*/background_opacity 0.85/' "$kconf" 2>/dev/null || true
        fi
    done
    pkill -SIGUSR1 kitty 2>/dev/null || true

    # 5. Restore Rofi default translucent blur
    for rdir in "$HOME/.config/rofi" "/home/rhythmcreative/.config/rofi"; do
        if [ -d "$rdir" ]; then
            > "$rdir/colors-powersave.rasi"
        fi
    done

    # 6. Desktop Notification
    notify-send -a "Battery Saver" -i battery-good "Battery Saver Turned Off" "Normal performance and visual effects restored" 2>/dev/null || true
    echo "off"
}

case "$ACTION" in
    status)
        if is_active; then
            echo "on"
        else
            echo "off"
        fi
        ;;
    on)
        enable_powersave
        ;;
    off)
        disable_powersave
        ;;
    toggle|*)
        if is_active; then
            disable_powersave
        else
            enable_powersave
        fi
        ;;
esac

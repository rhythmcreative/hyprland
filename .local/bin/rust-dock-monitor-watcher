#!/bin/bash
# Watches Hyprland IPC for monitor add/remove events and synchronizes:
# 1. Rust-Dock (one per connected screen)
# 2. Waybar (displays bar across all screens)
# 3. Wallpaper (awww applies current wallpaper to new monitors)

LAUNCHER="$HOME/.local/bin/rust-dock-launcher"
STATE_FILE="/tmp/rust-dock-visible"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

detect_socket() {
    local sig="${HYPRLAND_INSTANCE_SIGNATURE}"
    if [ -z "$sig" ]; then
        sig=$(ls -t "$RUNTIME/hypr/" 2>/dev/null | head -n1)
    fi
    echo "$RUNTIME/hypr/$sig/.socket2.sock"
}

restart_dock() {
    # El dock apagado por el usuario manda sobre los eventos de monitor y sobre
    # la reconciliacion periodica: si esta apagado, aqui no se relanza.
    if [ -f "$HOME/.config/rhythm/dock.conf" ] && \
       [ "$(awk -F= '$1 == "enabled" {print $2; exit}' "$HOME/.config/rhythm/dock.conf")" = "off" ]; then
        return 0
    fi
    "$LAUNCHER" >/dev/null 2>&1 &
}

# Make sure there is exactly one dock instance per connected monitor.
# Event driven handling alone is not enough: an event that arrives while the
# script is restarting, a monitor with a slow handshake, or an instance that
# dies on its own leaves the dock on the wrong screen until the next event.
reconcile_docks() {
    command -v hyprctl >/dev/null 2>&1 || return 0

    local monitors
    monitors=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
    [ -z "$monitors" ] && return 0

    local m pid out needs=0
    while IFS= read -r m; do
        [ -z "$m" ] && continue
        pgrep -f "rust-dock.*-o +$m(\$| )" >/dev/null 2>&1 || { needs=1; break; }
    done <<< "$monitors"

    if [ "$needs" = "0" ]; then
        for pid in $(pgrep -f "rust-dock.*-o" 2>/dev/null); do
            out=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -oP -- '-o\s+\K\S+' || true)
            if [ -n "$out" ] && ! echo "$monitors" | grep -qw "$out"; then
                kill "$pid" 2>/dev/null || true
            fi
        done
    fi

    [ "$needs" = "1" ] && restart_dock
    return 0
}

handle_monitor_event() {
    sleep 0.8

    # 1. Sincronizar Wallpaper en la nueva pantalla
    if [ -x "$HOME/.local/bin/load-last-wallpaper-fast" ]; then
        "$HOME/.local/bin/load-last-wallpaper-fast" >/dev/null 2>&1 &
    fi

    # 2. Reiniciar Waybar para que se adapte y cree barra en todos los monitores
    if [ -x "$HOME/.config/waybar/launch.sh" ]; then
        "$HOME/.config/waybar/launch.sh" >/dev/null 2>&1 &
    fi

    # 3. Relanzar Rust-Dock en todas las pantallas
    restart_dock
}

# Auto-reconciliación inicial tras arranque para monitores con handshake retardado (ej. DisplayPort/HDMI externo)
(
    sleep 3
    handle_monitor_event < /dev/null
) &

# Reconciliación periódica: el dock siempre queda en la pantalla correcta,
# aunque se pierda un evento o una instancia muera sola.
(
    while true; do
        sleep 15
        reconcile_docks < /dev/null
    done
) &

while true; do
    SOCKET=$(detect_socket)
    if [ -S "$SOCKET" ]; then
        socat -u "UNIX-CONNECT:$SOCKET" - 2>/dev/null | while read -r event; do
            case "$event" in
                monitoradded*|monitorremoved*)
                    handle_monitor_event < /dev/null
                    ;;
            esac
        done
    fi
    sleep 2
done

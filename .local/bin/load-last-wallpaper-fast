#!/bin/bash

# ═══════════════════════════════════════════════════════════════════════════════
# WALLPAPER LOADER - ULTRA FAST VERSION
# ═══════════════════════════════════════════════════════════════════════════════
# Optimizado para inicio ultra rápido de Hyprland

LOG_FILE="$HOME/.cache/wallpaper-theme.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# El entorno del compositor se resuelve aqui y no se da por puesto porque los
# dos watchers de monitor (wallpaper-monitor-watcher y rust-dock-monitor-watcher,
# ambos desde unidades de systemd de usuario) lanzan este script. systemd no
# hereda nada del compositor, asi que sin esto no hay ni WAYLAND_DISPLAY ni
# HYPRLAND_INSTANCE_SIGNATURE.
#
# Sin WAYLAND_DISPLAY el cliente de awww busca su socket en
# $XDG_RUNTIME_DIR/wayland-0-awww-daemon.sock y cae en "not found", porque en
# este portatil el compositor toma wayland-1. Entonces ni el `awww query` de la
# comprobacion de abajo, ni el `awww-daemon` de arranque, ni el repintado que se
# pide despues llegaban a nada: el fondo no se ponia solo en ninguna pantalla.
# El fallo no se notaba porque todo va con >/dev/null 2>&1 || true.
#
# wallpaper-selector y wallpaper-random ya hacian esto; este camino, que es el
# automatico, se quedaba sin el. wallpaper-backend tambien lo resuelve por su
# cuenta, pero aqui hace falta antes, para la comprobacion del daemon.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$WAYLAND_DISPLAY" ]; then
    _wl=$(ls -t "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww-daemon' | head -n1)
    if [ -n "$_wl" ]; then export WAYLAND_DISPLAY=$(basename "$_wl"); fi
    unset _wl
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    _sig=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$_sig" ]; then export HYPRLAND_INSTANCE_SIGNATURE="$_sig"; fi
    unset _sig
fi

# Verificación de daemon (soporta awww)
DAEMON_RUNNING=false
if awww query > /dev/null 2>&1 || pgrep -x "awww-daemon" > /dev/null; then
    DAEMON_RUNNING=true
fi

if [ "$DAEMON_RUNNING" = false ]; then
    log "Daemon no detectado, intentando iniciar awww-daemon..."
    # Usar setsid para que el daemon no muera con el script
    setsid awww-daemon --format xrgb --no-cache > /dev/null 2>&1 &

    # Esperar a que el daemon esté listo
    for i in {1..50}; do
        if awww query > /dev/null 2>&1; then
            log "Daemon listo tras $((i*100))ms"
            DAEMON_RUNNING=true
            break
        fi
        sleep 0.1
    done
fi

if [ "$DAEMON_RUNNING" = false ]; then
    # Antes salia aqui con exit 1, y como estaba ANTES de mirar el cache, una
    # arranque lento (5 s no bastan) se comia la puesta de fondo entero aunque
    # hubiera una imagen valida perfectamente conocida. Se avisa y se sigue: la
    # cadena de abajo lo intentara de nuevo y, si tampoco puede, lo deja escrito
    # en el log en vez de terminar en silencio.
    log "AVISO: awww-daemon no respondio; se intenta poner el fondo igualmente"
fi

# ── RED DE SEGURIDAD: el wallpaper por defecto del repo ──────────────────────
#
# Esta es la razon de que el escritorio saliera con el fondo en negro y sin nada
# que pareciese un fallo. El repo trae
# .config/hypr/wallpapers/default.jpg, se copia a ~/.config/hypr/wallpapers/,
# y no lo leia NADA: cero referencias en todo el repo. La cadena de abajo se
# acababa y no pasaba nada.
#
# Y como hyprland.lua lleva force_default_wallpaper = 0 y disable_hyprland_logo
# = true, Hyprland tampoco pinta lo suyo: sin awww, ni gris de arranque ni logo.
# Es decir, que cualquier fallo de esta cadena no se ve como "sin fondo", se ve
# como una pantalla negra sin pistas.
#
# Ademas la rama 1 era un callejon sin salida: si el cache apuntaba a una imagen
# que ya no estaba, solo escribia en el log y se caia fuera del if/elif entero,
# sin probar la rama 2 ni la 3 y sin reparar el cache. wallpaper-monitor-watcher
# volvia a ejecutar este mismo script cada 10 s sin que cambiasen las cosas.
#
# Ahora: cada rama cae a la siguiente si su fichero no existe, y la ultima es el
# default del repo, que siempre esta.
DEFAULT_WP="$HOME/.config/hypr/wallpapers/default.jpg"

# Un intento: si la imagen existe, se pinta y se elige. Devuelve 0 si se pudo.
intentar_wallpaper() {
    local ruta="$1" motivo="$2"
    [ -n "$ruta" ] || return 1
    if [ ! -f "$ruta" ]; then
        log "$motivo no existe: $ruta"
        return 1
    fi
    log "Cargando ($motivo): $(basename "$ruta")"
    if "$HOME/.local/bin/wallpaper-backend" apply "$ruta" --login > /dev/null 2>&1; then
        # Solo se registra como actual si el pintado ha funcionado. Al reves,
        # wallpaper-backend escribe el cache ANTES de pintar, asi que un fallo
        # dejaba constancia de un fondo que no se estaba viendo y se repetia en
        # cada arranque.
        echo "$ruta" > "$CACHE_FILE"
        return 0
    fi
    log "wallpaper-backend no pudo pintar $ruta"
    return 1
}

CACHE_FILE="$HOME/.cache/current-wallpaper"
SDDM_WP="/usr/share/sddm/themes/sddm-astronaut-theme/Backgrounds/current_wallpaper.jpg"

# La cache va primera, pero si lo que tiene dentro ya no existe se sigue hacia
# abajo en vez de abandonar. Se limpia para que la proxima vuelta no vuelva a
# mirar un camino muerto.
if [[ -f "$CACHE_FILE" ]]; then
    CACHED=$(cat "$CACHE_FILE" 2>/dev/null || true)
    if [ -n "$CACHED" ] && [ -f "$CACHED" ]; then
        if ! intentar_wallpaper "$CACHED" "wallpaper actual"; then
            log "Se descarta el cache, que no se pudo pintar: $CACHED"
            rm -f "$CACHE_FILE"
        fi
    else
        log "El cache apunta a algo inexistente, se ignora: ${CACHED:-vacio}"
        rm -f "$CACHE_FILE"
    fi
fi

# Solo se llega aqui si no hay nada utilizable en el cache.
if [ ! -f "$CACHE_FILE" ]; then
    if [ -f "$HOME/.cache/wal/wal" ]; then
        intentar_wallpaper "$(cat "$HOME/.cache/wal/wal" 2>/dev/null || true)" "ultimo wallpaper de pywal" || true
    fi
    if [ ! -f "$CACHE_FILE" ] && [ -f "$SDDM_WP" ]; then
        log "Sincronizando con el wallpaper del greeter..."
        intentar_wallpaper "$SDDM_WP" "wallpaper de SDDM" || true
    fi
    # Ultimo recurso: la imagen que trae el repo. Esta no puede fallar por
    # no existir en una instalacion hecha con install.sh.
    if [ ! -f "$CACHE_FILE" ]; then
        if [ -f "$DEFAULT_WP" ]; then
            log "Sin wallpaper previo: se usa el default del repo."
            intentar_wallpaper "$DEFAULT_WP" "wallpaper por defecto" || true
        else
            log "AVISO: no hay ningun wallpaper que poner. No hay cache, ni pywal,"
            log "AVISO: ni el del greeter, ni $DEFAULT_WP"
        fi
    fi
fi

if [ -f "$CACHE_FILE" ]; then
    log "Proceso de carga completado"
else
    log "Proceso de carga terminado SIN wallpaper: el escritorio quedara en negro"
fi

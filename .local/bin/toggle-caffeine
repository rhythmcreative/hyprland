#!/bin/bash
# toggle-caffeine: persistent idle/sleep inhibitor for the Dynamic Island.

STATE_FILE="/tmp/caffeine-active"
ACTION="${1:-toggle}"
SERVICE="rhythm-caffeine.service"

stop_hypridle() {
    pkill -STOP -x hypridle 2>/dev/null || true
}

cont_hypridle() {
    pkill -CONT -x hypridle 2>/dev/null || true
}

enable() {
    touch "$STATE_FILE"
    stop_hypridle
    if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files "$SERVICE" 2>/dev/null | grep -q "$SERVICE"; then
        if ! systemctl --user start "$SERVICE" 2>/dev/null; then
            "$HOME/.local/bin/caffeine-keeper" &
        fi
    else
        "$HOME/.local/bin/caffeine-keeper" &
    fi
    echo "on"
}

disable() {
    rm -f "$STATE_FILE"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop "$SERVICE" 2>/dev/null || true
    fi
    pkill -f "caffeine-keeper" 2>/dev/null || true
    cont_hypridle
    echo "off"
}

case "$ACTION" in
    status)
        if [ -f "$STATE_FILE" ]; then
            # Recover the supervised inhibitor if it was interrupted.
            if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files "$SERVICE" 2>/dev/null | grep -q "$SERVICE"; then
                systemctl --user is-active --quiet "$SERVICE" || systemctl --user start "$SERVICE" >/dev/null 2>&1 || true
            else
                pgrep -f "caffeine-keeper" >/dev/null 2>&1 || "$HOME/.local/bin/caffeine-keeper" &
            fi
            stop_hypridle
            echo "on"
        else
            echo "off"
        fi
        ;;
    on)
        enable
        ;;
    off)
        disable
        ;;
    toggle|*)
        if [ -f "$STATE_FILE" ]; then
            disable
        else
            enable
        fi
        ;;
esac

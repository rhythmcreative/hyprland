#!/usr/bin/env bash
# Daemon launcher para Dynamic Island de Waybar

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

export QT_QPA_PLATFORM="wayland"

# Si corre bajo un servicio systemd activo y se invoco manualmente, delegar reinicio
if [ -z "$INVOCATION_ID" ] && systemctl --user is-active waybar-island.service >/dev/null 2>&1; then
    exec systemctl --user restart waybar-island.service
fi

pkill -f "quickshell -p .*waybar-island" 2>/dev/null || true
sleep 0.2

exec quickshell -p "$HOME/.config/quickshell/waybar-island/shell.qml"

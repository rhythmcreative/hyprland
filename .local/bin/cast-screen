#!/bin/bash
# cast-screen: wireless display (Windows + K equivalent) via Miracast/Chromecast.
# Opens the display picker; select your TV to mirror this screen.
set -uo pipefail
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    [ -n "$WL_DISP" ] && export WAYLAND_DISPLAY=$(basename "$WL_DISP") || export WAYLAND_DISPLAY="wayland-1"
fi
# P2P discovery needs the firewall open for streaming backchannel
if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active firewalld >/dev/null 2>&1; then
    sudo firewall-cmd --add-port=7236/udp --add-port=7250/tcp --timeout=2h >/dev/null 2>&1 || true
fi
exec gnome-network-displays

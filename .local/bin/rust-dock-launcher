#!/bin/bash
# Lanza una instancia de rust-dock por cada monitor conectado

RUST_DOCK="$HOME/.local/bin/rust-dock"
if [ ! -x "$RUST_DOCK" ] && command -v rust-dock >/dev/null 2>&1; then
    RUST_DOCK=$(command -v rust-dock)
fi
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_FILE="$RUNTIME/rust-dock-visible"
DOCK_CONF="$HOME/.config/rhythm/dock.conf"

dock_pids() {
    local entry pid exe
    for entry in /proc/[0-9]*; do
        pid="${entry#/proc/}"
        exe=$(readlink "$entry/exe" 2>/dev/null) || continue
        case "$exe" in
            *rust-dock*) ;;
            *) continue ;;
        esac
        echo "$pid"
    done
}

# Estado persistente: si el usuario apago el dock, aqui no se relanza nunca.
# 'on' cuando no hay fichero, para que una instalacion nueva muestre el dock.
if [ -f "$DOCK_CONF" ] && [ "$(awk -F= '$1 == "enabled" {print $2; exit}' "$DOCK_CONF")" = "off" ]; then
    for pid in $(dock_pids); do kill "$pid" 2>/dev/null || true; done
    pkill -x rust-dock >/dev/null 2>&1 || true
    pkill -x .rust-dock-wrap >/dev/null 2>&1 || true
    pkill -x .rust-dock-wrapped >/dev/null 2>&1 || true
    pkill -f "rust-dock" >/dev/null 2>&1 || true
    echo "hidden" > "$STATE_FILE" 2>/dev/null || true
    echo "hidden" > "/tmp/rust-dock-visible" 2>/dev/null || true
    exit 0
fi

if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="$RUNTIME"
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

buscar_hypr_firma() {
    local d s dir
    for dir in "$XDG_RUNTIME_DIR/hypr" "/tmp/hypr"; do
        [ -d "$dir" ] || continue
        for d in $(ls -t "$dir" 2>/dev/null); do
            [ -d "$dir/$d" ] || continue
            s="$d"
            [ -n "$s" ] || continue
            if [ -S "$dir/$d/.socket2.sock" ] ||
               [ -S "$dir/$d.socket2.sock" ] ||
               [ -S "$dir/$d/.socket.sock" ]; then
                printf '%s\n' "$s"
                return 0
            fi
        done
    done
    return 1
}

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    if HYPR_SIG="$(buscar_hypr_firma)"; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    elif [ -d "$XDG_RUNTIME_DIR/hypr" ]; then
        HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
        [ -n "$HYPR_SIG" ] && export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Detectar monitores activos de forma segura con reintentos
monitors=""
for _ in {1..6}; do
    if command -v hyprctl >/dev/null 2>&1 && [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        mon_json=$(hyprctl monitors -j 2>/dev/null || true)
        if [ -n "$mon_json" ] && [ "$mon_json" != "[]" ]; then
            monitors=$(echo "$mon_json" | jq -r '.[].name' 2>/dev/null || true)
            [ -n "$monitors" ] && break
        fi
    fi
    sleep 0.3
done

if [ -z "$monitors" ] || [ "$monitors" = "null" ]; then
    if ! pgrep -x rust-dock >/dev/null 2>&1 && ! dock_pids | grep -q .; then
        "$RUST_DOCK" >/dev/null 2>&1 &
    fi
    echo "visible" > "$STATE_FILE" 2>/dev/null || true
    echo "visible" > "/tmp/rust-dock-visible" 2>/dev/null || true
    exit 0
fi

# Monitor (-o) en el que está un dock concreto.
dock_output() {
    tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="-o") {print $(i+1); exit}}'
}

dock_on_monitor() {
    local pid
    for pid in $(dock_pids); do
        [ "$(dock_output "$pid")" = "$1" ] && return 0
    done
    return 1
}

# Si hay alguna instancia genérica sin -o, terminarla para usar instancias por monitor
if (pgrep -x rust-dock >/dev/null 2>&1 || pgrep -x .rust-dock-wrap >/dev/null 2>&1 || pgrep -x .rust-dock-wrapped >/dev/null 2>&1) && ! dock_pids | grep -q .; then
    pkill -x rust-dock 2>/dev/null || true
    pkill -x .rust-dock-wrap 2>/dev/null || true
    pkill -x .rust-dock-wrapped 2>/dev/null || true
    sleep 0.2
fi

# Cerrar instancias asociadas a monitores desconectados
for pid in $(dock_pids); do
    out=$(dock_output "$pid")
    if [ -n "$out" ] && ! echo "$monitors" | grep -qw "$out"; then
        kill "$pid" 2>/dev/null
    fi
done

while IFS= read -r monitor; do
    [ -z "$monitor" ] && continue
    dock_on_monitor "$monitor" || "$RUST_DOCK" -o "$monitor" >/dev/null 2>&1 &
done <<< "$monitors"

echo "visible" > "$STATE_FILE" 2>/dev/null || true
echo "visible" > "/tmp/rust-dock-visible" 2>/dev/null || true
